<fuzz-target>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

#include "/src/jq/vendor/oniguruma/src/oniguruma.h"

// The prompt mentions this macro is necessary, although it is not used in this fuzz target.
#define reg_number_of_names onig_posix_reg_number_of_names

// A struct to hold arguments for the scan_callback.
// This allows us to pass the fuzzer-controlled return code to the callback.
typedef struct {
int return_code;
} callback_args_t;

// Callback function for onig_scan.
// It returns a fuzzer-controlled value to test both continuation and early-exit paths.
static int scan_callback(int match_index, int r, OnigRegion *region, void *arg) {
(void)match_index;
(void)r;
(void)region;
callback_args_t *args = (callback_args_t *)arg;
if (args) {
return args->return_code;
}
return 0; // Default to continue if args are not provided.
}

// One-time initialization for the Oniguruma library, as required by its documentation.
// This is called by the fuzzer runtime before LLVMFuzzerTestOneInput is called for the first time.
int LLVMFuzzerInitialize(int *argc, char ***argv) {
(void)argc;
(void)argv;
// onig_initialize expects an array of encodings.
OnigEncoding encodings[] = { ONIG_ENCODING_UTF8 };
onig_initialize(encodings, sizeof(encodings) / sizeof(encodings[0]));
return 0;
}

// One-time teardown for the Oniguruma library.
// Called by the fuzzer runtime after all inputs have been processed.
int LLVMFuzzerTearDown(void) {
onig_end();
return 0;
}

// The prompt provides a corrupted function signature for onig_scan's callback parameter:
// DW_TAG_subroutine_typeInfinite loop *
// The fuzzer is implemented using the correct signature from oniguruma.h:
// int (*scan_callback)(int, int, OnigRegion*, void*)

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
// We need at least 3 bytes for options and 2 for pattern/string.
if (size < 5) {
return 0;
}

// Consume the first 3 bytes for configuration.
OnigOptionType compile_options = ONIG_OPTION_NONE;
if (data[0] & 0x01) compile_options |= ONIG_OPTION_IGNORECASE;
if (data[0] & 0x02) compile_options |= ONIG_OPTION_EXTEND;
if (data[0] & 0x04) compile_options |= ONIG_OPTION_MULTILINE;
if (data[0] & 0x08) compile_options |= ONIG_OPTION_SINGLELINE;

OnigOptionType scan_options = ONIG_OPTION_NONE;
if (data[1] & 0x01) scan_options |= ONIG_OPTION_NOTBOL;
if (data[1] & 0x02) scan_options |= ONIG_OPTION_NOTEOL;
if (data[1] & 0x04) scan_options |= ONIG_OPTION_FIND_LONGEST;
if (data[1] & 0x08) scan_options |= ONIG_OPTION_FIND_NOT_EMPTY;

callback_args_t callback_args;
callback_args.return_code = (int)((char)data[2]); // Use signed char for -128 to 127 range.

const uint8_t *fuzz_data = data + 3;
size_t fuzz_size = size - 3;

// Split the remaining fuzzer input into a pattern and a string to search.
size_t pattern_len = fuzz_size / 2;
const OnigUChar *pattern = fuzz_data;
const OnigUChar *str = fuzz_data + pattern_len;
size_t str_len = fuzz_size - pattern_len;

regex_t *reg = NULL;
OnigErrorInfo err_info;

// Requirement: The `reg` argument must be a valid `regex_t` object created by `onig_new`.
int r = onig_new(&reg, pattern, pattern + pattern_len,
compile_options, ONIG_ENCODING_UTF8,
ONIG_SYNTAX_DEFAULT, &err_info);

if (r != ONIG_NORMAL) {
// Pattern compilation failed. This is a valid fuzzing outcome for the compiler.
// reg is not allocated on failure, so no free is needed.
return 0;
}

// Requirement: The `region` argument must be a valid `OnigRegion` object.
OnigRegion *region = onig_region_new();
if (region == NULL) {
onig_free(reg);
return 0;
}

// Call the function-under-test with fuzzed options and callback behavior.
onig_scan(reg, str, str + str_len, region, scan_options, scan_callback, &callback_args);

// Requirement: Clean up allocated resources.
onig_region_free(region, 1 /* free self */);
onig_free(reg);

return 0;
}
</fuzz-target>

