#include "/src/astc-encoder/Source/astcenc_internal.h"

#include <fuzzer/FuzzedDataProvider.h>
#include <vector>
#include <memory>

// Define valid block dimension ranges for ASTC
const int MIN_BD_X = 3;
const int MAX_BD_X = 12;
const int MIN_BD_Y = 3;
const int MAX_BD_Y = 12;

// Structure to hold a block dimension tuple
struct BlockDim
{
int x, y, z;
};

// Pre-defined list of valid 3D block sizes according to the ASTC specification
// This is based on the is_legal_3d_block_size function in astcenc_percentile_tables.cpp
static const BlockDim valid_3d_dims[] = {
{3, 3, 3}, {4, 3, 3}, {4, 4, 3}, {4, 4, 4}, {5, 4, 4},
{5, 5, 4}, {5, 5, 5}, {6, 5, 5}, {6, 6, 5}, {6, 6, 6}
};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
{
// Need enough data for dimensions, mode, and payload
if (size < 1 + 16)
{
return 0;
}

FuzzedDataProvider stream(data, size);

int dim_x, dim_y, dim_z;

// Decide whether to test a 2D or 3D block
bool is_3d = stream.ConsumeBool();

if (is_3d)
{
// For 3D, pick a known-valid block dimension from the list
BlockDim dim = stream.PickValueInArray(valid_3d_dims);
dim_x = dim.x;
dim_y = dim.y;
dim_z = dim.z;
}
else
{
// For 2D, generate dimensions within the valid range
dim_x = stream.ConsumeIntegralInRange<int>(MIN_BD_X, MAX_BD_X);
dim_y = stream.ConsumeIntegralInRange<int>(MIN_BD_Y, MAX_BD_Y);
dim_z = 1;
}

// Allocate bsd on the heap to avoid stack overflow
auto bsd = std::make_unique<block_size_descriptor>();
init_block_size_descriptor(dim_x, dim_y, dim_z, false, 4, 1.0f, *bsd);

// 2. Construct a more valid physical block header
uint8_t pcb[16];
std::vector<uint8_t> remaining_bytes = stream.ConsumeRemainingBytes<uint8_t>();
if (remaining_bytes.size() < 16)
{
return 0;
}

// Use fuzzer data for most of the block
std::memcpy(pcb, remaining_bytes.data(), 16);

// But guide the fuzzer by creating a more structured header
// This avoids spending too much time on trivial error blocks
unsigned int partition_count = stream.ConsumeIntegralInRange<unsigned int>(1, 4);
unsigned int quant_mode_val = stream.ConsumeIntegralInRange<unsigned int>(0, 8); // All 9 quant modes

// Construct a basic, valid-looking block mode (not void-extent, not error)
// This is a simplified construction but better than pure random
unsigned int block_mode = 0;
if ((partition_count == 1) && (quant_mode_val > 1))
{
block_mode |= (quant_mode_val - 2) << 2;
block_mode |= 0b100;
}
else
{
block_mode |= (quant_mode_val & 0x1) << 2;
block_mode |= ((quant_mode_val >> 1) & 0x1) << 3;
block_mode |= (partition_count - 1) << 4;
block_mode |= ((quant_mode_val >> 2) & 0x1) << 6;
}

// This is a more accurate way to construct a valid block mode based on ASTC spec
// It avoids illegal encodings and ensures we hit valid decoding paths
pcb[0] = block_mode & 0xFF;
pcb[1] = (pcb[1] & 0xE0) | ((block_mode >> 8) & 0x1F);

// Create a symbolic block from the physical one
symbolic_compressed_block scb;
physical_to_symbolic(*bsd, pcb, scb);

// Call the function under test
scb.get_color_quant_mode();

return 0;
}
</fuzz-target>

