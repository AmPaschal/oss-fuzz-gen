//  limitations under the License.
// ----------------------------------------------------------------------------

#include "/src/astc-encoder/Source/astcenc_internal.h"

#include <array>
#include <fuzzer/FuzzedDataProvider.h>
#include <vector>

struct BlockSizes {
int x;
int y;
int z;
};

std::array<BlockSizes, 3> testSz{{
{4, 4, 1},   // Highest bitrate
{12, 12, 1}, // Largest 2D block
{6, 6, 6}    // Largest 3D block
}};

std::array<block_size_descriptor, 3> testBSD;

/**
* @brief Utility function to create all of the block size descriptors needed.
*/
bool bsd_initializer() {
for (size_t i = 0; i < testSz.size(); i++) {
// Use true for can_omit_modes to only get valid, usable modes
init_block_size_descriptor(testSz[i].x, testSz[i].y, testSz[i].z, true, 4, 1.0f, testBSD[i]);
}
return true;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
// Preinitialize the block size descriptors we need
static bool init = bsd_initializer();

if (size < 1) {
return 0;
}

FuzzedDataProvider stream(data, size);

// Select a block size to test
int i = stream.ConsumeIntegralInRange<int>(0, testSz.size() - 1);
const block_size_descriptor& bsd = testBSD[i];

// Create a symbolic block from fuzzer data. This is the structure-aware part.
symbolic_compressed_block scb;

// Fuzz the high-level block type
uint8_t block_type_choice = stream.ConsumeIntegralInRange<uint8_t>(0, 2);

if (block_type_choice != 0) { // SYM_BTYPE_NONCONST = 3, but we treat it as default
// For constant color blocks, just fuzz the color values
scb.block_type = stream.PickValueInArray<uint8_t>({SYM_BTYPE_CONST_F16, SYM_BTYPE_CONST_U16});
for (int j = 0; j < BLOCK_MAX_COMPONENTS; j++) {
scb.constant_color[j] = stream.ConsumeIntegral<uint16_t>();
}
} else {
scb.block_type = SYM_BTYPE_NONCONST;
// For normal blocks, fuzz the detailed symbolic components
scb.partition_count = stream.ConsumeIntegralInRange<uint8_t>(1, 4);

// Pick a *valid* block mode for the chosen block size
if (bsd.block_mode_count_all == 0) return 0;
unsigned int packed_bm_idx = stream.ConsumeIntegralInRange<unsigned int>(0, bsd.block_mode_count_all - 1);
scb.block_mode = bsd.block_modes[packed_bm_idx].mode_index;

scb.partition_index = stream.ConsumeIntegralInRange<uint16_t>(0, 1023);

// Fuzz color formats and values
scb.quant_mode = static_cast<quant_method>(stream.ConsumeIntegralInRange<int>(QUANT_6, QUANT_256));

scb.color_formats_matched = stream.ConsumeBool();

for (unsigned int p = 0; p < scb.partition_count; p++) {
scb.color_formats[p] = stream.ConsumeIntegralInRange<uint8_t>(0, 15);
int vals = 2 * (scb.color_formats[p] >> 2) + 2;
for (int v = 0; v < vals; v++) {
scb.color_values[p][v] = stream.ConsumeIntegral<uint8_t>();
}
}

// Fuzz weights
const auto& bm = bsd.get_block_mode(scb.block_mode);
const auto& di = bsd.get_decimation_info(bm.decimation_mode);
int weight_count = di.weight_count;
for(int w = 0; w < weight_count; w++) {
scb.weights[w] = stream.ConsumeIntegralInRange<uint8_t>(0, (1 << bm.weight_bits) -1);
}

// Fuzz dual plane info
if (bm.is_dual_plane) {
scb.plane2_component = stream.ConsumeIntegralInRange<int8_t>(0, 3);
for(int w = 0; w < weight_count; w++) {
scb.weights[w + WEIGHTS_PLANE2_OFFSET] = stream.ConsumeIntegralInRange<uint8_t>(0, (1 << bm.weight_bits) -1);
}
} else {
scb.plane2_component = -1;
}
}

// Convert the fuzzed symbolic block to a physical block.
// This ensures the input to physical_to_symbolic is always well-structured.
uint8_t pcb[16];
symbolic_to_physical(bsd, scb, pcb);

// Optionally, apply minor mutations to the valid block to test error paths
if (stream.ConsumeBool() && stream.remaining_bytes() > 0) {
uint8_t bit_to_flip = stream.ConsumeIntegralInRange<uint8_t>(0, 127);
pcb[bit_to_flip / 8] ^= (1 << (bit_to_flip % 8));
}

// Create a new symbolic block from the physical block (the actual test)
symbolic_compressed_block scb_out;
physical_to_symbolic(bsd, pcb, scb_out);

// Call the function under test (as per original target)
if (scb_out.block_type != SYM_BTYPE_ERROR) {
scb_out.get_color_quant_mode();
}

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: astc-encoder
function signature: DW_TAG_enumeration_typequant_method symbolic_compressed_block::get_color_quant_mode(const struct symbolic_compressed_block *)
</input>

<description>
The `get_color_quant_mode` function is an inline method of the `symbolic_compressed_block` struct. It returns the `quant_mode` member of the struct, which is an enum of type `quant_method`. This value represents the quantization method for color components in an ASTC compressed block. Callers of this function use the returned quantization method to determine how to decode or process the color data within the block.
</description>

<requirements>
<requirement>
The `symbolic_compressed_block` pointer (`this`) must not be a null pointer. A null pointer would lead to a crash when the function attempts to dereference it to access the `quant_mode` member.
</requirement>
<requirement>
The `quant_mode` member of the `symbolic_compressed_block` struct must be a valid value from the `quant_method` enum. The valid integer values for this enum are in the range [0, 22], corresponding to `QUANT_2` through `QUANT_256`.
</requirement>
</requirements>

</function-requirements>

