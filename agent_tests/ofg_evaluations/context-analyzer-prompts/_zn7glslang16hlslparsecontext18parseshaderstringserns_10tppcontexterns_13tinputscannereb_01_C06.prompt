<fuzz-target>
#include <fuzzer/FuzzedDataProvider.h>
#include "glslang/Public/ResourceLimits.h"
#include "glslang/Public/ShaderLang.h"
#include <vector>
#include <string>

// Dictionaries for more structured generation
// Changed from std::vector to a C-style array to match FuzzedDataProvider::PickValueInArray's signature.
const std::string hlsl_types[] = {
"void", "bool", "int", "uint", "half", "float", "double",
"bool1", "bool2", "bool3", "bool4", "float1", "float2", "float3", "float4",
"int1", "int2", "int3", "int4", "double1", "double2", "double3", "double4",
"uint1", "uint2", "uint3", "uint4", "float2x2", "float3x3", "float4x4",
"Texture2D", "SamplerState"
};

// --- Enhanced Generation Functions ---

std::string generate_identifier(FuzzedDataProvider& provider) {
// Generate identifiers that are less likely to clash with keywords.
return "fuzz_" + provider.ConsumeBytesAsString(provider.ConsumeIntegralInRange<uint8_t>(1, 10));
}

std::string generate_value(FuzzedDataProvider& provider) {
return provider.PickValueInArray<std::string>({
std::to_string(provider.ConsumeFloatingPoint<float>()),
std::to_string(provider.ConsumeIntegral<int>()),
"true", "false"
});
}

std::string generate_variable_declaration(FuzzedDataProvider& provider) {
return provider.PickValueInArray(hlsl_types) + " " + generate_identifier(provider) +
(provider.ConsumeBool() ? " = " + generate_value(provider) : "") + ";\n";
}

std::string generate_struct_definition(FuzzedDataProvider& provider) {
std::string s = "struct " + generate_identifier(provider) + " {\n";
int num_members = provider.ConsumeIntegralInRange<int>(1, 4);
for (int i = 0; i < num_members; ++i) {
s += "  " + generate_variable_declaration(provider);
}
s += "};\n";
return s;
}

std::string generate_cbuffer_definition(FuzzedDataProvider& provider) {
std::string s = "cbuffer " + generate_identifier(provider) + " {\n";
int num_members = provider.ConsumeIntegralInRange<int>(1, 4);
for (int i = 0; i < num_members; ++i) {
s += "  " + generate_variable_declaration(provider);
}
s += "};\n";
return s;
}

std::string generate_function_body(FuzzedDataProvider& provider, int depth); // Fwd decl

std::string generate_statement(FuzzedDataProvider& provider, int depth) {
if (depth <= 0) return "";
uint8_t choice = provider.ConsumeIntegralInRange<uint8_t>(0, 4);
switch (choice) {
case 0: return generate_variable_declaration(provider);
case 1: return "if (" + generate_identifier(provider) + ") " + generate_function_body(provider, depth - 1);
case 2: return "for (int i=0; i<1; ++i) " + generate_function_body(provider, depth - 1);
case 3: return generate_identifier(provider) + " = " + generate_value(provider) + ";\n";
case 4: return "return;\n";
}
return "";
}

std::string generate_function_body(FuzzedDataProvider& provider, int depth) {
std::string body = "{\n";
int num_statements = provider.ConsumeIntegralInRange<int>(1, 5);
for (int i = 0; i < num_statements; ++i) {
if (provider.remaining_bytes() < 10) break;
body += "  " + generate_statement(provider, depth - 1);
}
body += "}\n";
return body;
}

std::string generate_function_definition(FuzzedDataProvider& provider) {
return provider.PickValueInArray(hlsl_types) + " " + generate_identifier(provider) +
"() " + generate_function_body(provider, 2);
}

std::string generate_top_level_declaration(FuzzedDataProvider& provider) {
uint8_t choice = provider.ConsumeIntegralInRange<uint8_t>(0, 4);
switch (choice) {
case 0: return generate_variable_declaration(provider);
case 1: return generate_struct_definition(provider);
case 2: return generate_cbuffer_definition(provider);
case 3: return generate_function_definition(provider);
case 4: return "typedef " + provider.PickValueInArray(hlsl_types) + " " + generate_identifier(provider) + ";\n";
}
return "";
}

// --- Fuzz Target ---

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < 50) { // Increased minimum size for more meaningful generation
return 0;
}
FuzzedDataProvider provider(data, size);

glslang::InitializeProcess();

const EShLanguage stage = provider.PickValueInArray<EShLanguage>({
EShLangVertex, EShLangTessControl, EShLangTessEvaluation,
EShLangGeometry, EShLangFragment, EShLangCompute,
});

glslang::TShader shader(stage);
shader.setHlslIoMapping(provider.ConsumeBool());
shader.setEnvTargetHlslFunctionality1();
// Use a fixed entry point name that we will ensure exists
shader.setEntryPoint("main");

// Start with a base set of messages and let the fuzzer add more
unsigned int message_flags = EShMsgReadHlsl | EShMsgRelaxedErrors | EShMsgSuppressWarnings;
if (provider.remaining_bytes() > sizeof(uint32_t)) {
message_flags |= provider.ConsumeIntegral<uint32_t>();
}
EShMessages messages = (EShMessages)message_flags;

const int default_version = 450;
const bool forward_compatible = false;

std::string shader_source;
int num_declarations = provider.ConsumeIntegralInRange<int>(1, 8);
for (int i = 0; i < num_declarations; ++i) {
if (provider.remaining_bytes() < 20) break;
shader_source += generate_top_level_declaration(provider);
}

// Ensure at least one function named 'main' exists to be a valid entry point.
shader_source += "float4 main() : SV_Position { return float4(1,1,1,1); }\n";

if (shader_source.empty()) {
glslang::FinalizeProcess();
return 0;
}

const char* shader_strings[] = {shader_source.c_str()};
const int shader_lengths[] = {static_cast<int>(shader_source.length())};
shader.setStringsWithLengths(shader_strings, shader_lengths, 1);

shader.parse(GetDefaultResources(), default_version, forward_compatible, messages);

glslang::FinalizeProcess();
return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: glslang
function signature: bool glslang::HlslParseContext::parseShaderStrings(TPpContext & ppContext, TInputScanner & input, bool versionWillBeError)
</input>

<description>
The function `HlslParseContext::parseShaderStrings` is responsible for parsing HLSL shader strings. It takes a `TPpContext` for preprocessing and a `TInputScanner` which contains the shader source code. The function returns true if parsing is successful and false otherwise. The `HlslParseContext` should be initialized before calling this function. The `TInputScanner` should be initialized with the HLSL shader code to be parsed. The `TPpContext` should be initialized with a `HlslParseContext` instance, an optional file name, and a `TShader::Includer` instance. The `versionWillBeError` parameter is a boolean that indicates whether a version directive will be an error.
</description>

<requirements>
<requirement>
The `HlslParseContext` object must be initialized. This is because the `parseShaderStrings` function is a method of this class and uses its internal state.
</requirement>
<requirement>
The `TInputScanner` object must be initialized with the shader source code. This is because it provides the input stream for the parser.
</requirement>
<requirement>
The `TPpContext` object must be initialized with a `HlslParseContext` object, a file name, and a `TShader::Includer` object. This is because the preprocessor needs these to work correctly.
</requirement>
<requirement>
The `versionWillBeError` parameter should be set to `false` for fuzzing. This allows the fuzzer to explore paths where the version is not specified, which may uncover more bugs.
</requirement>
</requirements>

</function-requirements>

