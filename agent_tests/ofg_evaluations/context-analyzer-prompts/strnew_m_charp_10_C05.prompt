n = string_size;
}

char *buffer = (char *)malloc(string_size + 1);
if (!buffer) {
return 0;
}
memcpy(buffer, string_data, string_size);
buffer[string_size] = '\0';

// Strnew_charp_n allows passing an explicit (and possibly negative) length.
Str result = Strnew_charp_n(buffer, n);
if (result) {
Strfree(result);
}
free(buffer);
break;
}
