#include "astcenc_internal.h"

#include <fuzzer/FuzzedDataProvider.h>
#include <vector>
#include <cstdint>
#include <algorithm>

// Forward declaration for the functions under test.
void encode_ise(quant_method, unsigned int, const uint8_t *, uint8_t *, unsigned int);
void decode_ise(quant_method, unsigned int, const uint8_t *, uint8_t *, unsigned int);

// Helper to get the max value for a given quantization level.
// For QUANT_N, the max value is N-1.
static unsigned int get_max_val_for_quant(quant_method q)
{
switch (q)
{
case QUANT_2: return 1;
case QUANT_3: return 2;
case QUANT_4: return 3;
case QUANT_5: return 4;
case QUANT_6: return 5;
case QUANT_8: return 7;
case QUANT_10: return 9;
case QUANT_12: return 11;
case QUANT_16: return 15;
case QUANT_20: return 19;
case QUANT_24: return 23;
case QUANT_32: return 31;
case QUANT_40: return 39;
case QUANT_48: return 47;
case QUANT_64: return 63;
case QUANT_80: return 79;
case QUANT_96: return 95;
case QUANT_128: return 127;
case QUANT_160: return 159;
case QUANT_192: return 191;
case QUANT_256: return 255;
default: return 1; // Should not be reached
}
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
{
FuzzedDataProvider stream(data, size);

// Requirement 1: quant_level must be a valid value from the quant_method enum.
const quant_method valid_quants[] = {
QUANT_2, QUANT_3, QUANT_4, QUANT_5, QUANT_6, QUANT_8, QUANT_10,
QUANT_12, QUANT_16, QUANT_20, QUANT_24, QUANT_32, QUANT_40,
QUANT_48, QUANT_64, QUANT_80, QUANT_96, QUANT_128, QUANT_160,
QUANT_192, QUANT_256
};

quant_method quant_level = stream.PickValueInArray(valid_quants);
unsigned int max_val = get_max_val_for_quant(quant_level);

// Requirement 2: character_count must be > 0.
// We cap this at a reasonable value to avoid excessive allocations/loops.
// The vulnerability in decode_ise triggers for counts > 68.
unsigned int character_count = stream.ConsumeIntegralInRange<unsigned int>(1, 256);

// Requirement 3: input_data values must be within the valid range for the quant_level.
std::vector<uint8_t> input_data;
input_data.reserve(character_count);
for (unsigned int i = 0; i < character_count; ++i)
{
input_data.push_back(stream.ConsumeIntegralInRange<uint8_t>(0, max_val));
}

// Requirement 4: encoded_data buffer must be large enough.
// A safe upper bound for the output size is character_count * 11 bits.
// For character_count <= 256, this is 2816 bits = 352 bytes.
// We allocate a 400 byte buffer to be safe.
constexpr unsigned int kMaxOutputSize = 400;
uint8_t encoded_data[kMaxOutputSize] = {0};

// The bit_offset should be within the bounds of the output buffer.
// We limit it to the first 8 bytes (64 bits) to ensure most of the buffer is available.
unsigned int bit_offset = stream.ConsumeIntegralInRange<unsigned int>(0, 63);

// Call the encode function
encode_ise(quant_level, character_count, input_data.data(), encoded_data, bit_offset);

// Now, perform the round-trip test by calling the decode function
std::vector<uint8_t> decoded_data(character_count);
decode_ise(quant_level, character_count, encoded_data, decoded_data.data(), bit_offset);

// Optional: Verify that the decoded data matches the original input data.
// This can help find correctness bugs.
// if (input_data != decoded_data)
// {
// 	__builtin_trap();
// }

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: astc-encoder
function signature: void encode_ise(DW_TAG_enumeration_typequant_method, unsigned int, const uint8_t *, uint8_t *, unsigned int)
</input>

<description>
This function, `encode_ise`, is responsible for encoding an integer sequence using a specified quantization level. It supports three different encoding schemes based on the quantization level: one that uses trits, one that uses quints, and a simple bit-based encoding. The choice of encoding is determined by the `btq_counts` global variable, which is indexed by the `quant_level` parameter. The function reads from the `input_data` buffer, encodes the data, and writes the result to the `output_data` buffer, starting at the specified `bit_offset`. The callers of this function are responsible for providing correctly quantized input data and appropriately sized buffers.
</description>

<requirements>
<requirement>
The `quant_level` parameter must be a valid value from the `quant_method` enum, which ranges from 0 to 18. This is because `quant_level` is used to index the `btq_counts` array, and an invalid value can lead to an out-of-bounds access.
</requirement>
<requirement>
The `character_count` parameter must be greater than 0, as enforced by the `promise` at the beginning of the function. Providing a value of 0 will lead to an assertion failure.
</requirement>
<requirement>
The `input_data` buffer must have a size of at least `character_count` bytes. The function reads up to `character_count` elements from this buffer, and a smaller buffer will result in an out-of-bounds read.
</requirement>
<requirement>
The `output_data` buffer must be large enough to hold the encoded data. A buffer of at least 16 bytes is recommended, as seen in the caller `symbolic_to_physical`, to prevent buffer overflows during the write operations.
</requirement>
<requirement>
The values in the `input_data` buffer should be properly quantized according to the `quant_level`. The encoding process involves right-shifting the input values by a number of bits determined by the quantization level, so the input data must be prepared accordingly.
</requirement>
</requirements>

</function-requirements>

