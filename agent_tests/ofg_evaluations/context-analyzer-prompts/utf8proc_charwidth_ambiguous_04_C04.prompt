Here is the provided data.

<fuzz-target>
#include <string.h>
#include <stdlib.h>
#include <stdint.h>
#include "/src/utf8proc/utf8proc.h"

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
/* Fuzz with arbitrary 32-bit integer for the target function. */
if (size >= sizeof(utf8proc_int32_t)) {
utf8proc_charwidth_ambiguous(*(const utf8proc_int32_t *)data);
}

/*
* To improve coverage, derive the normalization options from the fuzzer input.
* We need at least enough bytes for the options.
*/
if (size < sizeof(utf8proc_option_t)) {
return 0;
}

/* Use the first part of the data for options. */
utf8proc_option_t options;
memcpy(&options, data, sizeof(options));
/* The rest of the data is the string. */
const uint8_t *string_data = data + sizeof(options);
size_t string_size = size - sizeof(options);

/* Fuzz iteration and property functions on the string input buffer */
const uint8_t *ptr = string_data;
utf8proc_ssize_t remaining_size = string_size;
utf8proc_int32_t c = 0, c_prev = 0;
utf8proc_int32_t state = 0;
utf8proc_ssize_t ret;

while (remaining_size > 0) {
ret = utf8proc_iterate(ptr, remaining_size, &c);

if (ret <= 0) {
break;
}

ptr += ret;
remaining_size -= ret;

utf8proc_tolower(c);
utf8proc_toupper(c);
utf8proc_totitle(c);
utf8proc_islower(c);
utf8proc_isupper(c);
utf8proc_charwidth(c);
utf8proc_category(c);
utf8proc_category_string(c);
utf8proc_codepoint_valid(c);
utf8proc_charwidth_ambiguous(c);

utf8proc_grapheme_break(c_prev, c);
utf8proc_grapheme_break_stateful(c_prev, c, &state);

c_prev = c;
}

/*
* Refined fuzzing for utf8proc_normalize_utf32.
* First, parse the input as a UTF-8 string to get valid codepoints,
* as the normalization functions have complex logic for valid sequences.
*/
utf8proc_int32_t* codepoints = NULL;
utf8proc_ssize_t num_codepoints = 0;
ptr = string_data;
remaining_size = string_size;

// First pass: count the number of codepoints to allocate memory
while (remaining_size > 0) {
ret = utf8proc_iterate(ptr, remaining_size, &c);
if (ret <= 0) break;
ptr += ret;
remaining_size -= ret;
num_codepoints++;
}

if (num_codepoints > 0) {
codepoints = (utf8proc_int32_t*)malloc(num_codepoints * sizeof(utf8proc_int32_t));
if (codepoints) {
// Second pass: fill the buffer with codepoints
ptr = string_data;
remaining_size = string_size;
utf8proc_ssize_t i = 0;
while (remaining_size > 0 && i < num_codepoints) {
ret = utf8proc_iterate(ptr, remaining_size, &codepoints[i]);
if (ret <= 0) break;
ptr += ret;
remaining_size -= ret;
i++;
}

// Make a mutable copy since the function normalizes in-place
utf8proc_int32_t *copy = (utf8proc_int32_t *)malloc(num_codepoints * sizeof(utf8proc_int32_t));
if (copy) {
memcpy(copy, codepoints, num_codepoints * sizeof(utf8proc_int32_t));
/* Fuzz with fuzzer-provided options */
utf8proc_normalize_utf32(copy, num_codepoints, options);
free(copy);
}
free(codepoints);
}
}

/* Fuzz normalization functions on the raw byte buffer with fuzzer-provided options */
uint8_t *mapped_str = NULL;
utf8proc_map(string_data, string_size, &mapped_str, options);
free(mapped_str);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: utf8proc
function signature: utf8proc_bool utf8proc_charwidth_ambiguous(utf8proc_int32_t)
</input>

<description>
The function `utf8proc_charwidth_ambiguous` takes a Unicode codepoint `c` and returns a boolean value indicating whether the character has an ambiguous width. It achieves this by calling `utf8proc_get_property` to retrieve the character's properties and then returning the `ambiguous_width` member of the resulting structure. The `utf8proc_get_property` function includes checks to handle invalid codepoints, ensuring that `utf8proc_charwidth_ambiguous` can be safely called with any 32-bit integer.
</description>

<requirements>
<requirement>
The input `c` should be fuzzed with arbitrary 32-bit integers. This is to test the function's handling of both valid and invalid Unicode codepoints.
</requirement>
<requirement>
For more effective fuzzing, it is recommended to focus the input `c` on the valid Unicode range of `[0, 0x10FFFF]`. This allows for more targeted testing of the properties of actual Unicode characters, as values outside this range are handled by a default case.
</requirement>
</requirements>

</function-requirements>

