#include <string>
#include <vector>
#include <cstdint>
#include <functional>
#include <fuzzer/FuzzedDataProvider.h>
#include "SQLParser.h"

// Forward declarations for recursive generation
std::string GenerateExpression(FuzzedDataProvider& provider, int depth);
std::string GenerateSelectStatement(FuzzedDataProvider& provider, int depth);

// Helper to generate a lexically valid SQL identifier.
// Starts with a letter, followed by letters, numbers, or underscores.
std::string GenerateIdentifier(FuzzedDataProvider& provider) {
const char kFirstChars[] = "abcdefghijklmnopqrstuvwxyz";
const char kOtherChars[] = "abcdefghijklmnopqrstuvwxyz0123456789_";

std::string identifier;
identifier += provider.PickValueInArray(kFirstChars);

size_t len = provider.ConsumeIntegralInRange<size_t>(0, 15);
for (size_t i = 0; i < len; ++i) {
identifier += provider.PickValueInArray(kOtherChars);
}
return identifier;
}

// Helper to generate a data type string.
std::string GenerateDataType(FuzzedDataProvider& provider) {
return provider.PickValueInArray<std::string>({
"INT", "INTEGER", "TEXT", "CHAR(10)", "VARCHAR(255)", "DOUBLE", "BOOLEAN", "DATETIME", "DATE"
});
}

// Helper to generate a column definition (e.g., "col_name INT NOT NULL").
std::string GenerateColumnDefinition(FuzzedDataProvider& provider) {
std::string def = GenerateIdentifier(provider) + " " + GenerateDataType(provider);
if (provider.ConsumeBool()) {
def += " ";
def += provider.PickValueInArray<std::string>({"PRIMARY KEY", "UNIQUE", "NOT NULL", "NULL"});
}
return def;
}

// Helper to generate a literal value.
std::string GenerateLiteral(FuzzedDataProvider& provider) {
return provider.PickValueInArray<std::function<std::string()>>({
[&]() { 
std::string content = provider.ConsumeRandomLengthString(20);
size_t pos = 0;
while ((pos = content.find('\'', pos)) != std::string::npos) {
content.replace(pos, 1, "''");
pos += 2;
}
return "'" + content + "'";
},
[&]() { return std::to_string(provider.ConsumeIntegral<int64_t>()); },
[&]() { return std::to_string(provider.ConsumeFloatingPoint<double>()); },
[&]() { return provider.PickValueInArray<std::string>({"NULL", "TRUE", "FALSE"}); }
})();
}

// Recursive helper to generate a simple SQL expression.
std::string GenerateExpression(FuzzedDataProvider& provider, int depth) {
if (depth <= 0 || provider.ConsumeIntegralInRange(0, 4) == 0) {
// Base case: a literal or an identifier
return provider.ConsumeBool() ? GenerateIdentifier(provider) : GenerateLiteral(provider);
}

// Recursive case: binary operation
std::string op = provider.PickValueInArray<std::string>({
"=", "!=", "<>", "<", ">", "<=", ">=", "AND", "OR", "LIKE", "IN", "+", "-", "*", "/"
});

if (op == "IN") {
return GenerateExpression(provider, depth - 1) + " IN (" + GenerateLiteral(provider) + ")";
}

return GenerateExpression(provider, depth - 1) + " " + op + " " + GenerateExpression(provider, depth - 1);
}

// Generates a CREATE TABLE statement.
std::string GenerateCreateTable(FuzzedDataProvider& provider) {
std::string query = "CREATE TABLE " + GenerateIdentifier(provider) + " (";
size_t num_cols = provider.ConsumeIntegralInRange<size_t>(1, 8);
for (size_t i = 0; i < num_cols; ++i) {
if (i > 0) query += ", ";
query += GenerateColumnDefinition(provider);
}
query += ");";
return query;
}

// Generates a simple INSERT statement.
std::string GenerateInsert(FuzzedDataProvider& provider) {
std::string query = "INSERT INTO " + GenerateIdentifier(provider) + " VALUES (";
size_t num_values = provider.ConsumeIntegralInRange<size_t>(1, 8);
for (size_t i = 0; i < num_values; ++i) {
if (i > 0) query += ", ";
query += GenerateLiteral(provider);
}
query += ");";
return query;
}

// Generates a simple UPDATE statement.
std::string GenerateUpdate(FuzzedDataProvider& provider) {
std::string query = "UPDATE " + GenerateIdentifier(provider) + " SET ";
size_t num_updates = provider.ConsumeIntegralInRange<size_t>(1, 4);
for (size_t i = 0; i < num_updates; ++i) {
if (i > 0) query += ", ";
query += GenerateIdentifier(provider) + " = " + GenerateLiteral(provider);
}
if (provider.ConsumeBool()) {
query += " WHERE " + GenerateExpression(provider, 2);
}
query += ";";
return query;
}

// Generates a simple DELETE statement.
std::string GenerateDelete(FuzzedDataProvider& provider) {
std::string query = "DELETE FROM " + GenerateIdentifier(provider);
if (provider.ConsumeBool()) {
query += " WHERE " + GenerateExpression(provider, 2);
}
query += ";";
return query;
}

// Generates a simple SELECT statement.
std::string GenerateSelectStatement(FuzzedDataProvider& provider, int depth) {
std::string query = "SELECT ";

if (provider.ConsumeBool()) {
query += "DISTINCT ";
}

// Select list
if (provider.ConsumeBool()) {
query += "*";
} else {
size_t num_cols = provider.ConsumeIntegralInRange<size_t>(1, 5);
for (size_t i = 0; i < num_cols; ++i) {
if (i > 0) query += ", ";
query += GenerateExpression(provider, 1);
}
}

// FROM clause
query += " FROM " + GenerateIdentifier(provider);
if (provider.ConsumeBool()) {
query += " AS " + GenerateIdentifier(provider);
}

// Optional WHERE clause
if (provider.ConsumeBool()) {
query += " WHERE " + GenerateExpression(provider, 2);
}

// Optional GROUP BY
if (provider.ConsumeBool()) {
query += " GROUP BY " + GenerateIdentifier(provider);
if (provider.ConsumeBool()) {
query += " HAVING " + GenerateExpression(provider, 1);
}
}

// Optional ORDER BY
if (provider.ConsumeBool()) {
query += " ORDER BY " + GenerateIdentifier(provider) + (provider.ConsumeBool() ? " ASC" : " DESC");
}

// Optional LIMIT
if (provider.ConsumeBool()) {
query += " LIMIT " + std::to_string(provider.ConsumeIntegralInRange<int>(1, 100));
}

query += ";";
return query;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < 1) {
return 0;
}
FuzzedDataProvider provider(data, size);
std::string query;

// Choose a statement type to generate
auto statement_generator = provider.PickValueInArray<std::function<std::string(FuzzedDataProvider&)>>({
GenerateCreateTable,
GenerateInsert,
GenerateUpdate,
GenerateDelete,
[](FuzzedDataProvider& p) { return GenerateSelectStatement(p, 3); },
});

query = statement_generator(provider);

hsql::SQLParserResult res;
hsql::SQLParser::parseSQLString(query, &res);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: sql-parser
function signature: bool hsql::SQLParser::parseSQLString(const string &, SQLParserResult *)
</input>

<description>
The function `hsql::SQLParser::parseSQLString` parses an SQL query string. It is a wrapper around the `hsql::SQLParser::parse` function, which uses a lexer and a parser to process the input string. The result of the parsing, including syntax errors, is stored in the `SQLParserResult` object provided by the caller. The function's return value indicates whether the parsing process was initialized and completed successfully, not whether the SQL query itself is valid. The validity of the SQL is indicated within the `SQLParserResult` object.
</description>

<requirements>
<requirement>
The `sql` argument should be a fuzzed string. This string is processed as an SQL query, and fuzzing it can uncover vulnerabilities in the parser.
</requirement>
<requirement>
The `result` argument must be a valid pointer to a `SQLParserResult` object. A null pointer will cause a crash when the function attempts to write the parsing results to it.
</requirement>
</requirements>

</function-requirements>

