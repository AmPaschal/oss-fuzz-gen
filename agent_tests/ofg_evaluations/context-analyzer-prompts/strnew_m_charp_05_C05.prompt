<fuzz-target>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <gc.h>
#include <limits.h>
#include <stdarg.h>
#include "Str.h"
#include "wc.h"
#include "wtf.h"

#define MAX_ARGS 16
#define STR_SIZE_MAX 65535

static void *die_oom(size_t bytes) {
fprintf(stderr, "Out of memory: %lu bytes unavailable!\n", (unsigned long)bytes);
exit(1);
}

// A wrapper to call Strnew_m_charp with a variable number of arguments
Str Strnew_m_charp_wrapper(int n_args, const char **args) {
// This is a bit of a hack to call a variadic function with a dynamic
// number of arguments. A more robust solution might involve assembly
// or a different approach, but this should be sufficient for fuzzing.
switch (n_args) {
case 1: return Strnew_m_charp(args[0], NULL);
case 2: return Strnew_m_charp(args[0], args[1], NULL);
case 3: return Strnew_m_charp(args[0], args[1], args[2], NULL);
case 4: return Strnew_m_charp(args[0], args[1], args[2], args[3], NULL);
case 5: return Strnew_m_charp(args[0], args[1], args[2], args[3], args[4], NULL);
case 6: return Strnew_m_charp(args[0], args[1], args[2], args[3], args[4], args[5], NULL);
case 7: return Strnew_m_charp(args[0], args[1], args[2], args[3], args[4], args[5], args[6], NULL);
case 8: return Strnew_m_charp(args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], NULL);
case 9: return Strnew_m_charp(args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], NULL);
case 10: return Strnew_m_charp(args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], NULL);
case 11: return Strnew_m_charp(args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], NULL);
case 12: return Strnew_m_charp(args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], NULL);
case 13: return Strnew_m_charp(args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12], NULL);
case 14: return Strnew_m_charp(args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12], args[13], NULL);
case 15: return Strnew_m_charp(args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12], args[13], args[14], NULL);
default: return Strnew_m_charp(args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12], args[13], args[14], args[15], NULL);
}
}

void test_small_strings(const uint8_t *data, size_t size) {
const char *argv[MAX_ARGS + 1];
int argc = 0;

const uint8_t *p = data;
const uint8_t *end = data + size;

while (p < end && argc < MAX_ARGS) {
const uint8_t *next = (const uint8_t *)memchr(p, '\0', end - p);
if (next == NULL) {
break;
}
argv[argc++] = (const char *)p;
p = next + 1;
}

if (argc > 0) {
Str s = Strnew_m_charp_wrapper(argc, argv);
Strfree(s);
}
}

// This strategy creates very long strings to test the overflow handling
// logic in Strcat_charp_n.
void test_long_strings(const uint8_t *data, size_t size) {
if (size < 5) {
return;
}

Str s = Strnew();

// Use 2 bytes for number of appends, 2 for length per append.
uint16_t num_appends = *(const uint16_t*)data;
uint16_t len_per_append = *(const uint16_t*)(data + 2);

// Cap the length of each chunk to prevent extreme allocations, but allow
// the total to exceed STR_SIZE_MAX.
len_per_append %= 8192;

const uint8_t *chunk_data = data + 4;
size_t chunk_data_size = size - 4;

if (chunk_data_size == 0 || len_per_append == 0) {
Strfree(s);
return;
}

char *chunk = (char *)malloc(len_per_append + 1);
if (chunk == NULL) {
Strfree(s);
return;
}

for (size_t i = 0; i < len_per_append; ++i) {
chunk[i] = chunk_data[i % chunk_data_size];
}
chunk[len_per_append] = '\0';

for (uint16_t i = 0; i < num_appends; ++i) {
Strcat_charp(s, chunk);
// Stop if the string gets excessively large, to be reasonable with memory.
if (s->length > STR_SIZE_MAX * 2) {
break;
}
}

free(chunk);
Strfree(s);
}

// This strategy tests the handling of negative length in Strcat_charp_n.
void test_negative_len(const uint8_t *data, size_t size) {
if (size == 0) {
return;
}
Str s = Strnew_charp("initial string");
// Directly call Strcat_charp_n with a negative length.
Strcat_charp_n(s, (const char*)data, -1);
Strfree(s);
}


int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
static int init_done = 0;

if (!init_done) {
setenv("GC_LARGE_ALLOC_WARN_INTERVAL", "30000", 1);
GC_INIT();
#if (GC_VERSION_MAJOR > 7) || ((GC_VERSION_MAJOR == 7) && (GC_VERSION_MINOR >= 2))
GC_set_oom_fn(die_oom);
#else
GC_oom_fn = die_oom;
#endif
#ifdef USE_M17N
#ifdef USE_UNICODE
wtf_init(WC_CES_UTF_8, WC_CES_UTF_8);
#else
wtf_init(WC_CES_EUC_JP, WC_CES_EUC_JP);
#endif
#endif
init_done = 1;
}

if (size < 1) {
return 0;
}

// Use a byte from the input to switch between testing strategies
uint8_t mode = data[0];
data++;
size--;

switch (mode % 3) {
case 0:
test_small_strings(data, size);
break;
case 1:
test_long_strings(data, size);
break;
case 2:
test_negative_len(data, size);
break;
}

return 0;
}
</fuzz-target>

