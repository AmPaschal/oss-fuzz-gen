#include <assert.h>
#include <stdint.h>
#include <unistd.h>
#include <string.h>
#include <stdlib.h>
#include <errno.h>

#include <gnutls/crypto.h>
#include <gnutls/gnutls.h>
#include <gnutls/x509.h>

#include "certs.h"
#include "fuzzer.h"

static ssize_t push_func(gnutls_transport_ptr_t p, const void *data, size_t len)
{
gnutls_datum_t *buf = (gnutls_datum_t *)p;
void *new_data = gnutls_realloc(buf->data, buf->size + len);
if (new_data == NULL) {
return -1;
}
buf->data = new_data;
memcpy(buf->data + buf->size, data, len);
buf->size += len;
return len;
}

static ssize_t pull_func(gnutls_transport_ptr_t p, void *data, size_t len)
{
gnutls_datum_t *buf = (gnutls_datum_t *)p;
if (buf->size == 0) {
errno = EAGAIN;
return -1;
}

size_t to_copy = (len > buf->size) ? buf->size : len;
memcpy(data, buf->data, to_copy);
if (buf->size > to_copy) {
memmove(buf->data, buf->data + to_copy, buf->size - to_copy);
}
buf->size -= to_copy;
return to_copy;
}

static int do_handshake(gnutls_session_t client, gnutls_session_t server)
{
int ret_c = 0, ret_s = 0;

do {
if (ret_c != GNUTLS_E_AGAIN && ret_c < 0) return ret_c;
if (ret_s != GNUTLS_E_AGAIN && ret_s < 0) return ret_s;

ret_c = gnutls_handshake(client);
ret_s = gnutls_handshake(server);

} while ((ret_c < 0 && gnutls_error_is_fatal(ret_c) == 0) ||
(ret_s < 0 && gnutls_error_is_fatal(ret_s) == 0));

if (ret_c < 0 || ret_s < 0) return -1;

return 0;
}

static void setup_sessions(gnutls_session_t *client_session, gnutls_session_t *server_session,
gnutls_certificate_credentials_t *xcred_s, gnutls_certificate_credentials_t *xcred_c,
gnutls_datum_t *skey, gnutls_datum_t *client_to_server_buf, gnutls_datum_t *server_to_client_buf,
uint8_t control_byte, unsigned int server_flags)
{
gnutls_datum_t rsa_cert, rsa_key;

gnutls_init(server_session, GNUTLS_SERVER | server_flags);
gnutls_init(client_session, GNUTLS_CLIENT);

gnutls_transport_set_ptr2(*client_session, server_to_client_buf, client_to_server_buf);
gnutls_transport_set_push_function(*client_session, push_func);
gnutls_transport_set_pull_function(*client_session, pull_func);

gnutls_transport_set_ptr2(*server_session, client_to_server_buf, server_to_client_buf);
gnutls_transport_set_push_function(*server_session, push_func);
gnutls_transport_set_pull_function(*server_session, pull_func);

gnutls_certificate_allocate_credentials(xcred_s);
rsa_cert.data = (unsigned char *)kRSACertificateDER;
rsa_cert.size = sizeof(kRSACertificateDER);
rsa_key.data = (unsigned char *)kRSAPrivateKeyDER;
rsa_key.size = sizeof(kRSAPrivateKeyDER);
gnutls_certificate_set_x509_key_mem(*xcred_s, &rsa_cert, &rsa_key, GNUTLS_X509_FMT_DER);
gnutls_certificate_set_known_dh_params(*xcred_s, GNUTLS_SEC_PARAM_MEDIUM);
gnutls_credentials_set(*server_session, GNUTLS_CRD_CERTIFICATE, *xcred_s);

gnutls_session_ticket_key_generate(skey);
gnutls_session_ticket_enable_server(*server_session, skey);

if (control_byte % 2 == 1) {
gnutls_record_set_max_early_data_size(*server_session, 1024);
}

gnutls_certificate_allocate_credentials(xcred_c);
gnutls_certificate_set_x509_trust_mem(*xcred_c, &rsa_cert, GNUTLS_X509_FMT_DER);
gnutls_credentials_set(*client_session, GNUTLS_CRD_CERTIFICATE, *xcred_c);

const char *priority = "NORMAL:-VERS-TLS-ALL:+VERS-TLS1.3";
gnutls_priority_set_direct(*server_session, priority, NULL);
gnutls_priority_set_direct(*client_session, priority, NULL);
}

static void cleanup_sessions(gnutls_session_t *client_session, gnutls_session_t *server_session,
gnutls_certificate_credentials_t *xcred_s, gnutls_certificate_credentials_t *xcred_c,
gnutls_datum_t *skey, gnutls_datum_t *client_to_server_buf, gnutls_datum_t *server_to_client_buf)
{
if (*server_session) gnutls_deinit(*server_session);
if (*client_session) gnutls_deinit(*client_session);
if (*xcred_s) gnutls_certificate_free_credentials(*xcred_s);
if (*xcred_c) gnutls_certificate_free_credentials(*xcred_c);
if (skey->data) gnutls_free(skey->data);
if (client_to_server_buf->data) gnutls_free(client_to_server_buf->data);
if (server_to_client_buf->data) gnutls_free(server_to_client_buf->data);

*server_session = NULL;
*client_session = NULL;
*xcred_s = NULL;
*xcred_c = NULL;
skey->data = NULL;
client_to_server_buf->data = NULL;
server_to_client_buf->data = NULL;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
{
if (size < 3) {
return 0;
}

uint8_t scenario = data[0] % 3;
uint8_t control_byte = data[1];
unsigned int nr = data[2];
if (nr == 0) {
nr = 1;
}

gnutls_session_t server_session = NULL, client_session = NULL;
gnutls_certificate_credentials_t xcred_s = NULL, xcred_c = NULL;
gnutls_datum_t skey = {0};
gnutls_datum_t client_to_server_buf = {0};
gnutls_datum_t server_to_client_buf = {0};

if (scenario == 0) { // Initial handshake path
setup_sessions(&client_session, &server_session, &xcred_s, &xcred_c, &skey,
&client_to_server_buf, &server_to_client_buf, control_byte, 0);

if (do_handshake(client_session, server_session) >= 0) {
gnutls_session_ticket_send(server_session, nr, 0);
}
} else if (scenario == 1) { // Resumed handshake path
gnutls_datum_t resumption_data = {0};

// Handshake 1: Establish session and get ticket
setup_sessions(&client_session, &server_session, &xcred_s, &xcred_c, &skey,
&client_to_server_buf, &server_to_client_buf, control_byte, 0);

if (do_handshake(client_session, server_session) >= 0) {
gnutls_session_get_data2(client_session, &resumption_data);
}

cleanup_sessions(&client_session, &server_session, &xcred_s, &xcred_c, &skey,
&client_to_server_buf, &server_to_client_buf);

if (resumption_data.size > 0) {
// Handshake 2: Resume the session
setup_sessions(&client_session, &server_session, &xcred_s, &xcred_c, &skey,
&client_to_server_buf, &server_to_client_buf, control_byte, 0);

gnutls_session_set_data(client_session, resumption_data.data, resumption_data.size);

if (do_handshake(client_session, server_session) >= 0) {
gnutls_session_ticket_send(server_session, nr, 0);
}
}
gnutls_free(resumption_data.data);

} else { // GNUTLS_NO_TICKETS flag path
setup_sessions(&client_session, &server_session, &xcred_s, &xcred_c, &skey,
&client_to_server_buf, &server_to_client_buf, control_byte, GNUTLS_NO_TICKETS);

if (do_handshake(client_session, server_session) >= 0) {
gnutls_session_ticket_send(server_session, nr, 0);
}
}

cleanup_sessions(&client_session, &server_session, &xcred_s, &xcred_c, &skey,
&client_to_server_buf, &server_to_client_buf);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: gnutls
function signature: int gnutls_session_ticket_send(gnutls_session_t, unsigned int, unsigned int)
</input>

<description>
The `gnutls_session_ticket_send` function is used on the server side of a TLS 1.3 connection to send one or more session tickets to the client after the initial handshake has completed. This allows the client to use these tickets to resume sessions in the future, improving performance. The function can be called at any time after the handshake, but it is typically called either automatically by GnuTLS or manually by the application if automatic sending is disabled. It takes a session handle, the number of tickets to send, and a flags parameter (which must be zero) as input.
</description>

<requirements>

<requirement>
The session must be initialized as a server session by calling `gnutls_init` with the `GNUTLS_SERVER` flag. This is because sending session tickets is a server-side operation.
</requirement>
<requirement>
The session must be configured to use the TLS 1.3 protocol. The function explicitly checks for TLS 1.3 semantics and will return an error otherwise.
</requirement>
<requirement>
The `gnutls_session_ticket_enable_server` function must be called before the handshake. This function sets up the session ticket encryption key required to create and send tickets.
</requirement>
<requirement>
A full TLS handshake must have been completed successfully on the session. This ensures the session is in the correct state and the necessary keys are available to generate tickets.
</requirement>
<requirement>
The `nr` argument, representing the number of tickets to send, must be greater than zero. The function returns an `GNUTLS_E_INVALID_REQUEST` error if `nr` is zero.
</requirement>
<requirement>
The `flags` argument must be set to zero. The function's documentation specifies this, and non-zero values are reserved for future use.
</requirement>

</requirements>

</function-requirements>

