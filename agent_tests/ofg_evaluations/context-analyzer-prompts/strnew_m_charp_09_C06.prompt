<fuzz-target>
#include "wc.h"
#include "wtf.h"
#include <gc.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include "Str.h"
#include <limits.h>

// The function under test is variadic.
Str Strnew_m_charp(const char *, ...);

// Forward declaration for the function we want to test directly
// to hit the uncovered branch.
void Strcat_charp_n(Str x, const char *y, int n);

#define MAX_ARGS 8
#ifndef STR_SIZE_MAX
#define STR_SIZE_MAX (INT_MAX / 32)
#endif

static void *die_oom(size_t bytes) {
fprintf(stderr, "Out of memory: %lu bytes unavailable!\n", (unsigned long)bytes);
exit(1);
}

static void test_large_strings(const uint8_t *data, size_t size) {
// This function specifically targets the STR_SIZE_MAX edge cases.
// We create a very large string, and then concatenate a small,
// fuzzer-controlled string to it. This will trigger the size-limiting
// logic in Strcat_charp_n.

// Allocate a buffer for the large string.
// Leave some space to append the fuzzer data.
size_t large_size = STR_SIZE_MAX - 1024;
char *large_str = (char *)malloc(large_size + 1);
if (!large_str) {
return;
}
// Fill it with a non-null character to make it a valid string.
memset(large_str, 'A', large_size);
large_str[large_size] = '\0';

// Use the fuzzer data for the second string.
// Ensure the fuzzer string is null-terminated.
char *fuzzer_str = (char *)malloc(size + 1);
if (!fuzzer_str) {
free(large_str);
return;
}
memcpy(fuzzer_str, data, size);
fuzzer_str[size] = '\0';

// Call the function with the large string and the fuzzer-controlled string.
// The argument list must be NULL-terminated.
Str res = Strnew_m_charp(large_str, fuzzer_str, NULL);
(void)res; // Result is GC-managed.

free(large_str);
free(fuzzer_str);
}

static void test_multiple_args(const uint8_t *data, size_t size) {
// This function tests the general variadic argument handling.
// We need at least one byte to determine the number of arguments.
if (size < 1) {
return;
}

// Use the first byte to determine the number of string arguments.
// We generate between 1 and MAX_ARGS strings.
const int num_args = (data[0] % MAX_ARGS) + 1;
data++;
size--;

// Create a mutable copy of the input data to insert null terminators.
char *buffer = (char *)malloc(size + 1);
if (!buffer) {
return;
}
memcpy(buffer, data, size);
buffer[size] = '\0'; // Ensure the entire buffer is a valid string.

const char *argv[MAX_ARGS + 1];
int current_argc = 0;

if (size > 0) {
argv[current_argc++] = buffer;
// Split the buffer into num_args strings by placing null terminators.
if (num_args > 1 && size > 1) {
size_t chunk_size = size / num_args;
if (chunk_size == 0)
chunk_size = 1;

for (int i = 1; i < num_args && (i * chunk_size) < size; ++i) {
buffer[i * chunk_size] = '\0';
if ((i * chunk_size + 1) < size) {
argv[current_argc++] = &buffer[i * chunk_size + 1];
}
}
}
}

// If the input size was 0, we still want to test with an empty string.
if (current_argc == 0) {
argv[current_argc++] = "";
}

// The list of arguments must be NULL-terminated.
argv[current_argc] = NULL;

Str res = NULL;
// Call the variadic function with the generated arguments.
switch (current_argc) {
case 1:
res = Strnew_m_charp(argv[0], NULL);
break;
case 2:
res = Strnew_m_charp(argv[0], argv[1], NULL);
break;
case 3:
res = Strnew_m_charp(argv[0], argv[1], argv[2], NULL);
break;
case 4:
res = Strnew_m_charp(argv[0], argv[1], argv[2], argv[3], NULL);
break;
case 5:
res = Strnew_m_charp(argv[0], argv[1], argv[2], argv[3], argv[4], NULL);
break;
case 6:
res = Strnew_m_charp(argv[0], argv[1], argv[2], argv[3], argv[4], argv[5], NULL);
break;
case 7:
res = Strnew_m_charp(argv[0], argv[1], argv[2], argv[3], argv[4], argv[5], argv[6], NULL);
break;
case 8:
res = Strnew_m_charp(argv[0], argv[1], argv[2], argv[3], argv[4], argv[5], argv[6], argv[7], NULL);
break;
}

// Str objects are managed by the GC, so no explicit free is needed for 'res'.
(void)res;

free(buffer);
}

// New test function to directly target the n < 0 branch in Strcat_charp_n.
static void test_negative_len(const uint8_t *data, size_t size) {
if (size == 0) {
return;
}
Str s = Strnew(); // Create a new Str object

// Use fuzzer data as the string content
char *fuzzer_str = (char *)malloc(size + 1);
if (!fuzzer_str) {
return;
}
memcpy(fuzzer_str, data, size);
fuzzer_str[size] = '\0';

// Call Strcat_charp_n directly with a negative length to hit the uncovered branch.
// We use -1 to reliably trigger the `if (n < 0)` condition.
Strcat_charp_n(s, fuzzer_str, -1);

(void)s; // Result is GC-managed.
free(fuzzer_str);
}


int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
static int init_done = 0;

if (!init_done) {
setenv("GC_LARGE_ALLOC_WARN_INTERVAL", "30000", 1);
GC_INIT();
#if (GC_VERSION_MAJOR > 7) || ((GC_VERSION_MAJOR == 7) && (GC_VERSION_MINOR >= 2))
GC_set_oom_fn(die_oom);
#else
GC_oom_fn = die_oom;
#endif
#ifdef USE_M17N
#ifdef USE_UNICODE
wtf_init(WC_CES_UTF_8, WC_CES_UTF_8);
#else
wtf_init(WC_CES_EUC_JP, WC_CES_EUC_JP);
#endif
#endif
init_done = 1;
}

if (size < 1) {
return 0;
}

// Use the first byte to decide which test case to run.
unsigned char mode = data[0];
data++;
size--;

// Distribute test cases to cover more scenarios.
switch (mode % 3) {
case 0:
// Focus on general variadic argument handling.
test_multiple_args(data, size);
break;
case 1:
// Focus on triggering STR_SIZE_MAX edge cases.
test_large_strings(data, size);
break;
case 2:
// Focus on the negative length case in Strcat_charp_n.
test_negative_len(data, size);
break;
}

return 0;
}
