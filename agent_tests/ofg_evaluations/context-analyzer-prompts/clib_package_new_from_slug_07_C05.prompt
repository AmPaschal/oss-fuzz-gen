<fuzz-target>
#include "/src/clib/src/common/clib-package.h"
#include "/src/clib/deps/http-get/http-get.h"

// The clib code seems to have inconsistent usage of http_get_free vs
// http_response_free. Some parts seem to call http_get_free directly without
// the header's macro being applied. To solve this, we undef the macro and
// provide mocks for both functions.
#ifdef http_get_free
#undef http_get_free
#endif

#include <errno.h>
#include <libgen.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

// Forward declaration
void clib_package_free(clib_package_t *);

// Define the global options struct for the linker
clib_package_opts_t clib_package_opts;

// --- Mocking http_get ---
// Global variables to pass fuzzer data to the mock function
static const uint8_t *g_http_response_data = NULL;
static size_t g_http_response_size = 0;
static uint8_t g_http_control_byte = 0;

// Mock implementation of http_get that will override the real one
http_get_response_t *http_get(const char *url) {
(void)url; // The URL is ignored; we use fuzzer data instead.

http_get_response_t *res = calloc(1, sizeof(http_get_response_t));
if (!res) return NULL;

// Use a control byte to determine if the mock request should "succeed"
if (g_http_control_byte % 4 == 0) { // Simulate a failure
res->ok = 0;
res->status = 404;
res->data = NULL;
} else { // Simulate a success
res->ok = 1;
res->status = 200;
res->data = malloc(g_http_response_size + 1);
if (res->data) {
memcpy(res->data, g_http_response_data, g_http_response_size);
res->data[g_http_response_size] = '\0';
} else {
// Allocation failed, treat as an error
res->ok = 0;
res->status = 500;
}
}
return res;
}

// Mock implementation for the free function that the linker needs.
void http_get_free(http_get_response_t *res) {
if (res) {
free(res->data);
free(res);
}
}

// Mock implementation for the other free function.
void http_response_free(http_get_response_t *res) {
// Delegate to the other mock to avoid code duplication.
http_get_free(res);
}

// Mock for file download function with the correct signature.
int http_get_file_shared(const char *url, const char *path, void *data) {
(void)url;
(void)path;
(void)data;
// Simulate success.
return 0;
}
// --- End Mocking ---

// Helper to create directories recursively.
int mkdir_p(const char *path) {
char *path_copy = strdup(path);
if (!path_copy) return -1;
for (char *p = path_copy + 1; *p; p++) {
if (*p == '/') {
*p = '\0';
if (mkdir(path_copy, 0755) != 0 && errno != EEXIST) {
free(path_copy);
return -1;
}
*p = '/';
}
}
if (mkdir(path_copy, 0755) != 0 && errno != EEXIST) {
free(path_copy);
return -1;
}
free(path_copy);
return 0;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < 10) return 0;

// Consume control bytes
uint8_t control_byte = data[0];
uint8_t slug_type_byte = data[1];
uint8_t file_creation_byte = data[2];
g_http_control_byte = data[3]; // Use a byte for mock control
data += 4;
size -= 4;

// Configure options
int verbose = control_byte & 1;
clib_package_opts.force = (control_byte >> 1) & 1;
clib_package_opts.skip_cache = (control_byte >> 2) & 1;

size_t part_len = size / 6;
if (part_len == 0) {
clib_package_opts = (clib_package_opts_t){0};
return 0;
}

// Prepare data for slug, options, and mock HTTP response
const char *author_data = (const char *)data;
const char *name_data = (const char *)data + part_len;
const char *version_data = (const char *)data + 2 * part_len;
const char *token_data = (const char *)data + 3 * part_len;
const char *prefix_data = (const char *)data + 4 * part_len;
g_http_response_data = data + 5 * part_len;
g_http_response_size = size - 5 * part_len;

char author[part_len + 1];
char name[part_len + 1];
char version[part_len + 1];
memcpy(author, author_data, part_len);
memcpy(name, name_data, part_len);
memcpy(version, version_data, part_len);
author[part_len] = '\0';
name[part_len] = '\0';
version[part_len] = '\0';


for (size_t i = 0; i < part_len; ++i) {
if (author[i] == '\0' || author[i] == '/') author[i] = '_';
if (name[i] == '\0' || name[i] == '/') name[i] = '_';
if (version[i] == '\0' || version[i] == '/') version[i] = '_';
}
if (strlen(author) == 0 || strlen(name) == 0 || strlen(version) == 0) {
clib_package_opts = (clib_package_opts_t){0};
return 0;
}

char token[part_len + 1];
memcpy(token, token_data, part_len);
token[part_len] = '\0';
clib_package_opts.token = strdup(token);

char prefix[part_len + 1];
memcpy(prefix, prefix_data, part_len);
prefix[part_len] = '\0';
clib_package_opts.prefix = strdup(prefix);

char slug[part_len * 3 + 3];
switch (slug_type_byte % 4) {
case 0: snprintf(slug, sizeof(slug), "%s/%s@%s", author, name, version); break;
case 1: snprintf(slug, sizeof(slug), "%s/%s", author, name); break;
case 2: snprintf(slug, sizeof(slug), "%s", author); break;
case 3: slug[0] = '\0'; break;
}

const char *home_dir = getenv("HOME");
if (!home_dir) {
free(clib_package_opts.token);
free(clib_package_opts.prefix);
clib_package_opts = (clib_package_opts_t){0};
return 0;
}

char cache_dir[256];
snprintf(cache_dir, sizeof(cache_dir), "%s/.cache/clib/json", home_dir);
char cache_file_path[512];
snprintf(cache_file_path, sizeof(cache_file_path), "%s/%s_%s_%s.json", cache_dir, author, name, version);

unlink(cache_file_path);
unlink("clib.json");
unlink("package.json");

// The content for created files will be the same as the mock HTTP response
if ((file_creation_byte >> 0) & 1) {
mkdir_p(cache_dir);
FILE *fp = fopen(cache_file_path, "wb");
if (fp) {
fwrite(g_http_response_data, 1, g_http_response_size, fp);
fclose(fp);
}
}
if ((file_creation_byte >> 1) & 1) {
FILE *fp = fopen("clib.json", "wb");
if (fp) {
fwrite(g_http_response_data, 1, g_http_response_size, fp);
fclose(fp);
}
}
if ((file_creation_byte >> 2) & 1) {
FILE *fp = fopen("package.json", "wb");
if (fp) {
fwrite(g_http_response_data, 1, g_http_response_size, fp);
fclose(fp);
}
}

clib_package_t *pkg = clib_package_new_from_slug(slug, verbose);
if (pkg) {
clib_package_free(pkg);
}

unlink(cache_file_path);
unlink("clib.json");
unlink("package.json");
free(clib_package_opts.token);
free(clib_package_opts.prefix);
clib_package_opts = (clib_package_opts_t){0};

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: clib
function signature: clib_package_t * clib_package_new_from_slug(const char *, int)
</input>

<description>
The function `clib_package_new_from_slug` creates a new `clib_package_t` structure from a given slug. It iterates through a global array of manifest file names, attempting to create the package from each one until it succeeds. The slug is a string that specifies the package, typically in the format `author/name@version`. The function is used to resolve and install package dependencies.
</description>

<requirements>
<requirement>
The `slug` parameter should be a null-terminated string, and can be fuzzed. This is because the slug is parsed to extract the package author, name, and version, and malformed slugs should be tested.
</requirement>
<requirement>
The `verbose` parameter should be an integer, either 0 or 1. This parameter controls the verbosity of logging, and both paths should be tested.
</requirement>
<requirement>
At least one of the files "clib.json" or "package.json" should be present and contain valid, fuzzed JSON data. The function attempts to read package information from these files, and their presence and content are crucial for the function to succeed.
</requirement>
</requirements>

</function-requirements>

