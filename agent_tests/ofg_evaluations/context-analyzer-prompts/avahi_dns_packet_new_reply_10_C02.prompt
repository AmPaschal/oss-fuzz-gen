License along with avahi; if not, write to the Free Software
Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA 02111-1307
USA.
***/

#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

#include "avahi-common/malloc.h"
#include "avahi-common/defs.h"
#include "avahi-core/log.h"
#include "/src/avahi/avahi-core/dns.h"
#include "avahi-core/rr.h"

void log_function(AvahiLogLevel level, const char *txt) {}

AvahiDnsPacket * avahi_dns_packet_new_reply(AvahiDnsPacket *, unsigned int, int, int);

/* Minimum size for fuzzer input: some bytes for params + DNS header */
#define MIN_FUZZ_SIZE (sizeof(unsigned int) + sizeof(int) + AVAHI_DNS_PACKET_HEADER_SIZE)

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < MIN_FUZZ_SIZE) {
return 0;
}

/* 1. Consume parameters from the start of the data buffer */
unsigned int mtu;
int aa;
const uint8_t *packet_data = data;
size_t packet_size = size;

memcpy(&mtu, packet_data, sizeof(unsigned int));
packet_data += sizeof(unsigned int);
packet_size -= sizeof(unsigned int);

memcpy(&aa, packet_data, sizeof(int));
packet_data += sizeof(int);
packet_size -= sizeof(int);

/* Sanitize parameters */
mtu %= 8192;
if (mtu <= AVAHI_DNS_PACKET_EXTRA_SIZE) {
mtu = AVAHI_DNS_PACKET_EXTRA_SIZE + 1;
}
aa = !!aa;
/* Force copy_queries to 1 to ensure the fuzzer focuses on the complex packet parsing logic. */
const int copy_queries = 1;

avahi_set_log_function(log_function);

/* 2. Create a packet 'p' whose content is the fuzzer-provided data. */
/* This allows the fuzzer to generate malformed packets to test error handling. */
AvahiDnsPacket *p = avahi_new(AvahiDnsPacket, 1);
if (!p) {
return 0;
}

p->data = avahi_malloc(packet_size);
if (!p->data) {
avahi_free(p);
return 0;
}
memcpy(p->data, packet_data, packet_size);
p->size = packet_size;
p->max_size = packet_size;
p->rindex = 0;
p->name_table = NULL;
p->res_size = 0;


/* 3. Call the target function with the fuzzer-controlled packet. */
AvahiDnsPacket *r = avahi_dns_packet_new_reply(p, mtu, copy_queries, aa);

if (r) {
avahi_dns_packet_free(r);
}

/* Clean up the manually created packet 'p'. */
avahi_dns_packet_free(p);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: avahi
function signature: AvahiDnsPacket * avahi_dns_packet_new_reply(AvahiDnsPacket *, unsigned int, int, int)
</input>

<description>
The function `avahi_dns_packet_new_reply` creates a DNS reply packet. It takes a DNS query packet `p`, a maximum transmission unit `mtu`, a flag `copy_queries` to indicate whether to copy the query section from `p`, and an `aa` flag for the authoritative answer bit in the reply. It allocates a new packet, and if `copy_queries` is true, it copies the query records from the input packet `p` to the new reply packet. It also copies the transaction ID and opcode from the query packet to the reply.
</description>

<requirements>
<requirement>
The first argument `p` must be a valid `AvahiDnsPacket` pointer. This is because the function dereferences this pointer without a NULL check and passes it to other functions that expect a valid packet.
</requirement>
<requirement>
The `p` packet should be initialized with query records, for example by using `avahi_dns_packet_new_query` and `avahi_dns_packet_append_key`. This is necessary for the loop that copies query records to execute if `copy_queries` is set.
</requirement>
<requirement>
The `mtu` argument should be greater than `AVAHI_DNS_PACKET_EXTRA_SIZE` (48). This is because the function `avahi_dns_packet_new` which is called internally will return a packet with 0 `max_size` if `mtu` is less than or equal to this value, leading to a small or empty packet.
</requirement>
<requirement>
The `copy_queries` argument should be either 0 or 1. This is a boolean flag that determines whether to copy the query records from the input packet.
</requirement>
<requirement>
The `aa` argument should be either 0 or 1. This is a boolean flag that sets the authoritative answer bit in the DNS reply packet.
</requirement>
</requirements>

</function-requirements>

