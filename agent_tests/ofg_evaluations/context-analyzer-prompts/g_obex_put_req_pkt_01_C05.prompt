<fuzz-target>
#include <config.h>
#include <stdint.h>
#include <string.h>
#include <unistd.h>
#include <glib.h>
#include <fcntl.h>
#include <sys/socket.h>
#include "gobex/gobex.h"
#include "gobex/gobex-packet.h"

// A struct to hold the fuzzer input state.
typedef struct {
const uint8_t *data;
size_t size;
size_t offset;
gboolean cancel_done; // Flag for async cancel completion
} FuzzState;

// Callback for GObexDataProducer. This function provides the data for the PUT request.
static gssize data_producer_cb(void *buf, gsize len, gpointer user_data) {
FuzzState *ctx = (FuzzState *)user_data;

if (ctx == NULL || ctx->offset >= ctx->size) {
return 0; // No more data
}

gsize to_copy = len;
if (ctx->offset + to_copy > ctx->size) {
to_copy = ctx->size - ctx->offset;
}

memcpy(buf, ctx->data + ctx->offset, to_copy);
ctx->offset += to_copy;

return to_copy;
}

// Callback for GObexFunc. This is called when the transfer is complete.
static void complete_cb(GObex *obex, GError *err, gpointer user_data) {
// This callback is required but can be empty for our fuzzing purposes.
(void)obex;
(void)err;
(void)user_data;
}

// Callback for g_obex_cancel_transfer to signal completion asynchronously.
static void cancel_complete_cb(GObex *obex, GError *err, gpointer user_data) {
(void)obex;
(void)err;
FuzzState *state = (FuzzState *)user_data;
if (state) {
state->cancel_done = TRUE;
}
}

// Helper to run the main context to process events
static void run_context(void) {
GMainContext *context = g_main_context_default();
// Run for a few iterations to ensure events are processed
for (int i = 0; i < 5; i++) {
if (g_main_context_pending(context))
g_main_context_iteration(context, FALSE);
else
break;
}
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < 2) { // Need at least 1 byte for control, 1 for data
return 0;
}

// Use first byte to control server response, rest is payload
uint8_t control_byte = data[0];
const uint8_t *payload_data = data + 1;
size_t payload_size = size - 1;

// Create a socket pair to simulate a bidirectional connection
int sv[2];
if (socketpair(AF_UNIX, SOCK_STREAM, 0, sv) != 0) {
return 0;
}
int client_fd = sv[0];
int server_fd = sv[1];

// Set both ends to non-blocking
fcntl(client_fd, F_SETFL, O_NONBLOCK);
fcntl(server_fd, F_SETFL, O_NONBLOCK);

GIOChannel *channel = g_io_channel_unix_new(client_fd);
if (!channel) {
close(client_fd);
close(server_fd);
return 0;
}
g_io_channel_set_flags(channel, G_IO_FLAG_NONBLOCK, NULL);

GObex *obex = g_obex_new(channel, G_OBEX_TRANSPORT_STREAM, 1024, 1024);
if (!obex) {
g_io_channel_unref(channel);
close(server_fd);
return 0;
}

GObexPacket *req = g_obex_packet_new(G_OBEX_OP_PUT, FALSE, G_OBEX_HDR_INVALID);
if (!req) {
g_obex_unref(obex);
g_io_channel_unref(channel);
close(server_fd);
return 0;
}

// Add required headers for a valid PUT request
g_obex_packet_add_unicode(req, G_OBEX_HDR_NAME, "fuzz.txt");
g_obex_packet_add_unicode(req, G_OBEX_HDR_TYPE, "text/plain");

FuzzState fuzz_state = { .data = payload_data, .size = payload_size, .offset = 0, .cancel_done = FALSE };
GError *err = NULL;

guint transfer_id = g_obex_put_req_pkt(obex, req, data_producer_cb, complete_cb, &fuzz_state, &err);

if (transfer_id > 0) {
char read_buf[2048];

// 1. Let client send the first packet
run_context();
read(server_fd, read_buf, sizeof(read_buf)); // Consume the request

// 2. Decide on the scenario based on fuzzer input
uint8_t scenario = control_byte % 4;

if (scenario == 3) { // Scenario: Test cancellation
// Send a CONTINUE to keep the transfer alive
uint8_t rsp_pkt[] = { G_OBEX_RSP_CONTINUE, 0x00, 0x03 };
write(server_fd, rsp_pkt, sizeof(rsp_pkt));

// Let client process the CONTINUE
run_context();

// Now, cancel the transfer while it's in progress
g_obex_cancel_transfer(transfer_id, cancel_complete_cb, &fuzz_state);

// Process events until cancellation is confirmed or we time out
for (int i = 0; i < 10 && !fuzz_state.cancel_done; i++) {
run_context();
}

} else { // Scenarios: Test normal or error completion
gboolean is_final = TRUE;
uint8_t rsp_code;

// Decide whether to send CONTINUE or a final response
if (scenario == 0 && payload_size > 512) { // Full transfer with CONTINUE
rsp_code = G_OBEX_RSP_CONTINUE;
is_final = FALSE;
} else if (scenario == 0 || scenario == 1) { // Success
rsp_code = G_OBEX_RSP_SUCCESS;
} else { // (scenario == 2) Error
rsp_code = G_OBEX_RSP_FORBIDDEN;
}

uint8_t rsp_pkt[] = { rsp_code, 0x00, 0x03 };
if (is_final) {
rsp_pkt[0] |= 0x80; // Set final bit for final responses
}
write(server_fd, rsp_pkt, sizeof(rsp_pkt));

// If this was a final response, the transfer is conceptually over.
// The library has a bug where it might try to use the transfer after
// freeing it in the same event loop iteration. Explicitly cancelling
// the transfer from the client side helps to gracefully tear it down
// and avoid the UAF.
if (is_final) {
g_obex_cancel_transfer(transfer_id, NULL, NULL);
}

// Let client process the response and/or cancellation.
run_context();

// If we sent a CONTINUE, simulate the rest of the transfer
if (!is_final) {
read(server_fd, read_buf, sizeof(read_buf)); // Consume the next request

// Send a final SUCCESS response
uint8_t final_rsp_pkt[] = { G_OBEX_RSP_SUCCESS | 0x80, 0x00, 0x03 };
write(server_fd, final_rsp_pkt, sizeof(final_rsp_pkt));

// The transfer is now over. Cancel it to prevent UAF.
g_obex_cancel_transfer(transfer_id, NULL, NULL);

// Let client process the final response and cancellation.
run_context();
}
// After a final response is processed, the transfer is complete.
// The explicit cancellation above should prevent any UAF.
}
}

// Cleanup
if (err) {
g_error_free(err);
}
g_obex_unref(obex);
g_io_channel_unref(channel); // This closes client_fd
close(server_fd);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: bluez
function signature: guint g_obex_put_req_pkt(GObex *, GObexPacket *, GObexDataProducer, GObexFunc, gpointer, GError **)
</input>

<description>
The `g_obex_put_req_pkt` function is responsible for initiating an OBEX PUT request. It takes a `GObex` session object, a `GObexPacket` representing the request, a data producer callback, a completion callback, user data, and an error object.

The function first validates that the request packet's operation code is `G_OBEX_OP_PUT`. It then creates and initializes a `transfer` structure to manage the state of the PUT operation. This structure stores the `obex` session, the data producer and completion callbacks, and user data. The function then sets up the request packet's body by associating it with the `put_get_data` callback, which in turn uses the provided `data_producer` to get the data for the transfer. Finally, it sends the request using `g_obex_send_req`.

The main caller of this function is `g_obex_put_req`, a variadic function that simplifies creating and sending OBEX PUT requests by constructing the `GObexPacket` from a variable list of headers. Another caller, found in `obexd/client/transfer.c`, manually constructs the `GObexPacket` before calling `g_obex_put_req_pkt`. This indicates that the `req` packet must be properly formed with all necessary headers before being passed to `g_obex_put_req_pkt`. The `GObexDataProducer` callback is expected to provide the data to be sent, and the `GObexFunc` callback is invoked upon completion of the transfer.
</description>

<requirements>
<requirement>
The `req` GObexPacket argument must be created with the `G_OBEX_OP_PUT` opcode. This is a precondition checked by the function, and failure to meet it will result in an immediate return with a value of 0.
</requirement>
<requirement>
The `req` GObexPacket argument should be initialized using `g_obex_packet_new()` or `g_obex_packet_new_valist()` and populated with necessary headers. This is to ensure the packet is correctly formatted for the OBEX PUT operation as demonstrated by its callers.
</requirement>
<requirement>
The `data_func` argument must be a valid `GObexDataProducer` function pointer. This function is responsible for providing the data to be sent and is critical for the data transfer part of the PUT operation.
</requirement>
<requirement>
The `complete_func` argument must be a valid `GObexFunc` function pointer. This function is called upon completion of the transfer, and its absence could lead to resource leaks or improper handling of the transfer's final state.
</requirement>
<requirement>
The `obex` argument must be a valid `GObex` object, properly initialized. This object represents the OBEX session and is essential for sending the request and managing the transfer.
</requirement>
</requirements>

</function-requirements>

