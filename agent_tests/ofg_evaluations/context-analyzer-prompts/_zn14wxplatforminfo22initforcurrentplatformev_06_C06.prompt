<fuzz-target>
///////////////////////////////////////////////////////////////////////////////
// Name:        tests/fuzz/platinfo.cpp
// Purpose:     Fuzzing test for wxPlatformInfo
// Author:      Vadim Zeitlin, Artur de Sousa
// Created:     2017-10-24
// Copyright:   (c) 2017 Vadim Zeitlin <vadim@wxwidgets.org>
//              (c) 2023 Artur de Sousa
///////////////////////////////////////////////////////////////////////////////

// To test the logic for all platforms, not just the current one, we need to
// be able to create a wxPlatformInfo object and set its members to arbitrary
// values. We use this preprocessor hack to make protected members public.
#define protected public
#include "wx/platinfo.h"
#undef protected

#include "wx/log.h"
#include "wx/init.h"
#include "wx/string.h"
#include "wx/convauto.h"

#include <fuzzer/FuzzedDataProvider.h>
#include <initializer_list>

#if wxDEBUG_LEVEL

static void exitAssertHandler(const wxString& file,
int line,
const wxString& func,
const wxString& cond,
const wxString& msg);

static volatile wxAssertHandler_t
origAssertHandler = wxSetAssertHandler(exitAssertHandler);

static void exitAssertHandler(const wxString& file,
int line,
const wxString& func,
const wxString& cond,
const wxString& msg)
{
origAssertHandler(file, line, func, cond, msg);

exit(1);
}

#endif // wxDEBUG_LEVEL

extern "C" int LLVMFuzzerTestOneInput(const wxUint8 *data, size_t size)
{
FuzzedDataProvider fdp(data, size);

wxLogNull noLog;

// wxPlatformInfo requires a wxApp object to be alive for some operations.
wxInitializer init;
if ( !init.IsOk() )
{
// Can't do anything.
return 0;
}

// Create a wxPlatformInfo object and populate it with fuzzed data to
// simulate different platforms. This allows us to test the logic for all
// platforms, not just the one the fuzzer is running on.
wxPlatformInfo info;

// Use PickValueInArray with an initializer_list to avoid template deduction issues
// and use the correct enum names from wx/platinfo.h.
info.m_os = fdp.PickValueInArray({
wxOS_UNKNOWN, wxOS_MAC_OS, wxOS_MAC_OSX_DARWIN, wxOS_WINDOWS_NT,
wxOS_UNIX_LINUX, wxOS_UNIX_FREEBSD, wxOS_UNIX_OPENBSD,
wxOS_UNIX_NETBSD, wxOS_UNIX_SOLARIS, wxOS_UNIX_AIX, wxOS_UNIX_HPUX
});

info.m_port = fdp.PickValueInArray({
wxPORT_UNKNOWN, wxPORT_BASE, wxPORT_MSW, wxPORT_MOTIF, wxPORT_GTK,
wxPORT_DFB, wxPORT_X11, wxPORT_MAC, wxPORT_COCOA, wxPORT_QT
});

info.m_bitness = fdp.PickValueInArray({wxBITNESS_INVALID, wxBITNESS_32, wxBITNESS_64});

info.m_endian = fdp.PickValueInArray({wxENDIAN_INVALID, wxENDIAN_BIG, wxENDIAN_LITTLE, wxENDIAN_PDP});

const std::string desktopEnv = fdp.ConsumeRandomLengthString();
info.m_desktopEnv = wxString(desktopEnv.data(), wxConvAuto(), desktopEnv.length());
const std::string cpuArch = fdp.ConsumeRandomLengthString();
info.m_cpuArch = wxString(cpuArch.data(), wxConvAuto(), cpuArch.length());

info.m_osVersionMajor = fdp.ConsumeIntegral<int>();
info.m_osVersionMinor = fdp.ConsumeIntegral<int>();
info.m_osVersionMicro = fdp.ConsumeIntegral<int>();
info.m_tkVersionMajor = fdp.ConsumeIntegral<int>();
info.m_tkVersionMinor = fdp.ConsumeIntegral<int>();
info.m_tkVersionMicro = fdp.ConsumeIntegral<int>();

// Now that the object is populated with fuzzed data, call various getters
// to exercise the enum-to-string and other conversion/retrieval logic.
info.GetOperatingSystemFamilyName();
info.GetOperatingSystemIdName();
info.GetPortIdName();
info.GetPortIdShortName();
info.GetBitnessName();
info.GetEndiannessName();
info.GetCpuArchitectureName();
info.GetDesktopEnvironment();
info.GetOperatingSystemDescription();
info.GetOSMajorVersion();
info.GetOSMinorVersion();
info.GetOSMicroVersion();
info.GetToolkitMajorVersion();
info.GetToolkitMinorVersion();
info.GetToolkitMicroVersion();

// Exercise the version checking logic with fuzzed versions.
info.CheckOSVersion(fdp.ConsumeIntegral<int>(), fdp.ConsumeIntegral<int>(), fdp.ConsumeIntegral<int>());
info.CheckToolkitVersion(fdp.ConsumeIntegral<int>(), fdp.ConsumeIntegral<int>(), fdp.ConsumeIntegral<int>());

// Test the static string-to-enum conversion functions with fuzzed strings.
const std::string s1 = fdp.ConsumeRandomLengthString();
wxPlatformInfo::GetOperatingSystemId(wxString(s1.data(), wxConvAuto(), s1.length()));

const std::string s2 = fdp.ConsumeRandomLengthString();
wxPlatformInfo::GetPortId(wxString(s2.data(), wxConvAuto(), s2.length()));

const std::string s3 = fdp.ConsumeRandomLengthString();
wxPlatformInfo::GetArch(wxString(s3.data(), wxConvAuto(), s3.length()));

const std::string s4 = fdp.ConsumeRandomLengthString();
wxPlatformInfo::GetEndianness(wxString(s4.data(), wxConvAuto(), s4.length()));

return 0;
}
</fuzz-target>

