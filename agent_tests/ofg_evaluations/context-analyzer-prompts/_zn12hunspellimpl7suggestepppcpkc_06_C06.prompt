// Manages the lifecycle of the Hunspell handle using RAII.
// A single static instance ensures one-time initialization.
class HunspellFuzzer {
public:
HunspellFuzzer() {
// Create temporary files for the dictionary and affix data.
create_temp_file(aff_path_, kAffData);
create_temp_file(dic_path_, kDicData);

// Initialize Hunspell using the temporary files.
handle_ = Hunspell_create(aff_path_, dic_path_);
}

~HunspellFuzzer() {
if (handle_) {
Hunspell_destroy(handle_);
}
// Clean up the temporary files.
unlink(aff_path_);
unlink(dic_path_);
}

Hunhandle* get_handle() const { return handle_; }

private:
void create_temp_file(char* path_template, const char* data) {
int fd = mkstemp(path_template);
if (fd == -1) {
// If file creation fails, handle_ will remain nullptr,
// and the fuzzer will gracefully exit.
return;
}
write(fd, data, strlen(data));
close(fd);
}

Hunhandle* handle_ = nullptr;
char aff_path_[40] = "/tmp/fuzz-hunspell.aff.XXXXXX";
char dic_path_[40] = "/tmp/fuzz-hunspell.dic.XXXXXX";
};

// Global static instance to trigger one-time setup and teardown.
static HunspellFuzzer fuzzer_context;

const std::vector<std::string> kDictionaryWords = {
"created", "create", "imply", "natural", "like", "convey", "look", "text",
"hello", "said", "sawyer", "NASA", "rotten", "day", "tomorrow", "seven",
"FAQ", "can't", "doesn't", "etc", "won't", "lip", "horrifying", "speech",
"suggest", "uncreate", "Hunspell", "first", "second", "firstsecond"
};

std::string MutateWord(FuzzedDataProvider& provider, std::string word) {
if (word.empty()) {
return word;
}
int mutation_type = provider.ConsumeIntegralInRange<int>(0, 4);
switch (mutation_type) {
case 0: {
char new_char = provider.ConsumeIntegralInRange<char>('a', 'z');
size_t pos = provider.ConsumeIntegralInRange<size_t>(0, word.length());
word.insert(pos, 1, new_char);
break;
}
case 1: {
if (word.length() > 1) {
size_t pos = provider.ConsumeIntegralInRange<size_t>(0, word.length() - 1);
word.erase(pos, 1);
}
break;
}
case 2: {
char new_char = provider.ConsumeIntegralInRange<char>('a', 'z');
size_t pos = provider.ConsumeIntegralInRange<size_t>(0, word.length() - 1);
word[pos] = new_char;
break;
}
case 3: {
if (word.length() > 1) {
size_t pos = provider.ConsumeIntegralInRange<size_t>(0, word.length() - 2);
std::swap(word[pos], word[pos + 1]);
}
break;
}
case 4: {
break;
}
}
return word;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < 1) {
return 0;
}

// Get the pre-initialized Hunspell handle.
Hunhandle* hunspell_handle = fuzzer_context.get_handle();
if (!hunspell_handle) {
// Initialization failed, cannot proceed.
return 0;
}

FuzzedDataProvider provider(data, size);
std::string word_to_suggest;

int input_type = provider.ConsumeIntegralInRange<int>(0, 2);
switch (input_type) {
case 0: {
if (!kDictionaryWords.empty()) {
size_t index = provider.ConsumeIntegralInRange<size_t>(0, kDictionaryWords.size() - 1);
std::string base_word = kDictionaryWords[index];
word_to_suggest = MutateWord(provider, base_word);
}
break;
}
case 1: {
word_to_suggest = provider.ConsumeRemainingBytesAsString();
break;
}
case 2: {
std::string inner_word = provider.ConsumeRemainingBytesAsString();
// The crash occurs when `inner_word` is empty, leading to an XML
// query with an empty <word> tag. This check prevents it.
if (inner_word.empty()) {
return 0;
}
word_to_suggest = "<?xml?><query type=\"analyze\"><word>" + inner_word + "</word></query>";
break;
}
}

if (word_to_suggest.empty()) {
return 0;
}

char **suggestion_list = nullptr;
int num_suggestions = Hunspell_suggest(hunspell_handle, &suggestion_list, word_to_suggest.c_str());

if (num_suggestions > 0 && suggestion_list) {
Hunspell_free_list(hunspell_handle, &suggestion_list, num_suggestions);
}

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: hunspell
function signature: int HunspellImpl::suggest(char ***, const char *)
</input>

<description>
The function `HunspellImpl::suggest` takes a word as input and returns a list of suggestions. It is a wrapper around two other functions: another overload of `suggest` that returns a `std::vector<std::string>`, and `munge_vector` which converts the vector into a `char***` suitable for C-style output. The suggestions are generated based on the dictionaries loaded into the `HunspellImpl` object.
</description>

<requirements>
<requirement>
The first argument `slst` must be a valid, non-null pointer to a `char**`. This is because it is dereferenced in the `munge_vector` function to store the suggestions.
</requirement>
<requirement>
The second argument `word` should be a null-terminated string. It can be a regular word or a string starting with `"<spell>` to be treated as XML input.
</requirement>
<requirement>
A `HunspellImpl` object must be created and initialized before calling the target function. This is because the underlying `suggest` function relies on dictionaries that are loaded into this object.
</requirement>
</requirements>

</function-requirements>

