/* --- Embedded mem.h and mem.c contents --- */
struct mem_st {
const uint8_t *data;
size_t size;
size_t read_pos;
uint8_t *write_buf;
size_t write_pos;
size_t write_size;
};

static void init_mem_st(struct mem_st *mem)
{
mem->data = NULL;
mem->size = 0;
mem->read_pos = 0;
mem->write_buf = NULL;
mem->write_pos = 0;
mem->write_size = 0;
}

static void free_mem_st(struct mem_st *mem)
{
free(mem->write_buf);
init_mem_st(mem);
}

static ssize_t mem_push(gnutls_transport_ptr_t ptr, const void *data, size_t size)
{
struct mem_st *mem = ptr;
if (mem->write_pos + size > mem->write_size) {
size_t new_size = mem->write_size == 0 ? 1024 : mem->write_size * 2;
if (mem->write_pos + size > new_size) {
new_size = mem->write_pos + size;
}
uint8_t *new_buf = realloc(mem->write_buf, new_size);
if (new_buf == NULL) {
return -1;
}
mem->write_buf = new_buf;
mem->write_size = new_size;
}
memcpy(mem->write_buf + mem->write_pos, data, size);
mem->write_pos += size;
return size;
}

static ssize_t mem_pull(gnutls_transport_ptr_t ptr, void *data, size_t size)
{
struct mem_st *mem = ptr;
if (mem->read_pos >= mem->size) {
gnutls_transport_set_errno(ptr, EAGAIN);
return -1;
}
if (size > mem->size - mem->read_pos) {
size = mem->size - mem->read_pos;
}
memcpy(data, mem->data + mem->read_pos, size);
mem->read_pos += size;
return size;
}
/* --- End of embedded code --- */


/* This fuzzer establishes a connection between an in-memory client and server
* and then uses the fuzzer input to test the record-receiving functionality.
*/
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (gnutls_global_init() < 0) {
return 0;
}

gnutls_session_t client_session = NULL;
gnutls_session_t server_session = NULL;
gnutls_certificate_credentials_t x509_cred_s = NULL;
gnutls_certificate_credentials_t x509_cred_c = NULL;
struct mem_st client_to_server, server_to_client;
int ret;
int client_ret = 0, server_ret = 0;
gnutls_datum_t cert_datum = {.data = (unsigned char *)server_cert_pem, .size = sizeof(server_cert_pem) - 1};
gnutls_datum_t key_datum = {.data = (unsigned char *)server_key_pem, .size = sizeof(server_key_pem) - 1};

/* Initialize memory buffers for transport */
init_mem_st(&client_to_server);
init_mem_st(&server_to_client);

/* Initialize server credentials */
if (gnutls_certificate_allocate_credentials(&x509_cred_s) < 0) goto cleanup;
if (gnutls_certificate_set_x509_key_mem(
x509_cred_s, &cert_datum, &key_datum,
GNUTLS_X509_FMT_PEM) < 0) {
goto cleanup;
}

/* Initialize client credentials */
if (gnutls_certificate_allocate_credentials(&x509_cred_c) < 0) goto cleanup;
if (gnutls_certificate_set_x509_trust_mem(x509_cred_c, &cert_datum, GNUTLS_X509_FMT_PEM) < 0) {
goto cleanup;
}

/* Initialize server session */
if (gnutls_init(&server_session, GNUTLS_SERVER) < 0) goto cleanup;
if (gnutls_priority_set_direct(server_session, "NORMAL", NULL) < 0) goto cleanup;
if (gnutls_credentials_set(server_session, GNUTLS_CRD_CERTIFICATE, x509_cred_s) < 0) goto cleanup;
gnutls_transport_set_ptr(server_session, &client_to_server);
gnutls_transport_set_push_function(server_session, mem_push);
gnutls_transport_set_pull_function(server_session, mem_pull);

/* Initialize client session */
if (gnutls_init(&client_session, GNUTLS_CLIENT) < 0) goto cleanup;
if (gnutls_priority_set_direct(client_session, "NORMAL", NULL) < 0) goto cleanup;
if (gnutls_credentials_set(client_session, GNUTLS_CRD_CERTIFICATE, x509_cred_c) < 0) goto cleanup;
gnutls_transport_set_ptr(client_session, &server_to_client);
gnutls_transport_set_push_function(client_session, mem_push);
gnutls_transport_set_pull_function(client_session, mem_pull);

/* Link the two sessions */
server_to_client.data = client_to_server.write_buf;
server_to_client.size = client_to_server.write_pos;
client_to_server.data = server_to_client.write_buf;
client_to_server.size = server_to_client.write_pos;

/* Perform the handshake */
do {
server_to_client.size = client_to_server.write_pos;
server_to_client.read_pos = 0;
client_ret = gnutls_handshake(client_session);

client_to_server.size = server_to_client.write_pos;
client_to_server.read_pos = 0;
server_ret = gnutls_handshake(server_session);
} while ((client_ret < 0 && gnutls_error_is_fatal(client_ret) == 0) ||
(server_ret < 0 && gnutls_error_is_fatal(server_ret) == 0));

if (client_ret < 0 || server_ret < 0) {
goto cleanup;
}

/* Handshake successful. Now fuzz the record layer. */

/* Server sends the fuzzer data to the client */
gnutls_record_send(server_session, data, size);

/* Update the client's view of the data sent by the server */
server_to_client.size = client_to_server.write_pos;
server_to_client.read_pos = 0;

/* Client receives the data using the target function */
char buf[16384];
unsigned char seq[8];
while (true) {
ret = gnutls_record_recv_seq(client_session, buf, sizeof(buf), seq);
if (ret <= 0) {
break;
}
}

cleanup:
if (client_session) gnutls_deinit(client_session);
if (server_session) gnutls_deinit(server_session);
if (x509_cred_s) gnutls_certificate_free_credentials(x509_cred_s);
if (x509_cred_c) gnutls_certificate_free_credentials(x509_cred_c);
free_mem_st(&client_to_server);
free_mem_st(&server_to_client);
gnutls_global_deinit();

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: gnutls
function signature: ssize_t gnutls_record_recv_seq(gnutls_session_t, void *, size_t, unsigned char *)
</input>

<description>
The `gnutls_record_recv_seq` function is responsible for receiving a TLS record from a GnuTLS session. It stores the record payload in the provided `data` buffer and the record's sequence number in the `seq` buffer. The function returns the number of bytes received in the payload, or a negative error code if the operation fails. It is a lower-level function for receiving data, and callers are responsible for managing the session state and providing appropriately sized buffers.
</description>

<requirements>
<requirement>
The `session` argument must be a valid, initialized `gnutls_session_t` object. This is because the function needs a valid session to receive any data.
</requirement>
<requirement>
A handshake must be successfully completed on the `session` before calling this function. This is a necessary step to establish a secure channel before any record-layer communication can occur.
</requirement>
<requirement>
The `data` argument must point to a valid, writable memory buffer, and `data_size` must be the size of this buffer. This is to prevent a buffer overflow when the received record payload is copied to the buffer.
</requirement>
<requirement>
The `seq` argument must point to a valid, writable memory buffer of at least 8 bytes. This is because the TLS sequence number is a 64-bit integer, and this buffer is used to store the sequence number of the received record.
</requirement>
</requirements>

</function-requirements>

