or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Lesser General
Public License for more details.

You should have received a copy of the GNU Lesser General Public
License along with avahi; if not, write to the Free Software
Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA 02111-1307
USA.
***/

#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

#include "avahi-common/malloc.h"
#include "avahi-common/defs.h"
#include "avahi-core/log.h"
#include "avahi-core/dns.h"

// Dummy log function to suppress library output
void log_function(AvahiLogLevel level, const char *txt) {}

// Helper to write a 16-bit integer in network byte order
static void write_uint16(uint8_t *ptr, uint16_t val) {
ptr[0] = (uint8_t)(val >> 8);
ptr[1] = (uint8_t)val;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
const size_t parameter_size = 4;
const size_t min_label_size = 1;

// We need bytes for parameters and at least one byte for a domain label.
if (size < parameter_size + min_label_size) {
return 0;
}

avahi_set_log_function(log_function);

// --- Extract parameters for the function-under-test from the start of the input data ---
uint16_t temp_mtu;
memcpy(&temp_mtu, data, sizeof(uint16_t));
unsigned mtu = temp_mtu % 9001;
if (mtu < 512) {
mtu = 512;
}

int copy_queries = data[2] & 1;
int aa = data[3] & 1;

// --- Construct a valid DNS query packet 'p' using the rest of the data ---
const uint8_t *fuzz_content = data + parameter_size;
size_t fuzz_content_size = size - parameter_size;

// A DNS name label can be at most 63 chars.
uint8_t label_len = fuzz_content_size > 63 ? 63 : (uint8_t)fuzz_content_size;

// DNS question format: [name][type][class]. Name: [len][label][0].
// Total size: header + (1 byte for len + label_len + 1 byte for null terminator) + 2 for type + 2 for class.
size_t question_name_size = 1 + label_len + 1;
size_t question_size = question_name_size + 2 + 2;
size_t packet_content_size = AVAHI_DNS_PACKET_HEADER_SIZE + question_size;

AvahiDnsPacket *p = avahi_dns_packet_new(packet_content_size);
if (!p) {
return 0;
}

uint8_t *packet_data = AVAHI_DNS_PACKET_DATA(p);

// 1. Construct the DNS Header
memset(packet_data, 0, AVAHI_DNS_PACKET_HEADER_SIZE);
write_uint16(packet_data + 0, 0x1234); // Transaction ID
write_uint16(packet_data + 2, 0x0100); // Flags: Standard query
write_uint16(packet_data + 4, 1);      // QDCOUNT = 1. CRITICAL for coverage.

// 2. Construct the DNS Question
uint8_t *q_ptr = packet_data + AVAHI_DNS_PACKET_HEADER_SIZE;

// 2a. The domain name (e.g., <label_len>fuzz-data-here<0>)
*q_ptr++ = label_len;
memcpy(q_ptr, fuzz_content, label_len);
q_ptr += label_len;
*q_ptr++ = 0x00; // Null terminator for the name

// 2b. QTYPE and QCLASS
write_uint16(q_ptr, AVAHI_DNS_TYPE_A);
q_ptr += 2;
write_uint16(q_ptr, AVAHI_DNS_CLASS_IN);
q_ptr += 2;

p->size = packet_content_size;

// --- Call the function under test ---
AvahiDnsPacket *reply_packet = avahi_dns_packet_new_reply(p, mtu, copy_queries, aa);

// --- Cleanup ---
if (reply_packet) {
avahi_dns_packet_free(reply_packet);
}
avahi_dns_packet_free(p);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: avahi
function signature: AvahiDnsPacket* avahi_dns_packet_new_reply(AvahiDnsPacket* p, unsigned mtu, int copy_queries, int aa)
</input>

<description>
The function `avahi_dns_packet_new_reply` creates a new DNS packet as a reply to a given DNS packet. It allocates a new packet and, depending on the `copy_queries` flag, it may copy the question records from the original packet `p` to the new reply packet `r`. It also copies the transaction ID and opcode from the original packet to the reply. The `mtu` parameter determines the maximum size of the new packet, and the `aa` parameter sets the 'authoritative answer' flag in the new packet's header.
</description>

<requirements>

<requirement>
The input packet `p` must be a valid pointer to an `AvahiDnsPacket` structure. The function asserts that `p` is not NULL, so a NULL pointer will cause a crash.
</requirement>
<requirement>
The `p` packet should be initialized by first calling `avahi_dns_packet_new` and then populated with data. This is to ensure the packet has a valid header and structure for the function to operate on.
</requirement>
<requirement>
The `mtu` argument should be a reasonable value, for example, between 512 and 9000. The callers use values based on standard MTU sizes or calculated record sizes, and an invalid value could lead to allocation failures or unexpected behavior in `avahi_dns_packet_new_response`.
</requirement>
<requirement>
The `copy_queries` argument should be either 0 or 1. It is used as a boolean flag to determine if the question section should be copied from the source packet.
</requirement>
<requirement>
The `aa` argument should be either 0 or 1. It is used as a boolean flag to set the 'authoritative answer' bit in the DNS flags of the newly created packet.
</requirement>

</requirements>

</function-requirements>

