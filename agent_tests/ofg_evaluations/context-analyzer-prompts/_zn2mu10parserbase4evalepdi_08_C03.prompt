#include <fuzzer/FuzzedDataProvider.h>
#include <cstdint>
#include <string>
#include <vector>
#include <functional>
#include <cmath>
#include <memory>

#include "muParser.h"

// Generates a syntactically plausible mathematical expression using a fuzzed data provider.
// This approach builds complex expressions from simple parts (variables, constants)
// to ensure the parser has valid input to work with, which is critical for reaching
// the core logic of the Eval function.
std::string GenerateExpression(FuzzedDataProvider& provider) {
std::vector<std::string> parts;
// Seed the expression parts with defined variables and a fuzzed constant.
parts.push_back("a");
parts.push_back("b");
parts.push_back(std::to_string(provider.ConsumeFloatingPoint<double>()));

// Define a set of unary and binary operations to construct the expression.
const std::vector<std::function<std::string(std::string)>> unary_ops = {
[](std::string s) { return "sin(" + s + ")"; },
[](std::string s) { return "cos(" + s + ")"; },
// Use abs() to avoid domain errors with sqrt (e.g., sqrt(-1)).
[](std::string s) { return "sqrt(abs(" + s + "))"; },
[](std::string s) { return "(-" + s + ")"; }
};

const std::vector<std::function<std::string(std::string, std::string)>> binary_ops = {
[](std::string s1, std::string s2) { return "(" + s1 + " + " + s2 + ")"; },
[](std::string s1, std::string s2) { return "(" + s1 + " - " + s2 + ")"; },
[](std::string s1, std::string s2) { return "(" + s1 + " * " + s2 + ")"; },
// Add a small value to the denominator to avoid division-by-zero errors.
[](std::string s1, std::string s2) { return "(" + s1 + " / (" + s2 + " + 1e-9))"; }
};

// Iteratively build more complex expression parts.
int num_iterations = provider.ConsumeIntegralInRange<int>(1, 5);
for (int i = 0; i < num_iterations; ++i) {
uint8_t op_type = provider.ConsumeIntegralInRange<uint8_t>(0, 1);
if (op_type == 0 && !parts.empty() && !unary_ops.empty()) {
// Unary operation
std::string part = parts[provider.ConsumeIntegralInRange<size_t>(0, parts.size() - 1)];
auto op = unary_ops[provider.ConsumeIntegralInRange<size_t>(0, unary_ops.size() - 1)];
parts.push_back(op(part));
} else if (op_type == 1 && parts.size() >= 2 && !binary_ops.empty()) {
// Binary operation
std::string part1 = parts[provider.ConsumeIntegralInRange<size_t>(0, parts.size() - 1)];
std::string part2 = parts[provider.ConsumeIntegralInRange<size_t>(0, parts.size() - 1)];
auto op = binary_ops[provider.ConsumeIntegralInRange<size_t>(0, binary_ops.size() - 1)];
parts.push_back(op(part1, part2));
}
}

// Return one of the generated expressions, with a fallback.
if (parts.empty()) {
return "1.0";
}
return parts[provider.ConsumeIntegralInRange<size_t>(0, parts.size() - 1)];
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < 1) {
return 0;
}
FuzzedDataProvider provider(data, size);

mu::Parser parser;
// Allocate variables on the heap to ensure they are not contiguous
// on the stack, avoiding the ASan false positive.
// Use C++11-compatible unique_ptr construction.
std::unique_ptr<mu::value_type> var_a(new mu::value_type());
std::unique_ptr<mu::value_type> var_b(new mu::value_type());

// Define variables that can be used in the expression. This is a crucial
// step for enabling the parser to handle expressions with variables.
parser.DefineVar("a", var_a.get());
parser.DefineVar("b", var_b.get());

// Assign fuzzed values to the C++ variables linked to the parser.
*var_a = provider.ConsumeFloatingPoint<mu::value_type>();
*var_b = provider.ConsumeFloatingPoint<mu::value_type>();

// Generate a syntactically plausible expression.
std::string expr_string = GenerateExpression(provider);

// The bulk size for evaluation. Must be > 0.
const int nBulkSize = provider.ConsumeIntegralInRange<int>(1, 1024);

try {
parser.SetExpr(expr_string);

// The Eval function requires a pre-allocated array.
std::vector<mu::value_type> results(nBulkSize);
parser.Eval(results.data(), nBulkSize);

} catch (mu::Parser::exception_type &) {
// These exceptions are expected when the generated expression is
// syntactically or semantically invalid (e.g., "a++b").
// mu::Parser::exception_type is a typedef for mu::ParserError,
// so this catches all parser errors.
}

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: muparser
function signature: void mu::ParserBase::Eval(value_type* results, int nBulkSize)
</input>

<description>
The `Eval` function evaluates a mathematical expression in bulk mode. It takes a pre-allocated array `results` and its size `nBulkSize` as input. The function first calls `CreateRPN()` to parse the expression and create a Reverse Polish Notation (RPN) representation. If no expression is set prior to calling `Eval`, `CreateRPN` will raise an error. After successfully creating the RPN, the function iterates `nBulkSize` times, each time calling `ParseCmdCodeBulk` to evaluate the expression and storing the output in the `results` array. Callers must ensure that a valid expression is set on the `ParserBase` object and that the `results` array is large enough to hold `nBulkSize` values before invoking this function.
</description>

<requirements>

<requirement>
A `ParserBase` object must be created and a valid mathematical expression must be set on it before calling `Eval`. This is because the internal call to `CreateRPN()` requires an expression to parse, and will throw an error if the expression is empty.
</requirement>
<requirement>
The `results` argument must point to a valid, writable memory buffer of `value_type` that is at least `nBulkSize` elements long. The function writes to this buffer in a loop up to `nBulkSize`, so providing a smaller buffer will result in a heap buffer overflow.
</requirement>
<requirement>
The `nBulkSize` argument must be a non-negative integer that accurately represents the allocated size of the `results` buffer. This argument controls the number of iterations of the evaluation loop and the number of results written to the output array.
</requirement>

</requirements>

</function-requirements>

