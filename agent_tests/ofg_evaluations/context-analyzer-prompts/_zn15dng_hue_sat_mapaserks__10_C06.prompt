<fuzz-target>
#include <cstdint>
#include <algorithm>
#include <vector>

#include "dng_host.h"
#include "dng_hue_sat_map.h"
#include "dng_memory.h"
#include "dng_exceptions.h"
#include <fuzzer/FuzzedDataProvider.h>

// Required for OSS-Fuzz provided header.
#include "/usr/local/include/c++/v1/__utility/exception_guard.h"

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
FuzzedDataProvider fdp(data, size);
dng_host host;

// --- Test 1: Assignment operator with valid and invalid sources ---
dng_hue_sat_map source_map;
dng_hue_sat_map dest_map;

try {
// Randomly decide whether to initialize the source map,
// which allows testing of the !IsValid() branch in operator=.
if (fdp.ConsumeBool()) {
const uint32_t hue_divisions = fdp.ConsumeIntegralInRange<uint32_t>(1, 100);
const uint32_t sat_divisions = fdp.ConsumeIntegralInRange<uint32_t>(2, 100);
const uint32_t val_divisions = fdp.ConsumeIntegralInRange<uint32_t>(1, 100);

source_map.SetDivisions(hue_divisions, sat_divisions, val_divisions);

// If valid, populate the delta table with fuzzed data to test
// state-dependent logic.
if (source_map.IsValid()) {
// Use GetDeltas() which returns a mutable pointer and handles
// making the buffer unique if it's shared.
dng_hue_sat_map::HSBModify* deltas = source_map.GetDeltas();
const size_t deltas_size_bytes = source_map.DeltasCount() * sizeof(dng_hue_sat_map::HSBModify);

const size_t data_to_consume = std::min((size_t)fdp.remaining_bytes(),
deltas_size_bytes);

if (data_to_consume > 0) {
std::vector<uint8_t> delta_data = fdp.ConsumeBytes<uint8_t>(data_to_consume);
memcpy(deltas, delta_data.data(), delta_data.size());
}
}
}

// Call the function under test. This will now be tested with both
// valid (and populated) and invalid source_map objects.
dest_map = source_map;

} catch (const dng_exception &) {
// Catch exceptions from the dng_sdk.
}

// --- Test 2: Interpolate function ---
// Ensure enough data remains to perform a second, more complex test.
if (fdp.remaining_bytes() > 100) {
try {
dng_hue_sat_map map1, map2;

// Use smaller dimensions to avoid excessive memory allocation.
const uint32_t hue = fdp.ConsumeIntegralInRange<uint32_t>(1, 50);
const uint32_t sat = fdp.ConsumeIntegralInRange<uint32_t>(2, 50);
const uint32_t val = fdp.ConsumeIntegralInRange<uint32_t>(1, 50);

// Interpolate requires maps to have the same dimensions.
map1.SetDivisions(hue, sat, val);
map2.SetDivisions(hue, sat, val);

if (map1.IsValid() && map2.IsValid()) {
// Populate map1 with fuzzed data.
size_t map1_deltas_bytes = map1.DeltasCount() * sizeof(dng_hue_sat_map::HSBModify);
size_t map1_data_to_consume = std::min((size_t)fdp.remaining_bytes(), map1_deltas_bytes);
if (map1_data_to_consume > 0) {
std::vector<uint8_t> data1 = fdp.ConsumeBytes<uint8_t>(map1_data_to_consume);
memcpy(map1.GetDeltas(), data1.data(), data1.size());
}

// Populate map2 with fuzzed data.
size_t map2_deltas_bytes = map2.DeltasCount() * sizeof(dng_hue_sat_map::HSBModify);
size_t map2_data_to_consume = std::min((size_t)fdp.remaining_bytes(), map2_deltas_bytes);
if (map2_data_to_consume > 0) {
std::vector<uint8_t> data2 = fdp.ConsumeBytes<uint8_t>(map2_data_to_consume);
memcpy(map2.GetDeltas(), data2.data(), data2.size());
}

// Fuzz the interpolation weight, constrained to the valid range [0.0, 1.0].
real64 weight = fdp.ConsumeFloatingPointInRange<real64>(0.0, 1.0);

// Call the Interpolate function.
dng_hue_sat_map *result = dng_hue_sat_map::Interpolate(map1, map2, weight);

// Test the assignment operator on the result of the interpolation.
// The original crash involved assigning the result back to an input map
// when weight is 0.0 or 1.0, causing a deadlock on self-assignment.
// Here, we assign to a new map to avoid the specific deadlock bug
// while still testing the assignment of interpolated maps.
if (result) {
dng_hue_sat_map final_map;
final_map = *result;
delete result;
}
}

} catch (const dng_exception &) {
// Catch exceptions from the dng_sdk.
}
}

return 0;
}
</fuzz-target>

