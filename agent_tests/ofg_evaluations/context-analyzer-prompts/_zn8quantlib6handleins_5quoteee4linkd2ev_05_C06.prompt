<fuzz-target>
#include <fuzzer/FuzzedDataProvider.h>
#include <limits>
#include <map>
#include <ql/any.hpp>
#include <ql/exercise.hpp>
#include <ql/instrument.hpp>
#include <ql/instruments/payoffs.hpp>
#include <ql/instruments/vanillaoption.hpp>
#include <ql/math/distributions/normaldistribution.hpp>
#include <ql/math/functional.hpp>
#include <ql/math/integrals/gausslobattointegral.hpp>
#include <ql/math/integrals/integral.hpp>
#include <ql/math/randomnumbers/rngtraits.hpp>
#include <ql/math/statistics/incrementalstatistics.hpp>
#include <ql/models/equity/batesmodel.hpp>
#include <ql/models/equity/hestonmodel.hpp>
#include <ql/pricingengines/vanilla/analytichestonengine.hpp>
#include <ql/pricingengines/vanilla/batesengine.hpp>
#include <ql/pricingengines/vanilla/integralengine.hpp>
#include <ql/pricingengines/vanilla/mcamericanengine.hpp>
#include <ql/pricingengines/vanilla/analyticeuropeanengine.hpp>
#include <ql/pricingengines/vanilla/baroneadesiwhaleyengine.hpp>
#include <ql/pricingengines/vanilla/bjerksundstenslandengine.hpp>
#include <ql/pricingengines/vanilla/fdblackscholesshoutengine.hpp>
#include <ql/pricingengines/vanilla/fdblackscholesvanillaengine.hpp>
#include <ql/pricingengines/vanilla/juquadraticengine.hpp>
#include <ql/pricingengines/vanilla/qdfpamericanengine.hpp>
#include <ql/pricingengines/vanilla/qdplusamericanengine.hpp>
#include <ql/processes/batesprocess.hpp>
#include <ql/processes/hestonprocess.hpp>
#include <ql/termstructures/volatility/equityfx/blackconstantvol.hpp>
#include <ql/termstructures/yield/flatforward.hpp>
#include <ql/time/calendars/nullcalendar.hpp>
#include <ql/time/daycounters/actual360.hpp>
#include <ql/time/daycounters/actual365fixed.hpp>
#include <ql/time/daycounters/thirty360.hpp>
#include <ql/utilities/dataformatters.hpp>
#include <ql/settings.hpp>

using namespace QuantLib;

namespace {

struct OptionData {
Option::Type type;
Real strike;
Real s;       // spot
Rate q;       // dividend
Rate r;       // risk-free rate
Time t;       // time to maturity
Volatility v; // volatility
};

} // namespace

OptionData fuzzedOptionData(FuzzedDataProvider &fdp) {
return OptionData{
.type = fdp.PickValueInArray({Option::Type::Put, Option::Type::Call}),
.strike = fdp.ConsumeFloatingPointInRange<Real>(0.1, 5000.0),
.s = fdp.ConsumeFloatingPointInRange<Real>(0.1, 5000.0),
.q = fdp.ConsumeFloatingPointInRange<Rate>(0.0, 0.1),
.r = fdp.ConsumeFloatingPointInRange<Rate>(0.0, 0.1),
.t = fdp.ConsumeFloatingPointInRange<Time>(0.01, 10.0),
.v = fdp.ConsumeFloatingPointInRange<Volatility>(0.01, 2.0),
};
}

DayCounter pickDayCounter(FuzzedDataProvider &fdp) {
auto choice = fdp.ConsumeIntegralInRange<int>(0, 2);
switch (choice) {
case 0: return Actual360();
case 1: return Actual365Fixed();
case 2:
default: return Thirty360(Thirty360::USA);
}
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
FuzzedDataProvider fdp(data, size);
if (fdp.remaining_bytes() < 100) {
return 0;
}
SavedSettings saved_settings;

Date today(fdp.ConsumeIntegralInRange<Day>(1, 28),
(Month)fdp.ConsumeIntegralInRange<int>(1, 12),
fdp.ConsumeIntegralInRange<Year>(2000, 2020));

Settings::instance().evaluationDate() = today;

DayCounter dc = pickDayCounter(fdp);
ext::shared_ptr<SimpleQuote> spot(new SimpleQuote(0.0));
ext::shared_ptr<SimpleQuote> qRate(new SimpleQuote(0.0));
ext::shared_ptr<YieldTermStructure> qTS(new FlatForward(today, Handle<Quote>(qRate), dc));
ext::shared_ptr<SimpleQuote> rRate(new SimpleQuote(0.0));
ext::shared_ptr<YieldTermStructure> rTS(new FlatForward(today, Handle<Quote>(rRate), dc));
ext::shared_ptr<SimpleQuote> vol(new SimpleQuote(0.0));
ext::shared_ptr<BlackVolTermStructure> volTS(new BlackConstantVol(today, NullCalendar(), Handle<Quote>(vol), dc));

OptionData value = fuzzedOptionData(fdp);
Date exDate = today + Integer(std::lround(365 * value.t));
if (exDate <= today) {
exDate = today + 1;
}


ext::shared_ptr<PricingEngine> engine;
ext::shared_ptr<Exercise> exercise;

ext::shared_ptr<StrikedTypePayoff> payoff;
auto payoff_choice = fdp.ConsumeIntegralInRange(0, 2);
switch (payoff_choice) {
case 0:
payoff = ext::make_shared<PlainVanillaPayoff>(value.type, value.strike);
break;
case 1:
payoff = ext::make_shared<CashOrNothingPayoff>(value.type, value.strike, fdp.ConsumeFloatingPointInRange<Real>(0.1, 1000.0));
break;
case 2:
default:
payoff = ext::make_shared<AssetOrNothingPayoff>(value.type, value.strike);
break;
}

auto exercise_choice = fdp.ConsumeIntegralInRange<int>(0, 2);
switch (exercise_choice) {
case 0: { // European
exercise = ext::make_shared<EuropeanExercise>(exDate);
auto process_choice = fdp.ConsumeIntegralInRange<int>(0, 2);
switch(process_choice) {
case 0: { // BlackScholes
auto stochProcess = ext::make_shared<BlackScholesMertonProcess>(Handle<Quote>(spot), Handle<YieldTermStructure>(qTS), Handle<YieldTermStructure>(rTS), Handle<BlackVolTermStructure>(volTS));
engine = ext::make_shared<AnalyticEuropeanEngine>(stochProcess);
break;
}
case 1: { // Heston
auto hestonProcess = ext::make_shared<HestonProcess>(Handle<YieldTermStructure>(rTS), Handle<YieldTermStructure>(qTS), Handle<Quote>(spot), value.v*value.v, 1.0, value.v*value.v, 0.1, 0.0);
auto hestonModel = ext::make_shared<HestonModel>(hestonProcess);
engine = ext::make_shared<AnalyticHestonEngine>(hestonModel);
break;
}
case 2: { // Bates
auto batesProcess = ext::make_shared<BatesProcess>(Handle<YieldTermStructure>(rTS), Handle<YieldTermStructure>(qTS), Handle<Quote>(spot), value.v*value.v, 1.0, value.v*value.v, 0.1, 0.0, 0.1, 0.0, 0.1);
auto batesModel = ext::make_shared<BatesModel>(batesProcess);
engine = ext::make_shared<BatesEngine>(batesModel);
break;
}
}
break;
}
case 1: { // American
exercise = ext::make_shared<AmericanExercise>(today, exDate);
auto stochProcess = ext::make_shared<BlackScholesMertonProcess>(Handle<Quote>(spot), Handle<YieldTermStructure>(qTS), Handle<YieldTermStructure>(rTS), Handle<BlackVolTermStructure>(volTS));
auto engine_choice = fdp.ConsumeIntegralInRange<int>(0, 6);
switch(engine_choice) {
case 0: engine = ext::make_shared<BaroneAdesiWhaleyApproximationEngine>(stochProcess); break;
case 1: engine = ext::make_shared<BjerksundStenslandApproximationEngine>(stochProcess); break;
case 2: engine = ext::make_shared<JuQuadraticApproximationEngine>(stochProcess); break;
case 3: engine = ext::make_shared<QdPlusAmericanEngine>(stochProcess); break;
case 4: engine = ext::make_shared<QdFpAmericanEngine>(stochProcess); break;
case 5: {
Size tGrid = fdp.ConsumeIntegralInRange<Size>(2, 100);
Size xGrid = fdp.ConsumeIntegralInRange<Size>(2, 100);
engine = ext::make_shared<FdBlackScholesVanillaEngine>(stochProcess, tGrid, xGrid);
break;
}
case 6: {
engine = MakeMCAmericanEngine<PseudoRandom>(stochProcess)
.withSteps(fdp.ConsumeIntegralInRange<Size>(1, 20))
.withSamples(fdp.ConsumeIntegralInRange<Size>(32, 128))
.withPolynomialOrder(fdp.ConsumeIntegralInRange<Size>(1, 3))
.withSeed(fdp.ConsumeIntegral<BigNatural>());
break;
}
}
break;
}
case 2: { // Bermudan
std::vector<Date> dates;
int num_dates = fdp.ConsumeIntegralInRange<int>(1, 5);
for (int i = 0; i < num_dates; ++i) {
Integer days = fdp.ConsumeIntegralInRange<Integer>(1, exDate - today);
dates.push_back(today + days);
}
std::sort(dates.begin(), dates.end());
dates.erase(std::unique(dates.begin(), dates.end()), dates.end());
if (dates.empty()) {
dates.push_back(exDate);
}
exercise = ext::make_shared<BermudanExercise>(dates);
auto stochProcess = ext::make_shared<BlackScholesMertonProcess>(Handle<Quote>(spot), Handle<YieldTermStructure>(qTS), Handle<YieldTermStructure>(rTS), Handle<BlackVolTermStructure>(volTS));
Size tGrid = fdp.ConsumeIntegralInRange<Size>(2, 50);
Size xGrid = fdp.ConsumeIntegralInRange<Size>(2, 50);
engine = ext::make_shared<FdBlackScholesVanillaEngine>(stochProcess, tGrid, xGrid);
break;
}
}

spot->setValue(value.s);
qRate->setValue(value.q);
rRate->setValue(value.r);
vol->setValue(value.v);

if (engine && payoff) {
VanillaOption option(payoff, exercise);
option.setPricingEngine(engine);
(void)option.NPV();
}

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: quantlib
function signature: int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size)
</input>

<description>
The function under analysis is `LLVMFuzzerTestOneInput`, which is designed to fuzz the Net Present Value (NPV) calculation of American options. It initializes a testing environment and then, in a loop, generates a set of `AmericanOptionData` structures using `fuzzedAmericanOptionData`. Each structure is used to configure a `VanillaOption` object, which is subsequently priced using a `BaroneAdesiWhaleyApproximationEngine`. The core of the fuzzing logic is the call to `option.NPV()`, which is where potential vulnerabilities related to input validation are likely to be found.
</description>

<requirements>
<requirement>
The `s` member of the `AmericanOptionData` struct, representing the spot price, must be a non-negative value. This is to prevent mathematical errors in the pricing engine, such as taking the logarithm of a negative number.
</requirement>
<requirement>
The `t` member of the `AmericanOptionData` struct, representing the time to maturity, must be a non-negative value. This ensures that the option has a valid, non-negative time to expiration.
</requirement>
<requirement>
The `v` member of the `AmericanOptionData` struct, representing volatility, must be a non-negative value. Negative volatility is not a meaningful financial concept and can cause errors in the pricing model.
</requirement>
</requirements>

</function-requirements>

