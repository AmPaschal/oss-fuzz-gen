*/

#include "cppcheck.h"
#include "errorlogger.h"
#include "errortypes.h"
#include "filesettings.h"
#include "settings.h"
#include "suppressions.h"
#include "/src/cppcheck/lib/programmemory.h"

#include <string>
#include <vector>
#include <fstream>
#include <cstdio>

#include <cstddef>
#include <cstdint>
#include <fuzzer/FuzzedDataProvider.h>


class DummyErrorLogger : public ErrorLogger {
public:
void reportOut(const std::string& /*outmsg*/, Color /*c*/) override {}
void reportErr(const ErrorMessage& /*msg*/) override {}
void reportProgress(const std::string& /*filename*/,
const char /*stage*/[],
const std::size_t /*value*/) override {}
void reportMetric(const std::string & /*metric*/) override {}
};

static Settings create_settings()
{
Settings s;
s.templateFormat = "{bold}{file}:{line}:{column}: {red}{inconclusive:{magenta}}{severity}:{inconclusive: inconclusive:}{default} {message} [{id}]{reset}\\n{code}";
s.templateLocation = "{bold}{file}:{line}:{column}: {dim}note:{reset} {info}\\n{code}";
s.addEnabled("all");
s.certainty.setEnabled(Certainty::inconclusive, true);
return s;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
{
FuzzedDataProvider provider(data, size);

// Fuzz the language (C or C++) first.
const bool use_cpp = provider.ConsumeBool();

// Use the remaining fuzzed data as the content of the clang AST dump.
// This directly fuzzes the AST parsing logic within checkClang.
const std::string ast_dump_content = provider.ConsumeRemainingBytesAsString();

// A file path is still needed for the FileWithDetails object.
// We create an empty file to ensure the path is valid and accessible.
const std::string filename = "fuzz_file.cpp";
std::ofstream out_file(filename);
out_file.close();

// Setup the required objects for CppCheck
static DummyErrorLogger errorLogger;
Suppressions suppressions;
Settings settings = create_settings();

// Configure settings for checkClang
settings.clang = true;
settings.clangExecutable = "clang"; // Path is needed, but command won't be executed.

Standards::Language lang;
if (use_cpp) {
lang = Standards::Language::CPP;
settings.standards.setCPP("c++11");
} else {
lang = Standards::Language::C;
settings.standards.setC("c99");
}

// This lambda fakes the execution of clang. It provides the fuzzed AST dump
// to the checkClang function.
auto executeCommand =
[&ast_dump_content](const std::string&, const std::vector<std::string>&, const std::string&, std::string& output) -> int {
output = ast_dump_content;
// Return EXIT_SUCCESS to ensure the fuzzed output is processed.
// The fuzzer can still explore error paths within the AST parser.
return EXIT_SUCCESS;
};

// Instantiate CppCheck with the fuzzed settings and fake command execution
CppCheck cppcheck(settings, suppressions, errorLogger, false, executeCommand);

// Create the FileWithDetails object for the temporary file
const FileWithDetails file(filename, lang, 0);

// Call the public check() function, which will internally call checkClang().
cppcheck.check(file);

// Cleanup the temporary file
std::remove(filename.c_str());

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: cppcheck
function signature: unsigned int CppCheck::checkClang(const FileWithDetails &)
</input>

<description>
The CppCheck::checkClang function uses clang to perform a syntax check on the provided file and then imports the clang AST for further analysis. The function's behavior is heavily influenced by the settings provided in the CppCheck object.
</description>

<requirements>

<requirement>
The `file` argument, which is a `FileWithDetails` object, must contain a valid and accessible file path. This is because the file path is used to construct the clang command, and an invalid path will cause the command to fail.
</requirement>
<requirement>
The `file.lang()` method must return either `Standards::Language::C` or `Standards::Language::CPP`. This is important because the language is used to set the `-x` and `-std` flags for clang, and an incorrect language will lead to a failed analysis.
</requirement>
<requirement>
The `mSettings.clangExecutable` member of the `CppCheck` object must be a valid path to a clang executable. This is because this path is used to execute the clang command, and an invalid path will cause the execution to fail.
</requirement>
<requirement>
The `mExecuteCommand` member of the `CppCheck` object must be a valid, non-null function pointer. This is because it is used to execute the clang command, and a null pointer will lead to a crash.
</requirement>

</requirements>

</function-requirements>

