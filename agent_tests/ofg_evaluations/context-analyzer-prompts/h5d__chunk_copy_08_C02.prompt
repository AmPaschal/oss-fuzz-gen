See the License for the specific language governing permissions and
limitations under the License.
*/

/*
* This fuzzer is a "friend" of the H5D package, so it can reach
* into the package to call private functions. We must define H5D_MODULE
* to indicate this. We also need to be a "friend" of H5S to get the
* full dataspace definition.
*/
#define H5D_MODULE
#define H5S_FRIEND

#include "H5Dmodule.h"  /* This MUST be included first */
#include "H5private.h"  /* Generic Functions                        */
#include "H5Dpkg.h"     /* Datasets                                 */
#include "H5Eprivate.h" /* Error handling                           */
#include "H5Fprivate.h" /* Files                                    */
#include "H5FDcore.h"   /* Core file driver                         */
#include "H5Iprivate.h" /* IDs                                      */
#include "H5Oprivate.h" /* Object headers                           */
#include "H5Pprivate.h" /* Property lists                           */
#include "H5Spkg.h"     /* Dataspaces                               */

#include <string.h>
#include <stdlib.h>

#define MAX_RANK 3
#define MAX_DIM 64

/* A simple struct to act as a fuzzed data provider */
typedef struct {
const uint8_t *data;
size_t size;
size_t offset;
} fuzz_consumer_t;

/* Consume bytes from the fuzz data provider */
static int
consume_bytes(fuzz_consumer_t *consumer, void *dest, size_t len) {
if (consumer->offset + len > consumer->size) {
return 0; /* Not enough data */
}
memcpy(dest, consumer->data + consumer->offset, len);
consumer->offset += len;
return 1;
}

/* Consume a value of a specific type */
#define CONSUME_VALUE(consumer, value) consume_bytes(consumer, &value, sizeof(value))

extern int
LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < 32) {
return 0;
}

fuzz_consumer_t consumer = {data, size, 0};

hid_t src_fid = H5I_INVALID_HID, dst_fid = H5I_INVALID_HID;
hid_t src_dset_id = H5I_INVALID_HID, dst_dset_id = H5I_INVALID_HID;
hid_t space_id = H5I_INVALID_HID, dcpl_id = H5I_INVALID_HID;
hid_t fapl_id = H5I_INVALID_HID;
H5F_t *f_src = NULL, *f_dst = NULL;
H5D_t *dset_src = NULL, *dset_dst = NULL;

/* Turn off error reporting */
H5E_auto2_t old_func;
void *old_client_data;
H5Eget_auto2(H5E_DEFAULT, &old_func, &old_client_data);
H5Eset_auto2(H5E_DEFAULT, NULL, NULL);

/* Create an in-memory file access property list */
fapl_id = H5Pcreate(H5P_FILE_ACCESS);
if (fapl_id < 0)
goto cleanup;
if (H5Pset_fapl_core(fapl_id, (size_t)1024 * 1024, 0) < 0)
goto cleanup;

/* Create in-memory source and destination files */
src_fid = H5Fcreate("src.h5", H5F_ACC_TRUNC, H5P_DEFAULT, fapl_id);
dst_fid = H5Fcreate("dst.h5", H5F_ACC_TRUNC, H5P_DEFAULT, fapl_id);
if (src_fid < 0 || dst_fid < 0)
goto cleanup;

/* Fuzz dataset and chunk dimensions */
uint8_t rank;
if (!CONSUME_VALUE(&consumer, rank))
goto cleanup;
rank = (rank % MAX_RANK) + 1;

hsize_t dims[MAX_RANK] = {0};
hsize_t chunk_dims[MAX_RANK] = {0};
for (int i = 0; i < rank; i++) {
uint8_t dim_val, chunk_dim_val;
if (!CONSUME_VALUE(&consumer, dim_val) || !CONSUME_VALUE(&consumer, chunk_dim_val))
goto cleanup;
dims[i] = (dim_val % MAX_DIM) + 1;
chunk_dims[i] = (chunk_dim_val % dims[i]) + 1;
}

/* Create dataspace and dataset creation property list for chunking */
space_id = H5Screate_simple(rank, dims, NULL);
dcpl_id = H5Pcreate(H5P_DATASET_CREATE);
if (space_id < 0 || dcpl_id < 0)
goto cleanup;
if (H5Pset_chunk(dcpl_id, rank, chunk_dims) < 0)
goto cleanup;

/* Create source and destination datasets */
src_dset_id = H5Dcreate2(src_fid, "dset", H5T_NATIVE_INT, space_id, H5P_DEFAULT, dcpl_id, H5P_DEFAULT);
dst_dset_id = H5Dcreate2(dst_fid, "dset_copy", H5T_NATIVE_INT, space_id, H5P_DEFAULT, dcpl_id, H5P_DEFAULT);
if (src_dset_id < 0 || dst_dset_id < 0)
goto cleanup;

/* Write data to the source dataset to ensure chunks are allocated */
hsize_t num_elements = 1;
for (int i = 0; i < rank; i++)
num_elements *= dims[i];
if (num_elements > 0) {
int *write_buf = (int *)calloc(num_elements, sizeof(int));
if (write_buf) {
H5Dwrite(src_dset_id, H5T_NATIVE_INT, H5S_ALL, H5S_ALL, H5P_DEFAULT, write_buf);
free(write_buf);
}
}

/* Get internal pointers to HDF5 structures */
f_src = (H5F_t *)H5I_object_verify(src_fid, H5I_FILE);
f_dst = (H5F_t *)H5I_object_verify(dst_fid, H5I_FILE);
dset_src = (H5D_t *)H5I_object_verify(src_dset_id, H5I_DATASET);
dset_dst = (H5D_t *)H5I_object_verify(dst_dset_id, H5I_DATASET);

if (f_src && f_dst && dset_src && dset_dst && dset_src->shared && dset_dst->shared && dset_src->shared->space) {

/* Extract parameters for H5D__chunk_copy */
H5O_storage_chunk_t *storage_src = &dset_src->shared->layout.storage.u.chunk;
H5O_layout_chunk_t *layout_src = &dset_src->shared->layout.u.chunk;
H5O_storage_chunk_t *storage_dst = &dset_dst->shared->layout.storage.u.chunk;
const H5S_extent_t *ds_extent_src = &dset_src->shared->space->extent;
H5T_t *dt_src = dset_src->shared->type;
const H5O_pline_t *pline_src = &dset_src->shared->dcpl_cache.pline;

/* Fuzz the copy options */
H5O_copy_t cpy_info;
memset(&cpy_info, 0, sizeof(H5O_copy_t));
uint8_t flags;
if (CONSUME_VALUE(&consumer, flags)) {
cpy_info.copy_shallow = (flags >> 0) & 1;
cpy_info.expand_soft_link = (flags >> 1) & 1;
cpy_info.expand_ext_link = (flags >> 2) & 1;
cpy_info.expand_ref = (flags >> 3) & 1;
cpy_info.copy_without_attr = (flags >> 4) & 1;
cpy_info.preserve_null = (flags >> 5) & 1;
cpy_info.merge_comm_dt = (flags >> 6) & 1;
}

/* Call the target function */
H5D__chunk_copy(f_src, storage_src, layout_src, f_dst, storage_dst, ds_extent_src, dt_src,
pline_src, &cpy_info);
}

cleanup:
/* Clean up all HDF5 resources */
if (dcpl_id >= 0)
H5Pclose(dcpl_id);
if (space_id >= 0)
H5Sclose(space_id);
if (src_dset_id >= 0)
H5Dclose(src_dset_id);
if (dst_dset_id >= 0)
H5Dclose(dst_dset_id);
if (fapl_id >= 0)
H5Pclose(fapl_id);
if (src_fid >= 0)
H5Fclose(src_fid);
if (dst_fid >= 0)
H5Fclose(dst_fid);

/* Restore error reporting */
H5Eset_auto2(H5E_DEFAULT, old_func, old_client_data);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: hdf5
function signature: H5D__chunk_copy(H5F_t *, H5O_storage_chunk_t *, H5O_layout_chunk_t *, H5F_t *, H5O_storage_chunk_t *, const H5S_extent_t *, H5T_t *, const H5O_pline_t *, H5O_copy_t *)
</input>

<description>
This function copies chunked dataset raw data from a source file to a destination file. It is called by `H5O__layout_copy_file` when the layout of the dataset is chunked. The function iterates over all the chunks in the source dataset and copies them to the destination dataset. It handles data type conversion if necessary. It also handles copying of data in the cache.
</description>

<requirements>
<requirement>
The f_src and f_dst arguments must be valid, non-NULL pointers to H5F_t structs. This is because they are dereferenced and used in various file operations.
</requirement>
<requirement>
The storage_src and storage_dst arguments must be valid, non-NULL pointers to H5O_storage_chunk_t structs. Their idx_type and ops fields must be one of the valid combinations checked by the H5D_CHUNK_STORAGE_INDEX_CHK macro.
</requirement>
<requirement>
The layout_src argument must be a valid, non-NULL pointer to an H5O_layout_chunk_t struct. Its ndims field must be greater than 0 and less than or equal to H5O_LAYOUT_NDIMS to prevent out-of-bounds access.
</requirement>
<requirement>
The ds_extent_src argument must be a valid, non-NULL pointer to an H5S_extent_t struct. This is because it is passed to H5S_extent_get_dims which expects a valid pointer.
</requirement>
<requirement>
The dt_src argument must be a valid, non-NULL pointer to an H5T_t struct. This is because it is used in several data type operations and can lead to a crash if it is NULL.
</requirement>
<requirement>
The cpy_info argument must be a valid, non-NULL pointer to an H5O_copy_t struct. This is because its members are accessed without a prior NULL check.
</requirement>
</requirements>

</function-requirements>

