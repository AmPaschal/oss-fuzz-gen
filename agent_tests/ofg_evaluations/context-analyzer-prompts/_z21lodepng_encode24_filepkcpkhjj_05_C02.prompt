Here is the provided data.

<fuzz-target>
#include "/src/lodepng/lodepng.h"
#include <fuzzer/FuzzedDataProvider.h>
#include <cstdint>
#include <vector>

// Helper function to set a fuzzed color mode for LodePNG
void FuzzColorMode(LodePNGColorMode* mode, FuzzedDataProvider& provider) {
// Pick a valid color type from the enum
const LodePNGColorType color_types[] = {LCT_GREY, LCT_RGB, LCT_PALETTE, LCT_GREY_ALPHA, LCT_RGBA};
mode->colortype = provider.PickValueInArray(color_types);

// Pick a valid bit depth for the chosen color type
switch (mode->colortype) {
case LCT_GREY: {
const unsigned valid_bitdepths[] = {1, 2, 4, 8, 16};
mode->bitdepth = provider.PickValueInArray(valid_bitdepths);
break;
}
case LCT_RGB:
case LCT_GREY_ALPHA:
case LCT_RGBA: {
const unsigned valid_bitdepths[] = {8, 16};
mode->bitdepth = provider.PickValueInArray(valid_bitdepths);
break;
}
case LCT_PALETTE: {
const unsigned valid_bitdepths[] = {1, 2, 4, 8};
mode->bitdepth = provider.PickValueInArray(valid_bitdepths);
// Generate a palette with a fuzzed number of colors
unsigned palette_size = provider.ConsumeIntegralInRange<unsigned>(1, 256);
for (unsigned i = 0; i < palette_size; ++i) {
if (provider.remaining_bytes() < 4) break;
lodepng_palette_add(mode,
provider.ConsumeIntegral<uint8_t>(),
provider.ConsumeIntegral<uint8_t>(),
provider.ConsumeIntegral<uint8_t>(),
provider.ConsumeIntegral<uint8_t>());
}
break;
}
}
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < 1) {
return 0;
}
FuzzedDataProvider provider(data, size);

LodePNGState state;
lodepng_state_init(&state);

// Fuzz basic image dimensions, keeping them reasonable to avoid OOM.
unsigned w = provider.ConsumeIntegralInRange<unsigned int>(1, 512);
unsigned h = provider.ConsumeIntegralInRange<unsigned int>(1, 512);

// Fuzz various encoder settings to explore different code paths.
state.encoder.auto_convert = provider.ConsumeBool();
state.encoder.filter_palette_zero = provider.ConsumeBool();
state.encoder.filter_strategy = static_cast<LodePNGFilterStrategy>(provider.ConsumeIntegralInRange<unsigned>(0, 4));

// Fuzz zlib settings
state.encoder.zlibsettings.btype = provider.ConsumeIntegralInRange<unsigned>(0, 2);
state.encoder.zlibsettings.use_lz77 = provider.ConsumeBool();
// Zlib window size must be a power of two between 256 and 32768
unsigned windowsize_power = provider.ConsumeIntegralInRange<unsigned>(8, 15);
state.encoder.zlibsettings.windowsize = 1 << windowsize_power;

// Fuzz the input raw image format.
FuzzColorMode(&state.info_raw, provider);

// If not auto-converting, fuzz the desired output PNG format as well.
if (!state.encoder.auto_convert) {
FuzzColorMode(&state.info_png.color, provider);
}

// Calculate the size needed for the raw image based on fuzzed format.
size_t bpp = lodepng_get_bpp(&state.info_raw);
size_t image_data_size = ((size_t)w * (size_t)h * bpp + 7) / 8;

// Avoid excessive memory allocation.
if (image_data_size > 5 * 1024 * 1024) { // 5MB limit
lodepng_state_cleanup(&state);
return 0;
}

// Consume the raw image data.
std::vector<uint8_t> image_data = provider.ConsumeBytes<uint8_t>(image_data_size);
if (image_data.size() != image_data_size) {
lodepng_state_cleanup(&state);
return 0;
}

// Call the lower-level encode function to test more logic.
unsigned char* out_buf = nullptr;
size_t out_size = 0;
lodepng_encode(&out_buf, &out_size, image_data.data(), w, h, &state);

// Clean up allocated memory.
free(out_buf); // free is safe to call on nullptr.
lodepng_state_cleanup(&state);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: lodepng
function signature: unsigned int lodepng_encode24_file(const char *, const unsigned char *, unsigned int, unsigned int)
</input>

<description>
The lodepng_encode24_file function encodes a raw RGB image buffer into a PNG file. It is a wrapper function that calls other lodepng functions to perform the encoding and file writing. Specifically, it calls lodepng_encode_file, which in turn calls lodepng_encode_memory and lodepng_save_file. The color type is fixed to LCT_RGB (24-bit RGB) and bit depth is fixed to 8.
</description>

<requirements>
<requirement>
The `filename` argument must be a null-terminated string that represents a valid file path where the output PNG file can be written. This is because the function passes this argument to `lodepng_save_file`, which attempts to create and write to the specified file.</requirement>
<requirement>
The `image` argument must be a non-null pointer to a memory buffer containing the raw image data. This buffer is read by the `lodepng_encode` function, and a null pointer would cause a crash.</requirement>
<requirement>
The `w` and `h` arguments, representing the width and height of the image, must both be greater than zero. The total size of the image data is calculated from these values, and a size of zero would be invalid.</requirement>
<requirement>
The buffer pointed to by the `image` argument must be at least `w * h * 3` bytes in size. This is because the image is encoded as 24-bit RGB, which uses 3 bytes per pixel.</requirement>
</requirements>

</function-requirements>

