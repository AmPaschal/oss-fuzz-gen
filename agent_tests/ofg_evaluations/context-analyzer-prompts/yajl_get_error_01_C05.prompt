#include <assert.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>

#include "/src/yajl-ruby/ext/yajl/api/yajl_parse.h"

// Context for the failing allocator
typedef struct {
int allocations_to_succeed;
} alloc_context;

// Custom memory allocation functions to simulate failures
static void* failing_malloc(void* ctx, unsigned int sz) {
alloc_context* actx = (alloc_context*)ctx;
if (actx->allocations_to_succeed == 0) {
return NULL;
}
if (actx->allocations_to_succeed > 0) {
actx->allocations_to_succeed--;
}
return malloc(sz);
}

static void* failing_realloc(void* ctx, void* ptr, unsigned int sz) {
alloc_context* actx = (alloc_context*)ctx;
if (actx->allocations_to_succeed == 0) {
return NULL;
}
if (actx->allocations_to_succeed > 0) {
actx->allocations_to_succeed--;
}
return realloc(ptr, sz);
}

static void failing_free(void* ctx, void* ptr) {
free(ptr);
}

typedef struct {
int arrayLevel;
int objectLevel;
int cancel_parse;
} context;

static int yajl_found_null(void* ctx) {
return ((context*)ctx)->cancel_parse ? 0 : 1;
}

static int yajl_found_boolean(void* ctx, int boolean) {
return ((context*)ctx)->cancel_parse ? 0 : 1;
};

static int yajl_found_integer(void * ctx, long long integerVal) {
return ((context*)ctx)->cancel_parse ? 0 : 1;
}

static int yajl_found_double(void * ctx, double doubleVal) {
return ((context*)ctx)->cancel_parse ? 0 : 1;
}

static int yajl_found_string(void* ctx, const unsigned char* s, unsigned int l) {
return ((context*)ctx)->cancel_parse ? 0 : 1;
}

static int yajl_found_object_key(void* ctx, const unsigned char* v, unsigned int l) {
assert(((context*)ctx)->objectLevel > 0);
return ((context*)ctx)->cancel_parse ? 0 : 1;
}

static int yajl_found_start_object(void* ctx) {
((context*)ctx)->objectLevel++;
return ((context*)ctx)->cancel_parse ? 0 : 1;
}

static int yajl_found_end_object(void* ctx) {
assert(((context*)ctx)->objectLevel > 0);
((context*)ctx)->objectLevel--;
return ((context*)ctx)->cancel_parse ? 0 : 1;
}

static int yajl_found_start_array(void* ctx) {
((context*)ctx)->arrayLevel++;
return ((context*)ctx)->cancel_parse ? 0 : 1;
}

static int yajl_found_end_array(void* ctx) {
assert(((context*)ctx)->arrayLevel > 0);
((context*)ctx)->arrayLevel--;
return ((context*)ctx)->cancel_parse ? 0 : 1;
}

static yajl_callbacks callbacks = {
yajl_found_null,
yajl_found_boolean,
yajl_found_integer,
yajl_found_double,
NULL, /* yajl_number */
yajl_found_string,
yajl_found_start_object,
yajl_found_object_key,
yajl_found_end_object,
yajl_found_start_array,
yajl_found_end_array
};

int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
// Reserve 4 bytes for configuration, require at least one byte for data.
if (size < 5) {
return 0;
}

/* Use the first four bytes to control parser configuration and allocation failures */
int allocations_to_succeed = data[0]; // 0-255, how many allocations should succeed before one fails
int cancel = (data[1] == 'C');
unsigned int allow_comments = data[2] % 2;
unsigned int check_utf8 = data[3] % 2;
const unsigned char* json_data = data + 4;
size_t json_size = size - 4;

alloc_context actx = { .allocations_to_succeed = allocations_to_succeed };
yajl_alloc_funcs af = {
.malloc = failing_malloc,
.realloc = failing_realloc,
.free = failing_free,
.ctx = &actx
};

context ctx = {
.arrayLevel = 0,
.objectLevel = 0,
.cancel_parse = cancel,
};
yajl_parser_config cfg = {
.allowComments = allow_comments,
.checkUTF8 = check_utf8,
};
yajl_handle parser = yajl_alloc(&callbacks, &cfg, &af, (void*)&ctx);
if (!parser) {
return 0;
}

yajl_parse(parser, json_data, json_size);

// After parsing, get the error string regardless of the parse status.
unsigned char * error_str_non_verbose = yajl_get_error(parser, 0, json_data, (unsigned int)json_size);
if (error_str_non_verbose) {
yajl_free_error(parser, error_str_non_verbose);
}
unsigned char * error_str_verbose = yajl_get_error(parser, 1, json_data, (unsigned int)json_size);
if (error_str_verbose) {
yajl_free_error(parser, error_str_verbose);
}

// Also check for errors after completing the parse, for incomplete JSON.
yajl_parse_complete(parser);

// Again, get the error string unconditionally to test all states.
error_str_non_verbose = yajl_get_error(parser, 0, json_data, (unsigned int)json_size);
if (error_str_non_verbose) {
yajl_free_error(parser, error_str_non_verbose);
}
error_str_verbose = yajl_get_error(parser, 1, json_data, (unsigned int)json_size);
if (error_str_verbose) {
yajl_free_error(parser, error_str_verbose);
}

yajl_free(parser);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: yajl-ruby
function signature: unsigned char * yajl_get_error(yajl_handle, int, const unsigned char *, unsigned int)
</input>

<description>
The `yajl_get_error` function returns a descriptive string for the last error that occurred during parsing. It is a wrapper around `yajl_render_error_string`. The function requires a `yajl_handle` that has encountered a parse or lexical error. The verbosity of the error message is controlled by the `verbose` parameter. The `jsonText` and `jsonTextLen` parameters are used to provide context for the error in the returned string when `verbose` is enabled.
</description>

<requirements>

<requirement>
The `yajl_handle` (first argument) must be a valid handle returned by `yajl_alloc`. This is because the function dereferences this handle to access internal state.
</requirement>
<requirement>
The `yajl_handle` must be in an error state. This can be achieved by calling a parsing function like `yajl_parse` or `yajl_do_parse` with invalid JSON input, which sets the internal state to `yajl_state_parse_error` or `yajl_state_lexical_error`.
</requirement>
<requirement>
The `jsonText` (third argument) must be a valid pointer to a buffer of size `jsonTextLen` (fourth argument). This is to prevent memory access errors when the function generates a verbose error message.
</requirement>
<requirement>
The `verbose` parameter (second argument) should be either 0 or 1. This parameter controls the level of detail in the error message.
</requirement>

</requirements>

</function-requirements>

