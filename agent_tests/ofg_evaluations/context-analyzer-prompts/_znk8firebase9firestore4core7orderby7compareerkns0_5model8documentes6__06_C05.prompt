<fuzz-target>
#include <fuzzer/FuzzedDataProvider.h>
#include <algorithm>
#include <cctype>
#include <string>
#include <vector>

#include "Firestore/core/src/core/order_by.h"
#include "Firestore/core/src/model/document.h"
#include "Firestore/core/src/model/document_key.h"
#include "Firestore/core/src/model/field_path.h"
#include "Firestore/core/src/model/mutable_document.h"
#include "Firestore/core/src/model/object_value.h"
#include "Firestore/core/src/model/snapshot_version.h"
#include "Firestore/core/src/nanopb/message.h"
#include "Firestore/core/src/nanopb/nanopb_util.h"
#include "Firestore/Protos/nanopb/google/firestore/v1/document.nanopb.h"
#include "absl/strings/str_join.h"

using firebase::firestore::core::Direction;
using firebase::firestore::core::OrderBy;
using firebase::firestore::model::Document;
using firebase::firestore::model::DocumentKey;
using firebase::firestore::model::FieldPath;
using firebase::firestore::model::MutableDocument;
using firebase::firestore::model::ObjectValue;
using firebase::firestore::model::SnapshotVersion;
using firebase::Timestamp;

// Sanitize a string to be a valid field path segment by removing forbidden
// characters.
std::string SanitizeFieldSegment(std::string s) {
s.erase(std::remove_if(s.begin(), s.end(),
[](char c) {
return c == '~' || c == '*' || c == '/' ||
c == '[' || c == ']' || c == '.';
}),
s.end());
if (s.empty()) {
return "f";  // Return a default non-empty string
}
return s;
}

// Generate a valid field path string, which is a dot-separated sequence of
// non-empty segments that do not contain forbidden characters.
std::string GenerateValidFieldPath(FuzzedDataProvider& provider) {
uint8_t num_segments = provider.ConsumeIntegralInRange<uint8_t>(1, 5);
std::vector<std::string> segments;
for (uint8_t i = 0; i < num_segments; ++i) {
segments.push_back(
SanitizeFieldSegment(provider.ConsumeRandomLengthString(20)));
}
return absl::StrJoin(segments, ".");
}

// Sanitize a string to be a valid document path segment by removing slashes
// and other invalid characters.
std::string SanitizeDocSegment(std::string s) {
s.erase(std::remove_if(s.begin(), s.end(),
[](unsigned char c) {
return c == '/' || !isprint(c);
}),
s.end());
if (s.empty()) {
return "d";  // Return a default non-empty string
}
return s;
}

// Generate a valid document path string, which is a slash-separated sequence of
// an even number of non-empty segments.
std::string GenerateValidDocumentPath(FuzzedDataProvider& provider) {
// A document path must have an even number of segments.
uint8_t num_pairs = provider.ConsumeIntegralInRange<uint8_t>(1, 3);
std::vector<std::string> segments;
for (uint8_t i = 0; i < num_pairs * 2; ++i) {
segments.push_back(
SanitizeDocSegment(provider.ConsumeRandomLengthString(20)));
}
return absl::StrJoin(segments, "/");
}

// Fuzzer for OrderBy::Compare
extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
FuzzedDataProvider provider(data, size);

// Create a valid FieldPath for the OrderBy object.
const std::string field_path_str = GenerateValidFieldPath(provider);
const FieldPath field_path = FieldPath::FromDotSeparatedString(field_path_str);

// Create a Direction for the OrderBy object.
const Direction direction = provider.ConsumeBool() ? Direction::Ascending
: Direction::Descending;

// Create the OrderBy object.
const OrderBy order_by(field_path, direction);

// Create two Document objects to compare.
// Both documents must be FoundDocuments and contain the field specified in
// the OrderBy object.

// Create the first Document.
const std::string doc_key_str1 = GenerateValidDocumentPath(provider);
const DocumentKey doc_key1 = DocumentKey::FromPathString(doc_key_str1);
const int64_t seconds1 = provider.ConsumeIntegralInRange<int64_t>(
-62135596800L, 253402300799L);
const int32_t nanos1 = provider.ConsumeIntegralInRange<int32_t>(0, 999999999);
const SnapshotVersion version1(Timestamp(seconds1, nanos1));
ObjectValue object_value1;
firebase::firestore::nanopb::Message<firebase::firestore::google_firestore_v1_Value> value1;
std::string fuzzed_string1 = provider.ConsumeRandomLengthString(100);
value1->string_value =
firebase::firestore::nanopb::MakeBytesArray(fuzzed_string1);
value1->which_value_type = google_firestore_v1_Value_string_value_tag;
object_value1.Set(field_path, std::move(value1));
const Document doc1 =
MutableDocument::FoundDocument(doc_key1, version1, std::move(object_value1));

// Create the second Document.
const std::string doc_key_str2 = GenerateValidDocumentPath(provider);
const DocumentKey doc_key2 = DocumentKey::FromPathString(doc_key_str2);
const int64_t seconds2 = provider.ConsumeIntegralInRange<int64_t>(
-62135596800L, 253402300799L);
const int32_t nanos2 = provider.ConsumeIntegralInRange<int32_t>(0, 999999999);
const SnapshotVersion version2(Timestamp(seconds2, nanos2));
ObjectValue object_value2;
firebase::firestore::nanopb::Message<firebase::firestore::google_firestore_v1_Value> value2;
std::string fuzzed_string2 = provider.ConsumeRandomLengthString(100);
value2->string_value =
firebase::firestore::nanopb::MakeBytesArray(fuzzed_string2);
value2->which_value_type = google_firestore_v1_Value_string_value_tag;
object_value2.Set(field_path, std::move(value2));
const Document doc2 =
MutableDocument::FoundDocument(doc_key2, version2, std::move(object_value2));

// Call the function under test.
order_by.Compare(doc1, doc2);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: firestore
function signature: firebase::firestore::core::OrderBy::Compare(const Document &, const Document &)
</input>

<description>
The `OrderBy::Compare` function compares two `Document` objects based on a field and direction specified in the `OrderBy` object. The comparison logic differs depending on whether the `OrderBy` field is a key field path. If it's a key field path, the document keys are compared directly. Otherwise, the function extracts the field value from each document and compares them. A critical aspect of this function is the assertion that the specified field must exist in *both* documents when not comparing by key. If the field is missing from either document, the program will terminate with a `HARD_FAIL` assertion.
</description>

<requirements>
<requirement>
The `OrderBy` object must be initialized with a valid `FieldPath`. This is because the `field_` member of the `OrderBy` object is used to determine which field to compare in the two `Document` arguments.
</requirement>
<requirement>
Both `Document` arguments must be created as `FoundDocument`s. This is to ensure they represent valid, existing documents with data that can be compared.
</requirement>
<requirement>
If the `OrderBy` object's `field_` is not a key field path, both `Document` arguments must contain the field specified by `OrderBy.field_`. The function will crash with an assertion failure if the field does not exist in both documents.
</requirement>
<requirement>
The `Document` objects should be created using `MutableDocument::FoundDocument`, which requires a `DocumentKey`, `SnapshotVersion`, and an `ObjectValue`. The `ObjectValue` must contain the data for the fields being compared.
</requirement>
</requirements>

</function-requirements>

