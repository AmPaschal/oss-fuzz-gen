<fuzz-target>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>
#include "/src/janet/src/include/janet.h"

// A dictionary of Janet keywords, functions, and operators to guide the fuzzer.
// This helps in generating syntactically more valid inputs.
static const char *dictionary[] = {
// Special Forms
"if", "do", "def", "var", "quote", "quasiquote", "unquote", "splice-unquote",
"fn", "break", "while", "set", "try",

// Core Functions
"native", "describe", "string", "symbol", "keyword", "buffer", "abstract?", "table", "array", "scan-number",
"tuple", "struct", "gensym", "gccollect", "gcsetinterval", "gcinterval", "type", "hash", "getline", "dyn",
"setdyn", "trace", "untrace", "module/expand-path", "int?", "nat?", "bytes?", "indexed?", "dictionary?",
"lengthable?", "slice", "range", "signal", "memcmp", "getproto", "sandbox", "cmp", "next", "propagate",
"debug", "error", "yield", "cancel", "resume", "in", "get", "put", "length", "bnot", "apply",

// Operators
"+", "-", "*", "/", "div", "mod", "%", "band", "bor", "bxor", "blshift", "brshift", "brushift",

// Comparators
">", "<", ">=", "<=", "=", "not=",

// Literals
"true", "false", "nil"
};
static const size_t dictionary_size = sizeof(dictionary) / sizeof(dictionary[0]);

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < 2) {
return 0;
}

// Instead of feeding raw bytes, construct a semi-valid s-expression.
// This has a much higher chance of passing the parser and reaching deeper code.
// The buffer needs to be large enough to hold the generated code.
// Max token length is ~20, plus numbers/quotes. size*32 should be safe.
char *code_str = (char *)malloc(size * 32 + 100);
if (!code_str) {
return 0;
}
char *p = code_str;

// Start with a single s-expression
p += sprintf(p, "(");

// The first element is the function/macro to call, chosen from the dictionary.
const char *func = dictionary[data[0] % dictionary_size];
p += sprintf(p, "%s", func);

size_t i = 1;
// Use the rest of the data to generate arguments.
while (i < size) {
p += sprintf(p, " ");
uint8_t arg_type = data[i++] % 4;
if (i >= size) break;

switch (arg_type) {
case 0: { // A number
p += sprintf(p, "%d", (int8_t)data[i++]);
break;
}
case 1: { // A token from the dictionary
p += sprintf(p, "%s", dictionary[data[i++] % dictionary_size]);
break;
}
case 2: { // A quoted symbol
p += sprintf(p, "'%s", dictionary[data[i++] % dictionary_size]);
break;
}
case 3: { // A string literal
int len = 0;
if (i < size) {
len = data[i++] % 10; // Keep strings short
}
p += sprintf(p, "\"");
for (int j = 0; j < len && i < size; j++) {
// Use a limited, safe character set
char c = data[i++] % 95 + 32;
if (c == '"' || c == '\\') {
c = '.'; // Avoid breaking the string
}
*p++ = c;
}
p += sprintf(p, "\"");
break;
}
}
}

p += sprintf(p, ")"); // End s-expression
*p = '\0';

/* Initialize the Janet VM */
janet_init();

/* Set up the core environment */
janet_core_env(NULL);
JanetTable *env = janet_get_core_table("root");
Janet out;

/* Execute the fuzz-generated code string. */
janet_dostring(env, code_str, "fuzz", &out);

/* Clean up the Janet VM and allocated memory */
janet_deinit();
free(code_str);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: janet
function signature: int janet_dostring(JanetTable *, const char *, const char *, Janet *)
</input>

<description>
The `janet_dostring` function executes a string of Janet code. It is a wrapper around the `janet_dobytes` function, which performs the actual parsing and execution. The function takes an environment table (`env`), the code to execute (`str`), an optional source path for error reporting (`sourcePath`), and an optional output parameter (`out`).
</description>

<requirements>

<requirement>
The `env` argument must be a valid, initialized `JanetTable*`. This can be obtained by calling `janet_core_env(NULL)` and then `janet_get_core_table("root")`.
</requirement>
<requirement>
The `str` argument must be a null-terminated string. The function calculates the length of the string by iterating until a null terminator is found, so a non-terminated string will lead to a buffer over-read.
</requirement>
<requirement>
The `sourcePath` argument can be a null-terminated string or NULL. It is used for error reporting and does not affect the core functionality.
</requirement>
<requirement>
The `out` argument can be a pointer to a `Janet` struct or NULL. If it is not NULL, the result of the execution will be stored in it.
</requirement>
<requirement>
The `janet_init()` function must be called before calling `janet_dostring`. This is because `janet_init()` initializes the Janet VM, which is necessary for the interpreter to function correctly.
</requirement>
<requirement>
The `janet_deinit()` function should be called after `janet_dostring` to clean up resources used by the Janet VM. This is to prevent memory leaks.
</requirement>

</requirements>

</function-requirements>

