#include "/src/astc-encoder/Source/astcenc_internal.h"

#include <fuzzer/FuzzedDataProvider.h>
#include <vector>
#include <array>
#include <cstring>
#include <memory>

// Struct for holding valid dimensions
struct BlockDims { int x, y, z; };

// Arrays of all valid 2D and 3D block dimension combinations, taken from
// the is_legal_*_block_size functions in the ASTC encoder source.
static const std::array<BlockDims, 14> valid_2d_dims = {{
{4, 4, 1}, {5, 4, 1}, {5, 5, 1}, {6, 5, 1}, {6, 6, 1}, {8, 5, 1},
{8, 6, 1}, {8, 8, 1}, {10, 5, 1}, {10, 6, 1}, {10, 8, 1}, {10, 10, 1},
{12, 10, 1}, {12, 12, 1}
}};

static const std::array<BlockDims, 10> valid_3d_dims = {{
{3, 3, 3}, {4, 3, 3}, {4, 4, 3}, {4, 4, 4}, {5, 4, 4}, {5, 5, 4},
{5, 5, 5}, {6, 5, 5}, {6, 6, 5}, {6, 6, 6}
}};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < 1) {
return 0;
}
FuzzedDataProvider stream(data, size);

// 1. Fuzz the block_size_descriptor by picking a legal dimension set
// Allocate on the heap to avoid stack overflow
auto bsd = std::make_unique<block_size_descriptor>();
BlockDims dims;
bool is_3d = stream.ConsumeBool();

if (is_3d) {
dims = stream.PickValueInArray(valid_3d_dims);
} else {
dims = stream.PickValueInArray(valid_2d_dims);
}

// Use parameters that generate the most modes and partitions
init_block_size_descriptor(dims.x, dims.y, dims.z, false, 4, 1.0f, *bsd);

// 2. Fuzz the symbolic_compressed_block directly
symbolic_compressed_block scb;

// We can't test SYM_BTYPE_ERROR, as it triggers an assert
scb.block_type = stream.ConsumeIntegralInRange<uint8_t>(SYM_BTYPE_CONST_F16, SYM_BTYPE_NONCONST);

// Handle constant-color blocks separately
if (scb.block_type != SYM_BTYPE_NONCONST) {
for (int i = 0; i < BLOCK_MAX_COMPONENTS; ++i) {
scb.constant_color[i] = stream.ConsumeIntegral<uint16_t>();
}
uint8_t pcb_out[16];
symbolic_to_physical(*bsd, scb, pcb_out);
return 0;
}

// Handle non-constant blocks
// Get a valid block_mode for this bsd. The block_mode is a direct
// index into the bsd->block_modes array.
if (bsd->block_mode_count_all == 0) {
return 0;
}
scb.block_mode = stream.ConsumeIntegralInRange<uint16_t>(0, bsd->block_mode_count_all - 1);

// Check if the block mode is valid before using it to prevent assertion
if (bsd->block_mode_packed_index[scb.block_mode] == BLOCK_BAD_BLOCK_MODE) {
return 0;
}

const auto& bm = bsd->get_block_mode(scb.block_mode);

scb.partition_count = stream.ConsumeIntegralInRange<uint8_t>(1, 4);

// This is an illegal combination in ASTC
if (bm.is_dual_plane && scb.partition_count == 4) {
return 0;
}

if (scb.partition_count > 1) {
// Partition index must be valid for the given partition count
unsigned int max_part_idx = bsd->partitioning_count_all[scb.partition_count - 1];
if (max_part_idx == 0) {
return 0;
}
scb.partition_index = stream.ConsumeIntegralInRange<uint16_t>(0, max_part_idx - 1);
} else {
scb.partition_index = 0;
}

scb.color_formats_matched = stream.ConsumeBool();
scb.plane2_component = bm.is_dual_plane ? stream.ConsumeIntegralInRange<int8_t>(0, 3) : -1;

// Correctly consume the enum value by casting from an integral type
scb.quant_mode = static_cast<quant_method>(stream.ConsumeIntegralInRange<uint8_t>(QUANT_2, QUANT_256));

for (unsigned int i = 0; i < scb.partition_count; ++i) {
scb.color_formats[i] = stream.ConsumeIntegralInRange<uint8_t>(0, 15);
}

// Populate color_values and weights with remaining data.
// Use a nested provider to avoid issues with ConsumeRemainingBytes.
std::vector<uint8_t> remaining_bytes = stream.ConsumeRemainingBytes<uint8_t>();
FuzzedDataProvider bytes_stream(remaining_bytes.data(), remaining_bytes.size());

for (unsigned int i = 0; i < scb.partition_count; ++i) {
for (int j = 0; j < 8; ++j) {
scb.color_values[i][j] = bytes_stream.ConsumeIntegral<uint8_t>();
}
}

std::vector<uint8_t> weight_bytes = bytes_stream.ConsumeRemainingBytes<uint8_t>();
size_t weights_to_copy = std::min(weight_bytes.size(), sizeof(scb.weights));
if (weights_to_copy > 0) {
std::memcpy(scb.weights, weight_bytes.data(), weights_to_copy);
}
if (weights_to_copy < sizeof(scb.weights)) {
std::memset(scb.weights + weights_to_copy, 0, sizeof(scb.weights) - weights_to_copy);
}

// 3. Call the function under test
uint8_t pcb_out[16];
symbolic_to_physical(*bsd, scb, pcb_out);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: astc-encoder
function signature: void symbolic_to_physical(const struct block_size_descriptor &, const struct symbolic_compressed_block &, uint8_t *)
</input>

<description>
The `symbolic_to_physical` function converts a symbolic representation of a compressed block (`symbolic_compressed_block`) into a physical 16-byte ASTC block (`pcb`). It uses a `block_size_descriptor` (`bsd`) to get context about the block's properties, such as its dimensions and supported modes. The function handles various block types, including constant-color blocks and complex partitioned blocks, encoding weights, color endpoints, and other metadata into the final physical block. It is the final step in the ASTC compression pipeline, called by `compress_block` after it has determined the best symbolic representation for a given image block.
</description>

<requirements>

<requirement>
The `block_size_descriptor` (`bsd`) argument must be initialized by calling `init_block_size_descriptor`. This is because this function populates internal tables essential for the logic inside `symbolic_to_physical`.
</requirement>
<requirement>
The `scb.block_type` must not be `SYM_BTYPE_ERROR` (0). This is enforced by an assertion at the beginning of the function.
</requirement>
<requirement>
The `scb.block_mode` must be a valid block mode index within the provided `bsd`. This is because `bsd.get_block_mode(scb.block_mode)` is called, and an invalid index will lead to an out-of-bounds access.
</requirement>
<requirement>
The `scb.partition_count` must be a valid value (e.g., 1 to 4). The logic of the function for writing partition data depends on this value.
</requirement>
<requirement>
The `symbolic_compressed_block` (`scb`) should be generated in a way that is consistent with the `block_size_descriptor` (`bsd`). One way to achieve this is to call `physical_to_symbolic` on fuzzed data to produce a valid `scb`.
</requirement>
<requirement>
The `pcb` buffer must be at least 16 bytes long. The function writes 16 bytes to this buffer.
</requirement>

</requirements>

</function-requirements>

