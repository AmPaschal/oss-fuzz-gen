limitations under the License.
*/

#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "lcms2.h"

// Limit LUT sizes to prevent excessive memory allocation and timeouts.
#define MAX_LUT_1D_SIZE 2048
#define MAX_LUT_3D_SIZE 65 // 65*65*65 is a large but manageable number of points

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
// Need at least a few bytes to define LUT sizes and control structure.
if (size < 8) {
return 0;
}

// --- Create a structured CUBE file from fuzzer data ---
size_t offset = 0;

// Consume first bytes to determine LUT sizes.
// Use modulo to keep sizes within a reasonable range.
uint8_t lut_3d_size = (data[offset++] % (MAX_LUT_3D_SIZE - 2)) + 2; // Range [2, MAX_LUT_3D_SIZE-1]

uint16_t lut_1d_size_raw;
memcpy(&lut_1d_size_raw, &data[offset], 2);
offset += 2;
uint16_t lut_1d_size = lut_1d_size_raw % (MAX_LUT_1D_SIZE + 1); // Range [0, MAX_LUT_1D_SIZE]

// Use a byte to control which optional keywords to write
uint8_t options = data[offset++];

const char *filename = "fuzz.cube";
FILE *fp = fopen(filename, "w");
if (fp == NULL) {
return 0;
}

// Write header section based on the 'options' byte
if (options & 0x01) {
fprintf(fp, "TITLE \"Fuzzed CUBE file\"\n");
}
if (options & 0x02) {
fprintf(fp, "DOMAIN_MIN %f %f %f\n", 
(float)data[offset % size] / 255.0f, 
(float)data[(offset + 1) % size] / 255.0f, 
(float)data[(offset + 2) % size] / 255.0f);
}
if (options & 0x04) {
fprintf(fp, "DOMAIN_MAX %f %f %f\n", 
1.0f + (float)data[(offset + 3) % size] / 255.0f, 
1.0f + (float)data[(offset + 4) % size] / 255.0f, 
1.0f + (float)data[(offset + 5) % size] / 255.0f);
}

// Adobe spec requires LUT_1D_SIZE to be >= 2
int use_1d_lut = (options & 0x08) && (lut_1d_size > 1);
if (use_1d_lut) {
fprintf(fp, "LUT_1D_SIZE %u\n", lut_1d_size);
}

fprintf(fp, "LUT_3D_SIZE %u\n", lut_3d_size);

// --- Write table data ---
// Generate the exact number of points required by the header.
size_t data_idx = offset;

// Write 1D LUT data if enabled
if (use_1d_lut) {
for (uint16_t i = 0; i < lut_1d_size; ++i) {
if (size - data_idx < 3) {
fprintf(fp, "%f %f %f\n", 0.1f, 0.2f, 0.3f);
} else {
fprintf(fp, "%f %f %f\n",
(float)data[data_idx++] / 255.0f,
(float)data[data_idx++] / 255.0f,
(float)data[data_idx++] / 255.0f);
}
}
}

// Write 3D LUT data
uint32_t num_3d_points = (uint32_t)lut_3d_size * lut_3d_size * lut_3d_size;
for (uint32_t i = 0; i < num_3d_points; ++i) {
if (size - data_idx < 3) {
// If we run out of fuzzer data, pad with default values
// to ensure the file is syntactically complete.
fprintf(fp, "%f %f %f\n", 0.4f, 0.5f, 0.6f);
} else {
fprintf(fp, "%f %f %f\n",
(float)data[data_idx++] / 255.0f,
(float)data[data_idx++] / 255.0f,
(float)data[data_idx++] / 255.0f);
}
}

fclose(fp);

// --- Call the target function ---
cmsHPROFILE hProfile = cmsCreateDeviceLinkFromCubeFileTHR(NULL, filename);

if (hProfile != NULL) {
cmsCloseProfile(hProfile);
}

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: lcms
function signature: cmsHPROFILE cmsCreateDeviceLinkFromCubeFileTHR(cmsContext, const char *)
</input>

<description>
The function `cmsCreateDeviceLinkFromCubeFileTHR` creates a device link profile from a CUBE file. It takes a context ID and a file name as input. It opens and parses the CUBE file to extract color transformation information, including a color lookup table (CLUT) and shaper curves. It then creates a new profile, sets its header information, and populates it with the extracted data by creating a pipeline and writing the necessary tags. The context ID can be NULL, in which case a default global context is used.
</description>

<requirements>
<requirement>
The cFileName argument must be a valid pointer to a null-terminated string. This is because it is used in `fopen` and `strncpy`.
</requirement>
<requirement>
The file pointed to by cFileName must be a valid CUBE file. This is because the function `ParseCube` is used to parse the file, and an invalid file format will cause the parsing to fail and the function to return NULL.
</requirement>
<requirement>
The ContextID can be NULL. In the only call site, it is set to NULL, and the lcms library is designed to handle a NULL context by using a global one.
</requirement>
</requirements>

</function-requirements>

