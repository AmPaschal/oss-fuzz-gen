/* In-memory transport implementation */
typedef struct {
uint8_t *buffer;
size_t capacity;
size_t size;
size_t read_pos;
} transport_buffer;

static ssize_t transport_push(gnutls_transport_ptr_t ptr, const void* data, size_t len) {
transport_buffer *buf = (transport_buffer*)ptr;
if (buf->size + len > buf->capacity) {
return -1;
}
memcpy(buf->buffer + buf->size, data, len);
buf->size += len;
return len;
}

static ssize_t transport_pull(gnutls_transport_ptr_t ptr, void* data, size_t len) {
transport_buffer *buf = (transport_buffer*)ptr;
if (buf->read_pos >= buf->size) {
gnutls_transport_set_errno((gnutls_session_t)ptr, EAGAIN);
return -1;
}
size_t to_read = (buf->size - buf->read_pos < len) ? (buf->size - buf->read_pos) : len;
memcpy(data, buf->buffer + buf->read_pos, to_read);
buf->read_pos += to_read;
return to_read;
}

/* Helper to set up server credentials */
static void setup_server_credentials(gnutls_certificate_credentials_t *s_cred) {
gnutls_x509_privkey_t key;
gnutls_x509_crt_t cert;

assert(gnutls_certificate_allocate_credentials(s_cred) >= 0);
assert(gnutls_x509_privkey_init(&key) >= 0);
assert(gnutls_x509_crt_init(&cert) >= 0);

assert(gnutls_x509_privkey_import(key, &server_key, GNUTLS_X509_FMT_PEM) >= 0);
assert(gnutls_x509_crt_import(cert, &server_cert, GNUTLS_X509_FMT_PEM) >= 0);
assert(gnutls_certificate_set_x509_key(*s_cred, &cert, 1, key) >= 0);

gnutls_x509_privkey_deinit(key);
gnutls_x509_crt_deinit(cert);
}

/* Helper to set up client credentials and trust the server */
static void setup_client_credentials(gnutls_certificate_credentials_t *c_cred) {
assert(gnutls_certificate_allocate_credentials(c_cred) >= 0);
assert(gnutls_certificate_set_x509_trust_mem(*c_cred, &server_cert, GNUTLS_X509_FMT_PEM) >= 0);
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size == 0) {
return 0;
}

gnutls_session_t client_session, server_session;
gnutls_certificate_credentials_t client_cred, server_cred;

uint8_t client_to_server_buf[MAX_RECORD_SIZE] = {0};
uint8_t server_to_client_buf[MAX_RECORD_SIZE] = {0};
transport_buffer c2s = { .buffer = client_to_server_buf, .capacity = sizeof(client_to_server_buf) };
transport_buffer s2c = { .buffer = server_to_client_buf, .capacity = sizeof(server_to_client_buf) };

/* Initialize sessions */
assert(gnutls_init(&client_session, GNUTLS_CLIENT) >= 0);
assert(gnutls_init(&server_session, GNUTLS_SERVER) >= 0);

/* Set credentials */
setup_server_credentials(&server_cred);
setup_client_credentials(&client_cred);
assert(gnutls_credentials_set(server_session, GNUTLS_CRD_CERTIFICATE, server_cred) >= 0);
assert(gnutls_credentials_set(client_session, GNUTLS_CRD_CERTIFICATE, client_cred) >= 0);

/* Set priorities */
assert(gnutls_priority_set_direct(client_session, "NORMAL", NULL) >= 0);
assert(gnutls_priority_set_direct(server_session, "NORMAL", NULL) >= 0);

/* Set transport */
gnutls_transport_set_ptr(client_session, &s2c);
gnutls_transport_set_push_function(client_session, transport_push);
gnutls_transport_set_pull_function(client_session, transport_pull);

gnutls_transport_set_ptr(server_session, &c2s);
gnutls_transport_set_push_function(server_session, transport_push);
gnutls_transport_set_pull_function(server_session, transport_pull);

/* Perform handshake */
int ret;
unsigned int retry_count = 0;
do {
ret = gnutls_handshake(client_session);
if (ret < 0 && gnutls_error_is_fatal(ret) == 0) {
ret = gnutls_handshake(server_session);
} else if (ret < 0) {
break;
}

if (ret < 0 && gnutls_error_is_fatal(ret) == 0) {
ret = gnutls_handshake(client_session);
} else if (ret < 0) {
break;
}
retry_count++;
} while (ret < 0 && retry_count < HANDSHAKE_MAX_RETRY);

/* Only proceed if handshake was successful */
if (ret >= 0) {
/* Fuzz the `how` parameter */
gnutls_close_request_t how = (data[0] % 2 == 0) ? GNUTLS_SHUT_RDWR : GNUTLS_SHUT_WR;

/* Call gnutls_bye on the client */
gnutls_bye(client_session, how);

/* The server should also close the connection to respond */
gnutls_bye(server_session, GNUTLS_SHUT_RDWR);

/* If client only closed write, it can still read. Let's try to close read now. */
if (how == GNUTLS_SHUT_WR) {
gnutls_bye(client_session, GNUTLS_SHUT_RDWR);
}
}

/* Cleanup */
gnutls_deinit(client_session);
gnutls_deinit(server_session);
gnutls_certificate_free_credentials(client_cred);
gnutls_certificate_free_credentials(server_cred);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: gnutls
function signature: int gnutls_bye(gnutls_session_t, gnutls_close_request_t)
</input>

<description>
The `gnutls_bye` function is used to terminate a TLS session. It can be used to close the write direction of the connection, or both the read and write directions. It takes a `gnutls_session_t` object representing the session and a `gnutls_close_request_t` enum value indicating how to close the session.
</description>

<requirements>

<requirement>
The gnutls_init function must be called to initialize a `gnutls_session_t` object before it is used in `gnutls_bye`. This is because the session object must be initialized before it can be used by any other gnutls function.
</requirement>
<requirement>
The `gnutls_priority_set_direct` function should be called to set the priority string. This is necessary to negotiate cryptographic parameters for the session.
</requirement>
<requirement>
The `gnutls_credentials_set` function must be called to set the credentials for the session. This is required for the TLS handshake to succeed.
</requirement>
<requirement>
The `gnutls_transport_set_int` function must be called to associate a file descriptor with the session. This is because the session needs a transport medium to communicate.
</requirement>
<requirement>
The `gnutls_handshake` function must be called to perform the TLS handshake. This is because the session must be established before it can be terminated.
</requirement>
<requirement>
The `how` argument must be either `GNUTLS_SHUT_RDWR` or `GNUTLS_SHUT_WR`. These are the only valid values for the `gnutls_close_request_t` enum.
</requirement>

</requirements>

</function-requirements>

