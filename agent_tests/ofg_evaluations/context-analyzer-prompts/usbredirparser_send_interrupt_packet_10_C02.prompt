parser->free_lock_func = parser_free_lock;
parser->hello_func = parser_hello;
}

} // namespace

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
FuzzedDataProvider fdp(data, size);

// Create host (sender) and device (receiver) parsers
std::unique_ptr<struct usbredirparser, ParserDeleter> host_parser(usbredirparser_create());
std::unique_ptr<struct usbredirparser, ParserDeleter> device_parser(usbredirparser_create());
if (!host_parser || !device_parser) {
return 0;
}

// Setup host parser (sender)
setup_parser_callbacks(host_parser.get());
host_parser->write_func = host_parser_write;
usbredirparser_init(host_parser.get(), "fuzzer-host", nullptr, 0, usbredirparser_fl_usb_host);

// Setup device parser (receiver)
setup_parser_callbacks(device_parser.get());
device_parser->read_func = device_parser_read;
usbredirparser_init(device_parser.get(), "fuzzer-device", nullptr, 0, 0);

// Fuzz parameters for the target function
uint64_t id = fdp.ConsumeIntegral<uint64_t>();
struct usb_redir_interrupt_packet_header header;
header.endpoint = fdp.ConsumeIntegral<uint8_t>();
header.status = fdp.ConsumeIntegral<uint8_t>();

uint8_t *packet_data = nullptr;
int data_len = 0;
std::vector<uint8_t> data_vec;

// Adhere to function preconditions based on endpoint direction
if (header.endpoint & 0x80) { // IN endpoint
if (fdp.remaining_bytes() > 0) {
data_vec = fdp.ConsumeRemainingBytes<uint8_t>();
header.length = data_vec.size();
packet_data = data_vec.data();
data_len = data_vec.size();
} else {
header.length = 0;
packet_data = nullptr;
data_len = 0;
}
} else { // OUT endpoint
header.length = 0;
packet_data = nullptr;
data_len = 0;
}

// Call the function under test on the host parser
usbredirparser_send_interrupt_packet(host_parser.get(), id, &header, packet_data, data_len);

// Process the write queue to send data to the pipe
while (usbredirparser_has_data_to_write(host_parser.get())) {
usbredirparser_do_write(host_parser.get());
}

// Process the read queue on the device parser to parse the data from the pipe
while (!pipe.empty()) {
usbredirparser_do_read(device_parser.get());
}

// Clear the pipe for the next run
std::queue<uint8_t> empty;
pipe.swap(empty);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: spice-usbredir
function signature: void usbredirparser_send_interrupt_packet(struct usbredirparser *, uint64_t, struct usb_redir_interrupt_packet_header *, uint8_t *, int)
</input>

<description>
The `usbredirparser_send_interrupt_packet` function queues a USB interrupt packet to be sent. It acts as a wrapper for the `usbredirparser_queue` function, which performs the actual queuing. Callers of this function within `usbredirhost.c` utilize it for transmitting interrupt data, as well as for sending status updates and cancellation notifications related to interrupt transfers. The behavior and requirements for this function are conditional, based on the endpoint direction specified in the `interrupt_header`. For IN endpoints, the function expects a data payload, while for OUT endpoints, it expects no payload. The `parser` argument must be a valid pointer to a `usbredirparser` struct, initialized by functions like `usbredirparser_create` and `usbredirhost_open_full`. The `id` is a 64-bit transfer identifier. The `interrupt_header` points to a struct containing packet metadata. The `data` and `data_len` arguments represent the packet's payload, which may be empty for status-only packets.
</description>

<requirements>
<requirement>
The `parser` argument must be a valid, initialized `usbredirparser` struct. This is because the function internally dereferences this pointer to queue the interrupt packet.
</requirement>
<requirement>
The `interrupt_header` argument must be a valid pointer to a `usb_redir_interrupt_packet_header` struct. This is because its members, particularly `endpoint` and `length`, are used for validation and processing.
</requirement>
<requirement>
If the `endpoint` field in `interrupt_header` specifies an IN endpoint (the most significant bit is set), then the `length` field must be equal to `data_len`. This ensures consistency for data transfers on IN endpoints.
</requirement>
<requirement>
If the `endpoint` field in `interrupt_header` specifies an OUT endpoint (the most significant bit is not set), the `data` argument must be NULL and `data_len` must be 0. This is because data is not expected for OUT endpoint interrupt packets sent from the host.
</requirement>
<requirement>
If `data_len` is greater than 0, the `data` argument must point to a valid buffer of at least `data_len` bytes. This is to prevent memory access violations when the data payload is copied.
</requirement>
</requirements>

</function-requirements>

