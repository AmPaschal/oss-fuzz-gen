<fuzz-target>
#include <fuzzer/FuzzedDataProvider.h>
#include <cstddef>
#include <cstdint>
#include <memory>
#include <vector>
#include <queue>

#include "/src/spice-usbredir/usbredirparser/usbredirparser.h"
#include "/src/spice-usbredir/usbredirparser/usbredirproto.h"

// Forward declaration for the function under test
void usbredirparser_send_interrupt_packet(struct usbredirparser *, uint64_t, struct usb_redir_interrupt_packet_header *, uint8_t *, int);

namespace {

struct ParserDeleter {
void operator()(struct usbredirparser *p) { usbredirparser_destroy(p); }
};

// A queue to simulate the data pipe between two parsers
std::queue<uint8_t> pipe;

// Write function for the "host" parser, pushes data to the pipe
int host_parser_write(void *priv, uint8_t *data, int count) {
for (int i = 0; i < count; ++i) {
pipe.push(data[i]);
}
return count;
}

// Read function for the "device" parser, pulls data from the pipe
int device_parser_read(void *priv, uint8_t *data, int count) {
int i = 0;
while (i < count && !pipe.empty()) {
data[i++] = pipe.front();
pipe.pop();
}
return i;
}

// Dummy callbacks to satisfy the usbredirparser struct
void parser_log(void *priv, int level, const char *msg) {}
void parser_device_connect(void *priv, struct usb_redir_device_connect_header *device_connect) {}
void parser_device_disconnect(void *priv) {}
void parser_reset(void *priv) {}
void parser_interface_info(void *priv, struct usb_redir_interface_info_header *info) {}
void parser_ep_info(void *priv, struct usb_redir_ep_info_header *ep_info) {}
