#include <net-snmp/net-snmp-config.h>
#include <net-snmp/net-snmp-includes.h>
#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

int netsnmp_query_set(netsnmp_variable_list *, netsnmp_session *);

int LLVMFuzzerInitialize(int *argc, char ***argv) {
/* From requirement: The Net-SNMP library should be initialized by calling init_snmp() */
init_snmp("netsnmp_query_set_fuzzer");
return 0;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
/* We need at least 1 byte for OID length, 1 for type, and 1 for value */
if (size < 3) {
return 0;
}

/*
* Requirement: A valid netsnmp_session must be provided.
* We initialize a session but do not "open" it to prevent actual network
* I/O, which is unsuitable for fuzzing. The library calls will fail at the
* transport layer, but this allows fuzzing of the PDU construction and
* processing logic that occurs before transport.
*/
netsnmp_session session;
snmp_sess_init(&session);
session.version = SNMP_VERSION_2c;
session.community = (u_char *)"public";
session.community_len = strlen((const char *)session.community);
session.peername = "127.0.0.1";

/*
* Requirement: The netsnmp_variable_list should be created and populated.
* Requirement: The first argument, netsnmp_variable_list *list, must not be a NULL pointer.
* We construct a single variable from the raw fuzzer data.
*/
netsnmp_pdu *pdu = snmp_pdu_create(SNMP_MSG_SET);
if (pdu == NULL) {
return 0;
}

/* Use first byte for OID length. Each OID component is sizeof(oid). */
const size_t oid_len = data[0] % MAX_OID_LEN;
const size_t oid_byte_len = oid_len * sizeof(oid);
data++;
size--;

if (size < oid_byte_len + 1) { /* +1 for type */
snmp_free_pdu(pdu);
return 0;
}

oid an_oid[MAX_OID_LEN];
memcpy(an_oid, data, oid_byte_len);
data += oid_byte_len;
size -= oid_byte_len;

/* Use next byte for type, rest for value */
const u_char type = data[0];
data++;
size--;

if (snmp_pdu_add_variable(pdu, an_oid, oid_len, type, data, size) == NULL) {
snmp_free_pdu(pdu);
return 0;
}

/* Call the function under test */
netsnmp_query_set(pdu->variables, &session);

/* Cleanup */
snmp_free_pdu(pdu);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: net-snmp
function signature: int netsnmp_query_set(netsnmp_variable_list *, netsnmp_session *)
</input>

<description>
The `netsnmp_query_set` function is used to send an SNMP SET request. It is a wrapper around the internal `_query` function, which constructs and sends an SNMP PDU. The function takes a list of variables to be set and a session handle. It returns SNMP_ERR_NOERROR on success and a negative error code on failure. The `_query` function performs several checks on the input arguments, which must be satisfied for the function to execute correctly. Callers of this function are responsible for creating a valid variable list and a valid session.
</description>

<requirements>
<requirement>
The first argument, `netsnmp_variable_list *list`, must not be a NULL pointer. The internal `_query` function checks for a NULL list and will return an error, preventing the SET request from being sent.
</requirement>
<requirement>
A valid `netsnmp_session` must be provided. This can be done either by passing a non-NULL `netsnmp_session *session` as the second argument, or by setting a default session using `netsnmp_query_set_default_session` prior to calling the function. If both are NULL, the function will fail.
</requirement>
<requirement>
The `netsnmp_session` object should be initialized by calling `snmp_sess_init()` and then opened using `snmp_open()` or `snmp_sess_open()`. This is the standard procedure for creating a valid session that can be used for SNMP operations.
</requirement>
<requirement>
The `netsnmp_variable_list` should be created and populated using functions like `snmp_pdu_add_variable()` or `snmp_add_null_var()`. This ensures that the variable list is correctly formatted and contains the necessary information for the SNMP SET request.
</requirement>
<requirement>
The Net-SNMP library should be initialized by calling `init_snmp()` before any other library functions are used. This ensures that all necessary subsystems, such as MIB parsing and transport mechanisms, are properly set up.
</requirement>
</requirements>

</function-requirements>

