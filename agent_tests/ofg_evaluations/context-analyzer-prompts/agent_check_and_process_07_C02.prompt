#include <net-snmp/net-snmp-config.h>
#include <net-snmp/net-snmp-includes.h>
#include <net-snmp/agent/net-snmp-agent-includes.h>
#include <net-snmp/library/snmp_transport.h>
#include <net-snmp/library/large_fd_set.h>
#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>

/* Fuzzer input is stored in a global variable for the custom transport */
static const uint8_t *fuzz_data;
static size_t fuzz_data_size;
static size_t fuzz_data_offset;
static int pipefd[2];

/*
* Custom receive function that simulates reading from a socket.
* It copies the fuzzer input into the buffer provided by the agent.
*/
static int f_recv(netsnmp_transport *t, void *buf, int size,
void **transport_data, int *transport_data_length) {
/* Drain the pipe to reset it for the next run */
char drain_buf[16];
while (read(pipefd[0], drain_buf, sizeof(drain_buf)) > 0);

if (fuzz_data_offset >= fuzz_data_size) {
return -1; /* No more data */
}

size_t bytes_to_copy = fuzz_data_size - fuzz_data_offset;
if (bytes_to_copy > size) {
bytes_to_copy = size;
}

memcpy(buf, fuzz_data + fuzz_data_offset, bytes_to_copy);
fuzz_data_offset += bytes_to_copy;

return bytes_to_copy;
}

static int f_close(netsnmp_transport *t) {
return 0;
}

int LLVMFuzzerInitialize(int *argc, char ***argv) {
static int initialized = 0;
if (initialized) {
return 0;
}

/* 1. Initialize the agent's data structures. */
init_agent("fuzz_agent");

/* 2. Initialize the SNMP library. */
init_snmp("fuzz_agent");

/* 3. Create a pipe to wake up select() */
if (pipe(pipefd) == -1) {
perror("pipe");
exit(1);
}
fcntl(pipefd[0], F_SETFL, O_NONBLOCK);

/* 4. Create a fake session and transport */
netsnmp_session session, *ss;
netsnmp_transport *transport;

snmp_sess_init(&session);
transport = (netsnmp_transport *)calloc(1, sizeof(netsnmp_transport));
if (!transport) {
exit(1);
}
transport->sock = pipefd[0];
transport->f_recv = f_recv;
transport->f_close = f_close;

ss = snmp_add(&session, transport, NULL, NULL);
if (ss == NULL) {
snmp_log(LOG_ERR, "Failed to add session\n");
exit(1);
}

initialized = 1;
return 0;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size == 0) {
return 0;
}

/* Set up the global variables for our custom receive function */
fuzz_data = data;
fuzz_data_size = size;
fuzz_data_offset = 0;

/* Write to the pipe to wake up select() */
if (write(pipefd[1], "1", 1) < 0) {
/* Ignore errors, e.g. pipe full */
}

/*
* Call the function under test. We use a blocking call with a timeout
* to ensure it processes the event from the pipe.
*/
agent_check_and_process(1);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: net-snmp
function signature: int agent_check_and_process(int)
</input>

<description>
The `agent_check_and_process` function is the primary event loop for the Net-SNMP agent. It is responsible for receiving and processing SNMP packets, as well as handling scheduled alarms. The function's behavior is primarily controlled by the agent's global state, which must be initialized before this function is called. The single integer argument, `block`, determines whether the function will block waiting for network activity. A non-zero value for `block` will cause the function to block, while a value of zero will cause it to return immediately if there is no network activity.
</description>

<requirements>

<requirement>
The `init_agent` function must be called before `agent_check_and_process`. This is because `init_agent` is responsible for initializing the agent's MIBs and other internal data structures that are necessary for `agent_check_and_process` to function correctly.
</requirement>
<requirement>
The `init_snmp` function must be called before `agent_check_and_process`. This is because `init_snmp` initializes the SNMP library, which is a prerequisite for all other SNMP operations.
</requirement>
<requirement>
The `init_master_agent` function should be called before `agent_check_and_process`. This is because `init_master_agent` initializes the master agent, which is responsible for opening and binding to the necessary sockets for SNMP communication.
</requirement>
<requirement>
The input argument `block` should be either 0 or 1. This argument controls whether the function blocks waiting for network activity and other values are not expected.
</requirement>

</requirements>

</function-requirements>

