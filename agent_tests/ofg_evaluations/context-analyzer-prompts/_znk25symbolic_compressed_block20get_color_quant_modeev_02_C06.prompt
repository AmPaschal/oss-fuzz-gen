//  See the License for the specific language governing permissions and
//  limitations under the License.
// ----------------------------------------------------------------------------

#include "/src/astc-encoder/Source/astcenc_internal.h"

#include <array>
#include <fuzzer/FuzzedDataProvider.h>
#include <vector>

struct BlockSizes {
int x;
int y;
int z;
};

std::array<BlockSizes, 3> testSz{{
{4, 4, 1},   // Highest bitrate
{12, 12, 1}, // Largest 2D block
{6, 6, 6}    // Largest 3D block
}};

std::array<block_size_descriptor, 3> testBSD;
std::vector<std::vector<uint16_t>> valid_block_modes;

/**
* @brief Utility function to create all of the block size descriptors and
* pre-calculate the valid block modes for each.
*/
bool bsd_initializer() {
for (size_t i = 0; i < testSz.size(); i++) {
init_block_size_descriptor(testSz[i].x, testSz[i].y, testSz[i].z, false,
ASTCENC_PRF_LDR, 1.0f, testBSD[i]);

std::vector<uint16_t> modes;
for (int j = 0; j < 2048; j++) {
if (testBSD[i].block_mode_packed_index[j] != BLOCK_BAD_BLOCK_MODE) {
modes.push_back(j);
}
}
valid_block_modes.push_back(modes);
}

return true;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
// Preinitialize the block size descriptors we need
static bool init = bsd_initializer();

FuzzedDataProvider stream(data, size);

// Select a block size to test
int bsd_idx = stream.ConsumeIntegralInRange<int>(0, testSz.size() - 1);
const auto& bsd = testBSD[bsd_idx];
const auto& vbm = valid_block_modes[bsd_idx];

if (vbm.empty()) {
return 0;
}

// Create a symbolic block that we will populate with fuzzed data.
// This symbolic block will be converted to a physical block, which is then
// used to fuzz the physical_to_symbolic function. This is a form of
// structure-aware fuzzing that avoids wasting time on immediately-rejected
// random data.
symbolic_compressed_block scb_in;
scb_in.block_type = SYM_BTYPE_NONCONST;

// Pick a valid block mode for the chosen block size
scb_in.block_mode = vbm[stream.ConsumeIntegralInRange<size_t>(0, vbm.size() - 1)];
const auto& bm = bsd.get_block_mode(scb_in.block_mode);

// Fuzz the quantization mode within the valid range
scb_in.quant_mode = static_cast<quant_method>(
stream.ConsumeIntegralInRange<int>(QUANT_6, QUANT_256));

// Fuzz partition count within the valid range for the block mode
scb_in.partition_count = stream.ConsumeIntegralInRange<uint8_t>(1, BLOCK_MAX_PARTITIONS);

// Illegal combination; skip to avoid known error paths if desired,
// or let it run to test them. For this example, we will skip.
if (bm.is_dual_plane && scb_in.partition_count == 4) {
return 0;
}

// Fuzz other parameters of the symbolic block
if (scb_in.partition_count > 1) {
if (bsd.partitioning_count_all[scb_in.partition_count - 1] > 0)
{
scb_in.partition_index = stream.ConsumeIntegralInRange<uint16_t>(0, bsd.partitioning_count_all[scb_in.partition_count - 1] - 1);
} else {
scb_in.partition_index = 0;
}
} else {
scb_in.partition_index = 0;
}

for (unsigned int i = 0; i < scb_in.partition_count; i++) {
scb_in.color_formats[i] = stream.ConsumeIntegralInRange<uint8_t>(0, 15);
}

const auto& di = bsd.get_decimation_info(bm.decimation_mode);
int weight_count = di.weight_count;
int plane_count = bm.is_dual_plane ? 2 : 1;
for (int i = 0; i < weight_count * plane_count; i++) {
scb_in.weights[i] = stream.ConsumeIntegral<uint8_t>();
}

for (unsigned int i = 0; i < scb_in.partition_count; i++) {
for (int j = 0; j < 8; j++) { // Max endpoint values
scb_in.color_values[i][j] = stream.ConsumeIntegral<uint8_t>();
}
}

if (bm.is_dual_plane) {
scb_in.plane2_component = stream.ConsumeIntegralInRange<int8_t>(0, 3);
} else {
scb_in.plane2_component = -1;
}

// Add a fuzzed value for color_formats_matched, which affects bit packing
scb_in.color_formats_matched = stream.ConsumeBool();

// Check if the chosen parameters will cause a buffer overflow in the
// symbolic to physical conversion. This requires calculating the total bit
// cost of the encoded block and ensuring it does not exceed 128 bits.
unsigned int bits_for_weights = get_ise_sequence_bitcount(
bm.is_dual_plane ? (2 * weight_count) : weight_count,
bm.get_weight_quant_mode());

unsigned int encoded_type_highpart_size = 0;
if (scb_in.partition_count > 1 && !scb_in.color_formats_matched) {
encoded_type_highpart_size = (3 * scb_in.partition_count) - 4;
}

unsigned int bits_for_tail = bits_for_weights + encoded_type_highpart_size;
if (bm.is_dual_plane) {
bits_for_tail += 2;
}

int color_value_count = 0;
for (unsigned int i = 0; i < scb_in.partition_count; i++) {
int vals = 2 * (scb_in.color_formats[i] >> 2) + 2;
color_value_count += vals;
}
unsigned int bits_for_colors =
get_ise_sequence_bitcount(color_value_count, scb_in.quant_mode);

// Fixed header bits for mode, partition count, base partition/color info
unsigned int fixed_bits = (scb_in.partition_count == 1)
? (11 + 2 + 4)
: (11 + 2 + PARTITION_INDEX_BITS + 6);

// If the variable-sized middle parts (colors from start, tail from end)
// would overlap, the configuration is invalid.
if ((bits_for_colors + bits_for_tail) > (128 - fixed_bits)) {
return 0;
}

// Convert the fuzzed symbolic block to a physical block
uint8_t pcb[16];
symbolic_to_physical(bsd, scb_in, pcb);

// Optionally, apply a small mutation to the valid physical block to
// trigger error handling paths in the decoder.
if (stream.ConsumeBool() && stream.remaining_bytes() > 0) {
uint8_t pos = stream.ConsumeIntegralInRange<uint8_t>(0, 15);
pcb[pos] ^= stream.ConsumeIntegral<uint8_t>();
}

// Create the symbolic block from the physical block
symbolic_compressed_block scb_out;
physical_to_symbolic(bsd, pcb, scb_out);

// Call the function under test on the output of the main fuzzing logic
(void)scb_out.get_color_quant_mode();

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: astc-encoder
function signature: quant_method symbolic_compressed_block::get_color_quant_mode(const struct symbolic_compressed_block *)
</input>

<description>
The function `symbolic_compressed_block::get_color_quant_mode` is an inline function that returns the `quant_mode` member of a `symbolic_compressed_block` object. This object represents a symbolically-decoded ASTC block. The `quant_mode` itself is an enum of type `quant_method`, which determines the quantization level used for the color endpoints in the block. To correctly obtain a meaningful `quant_mode`, the `symbolic_compressed_block` object must first be properly initialized by decoding a physical ASTC block.
</description>

<requirements>
<requirement>
The `symbolic_compressed_block` object (`scb`) must be initialized by calling `physical_to_symbolic` before calling `get_color_quant_mode`. The `physical_to_symbolic` function populates the `quant_mode` member of the `scb` which is returned by `get_color_quant_mode`.
</requirement>
<requirement>
The `physical_to_symbolic` function requires a valid `block_size_descriptor` instance as its first argument. The `init_block_size_descriptor` function must be called to initialize the `block_size_descriptor` before it is used.
</requirement>
<requirement>
The `init_block_size_descriptor` function must be called with a valid `astcenc_profile` enum value and valid block dimensions (x, y, z). These parameters define the block's properties, which are essential for the correct execution of the `physical_to_symbolic` function.
</requirement>
<requirement>
The second argument to the `physical_to_symbolic` function is a pointer to a 16-byte buffer representing the physical ASTC block data. This buffer must contain valid ASTC block data, as it is read and decoded by the function.
</requirement>
</requirements>

</function-requirements>

