/**
* @brief Fuzz target for symbolic_to_physical().
*
* This function is the final entrypoint for compressing a symbolic block into
* a 16 byte physical block of ASTC data for storage.
*/

#include "/src/astc-encoder/Source/astcenc_internal.h"

#include <fuzzer/FuzzedDataProvider.h>
#include <array>
#include <vector>

struct BlockSizes
{
int x;
int y;
int z;
};

std::array<BlockSizes, 3> testSz {{
{ 4,  4, 1}, // Highest bitrate
{12, 12, 1}, // Largest 2D block
{6,  6,  6}  // Largest 3D block
}};

std::array<block_size_descriptor, 3> testBSD;

/**
* @brief Utility function to create all of the block size descriptors needed.
*/
bool bsd_initializer()
{
for (size_t i = 0; i < testSz.size(); i++)
{
init_block_size_descriptor(
testSz[i].x,
testSz[i].y,
testSz[i].z,
true,
4,
1.0f,
testBSD[i]);
}

return true;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
{
// Preinitialize the block size descriptors we need
static bool init = bsd_initializer();

FuzzedDataProvider stream(data, size);

// Select a block size to test
int bsd_idx = stream.ConsumeIntegralInRange<int>(0, testSz.size() - 1);
const block_size_descriptor& bsd = testBSD[bsd_idx];

// Create the symbolic block
symbolic_compressed_block scb;
std::memset(&scb, 0, sizeof(scb));

scb.block_type = stream.PickValueInArray<uint8_t>({
SYM_BTYPE_CONST_F16,
SYM_BTYPE_CONST_U16,
SYM_BTYPE_NONCONST
});

if (scb.block_type == SYM_BTYPE_NONCONST)
{
if (bsd.block_mode_count_all == 0)
{
return 0;
}

// Collect the list of valid block modes for this BSD
std::vector<uint16_t> valid_block_modes;
for (uint16_t i = 0; i < bsd.block_mode_count_all; ++i)
{
if (bsd.block_mode_packed_index[i] != BLOCK_BAD_BLOCK_MODE)
{
valid_block_modes.push_back(i);
}
}

// If no valid modes, can't continue
if (valid_block_modes.empty())
{
return 0;
}

scb.partition_count = stream.ConsumeIntegralInRange<uint8_t>(1, BLOCK_MAX_PARTITIONS);
size_t mode_idx = stream.ConsumeIntegralInRange<size_t>(0, valid_block_modes.size() - 1);
scb.block_mode = valid_block_modes[mode_idx];
const auto& bm = bsd.get_block_mode(scb.block_mode);

static const quant_method quant_methods[] = {
QUANT_2, QUANT_3, QUANT_4, QUANT_5, QUANT_6, QUANT_8,
QUANT_10, QUANT_12, QUANT_16, QUANT_20, QUANT_24, QUANT_32,
QUANT_40, QUANT_48, QUANT_64, QUANT_80, QUANT_96, QUANT_128,
QUANT_160, QUANT_192, QUANT_256
};
scb.quant_mode = stream.PickValueInArray(quant_methods);

for (unsigned int i = 0; i < scb.partition_count; i++)
{
scb.color_formats[i] = stream.ConsumeIntegral<uint8_t>();
stream.ConsumeData(scb.color_values[i], sizeof(scb.color_values[i]));
}

if (scb.partition_count > 1)
{
scb.partition_index = stream.ConsumeIntegral<uint16_t>();
scb.color_formats_matched = stream.ConsumeBool();
}

if (bm.is_dual_plane)
{
scb.plane2_component = stream.ConsumeIntegralInRange<int8_t>(0, 3);
}
else
{
scb.plane2_component = -1;
}

const auto& di = bsd.get_decimation_info(bm.decimation_mode);
int weight_count = di.weight_count;
int real_weight_count = bm.is_dual_plane ? 2 * weight_count : weight_count;
for (int i = 0; i < real_weight_count; i++)
{
scb.weights[i] = stream.ConsumeIntegralInRange<uint8_t>(0, 64);
}
}
else // Constant color block
{
for (int i = 0; i < BLOCK_MAX_COMPONENTS; i++)
{
scb.constant_color[i] = stream.ConsumeIntegral<uint16_t>();
}
}

// Call the function under test
uint8_t pcb[16];
symbolic_to_physical(bsd, scb, pcb);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: astc-encoder
function signature: void symbolic_to_physical(const struct block_size_descriptor &, const struct symbolic_compressed_block &, uint8_t *)
</input>

<description>
The `symbolic_to_physical` function converts a symbolic representation of a compressed block (`symbolic_compressed_block`) into a physical, binary format (`physical_compressed_block`). The conversion process depends on the block type specified in the symbolic block. For constant color blocks, the function directly writes the color data to the physical block. For other block types, it encodes weights, partition information, and color endpoint data into the physical block. The function relies on a `block_size_descriptor` to provide context about the block's structure and encoding parameters.
</description>

<requirements>

<requirement>
The `bsd` argument must be initialized by calling `init_block_size_descriptor` before calling `symbolic_to_physical`. This is because `symbolic_to_physical` uses the data in `bsd`, such as block modes and decimation tables, which are populated by `init_block_size_descriptor`.
</requirement>
<requirement>
The `scb.block_type` field must not be `SYM_BTYPE_ERROR`. The function asserts this condition at the beginning, and a failure will cause the program to crash.
</requirement>
<requirement>
If `scb.block_type` is `SYM_BTYPE_NONCONST`, the `scb.partition_count` field must be between 1 and 4, inclusive. This range is based on the valid partition counts in the ASTC specification.
</requirement>
<requirement>
If `scb.block_type` is `SYM_BTYPE_NONCONST`, the `scb.weights` array values must be in the range [0, 64]. These values are used in calculations that expect this range, and out-of-range values can lead to incorrect behavior or crashes.
</requirement>
<requirement>
The `pcb` argument must point to a buffer of at least 16 bytes. This is because the function writes 16 bytes of data to this buffer, and a smaller buffer will result in a buffer overflow.
</requirement>

</requirements>

</function-requirements>

