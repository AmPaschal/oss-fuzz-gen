#include <net-snmp/net-snmp-config.h>
#include <net-snmp/net-snmp-includes.h>
#include <net-snmp/agent/net-snmp-agent-includes.h>
#include <net-snmp/agent/mib_modules.h>
#include "../../agent/mibgroup/utilities/iquery.h"

#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

// Helper to consume a fixed-size, null-terminated string from the fuzz data.
static char *consume_string(const uint8_t **data, size_t *size, size_t len) {
if (*size < len) {
return NULL;
}
char *str = (char *)malloc(len + 1);
if (!str) {
return NULL;
}
memcpy(str, *data, len);
str[len] = '\0';
*data += len;
*size -= len;
return str;
}

int LLVMFuzzerInitialize(int *argc, char ***argv) {
if (getenv("NETSNMP_DEBUGGING") != NULL) {
snmp_enable_stderrlog();
snmp_set_do_debugging(1);
debug_register_tokens("");
}

netsnmp_ds_set_string(NETSNMP_DS_APPLICATION_ID,
NETSNMP_DS_AGENT_INTERNAL_SECNAME, "initial");

init_agent("fuzzer");

init_snmp("fuzzer");

u_char eID[SNMP_MAXBUF_SMALL];
size_t elen = snmpv3_get_engineID(eID, sizeof(eID));
netsnmp_session *s = netsnmp_query_get_default_session_unchecked();
if (s && s->securityEngineIDLen == 0 && elen > 0) {
s->securityEngineID = netsnmp_memdup(eID, elen);
s->securityEngineIDLen = elen;
}

return 0;
}

int netsnmp_query_set(netsnmp_variable_list *, netsnmp_session *);

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < 16) {
return 0;
}

char *secName = consume_string(&data, &size, 8);
if (!secName) {
return 0;
}

netsnmp_session *session = netsnmp_iquery_user_session(secName);
free(secName);

if (!session) {
return 0;
}

netsnmp_pdu *pdu = snmp_pdu_create(SNMP_MSG_SET);
if (!pdu) {
snmp_close(session);
return 0;
}

oid name[] = {1, 3, 6, 1, 2, 1, 1, 1, 0};
size_t name_length = OID_LENGTH(name);

char type = (char)data[0];
data++;
size--;

char *value = NULL;
if (size > 0) {
value = (char*)malloc(size + 1);
if (value) {
memcpy(value, data, size);
value[size] = '\0';
}
}

if (value) {
snmp_add_var(pdu, name, name_length, type, value);
free(value);
}

if (pdu->variables) {
netsnmp_query_set(pdu->variables, session);
}

snmp_free_pdu(pdu);
snmp_close(session);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: net-snmp
function signature: int netsnmp_query_set(netsnmp_variable_list *, netsnmp_session *)
</input>

<description>
The `netsnmp_query_set` function is used to send an SNMP SET request. It takes a `netsnmp_variable_list` containing the OIDs and values to be set, and a `netsnmp_session` representing the SNMP session to use for the request. The function returns an integer indicating the status of the request.
</description>

<requirements>

<requirement>
The first argument, `netsnmp_variable_list`, must not be NULL. This is to prevent a null pointer dereference in the `_query` function.
</requirement>
<requirement>
The `netsnmp_variable_list` must be a properly terminated linked list, with the `next_variable` member of the last element set to NULL. This is to prevent an infinite loop when the list is traversed.
</requirement>
<requirement>
The `netsnmp_variable_list` should be created by calling `snmp_pdu_create(SNMP_MSG_SET)` and then adding variables using `snmp_add_var`. This ensures that the list is correctly formatted for a SET request.
</requirement>
<requirement>
The second argument, `netsnmp_session`, must be a valid session object, or a default session must be set using `netsnmp_query_set_default_session`. This is because a valid session is required to send the SNMP request.
</requirement>
<requirement>
A valid `netsnmp_session` can be created using `netsnmp_iquery_user_session`, which takes a security name as an argument. The security name can be obtained using `netsnmp_ds_get_string`.
</requirement>

</requirements>

</function-requirements>

