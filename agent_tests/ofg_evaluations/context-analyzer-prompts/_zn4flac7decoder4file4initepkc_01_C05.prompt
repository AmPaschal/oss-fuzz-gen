<fuzz-target>
/* fuzzer_seek
* Copyright (C) 2022-2025  Xiph.Org Foundation
*
* This is a fuzzer for the FLAC::Decoder::File::init(const char *) function.
*
* Redistribution and use in source and binary forms, with or without
* modification, are permitted provided that the following conditions
* are met:
*
* - Redistributions of source code must retain the above copyright
* notice, this list of conditions and the following disclaimer.
*
* - Redistributions in binary form must reproduce the above copyright
* notice, this list of conditions and the following disclaimer in the
* documentation and/or other materials provided with the distribution.
*
* - Neither the name of the Xiph.org Foundation nor the names of its
* contributors may be used to endorse or promote products derived from
* this software without specific prior written permission.
*
* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS
* ``AS IS'' AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT
* LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR
* A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO EVENT SHALL THE FOUNDATION OR
* CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL,
* EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
* PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR
* PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF
* LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING
* NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS
* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
*/

#include "FLAC++/decoder.h"
#include <cstdint>
#include <cstdio>
#include <vector>
#include <climits>
#include "fuzzer/FuzzedDataProvider.h"

// Provide definitions for the allocation checking variables with C linkage.
// These are referenced by libFLAC when compiled for fuzzing but are not defined
// in the library itself, causing linker errors.
extern "C" {
int alloc_check_threshold = INT32_MAX;
int alloc_check_counter = 0;
int alloc_check_keep_failing = 0;
}

// A derived class is needed to implement the pure virtual callbacks from
// the base class FLAC::Decoder::Stream.
class FuzzDecoder : public FLAC::Decoder::File {
public:
FuzzedDataProvider *provider = nullptr;
FuzzDecoder() = default;
~FuzzDecoder() = default;

protected:
// This is called when the decoder has a chunk of decoded audio.
::FLAC__StreamDecoderWriteStatus
write_callback(const ::FLAC__Frame *frame,
const FLAC__int32 *const buffer[]) override {
(void)frame;
(void)buffer;
// Let the fuzzer decide whether to continue or abort, to test both paths.
if (provider && provider->ConsumeBool()) {
return FLAC__STREAM_DECODER_WRITE_STATUS_ABORT;
}
return FLAC__STREAM_DECODER_WRITE_STATUS_CONTINUE;
}

// This is called when the decoder has decoded a metadata block.
void metadata_callback(const ::FLAC__StreamMetadata *metadata) override {
(void)metadata;
// We don't need to do anything with the metadata.
}

// This is called when the decoder encounters an error.
void error_callback(::FLAC__StreamDecoderErrorStatus status) override {
(void)status;
// We don't need to do anything special on error.
}
};

// A minimal, valid FLAC file header.
// This consists of:
// 1. The 'fLaC' marker (4 bytes).
// 2. A metadata block header for STREAMINFO (4 bytes):
//    - 0x80: is_last_block=1, block_type=0 (STREAMINFO)
//    - 0x000022: length of block = 34 bytes
// 3. A 34-byte STREAMINFO block with some default values.
static const uint8_t valid_flac_header[] = {
'f', 'L', 'a', 'C',
0x80, 0x00, 0x00, 0x22,
0x10, 0x00, 0x10, 0x00,
0x00, 0x00, 0x00, 0x00,
0x00, 0x00, 0x00, 0x00,
0x00, 0x00, 0x00, 0x00,
0x00, 0xAC, 0x44, 0x00,
0x00, 0x00, 0x00, 0x00,
0x00, 0x00, 0x00, 0x00,
0x00, 0x00, 0x00, 0x00,
0x00, 0x00
};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
FuzzedDataProvider provider(data, size);
FuzzDecoder decoder;
decoder.provider = &provider;

// Set allocation failure options from fuzzer data
alloc_check_threshold = provider.ConsumeIntegralInRange<int>(0, 100);
alloc_check_keep_failing = provider.ConsumeBool();
alloc_check_counter = 0; // Reset for each run

// Consume configuration settings from the fuzzer data first and store them.
// These will be applied *after* the decoder is successfully initialized.
const bool md5_checking = provider.ConsumeBool();
const uint8_t metadata_choice = provider.ConsumeIntegralInRange<uint8_t>(0, 3);
std::vector<uint8_t> id;
if (metadata_choice == 2) {
id = provider.ConsumeBytes<uint8_t>(4);
}
const bool decode_chained_stream = provider.ConsumeBool();
const bool is_ogg = provider.ConsumeBool();


// Use the rest of the data for the file content.
std::vector<uint8_t> file_content = provider.ConsumeRemainingBytes<uint8_t>();

const char *tmp_filename = "/tmp/fuzz.flac";
FILE *fp = fopen(tmp_filename, "wb");
if (!fp) {
return 0;
}
fwrite(valid_flac_header, 1, sizeof(valid_flac_header), fp);
fwrite(file_content.data(), 1, file_content.size(), fp);
fclose(fp);

// Now, initialize the decoder.
if (is_ogg) {
decoder.init_ogg(tmp_filename);
} else {
decoder.init(tmp_filename);
}

// If initialization failed, we can't do anything else.
if (decoder.get_state() == FLAC__STREAM_DECODER_UNINITIALIZED) {
remove(tmp_filename);
return 0;
}

// Now that the decoder is initialized, apply the settings.
decoder.set_md5_checking(md5_checking);

switch (metadata_choice) {
case 0:
decoder.set_metadata_respond(FLAC__METADATA_TYPE_STREAMINFO);
break;
case 1:
decoder.set_metadata_respond(FLAC__METADATA_TYPE_VORBIS_COMMENT);
break;
case 2:
if (id.size() == 4) {
decoder.set_metadata_respond_application(id.data());
}
break;
case 3:
decoder.set_metadata_respond_all();
break;
}

decoder.set_decode_chained_stream(decode_chained_stream);

// Use a limited loop to test state transitions.
int max_actions = provider.ConsumeIntegralInRange<int>(1, 20);
for (int i = 0; i < max_actions; ++i) {
FLAC__StreamDecoderState state = decoder.get_state();
if (state == FLAC__STREAM_DECODER_END_OF_STREAM ||
state == FLAC__STREAM_DECODER_ABORTED) {
break;
}

switch (provider.ConsumeIntegralInRange<uint8_t>(0, 4)) {
case 0:
decoder.process_single();
break;
case 1:
decoder.process_until_end_of_metadata();
break;
case 2:
{
FLAC__uint64 seek_pos = provider.ConsumeIntegral<FLAC__uint64>();
decoder.seek_absolute(seek_pos);
}
break;
case 3:
if (is_ogg) {
decoder.process_until_end_of_link();
} else {
decoder.process_single();
}
break;
case 4:
decoder.process_until_end_of_stream();
break;
}
}

remove(tmp_filename);
return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: flac
function signature: FLAC__StreamDecoderInitStatus FLAC::Decoder::File::init(const char *)
</input>

<description>
The `FLAC::Decoder::File::init` function initializes a FLAC stream decoder for decoding a file. It acts as a wrapper around the C API function `FLAC__stream_decoder_init_file`. The function takes a single argument, `filename`, which is a path to the file to be decoded. It uses internal file handling callbacks to read from the specified file. Successful execution requires that the `FLAC::Decoder::File` object is correctly constructed, with an initialized `decoder_` member and properly set callback functions.
</description>

<requirements>
<requirement>
A `FLAC::Decoder::File` object must be instantiated before calling this function. This is necessary because the function relies on the object's internal state, such as the `decoder_` and callback members.
</requirement>
<requirement>
The `decoder_` member of the `FLAC::Decoder::File` object must be initialized, typically by calling `FLAC__stream_decoder_new()` in the constructor. The function asserts that `decoder_` is not null, and the underlying implementation requires it to be in an uninitialized state.
</requirement>
<requirement>
The `filename` argument must be a null-terminated string representing a valid path to a readable file. This file will be opened in binary read mode (`"rb"`) and its contents will be decoded as a FLAC stream.
</requirement>
<requirement>
The `write_callback_` and `error_callback_` members of the `FLAC::Decoder::File` object must be set to valid, non-NULL function pointers. These callbacks are essential for handling the decoded audio data and any errors that occur during the decoding process, and the underlying implementation checks for their validity.
</requirement>
<requirement>
If metadata processing is required, the `metadata_callback_` member must be set to a valid function pointer. While not strictly necessary for the initialization to succeed, this callback is needed to process any metadata present in the FLAC stream.
</requirement>
</requirements>

</function-requirements>

