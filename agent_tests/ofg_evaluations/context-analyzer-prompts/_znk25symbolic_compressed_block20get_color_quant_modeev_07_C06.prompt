#include "/src/astc-encoder/Source/astcenc_internal.h"
#include <fuzzer/FuzzedDataProvider.h>
#include <vector>
#include <array>
#include <cstring>

struct BlockSizes {
int x;
int y;
int z;
};

// A set of representative block sizes to test against
std::array<BlockSizes, 3> testSz{{
{4, 4, 1},   // Highest bitrate
{12, 12, 1}, // Largest 2D block
{6, 6, 6}    // Largest 3D block
}};

std::array<block_size_descriptor, 3> testBSD;

// Initialize the block size descriptors once to avoid recomputing them
// for every fuzzing iteration, which is very slow.
bool bsd_initializer() {
for (size_t i = 0; i < testSz.size(); i++) {
// Zero-initialize the struct to ensure no garbage data/pointers
memset(&testBSD[i], 0, sizeof(block_size_descriptor));
init_block_size_descriptor(testSz[i].x, testSz[i].y, testSz[i].z, false, 4, 1.0f, testBSD[i]);
}
return true;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
// Initialize BSDs once
static bool init = bsd_initializer();

FuzzedDataProvider stream(data, size);

// We need enough data to select a BSD and populate the physical block
if (size < 1 + 16) {
return 0;
}

// Select a block size descriptor to use for this run
int bsd_index = stream.ConsumeIntegralInRange<int>(0, (int)testSz.size() - 1);
const block_size_descriptor& bsd = testBSD[bsd_index];

// Fuzz the physical compressed block (pcb)
uint8_t pcb[16];
stream.ConsumeData(pcb, sizeof(pcb));

// Convert the fuzzed physical block to a symbolic block.
// This ensures that the scb is always valid and internally consistent,
// which prevents the crash in symbolic_to_physical.
symbolic_compressed_block scb;
physical_to_symbolic(bsd, pcb, scb);

// This is the buffer for the output of symbolic_to_physical
uint8_t pcb_out[16];

// Call symbolic_to_physical. This is a non-inlined function that
// internally calls scb.get_color_quant_mode(), creating an implicit
// and non-optimizable call to our target function.
// We are now calling it with a guaranteed-valid scb.
symbolic_to_physical(bsd, scb, pcb_out);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: astc-encoder
function signature: quant_method symbolic_compressed_block::get_color_quant_mode(const struct symbolic_compressed_block *)
</input>

<description>
The function `get_color_quant_mode` is an inline function that returns the `quant_mode` member of the `symbolic_compressed_block` struct. The `quant_mode` member is of type `quant_method`, which is an enum.
</description>

<requirements>
<requirement>
The `symbolic_compressed_block` input should be initialized. This is because the function accesses the `quant_mode` member of this struct.
</requirement>
<requirement>
The `quant_mode` member of the `symbolic_compressed_block` struct should be initialized to one of the values in the `quant_method` enum. This is because the return value of the function is used as an index into arrays, and an invalid value could lead to out-of-bounds access.
</requirement>
</requirements>

</function-requirements>

