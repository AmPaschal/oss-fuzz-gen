////////////////////////////////////////////////////////////////////////////////

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include "/src/inih/ini.h"

#define kMinInputLength 8
#define kMaxInputLength 512

int User;
char Prev_section[50];

int dumper(void* user, const char* section, const char* name,
const char* value)
{
User = *((int*)user);
if (strcmp(section, Prev_section)) {
strncpy(Prev_section, section, sizeof(Prev_section));
Prev_section[sizeof(Prev_section) - 1] = '\0';
}
return 1;
}

extern int
LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
{
static int u = 100;
FILE *file;

if (size < kMinInputLength || size > kMaxInputLength) {
return 0;
}

Prev_section[0] = '\0';

// Create an in-memory file stream from the fuzzer's data buffer.
// fmemopen requires a non-const pointer, so we cast.
file = fmemopen((void*)data, size, "r");
if (!file) {
return 0;
}

// Call the function under test.
ini_parse_file(file, dumper, &u);

// Clean up the file stream.
fclose(file);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: inih
function signature: int ini_parse_file(FILE* file, ini_handler handler, void* user)
</input>

<description>
The `ini_parse_file` function parses an INI file from a given file stream. It reads the file line by line, and for each section and name-value pair, it calls a user-provided handler function. The handler receives the section, name, and value, and can also be passed a user-defined pointer for custom data handling. The function is a wrapper around `ini_parse_stream`, providing `fgets` as the reader function.
</description>

<requirements>

<requirement>
The first argument `file` must be a valid file pointer that is opened in read mode. This is because the function reads from the file stream using `fgets`.
</requirement>
<requirement>
The `handler` function pointer must not be NULL. The function will crash if it's NULL because it's dereferenced without a prior null check.
</requirement>
<requirement>
The third argument `user` is a pointer to user-defined data that will be passed to the handler function. It can be NULL if the handler does not require any user-specific data.
</requirement>
<requirement>
The handler function must match the `ini_handler` typedef, which is `int (*)(void*, const char*, const char*, const char*)`. The handler should return 1 to continue parsing, and 0 to stop parsing and indicate an error.
</requirement>

</requirements>

</function-requirements>

