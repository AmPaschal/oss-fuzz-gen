* along with this program.  If not, see <http://www.gnu.org/licenses/>.
*/

#include "cppcheck.h"
#include "errorlogger.h"
#include "errortypes.h"
#include "filesettings.h"
#include "settings.h"
#include "suppressions.h"

#include <string>

#ifndef NO_FUZZ
#include <cstddef>
#include <cstdint>

#else
#include <cstdlib>
#include <fstream>
#include <sstream>
#endif

class DummyErrorLogger : public ErrorLogger {
public:
void reportOut(const std::string& /*outmsg*/, Color /*c*/) override {}
void reportErr(const ErrorMessage& /*msg*/) override {}
void reportProgress(const std::string& /*filename*/,
const char /*stage*/[],
const std::size_t /*value*/) override {}
void reportMetric(const std::string & /*metric*/) override {}
};

static Settings create_settings()
{
Settings s;
s.templateFormat = "{bold}{file}:{line}:{column}: {red}{inconclusive:{magenta}}{severity}:{inconclusive: inconclusive:}{default} {message} [{id}]{reset}\\n{code}";
s.templateLocation = "{bold}{file}:{line}:{column}: {dim}note:{reset} {info}\\n{code}";
s.addEnabled("all");
s.certainty.setEnabled(Certainty::inconclusive, true);
s.standards.cpp = Standards::CPP20;
return s;
}
static const Settings s_settings = create_settings();
static DummyErrorLogger s_errorLogger;
static const FileWithDetails s_file("test.cpp", Standards::Language::CPP, 0);

static void doCheck(const std::string& code)
{
Suppressions supprs;
CppCheck cppcheck(s_settings, supprs, s_errorLogger, false, nullptr);
cppcheck.check(s_file, code);
}

#ifndef NO_FUZZ
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t dataSize);

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t dataSize)
{
// The doCheck function performs a full analysis, which includes
// tokenization, simplification, and calling TemplateSimplifier::simplifyTemplates.
// This is the most reliable way to exercise the target function.
const std::string code(reinterpret_cast<const char*>(data), dataSize);
doCheck(code);
return 0;
}
#else
int main(int argc, char * argv[])
{
if (argc < 2 || argc > 3)
return EXIT_FAILURE;

std::ifstream f(argv[1]);
if (!f.is_open())
return EXIT_FAILURE;

std::ostringstream oss;
oss << f.rdbuf();

if (!f.good())
return EXIT_FAILURE;

const int cnt = (argc == 3) ? std::stoi(argv[2]) : 1;

const std::string code = oss.str();
for (int i = 0; i < cnt; ++i)
doCheck(code);

return EXIT_SUCCESS;
}
#endif
</fuzz-target>

<function-requirements>

<input>
project name: cppcheck
function signature: void TemplateSimplifier::simplifyTemplates(const time_t)
</input>

<description>
The `simplifyTemplates` function is a core component of the Cppcheck static analysis tool. Its primary purpose is to simplify C++ template code to make it easier to analyze for bugs. It operates on a token list representing the source code and performs multiple passes to expand template instantiations, resolve type aliases, and simplify various C++ constructs. The function is designed to handle complex template metaprogramming scenarios and has a timeout mechanism to prevent excessively long-running simplifications. The simplification process is highly dependent on the initial state of the `Tokenizer` and `TokenList`, which must be properly configured with the source code and settings before this function is called.
</description>

<requirements>

<requirement>
A `Settings` object must be created and configured. This is because the `simplifyTemplates` function uses settings such as the C++ standard to enable or disable certain simplifications.
</requirement>
<requirement>
An `ErrorLogger` object must be created, initialized with the `Settings` object. This is because the `simplifyTemplates` function uses the error logger to report warnings and debug messages.
</requirement>
<requirement>
A `TokenList` object must be created and populated with tokens from a C++ source code string. This is the primary input to the `simplifyTemplates` function, which operates on this token list.
</requirement>
<requirement>
A `Tokenizer` object must be created, initialized with the `TokenList` and `ErrorLogger`. The `TemplateSimplifier` is initialized with this `Tokenizer` and relies on it for context and further simplification steps.
</requirement>
<requirement>
The `maxtime` argument should be a `time_t` value representing a future timestamp. This is used as a timeout to prevent the template simplification process from running indefinitely on complex code.
</requirement>

</requirements>

</function-requirements>

