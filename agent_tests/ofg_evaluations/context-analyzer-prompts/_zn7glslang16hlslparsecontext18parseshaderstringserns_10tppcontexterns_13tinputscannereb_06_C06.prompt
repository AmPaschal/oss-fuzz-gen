<fuzz-target>
#include <fuzzer/FuzzedDataProvider.h>

#include "glslang/Public/ResourceLimits.h"
#include "glslang/Public/ShaderLang.h"
#include "/src/glslang/glslang/MachineIndependent/ParseHelper.h"
#include "/src/glslang/glslang/HLSL/hlslParseHelper.h"
#include "/src/glslang/glslang/MachineIndependent/preprocessor/PpContext.h"
#include "/src/glslang/glslang/MachineIndependent/Scan.h"
#include "glslang/HLSL/hlslParseables.h"

// A simple helper to construct a more valid shader
std::string CreateShader(FuzzedDataProvider& provider, std::string& entryPoint) {
entryPoint = provider.ConsumeBytesAsString(provider.ConsumeIntegralInRange<uint8_t>(1, 32));
if (entryPoint.empty()) {
entryPoint = "main";
}

// Use a simple template to guide the fuzzer.
// Avoid generating structs to prevent a known use-after-free bug in the parser.
std::string shader = "";

const char* type = provider.PickValueInArray({"float4", "int", "float", "bool2"});

bool add_buffer = provider.ConsumeBool();
if (add_buffer) {
shader += provider.PickValueInArray({"cbuffer", "tbuffer"});
shader += " b { " + std::string(type) + " x; };\n";
}

shader += std::string(type) + " " + entryPoint + "() : SV_Target {\n";

if (add_buffer) {
shader += "  " + std::string(type) + " y = x;\n";
} else {
shader += "  " + std::string(type) + " y = (" + std::string(type) + ")0;\n";
}

shader += provider.ConsumeRemainingBytesAsString();
shader += "\n  return y;\n}\n";

return shader;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
FuzzedDataProvider provider(data, size);

glslang::InitializeProcess();

const EShLanguage language = provider.PickValueInArray(
{EShLangVertex, EShLangFragment, EShLangTessControl, EShLangTessEvaluation,
EShLangGeometry, EShLangCompute});

const TBuiltInResource* resources = GetDefaultResources();
glslang::TBuiltInParseablesHlsl builtins;
glslang::SpvVersion spvVersion;

builtins.initialize(*resources, 450, ENoProfile, spvVersion, language);

glslang::TSymbolTable symbolTable;
symbolTable.push(); // Create the first scope level before using the table.
builtins.identifyBuiltIns(450, ENoProfile, spvVersion, language, symbolTable, *resources);

TInfoSink infoSink;
glslang::TIntermediate intermediate(language);

EShMessages messages = static_cast<EShMessages>(provider.ConsumeIntegral<uint32_t>());

std::string entryPoint;
const std::string shader_string = CreateShader(provider, entryPoint);

glslang::HlslParseContext parseContext(
symbolTable, intermediate, true, 450, ENoProfile, spvVersion, language,
infoSink, entryPoint.c_str(), provider.ConsumeBool(), messages);

parseContext.initializeExtensionBehavior();

const char *shader_strings[] = {shader_string.c_str()};
size_t shader_lengths[] = {shader_string.length()};
const char* shader_names[] = {"fuzzer.hlsl"};

glslang::TInputScanner inputScanner(1, shader_strings, shader_lengths, shader_names);

glslang::TShader::ForbidIncluder includer;
glslang::TPpContext ppContext(parseContext, "fuzzer.hlsl", includer);

bool versionWillBeError = provider.ConsumeBool();

parseContext.parseShaderStrings(ppContext, inputScanner, versionWillBeError);

glslang::FinalizeProcess();
return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: glslang
function signature: bool glslang::HlslParseContext::parseShaderStrings(TPpContext &, TInputScanner &, bool)
</input>

<description>
The function `HlslParseContext::parseShaderStrings` is responsible for parsing HLSL shader strings. It takes a preprocessor context (`TPpContext`), an input scanner (`TInputScanner`), and a boolean flag `versionWillBeError` as input. The function sets the input for the preprocessor context, creates a scanning context and a grammar parser, and then parses the shader strings. It records any errors encountered during parsing and returns true if parsing is successful (no errors) and false otherwise. The callers of this function are responsible for initializing the `TPpContext` and `TInputScanner` objects with the shader source code and relevant options.
</description>

<requirements>
<requirement>
The `TPpContext` object should be initialized with the shader source code. This is because the function uses the `TPpContext` to perform preprocessing tasks on the shader source.
</requirement>
<requirement>
The `TInputScanner` object must be initialized with the shader source code. This is because the `TInputScanner` is used to feed the source code to the parser.
</requirement>
<requirement>
The `HlslParseContext::initialize` method must be called before calling `parseShaderStrings`. This is because `initialize` sets up the necessary parsing context and symbol table.
</requirement>
</requirements>

</function-requirements>

