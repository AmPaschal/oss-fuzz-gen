See the License for the specific language governing permissions and
limitations under the License.
*/

#define FUSE_USE_VERSION 31

#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fuse.h>
#include <stddef.h>
#include <fuzzer/FuzzedDataProvider.h>

#include <string>
#include <vector>

#define MAX_OPTS 5
#define MAX_STR_LEN 64

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
FuzzedDataProvider provider(data, size);

if (provider.remaining_bytes() < 10) {
return 0;
}

// Create the options array.
struct fuse_opt opts[MAX_OPTS + 1];
std::vector<std::string> templates(MAX_OPTS);
for (int i = 0; i < MAX_OPTS; i++) {
templates[i] = provider.ConsumeRandomLengthString(MAX_STR_LEN);
opts[i].templ = templates[i].c_str();
opts[i].offset = provider.ConsumeIntegral<unsigned long>();
opts[i].value = provider.ConsumeIntegral<int>();
}
// The array must be terminated by an element with a NULL template.
opts[MAX_OPTS].templ = NULL;
opts[MAX_OPTS].offset = 0;
opts[MAX_OPTS].value = 0;

// Pick one of the generated templates to be the base for our match.
int target_opt_idx = provider.ConsumeIntegralInRange<int>(0, MAX_OPTS - 1);

std::string base_template = provider.ConsumeRandomLengthString(MAX_STR_LEN / 2);
if (base_template.empty()) {
// Test with an empty option string if the base is empty.
fuse_opt_match(opts, "");
return 0;
}

std::string opt_to_match_str;
std::string final_template;

// Decide which matching strategy to use.
int strategy = provider.ConsumeIntegralInRange<int>(0, 5);
switch (strategy) {
case 0: { // Exact match
final_template = base_template;
opt_to_match_str = base_template;
break;
}
case 1: { // Valid prefix match with '=' (e.g., "templ=", "templ=%s")
if (provider.ConsumeBool()) {
final_template = base_template + "=%s";
} else {
final_template = base_template + "=";
}
opt_to_match_str = base_template + "=" + provider.ConsumeRandomLengthString(MAX_STR_LEN / 2);
break;
}
case 2: { // Valid prefix match with ' ' (e.g., "templ ", "templ %s")
if (provider.ConsumeBool()) {
final_template = base_template + " %s";
} else {
final_template = base_template + " ";
}
opt_to_match_str = base_template;
break;
}
case 3: { // Invalid prefix match (e.g., "templ=foo", "templ s")
// This should fall back to strcmp and fail to match.
if (provider.ConsumeBool()) {
final_template = base_template + "=invalid";
} else {
final_template = base_template + " invalid";
}
opt_to_match_str = base_template;
break;
}
case 4: { // Edge case: argument is a prefix of the template's prefix
// (arglen < tlen), should not match.
final_template = base_template + "suffix=";
opt_to_match_str = base_template;
break;
}
case 5: { // Separator precedence: space only when no equals sign exists.
final_template = base_template + " %s"; // No '=' in template
opt_to_match_str = base_template;
break;
}
}

// Set the chosen template in the opts array.
templates[target_opt_idx] = final_template;
opts[target_opt_idx].templ = templates[target_opt_idx].c_str();

// Call the function under test with the crafted option.
fuse_opt_match(opts, opt_to_match_str.c_str());

// Also test a non-matching case with remaining data.
if (provider.remaining_bytes() > 0) {
std::string non_matching_opt = provider.ConsumeRemainingBytesAsString();
if (!non_matching_opt.empty()) {
fuse_opt_match(opts, non_matching_opt.c_str());
}
}

// Test with a NULL option string
fuse_opt_match(opts, NULL);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: libfuse
function signature: int fuse_opt_match(const struct fuse_opt *, const char *)
</input>

<description>
The `fuse_opt_match` function checks if a given command-line option string matches any of the option templates provided in an array. It takes two arguments: `opts`, which is a `NULL`-terminated array of `struct fuse_opt`, and `opt`, a string representing the option to check. The function iterates through the `opts` array, using the `templ` field of each `struct fuse_opt` as a pattern. It calls the internal `match_template` function to perform the actual comparison between the input `opt` string and the template string. It returns 1 if a match is found and 0 otherwise. The function is designed as a public API utility for applications using `libfuse` to pre-validate options.
</description>

<requirements>
<requirement>
The `opts` argument must be a pointer to an array of `struct fuse_opt` that is terminated by an element where the `templ` member is `NULL`.
This is because the function iterates through the array and uses the `NULL` template as a sentinel to stop, preventing out-of-bounds reads.
</requirement>
<requirement>
The `templ` member of each `struct fuse_opt` in the `opts` array must be a valid, null-terminated string.
This is necessary to prevent crashes inside the internal `match_template` function, which uses string operations like `strchr` and `strcmp`.
</requirement>
<requirement>
The `opt` argument must be a valid, null-terminated string.
This is because it is passed directly to `strlen` and `strcmp` within the `match_template` function, which will cause a segmentation fault if the pointer is `NULL`.
</requirement>
</requirements>

</function-requirements>

