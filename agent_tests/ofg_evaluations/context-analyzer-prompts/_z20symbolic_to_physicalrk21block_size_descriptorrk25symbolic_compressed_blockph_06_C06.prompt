#include "/src/astc-encoder/Source/astcenc_internal.h"
#include <fuzzer/FuzzedDataProvider.h>
#include <array>
#include <vector>
#include <cstring>

struct BlockSizes
{
int x;
int y;
int z;
};

std::array<BlockSizes, 3> testSz {{
{ 4,  4, 1}, // Highest bitrate
{12, 12, 1}, // Largest 2D block
{6,  6,  6}  // Largest 3D block
}};

std::array<block_size_descriptor, 3> testBSD;

/**
* @brief Utility function to create all of the block size descriptors needed.
*/
bool bsd_initializer()
{
for (size_t i = 0; i < testSz.size(); i++)
{
init_block_size_descriptor(
testSz[i].x,
testSz[i].y,
testSz[i].z,
false,
4,
1.0f,
testBSD[i]);
}

return true;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
{
// Preinitialize the block size descriptors we need
static bool init = bsd_initializer();

// Must have enough data to select a BSD
if (size < 1)
{
return 0;
}

FuzzedDataProvider stream(data, size);

// Select a block size to test
int bsd_idx = stream.ConsumeIntegralInRange<int>(0, (int)testSz.size() - 1);
const block_size_descriptor& bsd = testBSD[bsd_idx];

// Create and populate the symbolic block
symbolic_compressed_block scb;
std::memset(&scb, 0, sizeof(scb));

// Choose a block type, avoiding the error type
scb.block_type = stream.PickValueInArray<uint8_t>({SYM_BTYPE_CONST_U16, SYM_BTYPE_CONST_F16, SYM_BTYPE_NONCONST});

if (scb.block_type == SYM_BTYPE_CONST_U16 || scb.block_type == SYM_BTYPE_CONST_F16)
{
for (int i = 0; i < BLOCK_MAX_COMPONENTS; i++)
{
scb.constant_color[i] = stream.ConsumeIntegral<uint16_t>();
}
}
else
{
// Create a list of valid block modes
std::vector<uint16_t> valid_modes;
for (uint16_t i = 0; i < WEIGHTS_MAX_BLOCK_MODES; ++i)
{
if (bsd.block_mode_packed_index[i] != BLOCK_BAD_BLOCK_MODE)
{
const auto& bm = bsd.get_block_mode(i);
if (bm.decimation_mode < bsd.decimation_mode_count_all)
{
valid_modes.push_back(i);
}
}
}

// If there are no valid modes, we can't proceed
if (valid_modes.empty())
{
return 0;
}

// Pick a valid block mode from the list
size_t mode_idx = stream.ConsumeIntegralInRange<size_t>(0, valid_modes.size() - 1);
scb.block_mode = valid_modes[mode_idx];

// Then, determine the partition count from the selected block mode
const auto& bm = bsd.get_block_mode(scb.block_mode);
uint16_t raw_block_mode = bm.mode_index;
int part_raw = (raw_block_mode >> 1) & 0x3;
scb.partition_count = bsd.partitionings[part_raw].partition_count;

// Generate a quant_mode that is >= QUANT_6 to prevent out-of-bounds access
scb.quant_mode = (quant_method)stream.ConsumeIntegralInRange<int>(QUANT_6, QUANT_256);
scb.color_formats_matched = stream.ConsumeBool();

if (scb.partition_count > 1)
{
scb.partition_index = stream.ConsumeIntegral<uint16_t>();
}

if (bm.is_dual_plane)
{
scb.plane2_component = stream.ConsumeIntegralInRange<int8_t>(0, 3);
}
else
{
scb.plane2_component = -1;
}

unsigned int quant_limit = get_quant_level(scb.quant_mode);
if (quant_limit == 0)
{
return 0;
}

for (unsigned int i = 0; i < scb.partition_count; i++)
{
// Constrain color_formats to [0, 15] to prevent assert
scb.color_formats[i] = stream.ConsumeIntegralInRange<uint8_t>(0, 15);

// Determine how many values to generate for this format
int vals = 2 * (scb.color_formats[i] >> 2) + 2;

// Constrain color_values to valid quant range
for (int j = 0; j < vals; j++)
{
scb.color_values[i][j] = stream.ConsumeIntegralInRange<uint8_t>(0, quant_limit - 1);
}
}

// Add a check to ensure the generated symbolic block is valid and fits in 128 bits
unsigned int bits_used = 11; // Base bits for block mode
if (scb.partition_count > 1)
{
bits_used += 10; // Bits for partition index
}

bits_used += 15; // Pessimistic upper bound for color endpoint mode bits
bits_used += bm.weight_bits;

for (unsigned int i = 0; i < scb.partition_count; i++)
{
unsigned int endpoint_count = 2 * (scb.color_formats[i] >> 2) + 2;
bits_used += get_ise_sequence_bitcount(endpoint_count, scb.quant_mode);
}

if (bits_used > 128)
{
return 0;
}

stream.ConsumeData(scb.weights, sizeof(scb.weights));
}

// Output buffer for the physical block
uint8_t pcb[16];

// Call the function under test
symbolic_to_physical(bsd, scb, pcb);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: astc-encoder
function signature: void symbolic_to_physical(const struct block_size_descriptor &, const struct symbolic_compressed_block &, uint8_t *)
</input>

<description>
The `symbolic_to_physical` function is responsible for converting a symbolic representation of a compressed block, held in a `symbolic_compressed_block` struct, into a physical ASTC block, which is a 16-byte array. The process is guided by the `block_size_descriptor` struct, which provides context about the block's dimensions and available encoding modes. The function's behavior changes based on the `block_type` field of the symbolic block. For constant color blocks (`SYM_BTYPE_CONST_U16` or `SYM_BTYPE_CONST_F16`), the function performs a simple copy of the color data. For other block types, it undertakes a complex encoding process involving quantization and bit-packing of weights, partition information, color endpoint formats, and color endpoint values into the 16-byte physical block.
</description>

<requirements>

<requirement>
The `block_size_descriptor` argument `bsd` must be initialized by calling the `init_block_size_descriptor` function. This is because the `bsd` struct contains essential data like block dimensions and mode information that is used throughout the conversion process.
</requirement>
<requirement>
The `scb.block_type` field must not be equal to `SYM_BTYPE_ERROR`. This is enforced by an assertion at the beginning of the function to prevent processing of invalid blocks.
</requirement>
<requirement>
If `scb.block_type` is `SYM_BTYPE_CONST_U16` or `SYM_BTYPE_CONST_F16`, the `scb.constant_color` array must contain valid color data. This is because these values are directly copied into the output physical block.
</requirement>
<requirement>
The `scb.block_mode` must be a valid index for the block modes stored in the `bsd`. The function uses this mode to fetch block mode details, and an invalid index will lead to an out-of-bounds access.
</requirement>
<requirement>
The `scb.quant_mode` must be a value greater than or equal to `QUANT_6`. This is because the function calculates an index into `color_uquant_to_scrambled_pquant_tables` by subtracting `QUANT_6`, and a smaller value would lead to a negative index.
</requirement>
<requirement>
The values in the `scb.color_values` array must be valid indices for the `pack_table`. An out-of-bounds value will lead to an out-of-bounds read when accessing the `pack_table`.
</requirement>
<requirement>
The `pcb` argument must be a pointer to a writable buffer of at least 16 bytes. The function writes 16 bytes of data into this buffer, which represents the physical ASTC block.
</requirement>

</requirements>

</function-requirements>

