<fuzz-target>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <vector>
#include <string>
#include <algorithm>
#include <stdio.h>

// Wrap C headers in extern "C" for C++ compatibility
extern "C" {
#include "Str.h"
#include "wc.h"
#include "wtf.h"
#include <gc.h>
}

#include <fuzzer/FuzzedDataProvider.h>

static void *die_oom(size_t bytes) {
fprintf(stderr, "Out of memory: %lu bytes unavailable!\n", (unsigned long)bytes);
exit(1);
}

// Helper to generate a string with potentially valid UTF-8 sequences.
// This is crucial for exercising multi-byte character handling code paths.
std::string GenerateUtf8String(FuzzedDataProvider &provider) {
// A small set of multi-byte UTF-8 characters and control characters.
// Use a C-style array to be compatible with FuzzedDataProvider::PickValueInArray.
static const char * const utf8_chars[] = {
"a", "b", "c", "1", "2", "3", " ", "\t", "\n", // ASCII
"ñ", "é", "ç", "ü", "ø", "å",                 // 2-byte
"€", "α", "β", "γ", "£", "λ",                 // 3-byte
"😂", "👍", "🚀", "🤔", "😊", "✅"              // 4-byte
};

std::string result;
// Consume up to a certain number of characters to build the string
size_t len = provider.ConsumeIntegralInRange<size_t>(0, 128);
for (size_t i = 0; i < len; ++i) {
result += provider.PickValueInArray(utf8_chars);
}
return result;
}

// Expanded helper function to exercise a wider range of Str operations
void fuzz_str_operations(Str s, FuzzedDataProvider &provider) {
if (!s || provider.remaining_bytes() < 10) {
return;
}

// Use a copy for manipulations to preserve the original for other operations
Str temp_s = Strdup(s);
if (!temp_s)
return;

// Loop and perform various operations based on fuzzer data
while (provider.remaining_bytes() > 10 && temp_s->length < 4096) {
// Pick an operation to perform
switch (provider.ConsumeIntegralInRange<uint8_t>(0, 15)) {
case 0: {
std::string random_str = provider.ConsumeRandomLengthString(100);
Strcat_charp(temp_s, random_str.c_str());
break;
}
case 1:
Strlower(temp_s);
break;
case 2:
Strupper(temp_s);
break;
case 3:
if (temp_s->length > 0) {
int offset = provider.ConsumeIntegralInRange<int>(0, temp_s->length - 1);
int len = provider.ConsumeIntegralInRange<int>(0, temp_s->length - offset);
Str s2 = Strsubstr(temp_s, offset, len);
Strfree(s2);
}
break;
case 4:
Strchop(temp_s);
break;
case 5:
if (temp_s->length > 0) {
int offset = provider.ConsumeIntegralInRange<int>(0, temp_s->length);
char c = provider.ConsumeIntegral<char>();
Strinsert_char(temp_s, offset, c);
}
break;
case 6:
Stralign_left(temp_s, temp_s->length + provider.ConsumeIntegralInRange<int>(1, 16));
break;
case 7:
Strremovetrailingspaces(temp_s);
break;
case 8:
Strremovefirstspaces(temp_s);
break;
case 9:
if (temp_s->length > 0) {
int offset = provider.ConsumeIntegralInRange<int>(0, temp_s->length);
std::string insert_str = provider.ConsumeRandomLengthString(50);
Strinsert_charp(temp_s, offset, insert_str.c_str());
}
break;
case 10:
if (temp_s->length > 1) {
int offset = provider.ConsumeIntegralInRange<int>(0, temp_s->length - 1);
int len = provider.ConsumeIntegralInRange<int>(1, temp_s->length - offset);
Strdelete(temp_s, offset, len);
}
break;
case 11:
if (temp_s->length > 0) {
int len = provider.ConsumeIntegralInRange<int>(0, temp_s->length);
Strtruncate(temp_s, len);
}
break;
case 12:
Stralign_right(temp_s, temp_s->length + provider.ConsumeIntegralInRange<int>(1, 16));
break;
case 13:
Stralign_center(temp_s, temp_s->length + provider.ConsumeIntegralInRange<int>(1, 16));
break;
case 14: {
Str s_copy = Strnew();
Strcopy(s_copy, temp_s);
Strfree(s_copy);
break;
}
case 15: {
std::string copy_str = provider.ConsumeRandomLengthString(100);
Strcopy_charp(temp_s, copy_str.c_str());
break;
}
}
}

Strfree(temp_s);
}

// Add extern "C" to prevent C++ name mangling for the fuzzer entry point.
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
static bool init_done = false;

if (!init_done) {
setenv("GC_LARGE_ALLOC_WARN_INTERVAL", "30000", 1);
GC_INIT();
#if (GC_VERSION_MAJOR > 7) || ((GC_VERSION_MAJOR == 7) && (GC_VERSION_MINOR >= 2))
GC_set_oom_fn(die_oom);
#else
GC_oom_fn = die_oom;
#endif
#ifdef USE_M17N
#ifdef USE_UNICODE
wtf_init(WC_CES_UTF_8, WC_CES_UTF_8);
#else
wtf_init(WC_CES_EUC_JP, WC_CES_EUC_JP);
#endif
#endif
init_done = true;
}

FuzzedDataProvider provider(data, size);

// Use a switch to select which major code path to fuzz.
uint8_t choice = provider.ConsumeIntegralInRange<uint8_t>(0, 2);

switch (choice) {
case 0: {
// Original path: Fuzz Strnew_m_charp and related functions.
std::string s1_str, s2_str, s3_str;
if (provider.ConsumeBool()) {
s1_str = GenerateUtf8String(provider);
s2_str = GenerateUtf8String(provider);
s3_str = GenerateUtf8String(provider);
} else {
s1_str = provider.ConsumeRandomLengthString(provider.ConsumeIntegralInRange<size_t>(0, size / 3));
s2_str = provider.ConsumeRandomLengthString(provider.ConsumeIntegralInRange<size_t>(0, size / 2));
s3_str = provider.ConsumeRemainingBytesAsString();
}
const char *str1 = s1_str.c_str();
const char *str2 = s2_str.c_str();
const char *str3 = s3_str.c_str();

Str s_one = Strnew_m_charp(str1, NULL);
fuzz_str_operations(s_one, provider);
Strfree(s_one);

Str s_two = Strnew_m_charp(str1, str2, NULL);
fuzz_str_operations(s_two, provider);
Strfree(s_two);

Str s_three = Strnew_m_charp(str1, str2, str3, NULL);
fuzz_str_operations(s_three, provider);
Strfree(s_three);
break;
}
case 1: {
// New path: Fuzz Sprintf.
if (provider.remaining_bytes() < 20) break;
// Use a fixed format string to prevent format string vulnerabilities.
const char* format_str = "%s %d %c %f";

std::string s_arg = GenerateUtf8String(provider);
// Add a reasonable length limit to avoid the known bug in Sprintf.
if (s_arg.length() > 1024) {
s_arg.resize(1024);
}
int i_arg = provider.ConsumeIntegral<int>();
char c_arg = provider.ConsumeIntegral<char>();
double d_arg = provider.ConsumeFloatingPoint<double>();

Str res = Sprintf((char*)format_str, s_arg.c_str(), i_arg, c_arg, d_arg);
if (res) {
fuzz_str_operations(res, provider);
Strfree(res);
}
break;
}
case 2: {
// New path: Fuzz Strfgets and Strfgetall.
if (provider.remaining_bytes() < 1) break;
std::vector<uint8_t> file_content = provider.ConsumeRemainingBytes<uint8_t>();

// fmemopen needs a non-const pointer.
FILE *f = fmemopen((void*)file_content.data(), file_content.size(), "r");
if (f) {
// Test Strfgets
Str s_fgets = Strfgets(f);
if (s_fgets) {
fuzz_str_operations(s_fgets, provider);
Strfree(s_fgets);
}

// Rewind the file stream to test Strfgetall with the same content.
rewind(f);

// Test Strfgetall
Str s_fgetall = Strfgetall(f);
if (s_fgetall) {
fuzz_str_operations(s_fgetall, provider);
Strfree(s_fgetall);
}
fclose(f);
}
break;
}
}

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: w3m
function signature: Str Strnew_m_charp(const char *, void)
</input>

<description>
The function `Str Strnew_m_charp(const char *, ...)` is a variadic function that creates a new `Str` object by concatenating a variable number of null-terminated strings. The function takes a variable number of `const char *` arguments and concatenates them in the order they are provided. The list of arguments must be terminated by a NULL pointer. The function is used throughout the w3m codebase to construct strings dynamically.
</description>

<requirements>
<requirement>
The variadic argument list must be terminated with a NULL pointer. This is because the function iterates through the arguments until a NULL is encountered, so a missing terminator will cause a crash.
</requirement>
<requirement>
All arguments passed to the function before the terminating NULL must be valid, null-terminated strings. This is to prevent memory access errors when the function concatenates the strings.
</requirement>
</requirements>

</function-requirements>

