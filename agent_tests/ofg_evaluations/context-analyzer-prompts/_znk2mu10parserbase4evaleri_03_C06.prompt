// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
// See the License for the specific language governing permissions and
// limitations under the License.
//
////////////////////////////////////////////////////////////////////////////////

#include <fuzzer/FuzzedDataProvider.h>
#include <string>
#include <vector>
#include <cmath>
#include "muParser.h"
#include "muParserBytecode.h"

// Dictionaries of muparser features
const char* const kVariables[] = {"x", "y", "z"};
const char* const kBuiltInConstants[] = {"_pi", "_e"};
const char* const kUnaryOperators[] = {"-"};
const char* const kBinaryOperators[] = {"+",  "-",  "*",  "/",  "^",  "&&", "||",
"<=", ">=", "!=", "==", "<",  ">"};
const char* const kFunc1Arg[] = {
"sin",  "cos",  "tan",  "asin", "acos", "atan", "sinh",
"cosh", "tanh", "asinh", "acosh", "atanh", "log2", "log10",
"log",  "ln",   "exp",  "sqrt", "sign", "rint", "abs"};
const char* const kFunc2Arg[] = {"atan2", "pow"};
const char* const kFuncMultiArg[] = {"sum", "min", "max", "avg"};
const char* const kCustomFuncs[] = {"strfun1"};
const char* const kCustomPostfixOprt[] = {"!"};

// Forward declaration for recursion
std::string GenerateExpression(FuzzedDataProvider &provider, int depth);

// Generates a simple term: a number, a variable, or a constant.
std::string GenerateTerm(FuzzedDataProvider &provider) {
switch (provider.ConsumeIntegralInRange<int>(0, 2)) {
case 0:
return std::to_string(provider.ConsumeFloatingPoint<double>());
case 1:
return provider.PickValueInArray(kVariables);
case 2:
default:
return provider.PickValueInArray(kBuiltInConstants);
}
}

// Recursively generates a complex, syntactically valid expression.
std::string GenerateExpression(FuzzedDataProvider &provider, int depth) {
if (depth <= 0 || provider.ConsumeBool()) {
return GenerateTerm(provider);
}

// Choose a complex expression structure
switch (provider.ConsumeIntegralInRange<int>(0, 7)) {
case 0: // Unary operator: -expr
return std::string(provider.PickValueInArray(kUnaryOperators)) + "(" +
GenerateExpression(provider, depth - 1) + ")";
case 1: // Binary operator: expr op expr
return "(" + GenerateExpression(provider, depth - 1) + ") " +
provider.PickValueInArray(kBinaryOperators) + " (" +
GenerateExpression(provider, depth - 1) + ")";
case 2: // 1-argument function: fun(expr)
return std::string(provider.PickValueInArray(kFunc1Arg)) + "(" +
GenerateExpression(provider, depth - 1) + ")";
case 3: // 2-argument function: fun(expr, expr)
return std::string(provider.PickValueInArray(kFunc2Arg)) + "(" +
GenerateExpression(provider, depth - 1) + ", " +
GenerateExpression(provider, depth - 1) + ")";
case 4: // Multi-argument function: fun(expr, expr, ...)
{
std::string args;
int num_args = provider.ConsumeIntegralInRange<int>(1, 5);
for (int i = 0; i < num_args; ++i) {
args += GenerateExpression(provider, depth - 1);
if (i < num_args - 1) {
args += ", ";
}
}
return std::string(provider.PickValueInArray(kFuncMultiArg)) + "(" + args + ")";
}
case 5: // Ternary conditional: if(cond, true_expr, false_expr)
return "if(" + GenerateExpression(provider, depth - 1) + ", " +
GenerateExpression(provider, depth - 1) + ", " +
GenerateExpression(provider, depth - 1) + ")";
case 6: // Custom function
return std::string(provider.PickValueInArray(kCustomFuncs)) + "(\"" +
provider.ConsumeRandomLengthString(10) + "\")";
case 7: // Custom postfix operator
default:
return "(" + GenerateExpression(provider, depth - 1) + ")" +
provider.PickValueInArray(kCustomPostfixOprt);
}
}

// Callback for a user-defined string function
mu::value_type f_strfun1(const mu::char_type* sz) {
if (sz) return static_cast<mu::value_type>(std::string(sz).length());
return 0;
}

// Callback for a user-defined postfix operator (factorial)
mu::value_type f_postfix(mu::value_type v) {
return std::tgamma(v + 1);
}

// Entry point for LibFuzzer.
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < 1) {
return 0;
}
FuzzedDataProvider provider(data, size);
mu::Parser parser;

// Define variables that can be used in the expressions.
mu::value_type x_val = provider.ConsumeFloatingPoint<mu::value_type>();
mu::value_type y_val = provider.ConsumeFloatingPoint<mu::value_type>();
mu::value_type z_val = provider.ConsumeFloatingPoint<mu::value_type>();
parser.DefineVar("x", &x_val);
parser.DefineVar("y", &y_val);
parser.DefineVar("z", &z_val);

// Fuzz user-defined features
if (provider.ConsumeBool()) {
parser.DefineFun("strfun1", f_strfun1);
}
if (provider.ConsumeBool()) {
parser.DefinePostfixOprt("!", f_postfix);
}

std::string full_expression;

// 50% chance to fuzz with raw input to find parsing errors
if (provider.ConsumeBool()) {
full_expression = provider.ConsumeRemainingBytesAsString();
} else {
// The Eval(int&) overload is designed for expressions with multiple
// results, separated by commas. We generate 1 to 3 such expressions.
int num_expressions = provider.ConsumeIntegralInRange<int>(1, 3);
const int max_depth = 3; // Control recursion depth
for (int i = 0; i < num_expressions; ++i) {
if (i > 0) {
full_expression += ", ";
}
full_expression += GenerateExpression(provider, max_depth);
}
}

try {
parser.SetExpr(full_expression);
int nResult = 0;
parser.Eval(nResult);

// Fuzz bytecode serialization/deserialization
if (provider.ConsumeBool()) {
const mu::ParserByteCode& bc = parser.GetByteCode();
if (bc.GetMaxStackSize() > 0) {
mu::Parser parser2;
parser2.DefineVar("x", &x_val);
parser2.DefineVar("y", &y_val);
parser2.DefineVar("z", &z_val);

parser2.SetByteCode(bc);
parser2.Eval(nResult);
}
}

// Second evaluation: Change variable values and re-evaluate.
x_val = provider.ConsumeFloatingPoint<mu::value_type>();
y_val = provider.ConsumeFloatingPoint<mu::value_type>();
z_val = provider.ConsumeFloatingPoint<mu::value_type>();
parser.Eval(nResult);

} catch (mu::Parser::exception_type &) {
// Catch valid parsing and evaluation exceptions.
} catch (...) {
// Catch any other unexpected exceptions.
}
return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: muparser
function signature: value_type * mu::ParserBase::Eval(int &)
</input>

<description>
The `Eval` function in `mu::ParserBase` evaluates a mathematical expression that has been previously set. The function's execution path is determined by the state of the `m_vRPN` member variable, which holds the bytecode representation of the expression.

If `m_vRPN` is not empty, `Eval` calls `ParseCmdCode`, which in turn calls `ParseCmdCodeBulk` to execute the bytecode. This function uses the `m_vStackBuffer` as a stack to perform calculations. The final result is left on the stack.

If `m_vRPN` is empty, `Eval` calls `ParseString`, which parses the expression string directly. This is a less efficient path and is not the primary way the parser is intended to be used.

The `Eval` function returns a pointer to the second element of `m_vStackBuffer`. This means that `m_vStackBuffer` must be properly sized to avoid out-of-bounds access. The sizing of `m_vStackBuffer` is handled internally when the expression is set via `SetExpr`.

To correctly fuzz the `Eval` function, the fuzzer should first call `SetExpr` with a fuzzed mathematical expression. This will populate `m_vRPN` with a valid bytecode and allocate the necessary space in `m_vStackBuffer`. Then, the fuzzer can call `Eval`. It is also important to define variables that are used in the expression, otherwise the parser will throw an error.
</description>

<requirements>

<requirement>
The `SetExpr` function must be called before calling `Eval`. This is because `SetExpr` is responsible for parsing the mathematical expression and generating the bytecode that `Eval` executes.
</requirement>
<requirement>
If the expression contains variables, `DefineVar` must be called to define them before calling `SetExpr`. This is to ensure that the parser can correctly identify and handle variables in the expression.
</requirement>
<requirement>
`m_vStackBuffer` should have a size of at least 2 before `Eval` is called. This is because `Eval` returns a pointer to the second element of this buffer, and a smaller size would lead to an out-of-bounds access.
</requirement>

</requirements>

</function-requirements>

