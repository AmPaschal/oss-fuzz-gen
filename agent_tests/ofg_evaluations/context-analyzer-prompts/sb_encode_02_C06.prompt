#include <fuzzer/FuzzedDataProvider.h>
#include <cstdint>
#include <vector>
#include <cstring>

#ifdef HAVE_CONFIG_H
# include "config.h"
#endif

#include "speex/speex.h"
#include "speex/speex_bits.h"
#include "speex/speex_callbacks.h"

// Explicitly declare the internal C functions and data we need with C linkage.
extern "C" {
// Include internal header, build script will add the necessary -I flag.
#include "sb_celp.h" // For SpeexSBMode definition

void *sb_encoder_init(const SpeexMode *m);
void sb_encoder_destroy(void *state);
int sb_encoder_ctl(void *state, int request, void *ptr);
int sb_encode(void *state, void *in, SpeexBits *bits);

// Expose the public mode data structures
extern const SpeexMode speex_wb_mode;
extern const SpeexMode speex_uwb_mode;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
FuzzedDataProvider provider(data, size);

const SpeexMode *mode;
SpeexMode custom_mode;
SpeexSBMode custom_sb_mode;

// Decide whether to use a standard mode or a custom-built one.
if (provider.ConsumeBool()) {
// Use a standard mode
mode = provider.ConsumeBool() ? &speex_wb_mode : &speex_uwb_mode;
} else {
// Create a custom mode to vary subframeSize.
// This is necessary to reach code paths that are unreachable
// with the hardcoded subframeSize=80 in the public API modes.
custom_mode = speex_wb_mode;

// Access the internal SB mode data via the public API pointer and copy it.
// This avoids a direct link-time dependency on the internal 'sb_wb_mode' symbol.
custom_sb_mode = *((const SpeexSBMode*)speex_wb_mode.mode);

// Fuzz the subframeSize. Any value other than 80 will hit the target 'else' branch.
custom_sb_mode.subframeSize = provider.ConsumeIntegralInRange<int>(1, 160);

// Point our custom SpeexMode to our custom SpeexSBMode
custom_mode.mode = &custom_sb_mode;
mode = &custom_mode;
}

void *state = sb_encoder_init(mode);
if (!state) {
return 0;
}

// Fuzz encoder settings once at the beginning.
enum BitrateMode { CBR, VBR, ABR, QUALITY, kMaxValue = QUALITY };
BitrateMode bitrate_mode = provider.ConsumeEnum<BitrateMode>();

int vbr = 0;
int abr = 0;
switch (bitrate_mode) {
case VBR: {
vbr = 1;
sb_encoder_ctl(state, SPEEX_SET_VBR, &vbr);
float vbr_quality = provider.ConsumeFloatingPointInRange<float>(0.0, 10.0);
sb_encoder_ctl(state, SPEEX_SET_VBR_QUALITY, &vbr_quality);
if (provider.ConsumeBool()) {
int max_bitrate = provider.ConsumeIntegralInRange<int>(2000, 48000);
sb_encoder_ctl(state, SPEEX_SET_VBR_MAX_BITRATE, &max_bitrate);
}
break;
}
case ABR: {
abr = provider.ConsumeIntegralInRange<int>(2000, 48000);
sb_encoder_ctl(state, SPEEX_SET_ABR, &abr);
break;
}
case CBR: {
if (provider.ConsumeBool()) {
int bitrate = provider.ConsumeIntegralInRange<int>(2000, 48000);
sb_encoder_ctl(state, SPEEX_SET_BITRATE, &bitrate);
}
break;
}
case QUALITY: {
int quality = provider.ConsumeIntegralInRange<int>(0, 10);
sb_encoder_ctl(state, SPEEX_SET_QUALITY, &quality);
break;
}
}

if (provider.ConsumeBool()) {
int vad = provider.ConsumeBool();
sb_encoder_ctl(state, SPEEX_SET_VAD, &vad);
}
if (provider.ConsumeBool()) {
int dtx = provider.ConsumeBool();
sb_encoder_ctl(state, SPEEX_SET_DTX, &dtx);
}
if (provider.ConsumeBool()) {
int complexity = provider.ConsumeIntegralInRange<int>(0, 10);
sb_encoder_ctl(state, SPEEX_SET_COMPLEXITY, &complexity);
}
if (provider.ConsumeBool()) {
int high_mode = provider.ConsumeIntegralInRange<int>(0, 1);
sb_encoder_ctl(state, SPEEX_SET_HIGH_MODE, &high_mode);
}
if (provider.ConsumeBool()) {
int highpass = provider.ConsumeBool();
sb_encoder_ctl(state, SPEEX_SET_HIGHPASS, &highpass);
}
if (provider.ConsumeBool()) {
int encode_submode = provider.ConsumeBool();
sb_encoder_ctl(state, SPEEX_SET_SUBMODE_ENCODING, &encode_submode);
}
if (provider.ConsumeBool()) {
int plc_tuning = provider.ConsumeIntegralInRange<int>(0, 100);
sb_encoder_ctl(state, SPEEX_SET_PLC_TUNING, &plc_tuning);
}

int frame_size = 0;
sb_encoder_ctl(state, SPEEX_GET_FRAME_SIZE, &frame_size);
if (frame_size <= 0) {
sb_encoder_destroy(state);
return 0;
}

const int input_samples = 2 * frame_size;
const size_t frame_bytes = input_samples * sizeof(spx_int16_t);
std::vector<spx_int16_t> vin_data(input_samples);

SpeexBits bits;
speex_bits_init(&bits);

while (provider.remaining_bytes() > 0) {
if (provider.ConsumeBool()) {
sb_encoder_ctl(state, SPEEX_RESET_STATE, NULL);
}

bool is_silent_frame = provider.ConsumeBool();

if (is_silent_frame) {
std::memset(vin_data.data(), 0, frame_bytes);
} else {
if (provider.remaining_bytes() < frame_bytes) {
break;
}
size_t consumed_bytes = provider.ConsumeData(vin_data.data(), frame_bytes);
if (consumed_bytes < frame_bytes) {
break;
}
}

speex_bits_reset(&bits);
sb_encode(state, (void*)vin_data.data(), &bits);
}

speex_bits_destroy(&bits);
sb_encoder_destroy(state);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: speex
function signature: int sb_encode(void *state, void *vin, SpeexBits *bits)
</input>

<description>
The `sb_encode` function is the core of the Speex wideband and ultra-wideband encoding process. It takes the audio input, encodes it, and writes the resulting bits to a SpeexBits struct. The function is not called directly, but rather through a function pointer `enc` in a `SpeexMode` struct. The `SpeexMode` struct is initialized with either `speex_wb_mode` or `speex_uwb_mode`, which both set the `enc` pointer to `sb_encode`. The `state` argument must be initialized by `sb_encoder_init` before calling `sb_encode`.
</description>

<requirements>

<requirement>
The `state` argument must be initialized by calling `sb_encoder_init` with either `speex_wb_mode` or `speex_uwb_mode`. This is because `sb_encoder_init` allocates and initializes the `SBEncState` struct that `sb_encode` expects.
</requirement>
<requirement>
The `vin` argument should be a pointer to a block of audio data. The size of this block should be `2 * frameSize`, where `frameSize` is a member of the `SpeexSBMode` struct used to initialize the encoder.
</requirement>
<requirement>
The `bits` argument must be a pointer to a `SpeexBits` struct. This struct must be initialized before calling `sb_encode` so that the encoded bitstream can be written to it.
</requirement>

</requirements>

</function-requirements>

