#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stddef.h>

#include "fuse_opt.h"

// A struct to hold the values of parsed options.
struct fuzz_options {
char *name;
unsigned int size;
int show_help;
int is_debug;
};

// Option templates for fuse_opt_parse. This array defines how command-line
// arguments are mapped to the fields in `fuzz_options`.
static const struct fuse_opt fuzz_opts[] = {
// Template for an option with a string parameter (e.g., "name=foo").
// The value is stored in the 'name' field of `fuzz_options`.
{"name=%s", offsetof(struct fuzz_options, name), 0},

// Template for an option with an unsigned int parameter (e.g., "size=123").
// The value is stored in the 'size' field.
{"size=%u", offsetof(struct fuzz_options, size), 0},

// Template for a simple flag (e.g., "--help").
// If present, sets the 'show_help' field to 1.
{"--help", offsetof(struct fuzz_options, show_help), 1},

// Template for a key-based option. Instead of setting a field, it calls
// the processing function with the specified key (1000).
FUSE_OPT_KEY("-d", 1000),
FUSE_OPT_KEY("--debug", 1000),

// Standard FUSE option keys to ensure they are handled correctly.
FUSE_OPT_KEY_KEEP,
FUSE_OPT_KEY_DISCARD,

// The array must be terminated with FUSE_OPT_END.
FUSE_OPT_END
};

// A processing function for fuse_opt_parse. This is called for options
// that don't match a template or for key-based options.
static int fuzz_opt_proc(void *data, const char *arg, int key,
struct fuse_args *outargs) {
(void)arg;
(void)outargs;
struct fuzz_options *opts = (struct fuzz_options *)data;

// Handle our custom key-based option.
if (key == 1000) {
opts->is_debug = 1;
return 0; // Returning 0 consumes the argument.
}

// For all other cases, keep the argument.
return 1;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < 1) {
return 0;
}

// Create a mutable copy of the input data to build an argv array from.
char *input_copy = (char *)malloc(size + 1);
if (!input_copy) {
return 0;
}
memcpy(input_copy, data, size);
input_copy[size] = '\0'; // Ensure the buffer is terminated.

// Allocate an argv array. We can have at most `size` arguments, so
// over-allocate for simplicity.
char **argv = (char **)calloc(size + 2, sizeof(char *));
if (!argv) {
free(input_copy);
return 0;
}

int argc = 0;
argv[argc++] = "fuzzer"; // argv[0] is the program name.

// Parse the input buffer into arguments, using null bytes as separators.
char *current = input_copy;
char *end = input_copy + size;
while (current < end) {
argv[argc++] = current;
// Find the end of the current argument.
char *next = (char *)memchr(current, '\0', end - current);
if (next == NULL) {
break; // No more null terminators.
}
current = next + 1;
}

// Initialize FUSE arguments and the options struct.
struct fuse_args args = FUSE_ARGS_INIT(argc, argv);
struct fuzz_options opts = {0};

// Call the main function to be fuzzed.
fuse_opt_parse(&args, &opts, fuzz_opts, fuzz_opt_proc);

// Also test the original, simple function to maintain its coverage.
if (opts.name != NULL) {
char *extra_opts = NULL;
fuse_opt_add_opt(&extra_opts, opts.name);
free(extra_opts);
}

// Clean up all allocated resources.
free(opts.name);           // Freed by us, as it's allocated by fuse_opt_parse.
fuse_opt_free_args(&args); // Frees memory allocated by fuse_opt_parse within args.
free(argv);
free(input_copy);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: libfuse
function signature: int fuse_opt_add_opt(char **, const char *)
</input>

<description>
The `fuse_opt_add_opt` function is used to add a new option to a comma-separated list of options. It takes a pointer to a string (`char **opts`) and a new option string (`const char *opt`) as input. The function reallocates the memory for the option string to accommodate the new option and appends it to the list, separated by a comma. 

The first argument, `opts`, is a pointer to a `char*`. The function `add_opt_common` (which is called by `fuse_opt_add_opt`) uses `realloc` on the `char*` pointed to by `opts`. This means that `*opts` must be either `NULL` or a pointer to a dynamically allocated string that can be safely passed to `realloc`. The callers in `helper.c` and `mount.c` all pass addresses of `char*` variables that are either `NULL` or have been dynamically allocated.

The second argument, `opt`, is a `const char*` that points to the option string to be added. This string is read using `strlen`, so it must be a valid, null-terminated C-style string. The callers provide various strings, including string literals and dynamically generated strings, all of which are null-terminated. 

The function returns 0 on success and -1 on memory allocation failure.
</description>

<requirements>
<requirement>
The first argument `opts` must be a pointer to a `char *`. This is because the function will dereference this pointer to read and modify the string it points to.
</requirement>
<requirement>
The `char *` pointed to by `opts` must either be `NULL` or a pointer to a dynamically allocated string. This is because the function uses `realloc` to resize the string, which requires a pointer previously returned by `malloc`, `calloc` or `realloc`.
</requirement>
<requirement>
The second argument `opt` must be a valid, null-terminated string. This is because the function uses `strlen` to calculate its length and then copies its content.
</requirement>
</requirements>

</function-requirements>

