(void)ifname;
return 1;
}
void
__wrap_levent_hardware_add_fd(struct lldpd_hardware *hardware, int fd)
{
(void)hardware;
(void)fd;
}
void
__wrap_levent_hardware_release(struct lldpd_hardware *hardware)
{
(void)hardware;
}
void
__wrap_levent_hardware_init(struct lldpd_hardware *hardware)
{
(void)hardware;
}
void
donothing(int pri, const char *msg)
{
(void)pri;
(void)msg;
};

int
LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size)
{
fuzz_data = Data;
fuzz_size = Size;
fuzz_offset = 0;

if (Size < 100) {
return 0;
}
log_register(donothing);

struct lldpd cfg;
memset(&cfg, 0, sizeof(struct lldpd));
TAILQ_INIT(&cfg.g_chassis);
TAILQ_INIT(&cfg.g_hardware);

// Allocate g_netlink as it's expected to be non-null
cfg.g_netlink = calloc(1, sizeof(struct lldpd_netlink));
if (!cfg.g_netlink) {
return 0;
}

// Create interface patterns to exercise allow/deny logic
uint8_t num_patterns;
if (consume_data(&num_patterns, sizeof(num_patterns))) {
num_patterns %= 5; // Limit to a few patterns
cfg.g_config.c_iface_pattern = calloc(num_patterns + 1, sizeof(char *));
if (cfg.g_config.c_iface_pattern) {
for (int i = 0; i < num_patterns; i++) {
char *p = consume_string(10);
if (!p) break;
// Occasionally make it a deny pattern
if (p[0] != 0 && (i % 2 == 1)) {
char *p2 = calloc(1, strlen(p) + 2);
if (p2) {
p2[0] = '!';
strcpy(p2 + 1, p);
cfg.g_config.c_iface_pattern[i] = p2;
}
free(p);
} else {
cfg.g_config.c_iface_pattern[i] = p;
}
}
}
}

struct lldpd_chassis *chassis = calloc(1, sizeof(struct lldpd_chassis));
if (!chassis) {
free(cfg.g_netlink);
return 0;
}

if (!consume_data(&chassis->c_cap_available,
sizeof(chassis->c_cap_available))) {
free(chassis);
free(cfg.g_netlink);
return 0;
}
chassis->c_cap_enabled = chassis->c_cap_available;
TAILQ_INSERT_TAIL(&cfg.g_chassis, chassis, c_entries);

// Populate g_hardware with some existing interfaces to test update logic
uint8_t num_hw;
if (consume_data(&num_hw, sizeof(num_hw))) {
num_hw %= 5;
for (int i = 0; i < num_hw; i++) {
struct lldpd_hardware *h = calloc(1, sizeof(*h));
if (!h) break;
consume_data(&h->h_ifindex, sizeof(h->h_ifindex));
consume_data(&h->h_flags, sizeof(h->h_flags));
char *name = consume_string(IFNAMSIZ - 1);
if (name) {
strncpy(h->h_ifname, name, IFNAMSIZ - 1);
free(name);
}
TAILQ_INSERT_TAIL(&cfg.g_hardware, h, h_entries);
}
}

interfaces_update(&cfg);

// Cleanup
struct lldpd_hardware *hardware, *h_next;
for (hardware = TAILQ_FIRST(&cfg.g_hardware); hardware != NULL;
hardware = h_next) {
h_next = TAILQ_NEXT(hardware, h_entries);
if (hardware->h_ops && hardware->h_ops->cleanup) {
hardware->h_ops->cleanup(&cfg, hardware);
}
lldpd_hardware_cleanup(&cfg, hardware);
}

if (cfg.g_config.c_iface_pattern) {
for (char **p = cfg.g_config.c_iface_pattern; *p != NULL; p++) {
free(*p);
}
free(cfg.g_config.c_iface_pattern);
}

free(cfg.g_netlink);
lldpd_chassis_cleanup(chassis, 1);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: lldpd
function signature: void interfaces_update(struct lldpd *)
</input>

<description>
The `interfaces_update` function refreshes the list of local network interfaces and their properties. It fetches interface and address lists using OS-specific methods (Netlink on Linux), then enriches this data by identifying interface types (VLAN, bond, bridge, etc.), applying allowlists, and handling protocol-specific details. It relies heavily on the `struct lldpd *cfg` to access system information and existing hardware state.
</description>

<requirements>

<requirement>
The `cfg` argument must be a valid, non-null pointer to a `struct lldpd`. This is because it is dereferenced throughout the function to access global configuration and state.
</requirement>
<requirement>
The `cfg->g_netlink` field must point to a valid `struct lldpd_netlink`. The function's primary data sources, `netlink_get_interfaces` and `netlink_get_addresses`, populate and read from this structure.
</requirement>
<requirement>
`cfg->g_netlink->devices` must be an initialized `interfaces_device_list` populated with fuzzed `interfaces_device` structures. This list is the main input that drives the interface processing logic.
</requirement>
<requirement>
`cfg->g_netlink->addresses` must be an initialized `interfaces_address_list` populated with fuzzed `interfaces_address` structures. This data is required by the `interfaces_helper_mgmt` function to configure management addresses.
</requirement>
<requirement>
`cfg->g_chassis` list must be initialized and contain at least one `lldpd_chassis` element. This is to prevent a NULL pointer dereference by the `LOCAL_CHASSIS` macro when checking system capabilities.
</requirement>
<requirement>
The `c_cap_available` field of the main chassis (`LOCAL_CHASSIS(cfg)`) should be fuzzed with combinations of `LLDP_CAP_WLAN` and `LLDP_CAP_BRIDGE`. This is to explore the conditional code paths for wireless and bridge interface handling.
</requirement>
<requirement>
`cfg->g_hardware` must be an initialized `TAILQ_HEAD` for `lldpd_hardware` structs. Populating this list is necessary to achieve coverage in the final loop that updates MAC/PHY information.
</requirement>
<requirement>
The `h_flags` member of each `lldpd_hardware` element should be fuzzed, including the `IFF_RUNNING` flag. This is because the function checks this flag to determine if an interface is active and should be processed.
</requirement>

</requirements>

</function-requirements>

