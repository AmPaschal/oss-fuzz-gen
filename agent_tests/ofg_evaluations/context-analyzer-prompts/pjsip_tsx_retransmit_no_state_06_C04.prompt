* Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
*/
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

#include <pjlib.h>
#include <pjsip.h>
#include <pjsip_ua.h>
#include <pjsip/sip_parser.h>
#include <pjsip/sip_transaction.h>
#include <pjsip/sip_transport.h>

// Need at least 1 byte for path selector and some for data.
#define kMinInputLength 32
#define kMaxInputLength 1024

static void cleanup_pjsip(pjsip_endpoint *endpt, pj_caching_pool *cp) {
if (endpt) {
pjsip_endpt_destroy(endpt);
}
if (cp) {
pj_caching_pool_destroy(cp);
}
pj_shutdown();
}

extern int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < kMinInputLength || size > kMaxInputLength) {
return 0;
}

pj_caching_pool cp;
pjsip_endpoint *endpt = NULL;
pj_pool_t *pool = NULL;
pjsip_transaction *tsx = NULL;
pjsip_tx_data *tdata = NULL;
pj_status_t status;

// Init PJSIP
status = pj_init();
if (status != PJ_SUCCESS) {
return 0;
}

pj_caching_pool_init(&cp, &pj_pool_factory_default_policy, 0);
pj_log_set_level(0);

status = pjsip_endpt_create(&cp.factory, "fuzzer", &endpt);
if (status != PJ_SUCCESS) {
cleanup_pjsip(NULL, &cp);
return 0;
}

pjsip_tsx_layer_init_module(endpt);
pjsip_ua_init_module(endpt, NULL);
pjsip_udp_transport_start(endpt, NULL, NULL, 1, NULL);

// Use one byte to select code paths.
uint8_t path_selector = data[0];
data++;
size--;

pool = pj_pool_create(&cp.factory, "fuzz-pool", 1024, 1024, NULL);
if (!pool) {
cleanup_pjsip(endpt, &cp);
return 0;
}

// Path 1: Create UAC (client) transaction for sending a request.
if ((path_selector & 1) == 0) {
pj_str_t uri = pj_str((char*)data);
uri.slen = size;

status = pjsip_endpt_create_request(endpt, &pjsip_register_method, &uri,
&uri, &uri, NULL, NULL, -1, NULL,
&tdata);
if (status == PJ_SUCCESS) {
status = pjsip_tsx_create_uac(pjsip_ua_instance(), tdata, &tsx);
if (status != PJ_SUCCESS) {
pjsip_tx_data_dec_ref(tdata);
}
}
}
// Path 2: Create UAS (server) transaction for sending a response.
else {
pjsip_rx_data *rdata = PJ_POOL_ZALLOC_T(pool, pjsip_rx_data);
rdata->tp_info.pool = pool;

char *pkt_copy = (char*)pj_pool_alloc(pool, size + 1);
memcpy(pkt_copy, data, size);
pkt_copy[size] = '\0';

pjsip_msg *msg = pjsip_parse_rdata(pkt_copy, size, rdata);
if (msg && rdata->msg_info.msg->type == PJSIP_REQUEST_MSG) {
status = pjsip_tsx_create_uas(pjsip_ua_instance(), rdata, &tsx);
if (status == PJ_SUCCESS) {
status = pjsip_endpt_create_response(endpt, rdata, 200, NULL, &tdata);
if (status == PJ_SUCCESS) {
pjsip_tx_data_add_ref(tdata);
tsx->last_tx = tdata;
} else {
pjsip_tsx_terminate(tsx, PJSIP_SC_INTERNAL_SERVER_ERROR);
tsx = NULL;
}
}
}
}

if (tsx) {
// Path A: Perform a single retransmission.
if ((path_selector & 2) == 0) {
pjsip_tx_data *arg_tdata = ((path_selector & 4) == 0) ? tsx->last_tx : NULL;
pjsip_tx_data_add_ref(tsx->last_tx);
pjsip_tsx_retransmit_no_state(tsx, arg_tdata);
}
// Path B: Perform two retransmissions to test cached transport.
else {
// First send
pjsip_tx_data_add_ref(tsx->last_tx);
pjsip_tsx_retransmit_no_state(tsx, tsx->last_tx);

// Poll for events to allow async send to complete
for (int i = 0; i < 5; ++i) {
pjsip_endpt_handle_events(endpt, NULL);
}

// Second send
pjsip_tx_data *arg_tdata = ((path_selector & 4) == 0) ? tsx->last_tx : NULL;
if (tsx->last_tx) {
pjsip_tx_data_add_ref(tsx->last_tx);
pjsip_tsx_retransmit_no_state(tsx, arg_tdata);
}
}
pjsip_tsx_terminate(tsx, PJSIP_SC_REQUEST_TERMINATED);
}

// Cleanup
if (pool) {
pj_pool_release(pool);
}
cleanup_pjsip(endpt, &cp);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: pjsip
function signature: pj_status_t pjsip_tsx_retransmit_no_state(pjsip_transaction *, pjsip_tx_data *)
</input>

<description>
The function `pjsip_tsx_retransmit_no_state` retransmits a SIP message. It acquires a group lock from the transaction, sends the message using `tsx_send_msg`, and then releases the lock. If the message is sent successfully, it decrements the reference counter of the transmission data.
</description>

<requirements>

<requirement>
The first argument, `tsx`, must be a valid pointer to a `pjsip_transaction` struct. This is because the function dereferences this pointer to access `tsx->grp_lock` and `tsx->last_tx`.
</requirement>
<requirement>
The `grp_lock` member of the `pjsip_transaction` struct pointed to by `tsx` must be a valid, initialized group lock. This is because the function calls `pj_grp_lock_acquire` and `pj_grp_lock_release` on this member.
</requirement>
<requirement>
If the second argument, `tdata`, is `NULL`, then the `last_tx` member of the `pjsip_transaction` struct must be a valid pointer to a `pjsip_tx_data` struct. This is because `tsx->last_tx` is assigned to `tdata` and subsequently dereferenced.
</requirement>
<requirement>
The second argument, `tdata` (or `tsx->last_tx` if `tdata` is `NULL`), must be a valid pointer to a `pjsip_tx_data` struct with a valid reference count. This is because the function passes this pointer to `tsx_send_msg`, `pjsip_tx_data_add_ref`, and `pjsip_tx_data_dec_ref`.
</requirement>

</requirements>

</function-requirements>

