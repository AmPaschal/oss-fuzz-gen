<fuzz-target>
/* zip_fuzzer.c - Zip fuzzer for libFuzzer
part of the minizip-ng project

Copyright (C) 2018 The Chromium Authors
Copyright (C) 2018 Anand K. Mistry
Copyright (C) Nathan Moinvaziri
https://github.com/zlib-ng/minizip-ng

This program is distributed under the terms of the same license as zlib.
See the accompanying LICENSE file for the full text of the license.
*/

#include "mz.h"
#include "mz_strm.h"
#include "mz_strm_mem.h"
#include "/src/minizip-ng/mz_zip.h"
#include "/src/minizip-ng/mz_zip_rw.h"
#include "mz_os.h"

#include <string.h>
#include <stdlib.h>
#include <stdint.h>

#define MAX_FILENAME_LEN 256
#define MAX_PATTERN_LEN 64

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < MAX_FILENAME_LEN + MAX_PATTERN_LEN + 1) {
return 0;
}

/* Split the input data into parts for filename, pattern, and content */
const uint8_t *filename_data = data;
const uint8_t *pattern_data = data + MAX_FILENAME_LEN;
const uint8_t *file_content_data = data + MAX_FILENAME_LEN + MAX_PATTERN_LEN;
size_t file_content_size = size - (MAX_FILENAME_LEN + MAX_PATTERN_LEN);

/* Create a null-terminated filename from fuzzer data */
char filename[MAX_FILENAME_LEN + 1];
memcpy(filename, filename_data, MAX_FILENAME_LEN);
filename[MAX_FILENAME_LEN] = '\0';

/* Create a null-terminated search pattern from fuzzer data */
char pattern[MAX_PATTERN_LEN + 1];
memcpy(pattern, pattern_data, MAX_PATTERN_LEN);
pattern[MAX_PATTERN_LEN] = '\0';

void *stream = mz_stream_mem_create();
if (!stream) {
return 1;
}

void *writer_handle = mz_zip_writer_create();
if (!writer_handle) {
mz_stream_mem_delete(&stream);
return 1;
}

/* Create a zip archive in memory with one entry */
if (mz_zip_writer_open(writer_handle, stream, 0) == MZ_OK) {
mz_zip_file file_info = {0};
file_info.filename = filename;
file_info.flag = MZ_ZIP_FLAG_UTF8;
/* Use STORE method for simplicity and to avoid compression complexities */
file_info.compression_method = MZ_COMPRESS_METHOD_STORE;

if (mz_zip_writer_entry_open(writer_handle, &file_info) == MZ_OK) {
if (file_content_size > 0) {
mz_zip_writer_entry_write(writer_handle, file_content_data, file_content_size);
}
mz_zip_writer_entry_close(writer_handle);
}
mz_zip_writer_close(writer_handle);
}
mz_zip_writer_delete(&writer_handle);

/* Now, try to read the archive and locate the entry */
void *reader_handle = mz_zip_reader_create();
if (!reader_handle) {
mz_stream_mem_delete(&stream);
return 1;
}

mz_stream_mem_seek(stream, 0, MZ_SEEK_SET);

if (mz_zip_reader_open(reader_handle, stream) == MZ_OK) {
/* Use fuzzer data for case sensitivity */
uint8_t ignore_case = pattern_data[0] % 2;

/* This high-level call will internally use mz_zip_locate_first_entry
with the correct parameters and callback. */
mz_zip_reader_locate_entry(reader_handle, pattern, ignore_case);

mz_zip_reader_close(reader_handle);
}

mz_zip_reader_delete(&reader_handle);
mz_stream_mem_delete(&stream);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: minizip
function signature: int32_t mz_zip_locate_first_entry(void *handle, void *userdata, mz_zip_locate_entry_cb cb)
</input>

<description>
The `mz_zip_locate_first_entry` function is used to find the first entry in a zip archive that matches a given pattern. It iterates through the zip entries, calling a user-provided callback function for each entry. The callback function is responsible for determining if the entry is a match.
</description>

<requirements>

<requirement>
The `handle` argument must be a valid pointer to a `mz_zip` struct that has been initialized and opened. This is because the function calls `mz_zip_goto_first_entry` on the handle, which expects a valid, open zip archive.
</requirement>
<requirement>
The `userdata` argument should be a pointer to a `mz_zip_reader_s` struct. This is because the callback function used in the callers, `mz_zip_reader_locate_entry_cb`, casts `userdata` to this type to access pattern matching information.
</requirement>
<requirement>
The `mz_zip_reader_s` struct pointed to by `userdata` should have its `pattern` and `pattern_ignore_case` fields initialized. The `mz_zip_reader_set_pattern` function can be used for this purpose, as the callback `mz_zip_reader_locate_entry_cb` uses these fields to match entries.
</requirement>
<requirement>
The `cb` argument must be a valid function pointer of type `mz_zip_locate_entry_cb`. This callback function should be implemented to handle the logic of matching a zip entry, and it will be called for each entry in the archive until it returns 0.
</requirement>
<requirement>
Before calling `mz_zip_locate_first_entry`, a `mz_zip_reader` should be created using `mz_zip_reader_create` and a zip archive should be opened using a function like `mz_zip_reader_open_file`. This ensures that the `handle` and `userdata` arguments are valid and properly initialized.
</requirement>

</requirements>

</function-requirements>

