#include "/src/astc-encoder/Source/astcenc_internal.h"

#include <fuzzer/FuzzedDataProvider.h>
#include <vector>
#include <cassert>
#include <cstring>

// Manually define the btq_count struct as it's local to a .cpp file
// This must match the definition in astcenc_integer_sequence.cpp
struct btq_count
{
uint8_t bits:6;
uint8_t trits:1;
uint8_t quints:1;
};

// Replicate the static btq_count table from astcenc_integer_sequence.cpp
// as it is not accessible directly. This is needed to generate valid inputs.
// This must match the table in astcenc_integer_sequence.cpp
static const btq_count btq_counts[] = {
{ 1, 0, 0 }, // QUANT_2
{ 0, 1, 0 }, // QUANT_3
{ 2, 0, 0 }, // QUANT_4
{ 0, 0, 1 }, // QUANT_5
{ 1, 1, 0 }, // QUANT_6
{ 3, 0, 0 }, // QUANT_8
{ 1, 0, 1 }, // QUANT_10
{ 2, 1, 0 }, // QUANT_12
{ 4, 0, 0 }, // QUANT_16
{ 2, 0, 1 }, // QUANT_20
{ 3, 1, 0 }, // QUANT_24
{ 5, 0, 0 }, // QUANT_32
{ 3, 0, 1 }, // QUANT_40
{ 4, 1, 0 }, // QUANT_48
{ 6, 0, 0 }, // QUANT_64
{ 4, 0, 1 }, // QUANT_80
{ 5, 1, 0 }, // QUANT_96
{ 7, 0, 0 }, // QUANT_128
{ 5, 0, 1 }, // QUANT_160
{ 6, 1, 0 }, // QUANT_192
{ 8, 0, 0 }  // QUANT_256
};

// Forward declare functions to be fuzzed
void encode_ise(quant_method, unsigned int, const uint8_t *, uint8_t *, unsigned int);
void decode_ise(quant_method, unsigned int, const uint8_t *, uint8_t *, unsigned int);
unsigned int get_ise_sequence_bitcount(unsigned int, quant_method);


extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
FuzzedDataProvider stream(data, size);

// Section 1: Fuzz get_ise_sequence_bitcount with potentially invalid inputs
if (stream.remaining_bytes() > 10) {
unsigned int count = stream.ConsumeIntegralInRange<unsigned int>(1, 100);
// Allow out-of-bounds quant_level to test error handling
auto q_level_invalid = static_cast<quant_method>(stream.ConsumeIntegralInRange<uint8_t>(0, 30));
(void)get_ise_sequence_bitcount(count, q_level_invalid);
}

// Section 2: Perform round-trip fuzzing for encode_ise and decode_ise
if (stream.remaining_bytes() < 10) {
return 0;
}

// Requirement: quant_level must be between 0 and 20.
auto quant_level_val = stream.ConsumeIntegralInRange<uint8_t>(0, 20);
quant_method quant_level = static_cast<quant_method>(quant_level_val);

// Requirement: character_count must be > 0.
unsigned int character_count = stream.ConsumeIntegralInRange<unsigned int>(1, 256);

// Requirement: input_data values must be constrained.
const auto &params = btq_counts[quant_level_val];
unsigned int bits = params.bits;
unsigned int max_val;

if (params.trits) {
max_val = (3 << bits) - 1;
} else if (params.quints) {
max_val = (5 << bits) - 1;
} else {
max_val = (1 << bits) - 1;
}

std::vector<uint8_t> input_data;
input_data.reserve(character_count);
for (unsigned int i = 0; i < character_count; ++i) {
if (stream.remaining_bytes() == 0) {
break;
}
input_data.push_back(stream.ConsumeIntegralInRange<uint8_t>(0, max_val));
}

if (input_data.empty()) {
return 0;
}
character_count = input_data.size();

// Requirement: output_data must be large enough.
size_t output_size = character_count * 2 + 16;
std::vector<uint8_t> encoded_data(output_size, 0);

// Requirement: bit_offset must be valid.
unsigned int bit_offset = stream.ConsumeIntegralInRange<unsigned int>(0, 64);
if (bit_offset >= output_size * 8) {
return 0;
}

// Encode the data
encode_ise(quant_level, character_count, input_data.data(),
encoded_data.data(), bit_offset);

// Decode the data
std::vector<uint8_t> decoded_data(character_count, 0);
decode_ise(quant_level, character_count, encoded_data.data(),
decoded_data.data(), bit_offset);

// Verify the round-trip was successful
// This will crash and report a bug if the data does not match.
assert(memcmp(input_data.data(), decoded_data.data(), character_count) == 0);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: astc-encoder
function signature: void encode_ise(DW_TAG_enumeration_typequant_method, unsigned int, const uint8_t *, uint8_t *, unsigned int)
</input>

<description>
The encode_ise function implements the Bounded Integer Sequence Encoding (BISE) used in the ASTC texture compression standard. It takes an array of uncompressed integers (`input_data`) and encodes them into a bit-packed representation in `output_data`. The encoding is controlled by the `quant_level`, which determines the number of bits, trits, or quints used for each integer in the sequence. The function handles both full blocks and partial blocks of data.
</description>

<requirements>
<requirement>
The `quant_level` parameter must be a value between 0 and 20 (inclusive).
This is because `quant_level` is used as an index into the `btq_counts` array, which has a size of 21.
</requirement>
<requirement>
The `character_count` parameter must be greater than 0.
This is enforced by a `promise` at the beginning of the function and is necessary to prevent empty input.
</requirement>
<requirement>
The `input_data` array must contain values such that `(value >> bits)` is less than 3 when trits are used, or less than 5 when quints are used, where `bits` is derived from `btq_counts[quant_level].bits`.
These values are used as indices into the `integer_of_trits` and `integer_of_quints` arrays, and out-of-range values will lead to out-of-bounds access.
</requirement>
<requirement>
The `output_data` buffer must be large enough to hold the encoded bitstream.
The size required depends on `character_count` and `quant_level`, and the caller is responsible for allocating a sufficient buffer to prevent buffer overflows.
</requirement>
<requirement>
The `bit_offset` parameter should be initialized to a value that, when added to the number of bits to be written, does not exceed the size of the `output_data` buffer in bits.
This is to prevent writing beyond the allocated buffer.
</requirement>
</requirements>

</function-requirements>

