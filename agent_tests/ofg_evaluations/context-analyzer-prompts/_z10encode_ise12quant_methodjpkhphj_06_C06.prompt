/**
* @brief Fuzz target for encode_ise() and decode_ise().
*
* This fuzzer uses three strategies:
* 1. A round-trip test to check for correctness bugs (encode -> decode -> verify).
* 2. A direct decode test to check for parsing bugs in decode_ise with arbitrary data.
* 3. A direct decode test with crafted malicious data to trigger error paths.
*/

#include "/src/astc-encoder/Source/astcenc_internal.h"

#include <fuzzer/FuzzedDataProvider.h>
#include <vector>
#include <array>
#include <cstdint>
#include <cassert>

// Replicate internal structures to constrain input data correctly.
struct btq_count
{
uint8_t bits:6;
uint8_t trits:1;
uint8_t quints:1;
};

static const std::array<btq_count, 21> btq_counts {{
{ 1, 0, 0 }, // QUANT_2
{ 0, 1, 0 }, // QUANT_3
{ 2, 0, 0 }, // QUANT_4
{ 0, 0, 1 }, // QUANT_5
{ 1, 1, 0 }, // QUANT_6
{ 3, 0, 0 }, // QUANT_8
{ 1, 0, 1 }, // QUANT_10
{ 2, 1, 0 }, // QUANT_12
{ 4, 0, 0 }, // QUANT_16
{ 2, 0, 1 }, // QUANT_20
{ 3, 1, 0 }, // QUANT_24
{ 5, 0, 0 }, // QUANT_32
{ 3, 0, 1 }, // QUANT_40
{ 4, 1, 0 }, // QUANT_48
{ 6, 0, 0 }, // QUANT_64
{ 4, 0, 1 }, // QUANT_80
{ 5, 1, 0 }, // QUANT_96
{ 7, 0, 0 }, // QUANT_128
{ 5, 0, 1 }, // QUANT_160
{ 6, 1, 0 }, // QUANT_192
{ 8, 0, 0 }  // QUANT_256
}};

// Function signatures from the header for clarity.
void encode_ise(quant_method, unsigned int, const uint8_t *, uint8_t *, unsigned int);
void decode_ise(quant_method, unsigned int, const uint8_t *, uint8_t *, unsigned int);
unsigned int get_ise_sequence_bitcount(unsigned int, quant_method);

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
FuzzedDataProvider stream(data, size);

// We need at least a few bytes to select parameters.
if (size < 4) {
return 0;
}

// Choose between a round-trip test and a direct decode test
if (stream.ConsumeBool())
{
// STRATEGIES: Direct fuzzing of decode_ise
auto quant_level = static_cast<quant_method>(stream.ConsumeIntegralInRange<uint8_t>(0, 20));
unsigned int character_count = stream.ConsumeIntegralInRange<unsigned int>(1, 64);
unsigned int bit_offset = stream.ConsumeIntegralInRange<unsigned int>(0, 15);

unsigned int bit_count = get_ise_sequence_bitcount(character_count, quant_level);
size_t input_size_bytes = (bit_offset + bit_count + 15) / 8;

if (stream.remaining_bytes() < input_size_bytes) {
return 0;
}

std::vector<uint8_t> encoded_data = stream.ConsumeBytes<uint8_t>(input_size_bytes);
std::vector<uint8_t> decoded_data(character_count, 0);

// Call decode_ise with a potentially malformed bitstream of the correct size.
// This will cover the error paths for trits/quints with random data.
decode_ise(quant_level, character_count, encoded_data.data(), decoded_data.data(), bit_offset);
}
else
{
// STRATEGY: Round-trip test for encode_ise and decode_ise
auto quant_level = static_cast<quant_method>(stream.ConsumeIntegralInRange<uint8_t>(0, 20));
const auto& bq = btq_counts[quant_level];
unsigned int bit_offset;

// Systematically generate character counts to hit tail-handling logic
unsigned int character_count;
if (bq.trits) {
// Trit mode: block size = 5. Test with more blocks.
unsigned int num_blocks = stream.ConsumeIntegralInRange<unsigned int>(0, 40);
unsigned int remainder = stream.ConsumeIntegralInRange<unsigned int>(0, 4);
character_count = num_blocks * 5 + remainder;
bit_offset = stream.ConsumeIntegralInRange<unsigned int>(0, 15);
} else if (bq.quints) {
// Quint mode: block size = 3. Test with more blocks.
unsigned int num_blocks = stream.ConsumeIntegralInRange<unsigned int>(0, 60);
unsigned int remainder = stream.ConsumeIntegralInRange<unsigned int>(0, 2);
character_count = num_blocks * 3 + remainder;
bit_offset = stream.ConsumeIntegralInRange<unsigned int>(0, 15);
} else {
// Bits-only mode: Test larger counts and specifically target the bit_offset=0 fast path
character_count = stream.ConsumeIntegralInRange<unsigned int>(0, 200);
if (stream.ConsumeBool()) {
bit_offset = 0; // Target the memcpy fast path
} else {
bit_offset = stream.ConsumeIntegralInRange<unsigned int>(1, 15);
}
}

// Ensure character_count is always > 0, as required by the function
if (character_count == 0) {
character_count = 1;
}

std::vector<uint8_t> input_data(character_count);
unsigned int bits = bq.bits;
uint8_t lower_mask = (1 << bits) - 1;

if (stream.remaining_bytes() < character_count) {
return 0;
}

if (bq.trits) {
for (unsigned int i = 0; i < character_count; ++i) {
uint8_t upper = stream.ConsumeIntegralInRange<uint8_t>(0, 2);
uint8_t lower = stream.ConsumeIntegralInRange<uint8_t>(0, lower_mask);
input_data[i] = (upper << bits) | lower;
}
} else if (bq.quints) {
for (unsigned int i = 0; i < character_count; ++i) {
uint8_t upper = stream.ConsumeIntegralInRange<uint8_t>(0, 4);
uint8_t lower = stream.ConsumeIntegralInRange<uint8_t>(0, lower_mask);
input_data[i] = (upper << bits) | lower;
}
} else { // bits-only
for (unsigned int i = 0; i < character_count; ++i) {
input_data[i] = stream.ConsumeIntegralInRange<uint8_t>(0, lower_mask);
}
}

unsigned int bit_count = get_ise_sequence_bitcount(character_count, quant_level);
size_t output_size_bytes = (bit_offset + bit_count + 15) / 8;
std::vector<uint8_t> encoded_data(output_size_bytes, 0);

encode_ise(quant_level, character_count, input_data.data(), encoded_data.data(), bit_offset);

std::vector<uint8_t> decoded_data(character_count, 0);
decode_ise(quant_level, character_count, encoded_data.data(), decoded_data.data(), bit_offset);

for (unsigned int i = 0; i < character_count; ++i) {
assert(input_data[i] == decoded_data[i]);
}
}

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: astc-encoder
function signature: void encode_ise(quant_method quant_level, unsigned int character_count, const uint8_t* input_data, uint8_t* output_data, unsigned int bit_offset)
</input>

<description>
The `encode_ise` function performs Bounded Integer Sequence Encoding (BISE), a variable-bitrate encoding scheme used by the ASTC texture compression format. It takes an array of unpacked integer values and compresses them into a compact, bit-packed representation. The level of quantization is determined by the `quant_level` parameter, which specifies the mix of bits, trits (base-3), and quints (base-5) to use for encoding, thereby controlling the trade-off between compression ratio and precision. The function processes the input data in blocks, writing the resulting bitstream into the output buffer starting at a specified bit offset.
</description>

<requirements>
<requirement>
The `quant_level` argument must be a valid enum value from `quant_method`, which corresponds to an integer in the range [0, 20]. This is critical to prevent out-of-bounds access on the `btq_counts` global array, which would lead to a crash.
</requirement>
<requirement>
The `character_count` argument must be greater than zero. The function contains a `promise` check for this condition, and the internal logic is not designed to handle a zero-count input, which would lead to incorrect behavior or assertions.
</requirement>
<requirement>
The `input_data` buffer must be allocated to a size of at least `character_count` bytes. This is necessary to prevent out-of-bounds memory reads during the encoding process.
</requirement>
<requirement>
The values within the `input_data` buffer must be constrained according to the `quant_level`. If the selected mode uses trits, each value must be less than `3 << bits`. If the mode uses quints, each value must be less than `5 << bits`, where `bits` is derived from `btq_counts[quant_level]`. This prevents out-of-bounds reads from the `integer_of_trits` and `integer_of_quints` lookup tables.
</requirement>
<requirement>
The `output_data` buffer must be large enough to hold the encoded bitstream. The required size in bytes should be at least `(bit_offset + get_ise_sequence_bitcount(character_count, quant_level) + 7) / 8`. The `get_ise_sequence_bitcount` function should be used to calculate the precise number of bits the payload will require to prevent buffer overflows.
</requirement>
</requirements>

</function-requirements>

