<fuzz-target>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>

/* Undefine this to enable newer API functions */
#undef ZIP_DISABLE_DEPRECATED

/* Use extern "C" only when compiling with a C++ compiler */
#ifdef __cplusplus
extern "C" {
#endif

#include "/src/libzip/lib/zip.h"
#include "/src/libzip/lib/zipint.h"

#ifdef __cplusplus
}
#endif

/* --- Versatile Fuzzing Source --- */

/* Control flags to dictate the behavior of the versatile source */
#define FUZZ_FAIL_OPEN 0x01
#define FUZZ_FAIL_READ 0x02
#define FUZZ_FAIL_SEEK 0x04
#define FUZZ_FAIL_TELL 0x08
#define FUZZ_IS_SEEKABLE 0x10

/* Context for the versatile source, configured by fuzzer input */
struct fuzzer_context {
const uint8_t *data;
size_t size;
zip_uint64_t offset;

/* Fuzzer-controlled behavior */
uint8_t control_flags;
int read_fail_countdown;
};

/*
* A versatile source callback that can be configured to be seekable
* or not, and to fail various operations on demand.
*/
static zip_int64_t
versatile_source_callback(void *userdata, void *data, zip_uint64_t len, enum zip_source_cmd cmd) {
struct fuzzer_context *ctx = (struct fuzzer_context *)userdata;

switch (cmd) {
case ZIP_SOURCE_OPEN:
if (ctx->control_flags & FUZZ_FAIL_OPEN) {
return -1;
}
ctx->offset = 0;
return 0;

case ZIP_SOURCE_READ:
if (ctx->read_fail_countdown > 0) {
ctx->read_fail_countdown--;
}
if ((ctx->control_flags & FUZZ_FAIL_READ) && ctx->read_fail_countdown == 0) {
return -1;
}
if (len > ctx->size - ctx->offset) {
len = ctx->size - ctx->offset;
}
if (len > 0) {
memcpy(data, ctx->data + ctx->offset, len);
ctx->offset += len;
}
return (zip_int64_t)len;

case ZIP_SOURCE_CLOSE:
return 0;

case ZIP_SOURCE_STAT: {
zip_stat_t *st = (zip_stat_t *)data;
zip_stat_init(st);
st->size = ctx->size;
st->valid = ZIP_STAT_SIZE;
return 0;
}

case ZIP_SOURCE_ERROR:
return 0;

case ZIP_SOURCE_FREE:
free(ctx);
return 0;

case ZIP_SOURCE_SEEK: {
if (!(ctx->control_flags & FUZZ_IS_SEEKABLE)) {
return -1;
}
if (ctx->control_flags & FUZZ_FAIL_SEEK) {
return -1;
}
struct zip_source_args_seek *args = (struct zip_source_args_seek *)data;
zip_int64_t new_offset;
switch (args->whence) {
case SEEK_SET:
new_offset = args->offset;
break;
case SEEK_CUR:
new_offset = (zip_int64_t)ctx->offset + args->offset;
break;
case SEEK_END:
new_offset = (zip_int64_t)ctx->size + args->offset;
break;
default:
return -1;
}
if (new_offset < 0 || (zip_uint64_t)new_offset > ctx->size) {
return -1;
}
ctx->offset = (zip_uint64_t)new_offset;
return 0;
}

case ZIP_SOURCE_TELL:
if (!(ctx->control_flags & FUZZ_IS_SEEKABLE)) {
return -1;
}
if (ctx->control_flags & FUZZ_FAIL_TELL) {
return -1;
}
return (zip_int64_t)ctx->offset;

case ZIP_SOURCE_SUPPORTS:
if (ctx->control_flags & FUZZ_IS_SEEKABLE) {
return zip_source_make_command_bitmap(ZIP_SOURCE_OPEN, ZIP_SOURCE_READ, ZIP_SOURCE_CLOSE, ZIP_SOURCE_STAT, ZIP_SOURCE_ERROR, ZIP_SOURCE_FREE, ZIP_SOURCE_SEEK, ZIP_SOURCE_TELL, -1);
}
return zip_source_make_command_bitmap(ZIP_SOURCE_OPEN, ZIP_SOURCE_READ, ZIP_SOURCE_CLOSE, ZIP_SOURCE_STAT, ZIP_SOURCE_ERROR, ZIP_SOURCE_FREE, -1);

default:
return -1;
}
}

#ifdef __cplusplus
extern "C"
#endif
int
LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < 20) { /* Need enough data for controls and structs */
return 0;
}

/* --- Consume fuzzer data for controls --- */
uint8_t control_flags = data[0];
uint8_t read_fail_countdown = data[1];
uint8_t start_percent = data[2];
uint8_t len_control = data[3];
uint8_t option_flags = data[4]; /* To control which optional structs are used */
bool take_ownership = data[5] & 1;
zip_uint64_t st_invalid = data[6];
data += 7;
size -= 7;

zip_error_t error;
zip_error_init(&error);

/* --- Setup versatile source --- */
struct fuzzer_context *f_ctx = (struct fuzzer_context *)malloc(sizeof(*f_ctx));
if (f_ctx == NULL) {
zip_error_fini(&error);
return 0;
}
f_ctx->data = data;
f_ctx->size = size;
f_ctx->offset = 0;
f_ctx->control_flags = control_flags;
f_ctx->read_fail_countdown = read_fail_countdown;

zip_source_t *src = zip_source_function_create(versatile_source_callback, f_ctx, &error);
if (src == NULL) {
free(f_ctx);
zip_error_fini(&error);
return 0;
}

/* --- Prepare parameters for _zip_source_window_new --- */
zip_uint64_t start = (size > 0) ? (zip_uint64_t)((double)start_percent / 255.0 * size) : 0;
zip_int64_t len = (len_control == 0) ? -1 : (zip_int64_t)((double)len_control / 255.0 * size);

zip_stat_t st;
zip_stat_init(&st);
if ((option_flags & 0x01) && size >= sizeof(zip_stat_t)) {
memcpy(&st, data, sizeof(zip_stat_t));
}

zip_file_attributes_t attributes;
memset(&attributes, 0, sizeof(attributes));
if ((option_flags & 0x02) && size >= sizeof(zip_file_attributes_t)) {
memcpy(&attributes, data, sizeof(zip_file_attributes_t));
}

zip_dostime_t dostime;
memset(&dostime, 0, sizeof(dostime));
if ((option_flags & 0x04) && size >= sizeof(zip_dostime_t)) {
memcpy(&dostime, data, sizeof(zip_dostime_t));
}

zip_t *source_archive = NULL;
zip_source_t *archive_src = NULL;
if ((option_flags & 0x08) && size > 0) {
archive_src = zip_source_buffer_create(data, size, 0, &error);
if (archive_src) {
source_archive = zip_open_from_source(archive_src, 0, &error);
if (!source_archive) {
zip_source_free(archive_src);
archive_src = NULL;
}
}
}

/* --- Call the target internal function --- */
zip_source_t *window_src = _zip_source_window_new(
src, start, len, (option_flags & 0x01) ? &st : NULL, st_invalid, (option_flags & 0x02) ? &attributes : NULL, (option_flags & 0x04) ? &dostime : NULL, source_archive, 0, take_ownership, &error);

if (window_src != NULL) {
/* On success, window_src takes ownership of src and its userdata */
if (zip_source_open(window_src) == 0) {
char buffer[256];
zip_stat_t read_st;
zip_stat_init(&read_st);
zip_file_attributes_t read_attrs;
memset(&read_attrs, 0, sizeof(read_attrs));

/* Exercise various source commands */
zip_source_stat(window_src, &read_st);
zip_source_tell(window_src);
zip_source_read(window_src, buffer, sizeof(buffer));

zip_source_get_file_attributes(window_src, &read_attrs);

/* Exercise seek logic */
if ((zip_source_supports(window_src) & ZIP_SOURCE_MAKE_COMMAND_BITMASK(ZIP_SOURCE_SEEK)) != 0) {
zip_source_seek(window_src, 1, SEEK_SET);
zip_source_read(window_src, buffer, sizeof(buffer));
zip_source_seek(window_src, -1, SEEK_END);
zip_source_read(window_src, buffer, sizeof(buffer));
}

zip_source_close(window_src);
}
zip_source_free(window_src);
} else {
/* On failure, we still own src and must free it */
zip_source_free(src);
}

/* Clean up the created archive if it exists */
if (source_archive) {
zip_close(source_archive);
} else if (archive_src) {
/* if zip_open_from_source succeeded, source_archive is non-NULL.
if it failed, we still own archive_src */
zip_source_free(archive_src);
}

zip_error_fini(&error);
return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: libzip
function signature: zip_source_t * zip_source_window_create(zip_source_t *, zip_uint64_t, zip_int64_t, zip_error_t *)
</input>

<description>
The function `zip_source_window_create` creates a new zip source from a window (a sub-range) of another zip source. It takes a source `src`, a starting offset `start`, and a length `len` to define the window. The new source reads data from the original source within the specified range.
</description>

<requirements>

<requirement>
The first argument, `src`, must be a valid pointer to a `zip_source_t` struct. This is because the function will dereference this pointer to access information about the source.
</requirement>
<requirement>
The third argument, `len`, must be greater than or equal to -1. This is because a negative value other than -1 will cause an error.
</requirement>
<requirement>
If `len` is non-negative, the sum of `start` and `len` must not cause an integer overflow. An overflow would mean the specified window is invalid and will lead to an error.
</requirement>
<requirement>
The `error` argument can be a `NULL` pointer. The function checks for this and will not dereference a `NULL` pointer.
</requirement>

</requirements>

</function-requirements>

