#include <net-snmp/net-snmp-config.h>
#include <net-snmp/net-snmp-includes.h>
#include <net-snmp/library/snmp_transport.h>
#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

/*
* This fuzzer targets netsnmp_query_walk.
*
* It uses a mock transport to simulate SNMP agent responses, allowing us to
* fuzz the client-side walk logic without actual network I/O.
*/

static const uint8_t *fuzz_data;
static size_t fuzz_size;
static size_t fuzz_offset;
static int walk_count;

#define MAX_WALK_ITERATIONS 10

int netsnmp_query_walk(netsnmp_variable_list *, netsnmp_session *);

static int mock_snmp_send(netsnmp_transport *t, const void *packet, int length,
void **transport_data, int *transport_data_length) {
netsnmp_session *session = (netsnmp_session *)t->data;
netsnmp_pdu *request_pdu = NULL;
netsnmp_pdu *response = NULL;
size_t pdu_len = length;
oid next_oid[MAX_OID_LEN];
size_t next_oid_len;
u_char type;
const uint8_t *value_ptr;
size_t value_len;

if (!session) {
return -1;
}

request_pdu = snmp_pdu_create(0);
if (!request_pdu) {
return -1;
}

if (snmp_pdu_parse(request_pdu, (u_char *)packet, &pdu_len) != 0 ||
!request_pdu->variables) {
snmp_free_pdu(request_pdu);
return -1;
}

response = snmp_pdu_create(SNMP_MSG_RESPONSE);
if (!response) {
snmp_free_pdu(request_pdu);
return -1;
}
response->reqid = request_pdu->reqid;
response->version = request_pdu->version;
response->community = (u_char *)malloc(request_pdu->community_len + 1);
memcpy(response->community, request_pdu->community, request_pdu->community_len);
response->community[request_pdu->community_len] = '\0';
response->community_len = request_pdu->community_len;

if (walk_count >= MAX_WALK_ITERATIONS || fuzz_offset >= fuzz_size) {
snmp_varlist_add_variable(&response->variables, request_pdu->variables->name,
request_pdu->variables->name_length, SNMP_ENDOFMIBVIEW,
NULL, 0);
} else {
next_oid_len = request_pdu->variables->name_length;
memcpy(next_oid, request_pdu->variables->name, next_oid_len * sizeof(oid));
next_oid[next_oid_len - 1]++;
walk_count++;

type = ASN_OCTET_STR;
value_ptr = NULL;
value_len = 0;

if (fuzz_size - fuzz_offset > 2) {
type = fuzz_data[fuzz_offset] % 20;
fuzz_offset++;
value_len = fuzz_data[fuzz_offset] % 32;
fuzz_offset++;
if (fuzz_offset + value_len > fuzz_size) {
value_len = fuzz_size - fuzz_offset;
}
value_ptr = fuzz_data + fuzz_offset;
fuzz_offset += value_len;
}
snmp_varlist_add_variable(&response->variables, next_oid, next_oid_len,
type, value_ptr, value_len);
}

session->callback(NETSNMP_CALLBACK_OP_RECEIVED_MESSAGE, session,
response->reqid, response, session->callback_magic);

snmp_free_pdu(request_pdu);
snmp_free_pdu(response);
return length;
}

static int mock_snmp_close(netsnmp_transport *t) {
/*
* Do not free the transport here. The caller, snmp_sess_close,
* is responsible for freeing the transport structure. Freeing it
* here would lead to a double-free.
*/
return 0;
}

static int mock_snmp_setup_session(netsnmp_transport *t, netsnmp_session *s) {
t->data = s;
return 0;
}

static netsnmp_transport *mock_transport_create_from_tspec(netsnmp_tdomain_spec *tspec) {
netsnmp_transport *t = (netsnmp_transport *)calloc(1, sizeof(netsnmp_transport));
if (t == NULL) {
return NULL;
}
t->f_send = mock_snmp_send;
t->f_close = mock_snmp_close;
t->f_setup_session = mock_snmp_setup_session;
t->msgMaxSize = 65535;
return t;
}

static oid mock_domain[] = {1, 3, 6, 1, 4, 1, 8072, 9999, 9999, 1};
static const char *mock_prefix[] = {"fuzz", NULL};
static netsnmp_tdomain mock_domain_def;

int LLVMFuzzerInitialize(int *argc, char ***argv) {
if (getenv("NETSNMP_DEBUGGING") != NULL) {
snmp_enable_stderrlog();
snmp_set_do_debugging(1);
debug_register_tokens("");
}
init_snmp("snmp-fuzzer");

mock_domain_def.name = mock_domain;
mock_domain_def.name_length = OID_LENGTH(mock_domain);
mock_domain_def.prefix = mock_prefix;
mock_domain_def.f_create_from_tspec = mock_transport_create_from_tspec;
netsnmp_tdomain_register(&mock_domain_def);
return 0;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
netsnmp_session session, *ss;
netsnmp_variable_list *vars = NULL;
oid start_oid[MAX_OID_LEN];
size_t start_oid_len;

if (size < 4) {
return 0;
}

fuzz_data = data;
fuzz_size = size;
fuzz_offset = 0;
walk_count = 0;

snmp_sess_init(&session);
session.version = SNMP_VERSION_2c;
session.peername = strdup("fuzz:target");
session.community = (u_char *)strdup("public");
session.community_len = strlen((const char *)session.community);

ss = snmp_open(&session);

free(session.peername);
free(session.community);

if (!ss) {
return 0;
}

start_oid_len = (data[fuzz_offset] % 10) + 2;
fuzz_offset++;
if (fuzz_offset + start_oid_len > size) {
snmp_close(ss);
return 0;
}
for (size_t i = 0; i < start_oid_len; i++) {
start_oid[i] = data[fuzz_offset + i];
}
fuzz_offset += start_oid_len;

snmp_varlist_add_variable(&vars, start_oid, start_oid_len, ASN_NULL, NULL, 0);
if (!vars) {
snmp_close(ss);
return 0;
}

netsnmp_query_walk(vars, ss);

snmp_free_varbind(vars);
snmp_close(ss);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: net-snmp
function signature: int netsnmp_query_walk(netsnmp_variable_list *, netsnmp_session *)
</input>

<description>
The `netsnmp_query_walk` function performs a walk of a MIB subtree for a given SNMP session. It starts from the OID specified in the `list` argument and iteratively performs GETNEXT requests to retrieve all variables under that subtree root. The `list` argument is used both as input to specify the starting OID and as output to store the linked list of retrieved variable bindings. The `session` argument specifies the SNMP session to use for the queries.
</description>

<requirements>

<requirement>
The `session` argument must be a valid pointer to an initialized `netsnmp_session` structure. This session should be created by calling `snmp_open()` to ensure it is properly configured for communication.
</requirement>
<requirement>
The `list` argument must be a valid pointer to a `netsnmp_variable_list` structure. It must contain at least one variable binding which defines the root OID of the subtree to be walked.
</requirement>
<requirement>
The variable binding in the `list` argument should be created using a function like `snmp_varlist_add_variable()`. This ensures the OID `name` and `name_length` are correctly set for the walk operation.
</requirement>
<requirement>
The `list` variable's `next_variable` pointer should be NULL on input if only one subtree is to be walked. The function uses the initial varbind to track the walk and appends results to the list.
</requirement>

</requirements>

</function-requirements>

