//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
//  See the License for the specific language governing permissions and
//  limitations under the License.
// ----------------------------------------------------------------------------

#include "astcenc_internal.h"

#include <array>
#include <fuzzer/FuzzedDataProvider.h>
#include <vector>

struct BlockSizes {
int x;
int y;
int z;
};

std::array<BlockSizes, 3> testSz{{
{4, 4, 1},   // Highest bitrate
{12, 12, 1}, // Largest 2D block
{6, 6, 6}    // Largest 3D block
}};

std::array<block_size_descriptor, 3> testBSD;

/**
* @brief Utility function to create all of the block size descriptors needed.
*/
bool bsd_initializer() {
for (size_t i = 0; i < testSz.size(); i++) {
init_block_size_descriptor(testSz[i].x, testSz[i].y, testSz[i].z, false, 4, 1.0f, testBSD[i]);
}
return true;
}

/**
* @brief Get the number of values for a color endpoint mode.
*
* This is a local implementation as the library function is not exported.
*/
static unsigned int get_cem_num_values(
unsigned int cem
) {
if (cem == 5)
{
return 3;
}
if (cem == 6)
{
return 4;
}
return 2;
}

/**
* @brief Get the number of bits for a color endpoint.
*/
static unsigned int get_color_endpoint_bits(
unsigned int cem,
quant_method qm
) {
unsigned int values = get_cem_num_values(cem);
return get_ise_sequence_bitcount(values, qm);
}

/**
* @brief Pre-calculates the number of bits required for a symbolic block.
*
* This replicates the bit counting logic from symbolic_to_physical without
* actually writing any data, to prevent buffer overflows.
*
* @param bsd The block size descriptor.
* @param scb The symbolic compressed block.
*
* @return The total number of bits required.
*/
int get_symbolic_compressed_block_bits(
const block_size_descriptor& bsd,
const symbolic_compressed_block& scb
) {
if (scb.block_type == SYM_BTYPE_CONST_U16 || scb.block_type == SYM_BTYPE_CONST_F16)
{
return 128;
}

// Base header bits for different partition counts.
// These values are derived from the ASTC specification (128 - free_bits).
static const int header_bits[4] = { 13, 17, 20, 23 };

const block_mode& bm = bsd.block_modes[scb.block_mode];
int partition_count = scb.partition_count;

int bit_count = header_bits[partition_count - 1] + bm.weight_bits;

int plane_count = bm.is_dual_plane ? 2 : 1;
for (int i = 0; i < plane_count; i++)
{
int color_formats[4];
if (scb.color_formats_matched)
{
int cf = scb.color_formats[0];
for (int j = 0; j < partition_count; j++)
{
color_formats[j] = cf;
}
}
else
{
for (int j = 0; j < partition_count; j++)
{
color_formats[j] = scb.color_formats[j];
}
}

for (int j = 0; j < partition_count; j++)
{
bit_count += get_color_endpoint_bits(color_formats[j], scb.quant_mode);
}
}

return bit_count;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
// Preinitialize the block size descriptors we need
static bool init = bsd_initializer();

if (size < 256) {
return 0;
}

FuzzedDataProvider stream(data, size);

// Select a block size to test
int bsd_index = stream.ConsumeIntegralInRange<int>(0, testSz.size() - 1);
const block_size_descriptor &bsd = testBSD[bsd_index];

// Populate the symbolic block
symbolic_compressed_block scb;

const uint8_t block_types[] = {SYM_BTYPE_NONCONST, SYM_BTYPE_CONST_U16, SYM_BTYPE_CONST_F16};
scb.block_type = stream.PickValueInArray(block_types);

if (scb.block_type == SYM_BTYPE_ERROR) {
return 0;
}

if (scb.block_type == SYM_BTYPE_CONST_U16 || scb.block_type == SYM_BTYPE_CONST_F16) {
for (int i = 0; i < BLOCK_MAX_COMPONENTS; ++i) {
scb.constant_color[i] = stream.ConsumeIntegral<uint16_t>();
}
} else { // SYM_BTYPE_NONCONST
scb.partition_count = stream.ConsumeIntegralInRange<uint8_t>(1, 4);

// Create a list of valid block modes for the chosen BSD
std::vector<uint16_t> valid_block_modes;
if (bsd.block_mode_count_all > 0) {
for (unsigned int i = 0; i < bsd.block_mode_count_all; i++) {
if (bsd.block_mode_packed_index[i] != BLOCK_BAD_BLOCK_MODE) {
valid_block_modes.push_back(i);
}
}
}

// If there are no valid modes for this BSD, we can't proceed
if (valid_block_modes.empty()) {
return 0;
}
size_t index = stream.ConsumeIntegralInRange<size_t>(0, valid_block_modes.size() - 1);
scb.block_mode = valid_block_modes[index];

scb.partition_index = stream.ConsumeIntegral<uint16_t>();
scb.color_formats_matched = stream.ConsumeBool();

// The valid range is QUANT_6 to QUANT_32.
scb.quant_mode = static_cast<quant_method>(stream.ConsumeIntegralInRange<int>(QUANT_6, QUANT_32));

scb.plane2_component = stream.ConsumeIntegralInRange<int8_t>(-1, 3);

for (unsigned int i = 0; i < scb.partition_count; ++i) {
// (format >> 2) must be <= 3. So format must be < 16.
scb.color_formats[i] = stream.ConsumeIntegralInRange<uint8_t>(0, 15);
for (int j = 0; j < 8; ++j) {
scb.color_values[i][j] = stream.ConsumeIntegral<uint8_t>();
}
}

for (int i = 0; i < BLOCK_MAX_WEIGHTS; ++i) {
scb.weights[i] = stream.ConsumeIntegral<uint8_t>();
}
}

// Check that the generated symbolic block will fit in 128 bits
if (scb.block_type == SYM_BTYPE_NONCONST) {
int bits_needed = get_symbolic_compressed_block_bits(bsd, scb);
if (bits_needed > 128)
{
return 0;
}
}

// Call the function under test
uint8_t pcb[16];
symbolic_to_physical(bsd, scb, pcb);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: astc-encoder
function signature: void symbolic_to_physical(const struct block_size_descriptor &, const struct symbolic_compressed_block &, uint8_t *)
</input>

<description>
The `symbolic_to_physical` function converts a symbolic representation of a compressed block (`symbolic_compressed_block`) into a physical hardware-readable format (`uint8_t pcb[16]`). The conversion process depends on the block type specified in the symbolic block. For constant color blocks, it directly writes the color data to the physical block. For other block types, it performs a series of operations including weight compression, color endpoint encoding, and writing various header fields to the physical block. The function relies on a `block_size_descriptor` to get information about the block mode, decimation, and partitioning.
</description>

<requirements>

<requirement>
The `scb.block_type` field must not be `SYM_BTYPE_ERROR`. This is because the function has an assertion to prevent processing of erroneous blocks, and different block types trigger different processing paths.
</requirement>
<requirement>
The `scb.partition_count` field must be between 1 and 4, inclusive. This is because the function's logic, particularly for encoding color endpoints and partition indices, is designed to handle up to 4 partitions.
</requirement>
<requirement>
The `scb.block_mode` field must be a valid index into the `bsd.block_modes` array. This is to prevent out-of-bounds access when retrieving block mode information from the `block_size_descriptor`.
</requirement>
<requirement>
The `scb.color_formats` values must be such that `(color_format >> 2) <= 3`. This is to prevent an assertion failure `assert(vals <= 8)` where `vals` is calculated based on `color_format`.
</requirement>
<requirement>
The `scb.quant_mode` field should be between `QUANT_6` (6) and `QUANT_32` (12). This is to avoid out-of-bounds access on the `color_uquant_to_scrambled_pquant_tables` array.
</requirement>
<requirement>
The `bsd` argument should be initialized by calling `init_block_size_descriptor`. This is because the function heavily relies on the precomputed tables and metadata within the `block_size_descriptor` for its operations.
</requirement>
<requirement>
The `pcb` argument must be a writable buffer of at least 16 bytes. This is because the function writes the 16-byte physical block representation into this buffer.
</requirement>

</requirements>

</function-requirements>

