#include "cppcheck.h"
#include "errorlogger.h"
#include "errortypes.h"
#include "filesettings.h"
#include "settings.h"
#include "suppressions.h"

#include <string>

#ifndef NO_FUZZ
#include <cstddef>
#include <cstdint>
#include <fuzzer/FuzzedDataProvider.h>
#include <ctime>
#include <sstream>
#include <utility>

#include "tokenlist.h"
#include "tokenize.h"
#include "/src/cppcheck/lib/templatesimplifier.h"
#include "standards.h"

#else
#include <cstdlib>
#include <fstream>
#include <sstream>
#endif

class DummyErrorLogger : public ErrorLogger {
public:
void reportOut(const std::string& /*outmsg*/, Color /*c*/) override {}
void reportErr(const ErrorMessage& /*msg*/) override {}
void reportProgress(const std::string& /*filename*/,
const char /*stage*/[],
const std::size_t /*value*/) override {}
void reportMetric(const std::string & /*metric*/) override {}
};

#ifndef NO_FUZZ
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size);

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
{
FuzzedDataProvider provider(data, size);
const std::string code = provider.ConsumeRemainingBytesAsString();

Settings settings;
settings.addEnabled("all");
settings.standards.cpp = Standards::CPP20;

DummyErrorLogger errorLogger;

TokenList tokenList(settings, Standards::Language::CPP);

std::stringstream ss(code);
if (!tokenList.createTokens(ss)) {
return 0;
}

// If the token list is empty, return early to avoid a crash.
if (!tokenList.front()) {
return 0;
}

Tokenizer tokenizer(std::move(tokenList), errorLogger);

TemplateSimplifier simplifier(tokenizer);

// Call the target function with a timeout
simplifier.simplifyTemplates(time(nullptr) + 5);

return 0;
}
#else
// Original main for non-fuzzing builds
int main(int argc, char * argv[])
{
if (argc < 2 || argc > 3)
return EXIT_FAILURE;

std::ifstream f(argv[1]);
if (!f.is_open())
return EXIT_FAILURE;

std::ostringstream oss;
oss << f.rdbuf();

if (!f.good())
return EXIT_FAILURE;

const int cnt = (argc == 3) ? std::stoi(argv[2]) : 1;

const std::string code = oss.str();
// Dummy doCheck for non-fuzzing build to compile
auto doCheck = [&](const std::string& code_to_check){
static Settings s_settings;
s_settings.addEnabled("all");
static DummyErrorLogger s_errorLogger;
static Suppressions supprs;
static const FileWithDetails s_file("test.cpp", Standards::Language::CPP, 0);
CppCheck cppcheck(s_settings, supprs, s_errorLogger, false, nullptr);
cppcheck.check(s_file, code_to_check);
};

for (int i = 0; i < cnt; ++i)
doCheck(code);

return EXIT_SUCCESS;
}
#endif
</fuzz-target>

<function-requirements>

<input>
project name: cppcheck
function signature: void TemplateSimplifier::simplifyTemplates(const std::time_t)
</input>

<description>
The function `simplifyTemplates` is a method of the `TemplateSimplifier` class. It simplifies C++ template code. The simplification process is complex and involves multiple passes. The function takes a `maxtime` argument to limit the execution time. The main input to this function is the C++ code that has been tokenized by the `Tokenizer` object, which is a member of the `TemplateSimplifier` class.
</description>

<requirements>

<requirement>
A `TemplateSimplifier` object must be initialized before calling the target function. This is because the function operates on the internal state of the `TemplateSimplifier` object.
</requirement>
<requirement>
To initialize a `TemplateSimplifier` object, a `Tokenizer` object must be created and passed to its constructor. This is because the `TemplateSimplifier` uses the `Tokenizer` to access the tokenized code.
</requirement>
<requirement>
To initialize a `Tokenizer` object, a `Settings` object and an `ErrorLogger` object must be created and passed to its constructor. The `Settings` object can be default-constructed, and a `CppcheckExecutor` object can be used as the `ErrorLogger`.
</requirement>
<requirement>
Before calling `simplifyTemplates`, the `tokenize` method of the `Tokenizer` object must be called with a string of C++ code. This is because `simplifyTemplates` processes the tokens generated by the `tokenize` method.
</requirement>
<requirement>
The `maxtime` argument should be a valid `time_t` value. A large value is recommended to avoid premature termination of the simplification process, especially for complex templates.
</requirement>

</requirements>

</function-requirements>

