<fuzz-target>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

#include "/src/jq/vendor/oniguruma/src/oniguruma.h"

// A selection of supported encodings to be chosen by the fuzzer.
static OnigEncoding supported_encodings[] = {
ONIG_ENCODING_ASCII,      ONIG_ENCODING_ISO_8859_1,
ONIG_ENCODING_ISO_8859_2,  ONIG_ENCODING_ISO_8859_3,
ONIG_ENCODING_ISO_8859_4,  ONIG_ENCODING_ISO_8859_5,
ONIG_ENCODING_ISO_8859_6,  ONIG_ENCODING_ISO_8859_7,
ONIG_ENCODING_ISO_8859_8,  ONIG_ENCODING_ISO_8859_9,
ONIG_ENCODING_ISO_8859_10, ONIG_ENCODING_ISO_8859_11,
ONIG_ENCODING_ISO_8859_13, ONIG_ENCODING_ISO_8859_14,
ONIG_ENCODING_ISO_8859_15, ONIG_ENCODING_ISO_8859_16,
ONIG_ENCODING_EUC_JP,     ONIG_ENCODING_EUC_TW,
ONIG_ENCODING_EUC_KR,     ONIG_ENCODING_EUC_CN,
ONIG_ENCODING_SJIS,       ONIG_ENCODING_KOI8_R,
ONIG_ENCODING_CP1251,     ONIG_ENCODING_BIG5,
ONIG_ENCODING_GB18030,    ONIG_ENCODING_UTF8,
ONIG_ENCODING_UTF16_BE,   ONIG_ENCODING_UTF16_LE,
ONIG_ENCODING_UTF32_BE,   ONIG_ENCODING_UTF32_LE,
};

// All supported syntaxes to be chosen by the fuzzer.
// Note: ONIG_SYNTAX_DEFAULT is a variable, not a constant, so it's excluded.
static OnigSyntaxType *supported_syntaxes[] = {
ONIG_SYNTAX_ASIS,           ONIG_SYNTAX_POSIX_BASIC,
ONIG_SYNTAX_POSIX_EXTENDED, ONIG_SYNTAX_EMACS,
ONIG_SYNTAX_GREP,           ONIG_SYNTAX_GNU_REGEX,
ONIG_SYNTAX_JAVA,           ONIG_SYNTAX_PERL,
ONIG_SYNTAX_PERL_NG,        ONIG_SYNTAX_RUBY,
ONIG_SYNTAX_ONIGURUMA,
};

// Callback function for onig_scan.
// It returns a fuzzer-controlled value to test both continuation and early-exit paths.
static int scan_callback(int match_index, int r, OnigRegion *region, void *arg) {
// Unused parameters
(void)match_index;
(void)r;
(void)region;

// Return the value provided by the fuzzer.
// 0 continues the scan, non-zero stops it.
if (arg) {
return *(int *)arg;
}
return 0;
}

// Fuzzer entrypoint
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
// We need enough data for encoding/syntax selection, options, callback value,
// and a minimal pattern/string.
if (size < 2 + sizeof(OnigOptionType) * 2 + sizeof(int) + 2) {
return 0;
}

// Consume a byte to select encoding and another for syntax.
const uint8_t encoding_choice = data[0];
const uint8_t syntax_choice = data[1];
data += 2;
size -= 2;

OnigEncoding chosen_encoding = supported_encodings[encoding_choice % (sizeof(supported_encodings) / sizeof(supported_encodings[0]))];
OnigSyntaxType *chosen_syntax = supported_syntaxes[syntax_choice % (sizeof(supported_syntaxes) / sizeof(supported_syntaxes[0]))];

// Initialize Oniguruma library with the chosen encoding.
OnigEncoding encodings[] = {chosen_encoding};
onig_initialize(encodings, sizeof(encodings) / sizeof(encodings[0]));

// Consume compile options from the fuzzer input.
OnigOptionType compile_options;
memcpy(&compile_options, data, sizeof(OnigOptionType));
data += sizeof(OnigOptionType);
size -= sizeof(OnigOptionType);

// Sanitize the compile options to only allow those supported by jq's 'f_match'.
const OnigOptionType allowed_compile_options =
ONIG_OPTION_IGNORECASE | ONIG_OPTION_EXTEND | ONIG_OPTION_MULTILINE |
ONIG_OPTION_SINGLELINE | ONIG_OPTION_FIND_LONGEST |
ONIG_OPTION_FIND_NOT_EMPTY;
compile_options &= allowed_compile_options;

// Consume search options from the fuzzer input.
OnigOptionType search_options;
memcpy(&search_options, data, sizeof(OnigOptionType));
data += sizeof(OnigOptionType);
size -= sizeof(OnigOptionType);

// Consume a value to be returned by the callback.
int callback_rc;
memcpy(&callback_rc, data, sizeof(int));
data += sizeof(int);
size -= sizeof(int);

// Split the rest of the data for the pattern and the search string.
size_t pattern_size = size / 2;
const OnigUChar *pattern = (const OnigUChar *)data;
const OnigUChar *pattern_end = pattern + pattern_size;

const OnigUChar *str = (const OnigUChar *)(data + pattern_size);
const OnigUChar *end = str + (size - pattern_size);

regex_t *reg = NULL;
OnigErrorInfo einfo;
int r = onig_new(&reg, pattern, pattern_end, compile_options, chosen_encoding, chosen_syntax, &einfo);

if (r == ONIG_NORMAL) {
OnigRegion *region = onig_region_new();
if (region) {
onig_scan(reg, str, end, region, search_options, scan_callback, &callback_rc);
onig_region_free(region, 1 /* free self */);
}
onig_free(reg);
}

// Clean up Oniguruma library resources.
onig_end();

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: jq
function signature: int onig_scan(regex_t *, const OnigUChar *, const OnigUChar *, OnigRegion *, OnigOptionType, int (*)(int, int, OnigRegion*, void *), void *)
</input>

<description>
The `onig_scan` function repeatedly searches for a regular expression pattern within a string, from a starting position to an end position. For each match found, it invokes a user-defined callback function, `scan_callback`. The function begins by compiling the regular expression using `onig_new` and prepares a region object with `onig_region_new`. The core of its operation is a loop that repeatedly calls `onig_search`. When `onig_search` finds a match, `onig_scan` executes the `scan_callback` function, passing it details about the match. The scan continues until no more matches can be found, the callback function returns a non-zero value, or an error occurs within `onig_search`. The function returns the total number of matches found or an error code if the scan fails.
</description>

<requirements>

<requirement>
The `onig_initialize` function must be called before any other Oniguruma function. This sets up the necessary environment and internal structures for the library to operate correctly.
</requirement>
<requirement>
The first argument, `reg`, must be a compiled regular expression of type `regex_t*`, initialized by `onig_new`. `onig_scan` uses this compiled pattern to perform the search, and a valid object is essential to prevent null pointer dereferences or crashes.
</requirement>
<requirement>
The fourth argument, `region`, must be a valid `OnigRegion*` object created by `onig_region_new`. This structure is used internally to store information about the matched substrings, and it must be properly allocated to avoid memory corruption.
</requirement>
<requirement>
The `str` and `end` pointers, the second and third arguments, must define a valid and accessible memory range. The `end` address must be greater than or equal to `str` to prevent buffer overflows or segmentation faults during scanning.
</requirement>
<requirement>
The sixth argument, `scan_callback`, must be a non-null function pointer. This callback is dereferenced and executed for every match found, so a null pointer would lead to a crash.
</requirement>
<requirement>
The `scan_callback` function should return 0 to ensure the scan continues through all possible matches. A non-zero return value will cause `onig_scan` to terminate its operation prematurely.
</requirement>
<requirement>
To prevent resource leaks, `onig_free` must be called on the `regex_t` object and `onig_region_free` on the `OnigRegion` object after `onig_scan` has completed. Futhermore, `onig_end` should be called for a final cleanup of all resources used by the Oniguruma library.
</requirement>

</requirements>

</function-requirements>

