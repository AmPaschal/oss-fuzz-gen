#include "/src/astc-encoder/Source/astcenc_internal.h"

#include <fuzzer/FuzzedDataProvider.h>
#include <array>
#include <vector>
#include <cstring>

struct BlockSizes {
int x;
int y;
int z;
};

std::array<BlockSizes, 3> testSz{{
{4, 4, 1},   // Highest bitrate
{12, 12, 1}, // Largest 2D block
{6, 6, 6}    // Largest 3D block
}};

std::array<block_size_descriptor, 3> testBSD;

/**
* @brief Utility function to create all of the block size descriptors needed.
*/
bool bsd_initializer() {
for (size_t i = 0; i < testSz.size(); i++) {
init_block_size_descriptor(testSz[i].x, testSz[i].y, testSz[i].z, false, 4, 1.0f, testBSD[i]);
}
return true;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
// Preinitialize the block size descriptors we need
static bool init = bsd_initializer();

if (size < 1) {
return 0;
}

FuzzedDataProvider stream(data, size);

// Select a block size to test
int i = stream.ConsumeIntegralInRange<int>(0, static_cast<int>(testSz.size() - 1));
const block_size_descriptor& bsd = testBSD[i];

// Create and populate the symbolic block
symbolic_compressed_block scb;
std::memset(&scb, 0, sizeof(scb));

// Populate scb according to requirements
const uint8_t block_types[] = {SYM_BTYPE_CONST_F16, SYM_BTYPE_CONST_U16, SYM_BTYPE_NONCONST};
scb.block_type = stream.PickValueInArray(block_types);

if (scb.block_type == SYM_BTYPE_NONCONST) {
scb.partition_count = stream.ConsumeIntegralInRange<uint8_t>(1, 4);

// The block_mode must be valid for the chosen block_size_descriptor.
// Create a list of valid modes by checking the packed_index.
std::vector<uint16_t> valid_modes;
for (unsigned int mode = 0; mode < WEIGHTS_MAX_BLOCK_MODES; ++mode) {
if (bsd.block_mode_packed_index[mode] != BLOCK_BAD_BLOCK_MODE) {
valid_modes.push_back(mode);
}
}

// If there are no valid modes for this bsd, we can't proceed.
if (valid_modes.empty()) {
return 0;
}

size_t mode_index = stream.ConsumeIntegralInRange<size_t>(0, valid_modes.size() - 1);
scb.block_mode = valid_modes[mode_index];

scb.quant_mode = static_cast<quant_method>(stream.ConsumeIntegralInRange<int>(6, 11));
scb.color_formats_matched = stream.ConsumeBool();
scb.plane2_component = stream.ConsumeIntegralInRange<int8_t>(-1, 3);

if (scb.partition_count > 1) {
scb.partition_index = stream.ConsumeIntegral<uint16_t>();
}

for (unsigned int j = 0; j < scb.partition_count; ++j) {
// Valid color formats are 0-15.
scb.color_formats[j] = stream.ConsumeIntegralInRange<uint8_t>(0, 15);
}

stream.ConsumeData(scb.color_values, sizeof(scb.color_values));
stream.ConsumeData(scb.weights, sizeof(scb.weights));

} else { // SYM_BTYPE_CONST_F16 or SYM_BTYPE_CONST_U16
stream.ConsumeData(scb.constant_color, sizeof(scb.constant_color));
}

// Output buffer
uint8_t pcb[16];

// Call the function under test
symbolic_to_physical(bsd, scb, pcb);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: astc-encoder
function signature: void symbolic_to_physical(const struct block_size_descriptor &, const struct symbolic_compressed_block &, uint8_t *)
</input>

<description>
The `symbolic_to_physical` function converts a symbolic representation of a compressed ASTC block (`symbolic_compressed_block`) into a physical hardware-ready 128-bit block (`uint8_t pcb[16]`). It takes a `block_size_descriptor` which contains information about the block dimensions and modes, and the symbolic block itself. The function handles different types of blocks, including constant color blocks and blocks with multiple partitions and weights. It performs quantization and encoding of color endpoints and weights according to the parameters specified in the symbolic block and the block size descriptor. The final output is a 16-byte array representing the physical ASTC block.
</description>

<requirements>

<requirement>
The `bsd` argument must be a valid `block_size_descriptor` initialized by `init_block_size_descriptor`. This is because the function relies on `bsd` to provide correct block mode and decimation information for processing the symbolic block.
</requirement>
<requirement>
The block dimensions passed to `init_block_size_descriptor` must be between 1 and 12 for x, y and z. This is enforced by assertions within `init_block_size_descriptor`.
</requirement>
<requirement>
`scb.block_type` must not be `SYM_BTYPE_ERROR`. This is because an assertion `assert(scb.block_type != SYM_BTYPE_ERROR)` exists at the beginning of the function.
</requirement>
<requirement>
`scb.block_mode` must be a value less than `ASTCENC_BLOCK_MODE_COUNT` (2048). This is because `scb.block_mode` is used as an index to retrieve block mode information from the `bsd`.
</requirement>
<requirement>
`scb.partition_count` must be between 1 and 4, inclusive. This is because it is used in calculations like `partition_count - 1` for writing bits, and the number of partitions in ASTC is limited.
</requirement>
<requirement>
`scb.quant_mode` must be between 6 and 11, inclusive. This is to prevent out-of-bounds access on `color_uquant_to_scrambled_pquant_tables`.
</requirement>
<requirement>
The upper bits of `scb.color_formats[i]` (i.e., `scb.color_formats[i] >> 2`) must be less than or equal to 3. This is to satisfy the assertion `assert(vals <= 8)` where `vals` is derived from `scb.color_formats`.
</requirement>
<requirement>
`scb.weights` should contain values between 0 and 64. This is because they are scaled by `1.0/64.0` before quantization.
</requirement>
<requirement>
The `pcb` argument must point to a valid memory buffer of at least 16 bytes. This is because the function writes 16 bytes (128 bits) of the physical block data into this buffer.
</requirement>

</requirements>

</function-requirements>

