#include "/src/astc-encoder/Source/astcenc_internal.h"

#include <fuzzer/FuzzedDataProvider.h>
#include <vector>
#include <utility>

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
// We need at least some bytes for parameters and 16 for the payload
if (size < 1 + 16) {
return 0;
}

FuzzedDataProvider stream(data, size);

// A list of 2D block sizes that have precomputed percentile tables.
// Using other sizes will cause a crash in init_block_size_descriptor.
// Use a C-style array to be compatible with PickValueInArray.
const std::pair<int, int> valid_2d_block_sizes[] = {
{4, 4}, {5, 4}, {5, 5}, {6, 5}, {6, 6}, {8, 5}, {8, 6}, {8, 8},
{10, 5}, {10, 6}, {10, 8}, {10, 10}, {12, 10}, {12, 12}
};

// Fuzz the parameters for the block_size_descriptor
// Valid block dimensions are 4-12 for 2D, and 1-12 for 3D axes
int x, y, z;

// Decide if we are fuzzing a 2D or 3D block
bool is_3d = stream.ConsumeBool();

if (is_3d) {
// For 3D blocks, the product of dimensions must be at least 12.
// Keep generating dimensions until this condition is met.
do {
x = stream.ConsumeIntegralInRange<int>(1, 12);
y = stream.ConsumeIntegralInRange<int>(1, 12);
z = stream.ConsumeIntegralInRange<int>(2, 12); // z > 1 for 3D
} while (static_cast<size_t>(x) * y * z < 12 && stream.remaining_bytes() > 2);
} else {
// For 2D, we must pick a valid block size to avoid crashes.
std::pair<int, int> block_dim = stream.PickValueInArray(valid_2d_block_sizes);
x = block_dim.first;
y = block_dim.second;
z = 1;
}

// If we ran out of data generating valid 3D dimensions, exit.
if (stream.remaining_bytes() < 16) {
return 0;
}

bool is_srgb = stream.ConsumeBool();
// The number of components is determined by the swizzle in the library,
// not directly configurable in the same way. We use 4 as a representative
// value, consistent with the original fuzzer.
int num_components = 4;

// Initialize the block size descriptor with fuzzed values
// Allocate on the heap to avoid stack overflow
block_size_descriptor* bsd = new block_size_descriptor;
// The error weight is not critical for this fuzzer's goal
init_block_size_descriptor(x, y, z, is_srgb, num_components, 1.0f, *bsd);

// Populate the physical block from the rest of the fuzzer data
uint8_t pcb[16];
std::vector<uint8_t> buffer = stream.ConsumeBytes<uint8_t>(16);

// Ensure we have enough data for the physical block
if (buffer.size() < 16) {
delete bsd;
return 0;
}
std::memcpy(pcb, buffer.data(), 16);

// Allocate the symbolic block on the heap to avoid stack overflow
symbolic_compressed_block* scb = new symbolic_compressed_block;
physical_to_symbolic(*bsd, pcb, *scb);

// Call the function under test, but only on valid blocks
if (scb->block_type != SYM_BTYPE_ERROR) {
(void)scb->get_color_quant_mode();
}

delete scb;
delete bsd;
return 0;
}
</fuzz-target>

