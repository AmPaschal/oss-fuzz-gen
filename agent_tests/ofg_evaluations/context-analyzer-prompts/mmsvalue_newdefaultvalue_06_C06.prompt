<fuzz-target>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>

// Override memory allocation functions for fault injection
#define GLOBAL_CALLOC(count, size) fuzz_calloc(count, size)
#define GLOBAL_FREEMEM(ptr) fuzz_free(ptr)
#define GLOBAL_REALLOC(ptr, size) realloc(ptr, size)

// Fuzzing-controlled memory allocation
static int allocation_failure_countdown = -1;

static void* fuzz_calloc(size_t count, size_t size) {
if (allocation_failure_countdown > 0) {
allocation_failure_countdown--;
}

if (allocation_failure_countdown == 0) {
// Reset to -1 to prevent subsequent failures unless intended
allocation_failure_countdown = -1; 
return NULL;
}

return calloc(count, size);
}

static void fuzz_free(void* ptr) {
free(ptr);
}


#include "/src/libiec61850/src/mms/inc/mms_value.h"
#include "mms_types.h"
#include "mms_common.h"
#include "hal_thread.h"

#define MAX_RECURSION_DEPTH 3
#define MAX_ELEMENTS 5

// Forward declarations for recursive functions
struct sMmsVariableSpecification;
static void free_spec(struct sMmsVariableSpecification* spec);
static struct sMmsVariableSpecification* generate_spec(const uint8_t** data, size_t* size, int depth);

// Helper to safely consume a byte from the fuzzer input
static uint8_t
consume_byte(const uint8_t** data, size_t* size)
{
if (*size == 0) {
return 0;
}
uint8_t value = **data;
(*data)++;
(*size)--;
return value;
}

// Recursively generates an MmsVariableSpecification from fuzzer data
static MmsVariableSpecification*
generate_spec(const uint8_t** data, size_t* size, int depth)
{
if (depth > MAX_RECURSION_DEPTH || *size < 1) {
return NULL;
}

MmsVariableSpecification* spec = (MmsVariableSpecification*)calloc(1, sizeof(MmsVariableSpecification));
if (!spec) {
return NULL;
}

spec->type = (MmsType)(consume_byte(data, size) % (MMS_DATA_ACCESS_ERROR + 1));
spec->name = NULL;

switch (spec->type) {
case MMS_INTEGER:
spec->typeSpec.integer = (int)(int8_t)consume_byte(data, size);
break;
case MMS_UNSIGNED:
spec->typeSpec.unsignedInteger = (int)consume_byte(data, size);
break;
case MMS_BIT_STRING:
// Cast to int8_t to generate negative values to test abs()
spec->typeSpec.bitString = (int)(int8_t)consume_byte(data, size);
break;
case MMS_VISIBLE_STRING:
// Cast to int8_t to generate negative values to test abs()
spec->typeSpec.visibleString = (int)(int8_t)consume_byte(data, size);
break;
case MMS_STRING:
// Cast to int8_t to generate negative values to test abs()
// NOTE: The target function uses `visibleString` for MMS_STRING type as well.
spec->typeSpec.visibleString = (int)(int8_t)consume_byte(data, size);
break;
case MMS_OCTET_STRING:
// Cast to int8_t to generate negative values to test the if (size < 0) branch
spec->typeSpec.octetString = (int)(int8_t)consume_byte(data, size);
break;
case MMS_FLOAT:
spec->typeSpec.floatingpoint.exponentWidth = consume_byte(data, size);
spec->typeSpec.floatingpoint.formatWidth = consume_byte(data, size);
break;
case MMS_BINARY_TIME:
// The target code checks for spec->typeSpec.binaryTime == 4.
// The original fuzzer only generated 0 or 1. By assigning the raw
// byte, the fuzzer can discover the value 4 and cover the branch.
spec->typeSpec.binaryTime = consume_byte(data, size);
break;
case MMS_ARRAY: {
spec->typeSpec.array.elementCount = consume_byte(data, size) % MAX_ELEMENTS;
spec->typeSpec.array.elementTypeSpec = generate_spec(data, size, depth + 1);
if (spec->typeSpec.array.elementTypeSpec == NULL) {
spec->typeSpec.array.elementCount = 0;
}
break;
}
case MMS_STRUCTURE: {
int count = consume_byte(data, size) % MAX_ELEMENTS;
spec->typeSpec.structure.elementCount = count;
if (count > 0) {
spec->typeSpec.structure.elements = (MmsVariableSpecification**)calloc(count, sizeof(MmsVariableSpecification*));
if (!spec->typeSpec.structure.elements) {
spec->typeSpec.structure.elementCount = 0;
break;
}
for (int i = 0; i < count; i++) {
// Consume a byte to decide if this element should be NULL to cover the target branch.
if ((consume_byte(data, size) % 4) == 0) {
spec->typeSpec.structure.elements[i] = NULL;
continue;
}

spec->typeSpec.structure.elements[i] = generate_spec(data, size, depth + 1);
if (spec->typeSpec.structure.elements[i] == NULL) {
for (int j = 0; j < i; j++) {
free_spec(spec->typeSpec.structure.elements[j]);
}
free(spec->typeSpec.structure.elements);
spec->typeSpec.structure.elements = NULL;
spec->typeSpec.structure.elementCount = 0;
break;
}
}
} else {
spec->typeSpec.structure.elements = NULL;
}
break;
}
case MMS_BOOLEAN:
case MMS_UTC_TIME:
case MMS_DATA_ACCESS_ERROR:
default:
// These types don't require specific initialization in the union
break;
}

return spec;
}

// Recursively frees the MmsVariableSpecification structure
static void
free_spec(MmsVariableSpecification* spec)
{
if (spec == NULL) {
return;
}

if (spec->type == MMS_ARRAY) {
free_spec(spec->typeSpec.array.elementTypeSpec);
} else if (spec->type == MMS_STRUCTURE) {
if (spec->typeSpec.structure.elements) {
for (int i = 0; i < spec->typeSpec.structure.elementCount; i++) {
free_spec(spec->typeSpec.structure.elements[i]);
}
free(spec->typeSpec.structure.elements);
}
}

free(spec);
}

int
LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
{
if (size < 2) {
return 0;
}

const uint8_t* current_data = data;
size_t current_size = size;

// Use the first byte to control allocation failures.
// A value of 0 means no induced failures.
// A value of N > 0 means the N-th allocation will fail.
uint8_t failure_control = consume_byte(&current_data, &current_size);
if (failure_control > 0) {
// Cap the failure count to a reasonable number to avoid long-running tests
allocation_failure_countdown = (failure_control % 10) + 1;
} else {
allocation_failure_countdown = -1; // No failures
}

MmsVariableSpecification* typeSpec = generate_spec(&current_data, &current_size, 0);

if (typeSpec != NULL) {
MmsValue* value = MmsValue_newDefaultValue(typeSpec);
if (value != NULL) {
MmsValue_delete(value);
}
free_spec(typeSpec);
}

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: libiec61850
function signature: MmsValue * MmsValue_newDefaultValue(const MmsVariableSpecification *)
</input>

<description>
The function `MmsValue_newDefaultValue` creates a new `MmsValue` instance with a default value based on the provided `MmsVariableSpecification`. The type of the created `MmsValue` depends on the `type` field of the `typeSpec` argument. The function handles various MMS data types, including primitive types like integer, float, boolean, and complex types like arrays and structures. For complex types, the function recursively calls itself to create nested values.
</description>

<requirements>
<requirement>
The `typeSpec` parameter must not be NULL. This is to prevent a NULL pointer dereference when accessing its members.
</requirement>
<requirement>
The `type` field of the `typeSpec` parameter should be a valid `MmsType` enum value. This is to ensure that the switch statement in the function has a corresponding case to handle the type.
</requirement>
<requirement>
If `typeSpec->type` is `MMS_ARRAY`, the `typeSpec->typeSpec.array.elementTypeSpec` must be a valid pointer to an `MmsVariableSpecification`. This is to prevent a NULL pointer dereference in the recursive call to `MmsValue_newDefaultValue` within `MmsValue_createArray`.
</requirement>
<requirement>
If `typeSpec->type` is `MMS_STRUCTURE`, `typeSpec->typeSpec.structure.elements` must be a valid pointer to an array of `MmsVariableSpecification` pointers. This is to avoid a crash in the recursive call to `MmsValue_newDefaultValue` within `MmsValue_newStructure`.
</requirement>
<requirement>
The `typeSpec->typeSpec.structure.elementCount` and `typeSpec->typeSpec.array.elementCount` fields should be within a reasonable range. This is to avoid excessive memory allocation and potential denial-of-service vulnerabilities.
</requirement>
</requirements>

</function-requirements>

