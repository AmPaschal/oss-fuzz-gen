#include "/src/astc-encoder/Source/astcenc_internal.h"

#include <fuzzer/FuzzedDataProvider.h>
#include <vector>

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
{
// Need at least 4 bytes for dimensions and 16 for the block
if (size < 4 + 16)
{
return 0;
}

FuzzedDataProvider stream(data, size);

// Fuzz the block dimensions and type
int x, y, z;
bool is_3d = stream.ConsumeBool();
bool bsd_valid;

if (is_3d)
{
x = stream.ConsumeIntegralInRange<int>(3, 6);
y = stream.ConsumeIntegralInRange<int>(3, 6);
z = stream.ConsumeIntegralInRange<int>(3, 6);
bsd_valid = is_legal_3d_block_size(x, y, z);
}
else
{
x = stream.ConsumeIntegralInRange<int>(4, 12);
y = stream.ConsumeIntegralInRange<int>(4, 12);
z = 1;
bsd_valid = is_legal_2d_block_size(x, y);
}

// If the dimensions are not valid, bail
if (!bsd_valid)
{
return 0;
}

bool is_dual_plane = stream.ConsumeBool();

// Initialize the block size descriptor
block_size_descriptor bsd;
init_block_size_descriptor(
x, y, z,
is_dual_plane,
4, // A default value for weight bits
1.0f, // A default value for weight min
bsd);

// Populate the physical block if there is enough data
if (stream.remaining_bytes() < 16)
{
return 0;
}

uint8_t pcb[16];
std::vector<uint8_t> buffer = stream.ConsumeBytes<uint8_t>(16);
std::memcpy(pcb, buffer.data(), 16);

// Create the symbolic block
symbolic_compressed_block scb;
physical_to_symbolic(bsd, pcb, scb);

// Call the function under test
scb.get_color_quant_mode();

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: astc-encoder
function signature: DW_TAG_enumeration_typequant_method symbolic_compressed_block::get_color_quant_mode(const struct symbolic_compressed_block *)
</input>

<description>
The function `symbolic_compressed_block::get_color_quant_mode` is an inline function that returns the `quant_mode` member of the `symbolic_compressed_block` struct. The `quant_mode` member is an enum of type `quant_method`, which specifies the quantization level for color data. To correctly call this function, the `symbolic_compressed_block` struct must be properly initialized. This is typically done by the `physical_to_symbolic` function, which decodes a `physical_compressed_block` (a 16-byte data block) into a `symbolic_compressed_block`. Therefore, a valid `physical_compressed_block` and `block_size_descriptor` are required to create the input for the target function.
</description>

<requirements>
<requirement>
The `symbolic_compressed_block` input object must be initialized by calling the `physical_to_symbolic` function. This function populates the struct with meaningful data based on a compressed block.
</requirement>
<requirement>
The `physical_to_symbolic` function requires a valid `block_size_descriptor`. The `init_block_size_descriptor` function should be called to initialize it with valid dimensions.
</requirement>
<requirement>
The `physical_compressed_block` can be populated with 16 bytes of fuzzer data. This will be decoded by `physical_to_symbolic`.
</requirement>
<requirement>
The `quant_mode` member of the `symbolic_compressed_block` struct must be a valid value from the `quant_method` enum. This is ensured by proper initialization.
</requirement>
</requirements>

</function-requirements>

