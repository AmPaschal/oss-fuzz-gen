* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
*/

#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <vector>
#include <string.h>

#include <fuzzer/FuzzedDataProvider.h>

#include "FLAC++/encoder.h"
#include "FLAC++/decoder.h"
#include "common.h"

// A simple derived class to provide the necessary virtual functions for the decoder.
class FuzzDecoder : public FLAC::Decoder::File {
public:
FuzzDecoder() = default;
~FuzzDecoder() override = default;

protected:
::FLAC__StreamDecoderWriteStatus
write_callback(const ::FLAC__Frame * /*frame*/,
const FLAC__int32 *const /*buffer*/[]) override {
return FLAC__STREAM_DECODER_WRITE_STATUS_CONTINUE;
}

void error_callback(::FLAC__StreamDecoderErrorStatus /*status*/) override {}

void metadata_callback(const ::FLAC__StreamMetadata *metadata) override {
(void)metadata;
}
};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
FuzzedDataProvider provider(data, size);

// --- Consume ALL configuration data first ---
// Encoder configuration
const uint32_t channels = provider.ConsumeIntegralInRange<uint32_t>(1, 2);
const uint32_t bps = provider.ConsumeIntegralInRange<uint32_t>(8, 24);
const uint32_t sample_rate = provider.ConsumeIntegralInRange<uint32_t>(8000, 48000);
const uint32_t block_size = provider.ConsumeIntegralInRange<uint32_t>(16, 1024);

// Decoder configuration
const bool md5_checking = provider.ConsumeBool();
const bool decode_chained = provider.ConsumeBool();
const uint8_t metadata_options = provider.ConsumeIntegral<uint8_t>();
const bool do_seek = provider.ConsumeBool();
const FLAC__uint64 seek_val = provider.ConsumeIntegral<FLAC__uint64>();

// --- Use remaining data for audio ---
std::vector<uint8_t> raw_audio_data = provider.ConsumeRemainingBytes<uint8_t>();

// Create a temporary file to store the generated Ogg FLAC stream.
const char *tmp_filename = "/tmp/fuzz.ogg";

// Use the encoder to generate a valid Ogg FLAC stream.
{
FLAC::Encoder::File encoder;
if (!encoder.is_valid()) {
return 0;
}

encoder.set_channels(channels);
encoder.set_bits_per_sample(bps);
encoder.set_sample_rate(sample_rate);
encoder.set_blocksize(block_size);

if (encoder.init_ogg(tmp_filename) != FLAC__STREAM_ENCODER_INIT_STATUS_OK) {
remove(tmp_filename);
return 0;
}

// Convert raw bytes to FLAC__int32 samples
std::vector<FLAC__int32> audio_data;
size_t num_integers = raw_audio_data.size() / sizeof(FLAC__int32);
if (num_integers > 0) {
audio_data.resize(num_integers);
memcpy(audio_data.data(), raw_audio_data.data(), num_integers * sizeof(FLAC__int32));
}

// Process the audio data if any exists.
if (!audio_data.empty()) {
// The number of samples must be a multiple of the number of channels.
size_t num_samples_total = audio_data.size();
size_t num_frames = num_samples_total / channels;
if (num_frames > 0) {
encoder.process_interleaved(audio_data.data(), num_frames);
}
}

// The encoder's finish method is called by its destructor.
}

// Now, fuzz the decoder with the generated file.
FuzzDecoder decoder;

// Configure the decoder with the data consumed earlier.
decoder.set_md5_checking(md5_checking);
decoder.set_decode_chained_stream(decode_chained);

if (metadata_options == 0) {
decoder.set_metadata_ignore_all();
} else if (metadata_options == 0xff) {
decoder.set_metadata_respond_all();
} else {
if (metadata_options & (1 << 0))
decoder.set_metadata_respond(FLAC__METADATA_TYPE_STREAMINFO);
if (metadata_options & (1 << 1))
decoder.set_metadata_respond(FLAC__METADATA_TYPE_PADDING);
if (metadata_options & (1 << 2))
decoder.set_metadata_respond(FLAC__METADATA_TYPE_APPLICATION);
if (metadata_options & (1 << 3))
decoder.set_metadata_respond(FLAC__METADATA_TYPE_SEEKTABLE);
if (metadata_options & (1 << 4))
decoder.set_metadata_respond(FLAC__METADATA_TYPE_VORBIS_COMMENT);
if (metadata_options & (1 << 5))
decoder.set_metadata_respond(FLAC__METADATA_TYPE_CUESHEET);
if (metadata_options & (1 << 6))
decoder.set_metadata_respond(FLAC__METADATA_TYPE_PICTURE);
}

FILE *fp = fopen(tmp_filename, "rb");
if (!fp) {
remove(tmp_filename);
return 0;
}

// Call the function under test.
decoder.init_ogg(fp);

decoder.process_until_end_of_metadata();

if (do_seek && decoder.get_total_samples() > 0) {
FLAC__uint64 seek_pos = seek_val % decoder.get_total_samples();
decoder.seek_absolute(seek_pos);
}

decoder.process_until_end_of_stream();

// The decoder destructor closes the file. We just need to remove it.
remove(tmp_filename);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: flac
function signature: ::FLAC__StreamDecoderInitStatus FLAC::Decoder::File::init_ogg(FILE *file)
</input>

<description>
The function `FLAC::Decoder::File::init_ogg(FILE *file)` is a member of the `FLAC::Decoder::File` class and is used to initialize the FLAC stream decoder for decoding an Ogg FLAC stream from a C-style file stream (`FILE*`). The function acts as a C++ wrapper, calling the underlying C function `FLAC__stream_decoder_init_ogg_FILE`. Before this function can be called, an instance of the `FLAC::Decoder::File` class must be created. Its constructor allocates an internal `FLAC__StreamDecoder` object, which is a critical prerequisite for the `init_ogg` function to succeed, as it asserts that this object is not null. The function requires a valid `FILE*` pointer to a readable file that contains the Ogg FLAC data. It uses several internal callbacks which are passed to the underlying C library; these have default do-nothing implementations in the base class that are sufficient for fuzzing purposes.
</description>

<requirements>
<requirement>
An instance of the `FLAC::Decoder::File` class must be constructed before calling `init_ogg`. The class constructor allocates the internal decoder structure, and failing to do so will cause an assertion failure.
</requirement>
<requirement>
The `file` argument must be a valid pointer to a file opened for reading. Passing a NULL or invalid file pointer can lead to a crash or an error from the underlying C library.
</requirement>
<requirement>
The file associated with the `file` pointer should be populated with fuzzer-generated data. This data should ideally represent a valid or near-valid Ogg FLAC stream to effectively test the decoder for vulnerabilities.
</requirement>
</requirements>

</function-requirements>

