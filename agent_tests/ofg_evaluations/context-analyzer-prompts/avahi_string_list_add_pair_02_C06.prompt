Public License for more details.

You should have received a copy of the GNU Lesser General Public
License along with avahi; if not, write to the Free Software
Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA 02111-1307
USA.
***/

#include <assert.h>
#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

#include "avahi-common/defs.h"
#include "avahi-common/malloc.h"
#include "avahi-common/strlst.h"
#include "avahi-core/log.h"

// Dummy log function to prevent log output during fuzzing
void log_function(AvahiLogLevel level, const char *txt) {
(void)level;
(void)txt;
}

// A simple data provider to safely consume bytes from the fuzzing input.
typedef struct {
const uint8_t *data;
size_t size;
size_t offset;
} FuzzDataProvider;

static FuzzDataProvider FuzzDataProvider_create(const uint8_t *data, size_t size) {
FuzzDataProvider p = {data, size, 0};
return p;
}

static int FuzzDataProvider_remaining(FuzzDataProvider *p) {
return p->offset < p->size;
}

static uint8_t FuzzDataProvider_get_u8(FuzzDataProvider *p) {
if (p->offset < p->size) {
return p->data[p->offset++];
}
return 0;
}

// Consumes a null-terminated string, or up to a max_len.
// The returned string is allocated with avahi_malloc and must be freed.
// Returns an empty string if no data is left.
static char *FuzzDataProvider_get_string(FuzzDataProvider *p, size_t max_len) {
if (!FuzzDataProvider_remaining(p)) {
char *s = avahi_malloc(1);
if (!s) abort();
s[0] = '\0';
return s;
}

size_t remaining = p->size - p->offset;
size_t len = 0;
const uint8_t *end = memchr(p->data + p->offset, '\0', remaining);
if (end) {
len = end - (p->data + p->offset);
} else {
len = remaining;
}

if (len > max_len) {
len = max_len;
}

char *str = avahi_malloc(len + 1);
if (!str) {
abort();
}
memcpy(str, p->data + p->offset, len);
str[len] = '\0';
p->offset += len;
if (end && p->offset < p->size) {
p->offset++; // consume the null terminator
}
return str;
}

// Consumes a block of data. The returned pointer is a view into the input buffer.
static const uint8_t *FuzzDataProvider_get_data(FuzzDataProvider *p, size_t *len) {
if (!FuzzDataProvider_remaining(p)) {
*len = 0;
return NULL;
}

// Use one byte to determine the length.
uint8_t length_byte = FuzzDataProvider_get_u8(p);

// The number of bytes now remaining is the maximum possible length.
size_t data_available = p->size - p->offset;

// Constrain the length to what is actually available.
*len = length_byte % (data_available + 1);

const uint8_t *data_ptr = p->data + p->offset;
p->offset += *len;
return data_ptr;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
avahi_set_log_function(log_function);
FuzzDataProvider provider = FuzzDataProvider_create(data, size);

AvahiStringList *slist = NULL;

while (FuzzDataProvider_remaining(&provider)) {
uint8_t op = FuzzDataProvider_get_u8(&provider);
switch (op % 8) {
case 0: { // Add a key-value pair
char *key = FuzzDataProvider_get_string(&provider, 255);
char *value = FuzzDataProvider_get_string(&provider, 1024);
// value can be NULL, but key cannot.
slist = avahi_string_list_add_pair(slist, key, strlen(value) > 0 ? value : NULL);
avahi_free(key);
avahi_free(value);
break;
}
case 1: { // Add a pair with arbitrary data
char *key = FuzzDataProvider_get_string(&provider, 255);
size_t value_len;
const uint8_t *value_data = FuzzDataProvider_get_data(&provider, &value_len);
slist = avahi_string_list_add_pair_arbitrary(slist, key, value_data, value_len);
avahi_free(key);
break;
}
case 2: { // Copy and compare
if (!slist) break;
AvahiStringList *copy = avahi_string_list_copy(slist);
assert(avahi_string_list_equal(slist, copy));
avahi_string_list_free(copy);
break;
}
case 3: { // Serialize and parse
if (slist) {
size_t length = avahi_string_list_serialize(slist, NULL, 0);
if (length > 0) {
void *buffer = avahi_malloc(length);
if (buffer) {
avahi_string_list_serialize(slist, buffer, length);
AvahiStringList *parsed = NULL;
if (avahi_string_list_parse(buffer, length, &parsed) == 0) {
assert(avahi_string_list_equal(slist, parsed));
avahi_string_list_free(parsed);
}
avahi_free(buffer);
}
}
}
// Fuzz the parser with arbitrary data
size_t data_len;
const uint8_t *raw_data = FuzzDataProvider_get_data(&provider, &data_len);
if (raw_data) {
AvahiStringList *parsed_fuzz = NULL;
avahi_string_list_parse(raw_data, data_len, &parsed_fuzz);
avahi_string_list_free(parsed_fuzz);
}
break;
}
case 4: { // Find a key
if (!slist) break;
char *key = FuzzDataProvider_get_string(&provider, 255);
// The result of find is a pointer into the list, do not free it.
(void)avahi_string_list_find(slist, key);
avahi_free(key);
break;
}
case 5: { // Convert to string
if (!slist) break;
char *str = avahi_string_list_to_string(slist);
avahi_free(str);
break;
}
case 6: { // Get a pair
if (!slist) break;
char *key = NULL, *value = NULL;
size_t size_out;
// The key/value are allocated and must be freed.
if (avahi_string_list_get_pair(slist, &key, &value, &size_out) >= 0) {
avahi_free(key);
avahi_free(value);
}
break;
}
case 7: { // Free the list and start over
avahi_string_list_free(slist);
slist = NULL;
break;
}
}
}

avahi_string_list_free(slist);
return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: avahi
function signature: AvahiStringList * avahi_string_list_add_pair(AvahiStringList *, const char *, const char *)
</input>

<description>
The function `avahi_string_list_add_pair` is a utility function that adds a key-value pair to an `AvahiStringList`. If the `value` is NULL, it adds only the `key`. Otherwise, it adds the pair in the format "key=value". The function returns the head of the modified string list.
</description>

<requirements>
<requirement>
The first argument, `l`, which is the string list, can be NULL. If it is NULL, a new list is created.
</requirement>
<requirement>
The `key` argument must not be NULL. The function has an assertion `assert(key)` that will cause a crash if `key` is NULL.
</requirement>
<requirement>
The `value` argument can be NULL. The function handles this by adding only the key to the list.
</requirement>
<requirement>
The `key` and `value` arguments should be null-terminated strings. This is because they are passed to `avahi_string_list_add_printf` which expects format strings.
</requirement>
</requirements>

</function-requirements>

