/**
* @brief Fuzz target for symbolic_to_physical().
*
* This function is the final entrypoint for compressing a symbolic block of
* ASTC data into a 16 byte physical hardware format.
*/

#include "/src/astc-encoder/Source/astcenc_internal.h"

#include <fuzzer/FuzzedDataProvider.h>
#include <array>
#include <vector>
#include <cstring>

struct BlockSizes
{
int x;
int y;
int z;
};

// A representative subset of the available block sizes
std::array<BlockSizes, 3> testSz {{
{ 4,  4, 1}, // Highest bitrate
{12, 12, 1}, // Largest 2D block
{6,  6,  6}  // Largest 3D block
}};

std::array<block_size_descriptor, 3> testBSD;

/**
* @brief Utility function to create all of the block size descriptors needed.
*/
bool bsd_initializer()
{
for (size_t i = 0; i < testSz.size(); i++)
{
init_block_size_descriptor(
testSz[i].x,
testSz[i].y,
testSz[i].z,
false,
4,
1.0f,
testBSD[i]);
}

return true;
}

// Forward declaration for the function to be tested
void symbolic_to_physical(const struct block_size_descriptor &, const struct symbolic_compressed_block &, uint8_t *);

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
{
// Preinitialize the block size descriptors we need
static bool init = bsd_initializer();

// We need enough data to select a bsd and populate the scb
if (size < sizeof(symbolic_compressed_block) + 4)
{
return 0;
}

FuzzedDataProvider stream(data, size);

// Select a block size to test
int i = stream.ConsumeIntegralInRange<int>(0, (int)testSz.size() - 1);
const block_size_descriptor& bsd = testBSD[i];

// Create the symbolic block and populate with fuzzed data
symbolic_compressed_block scb;
std::memset(&scb, 0, sizeof(scb));

// Populate the scb with fuzzed data, respecting function preconditions
scb.block_type = stream.PickValueInArray<uint8_t>(
{SYM_BTYPE_CONST_U16, SYM_BTYPE_CONST_F16, SYM_BTYPE_NONCONST});

if (scb.block_type != SYM_BTYPE_NONCONST)
{
for (unsigned int j = 0; j < BLOCK_MAX_COMPONENTS; j++)
{
scb.constant_color[j] = stream.ConsumeIntegral<int>();
}
}
else
{
// If there are no non-constant modes, we can't test this path
if (bsd.block_mode_count_all == 0)
{
return 0;
}

// These fields are only valid for non-constant blocks
// The block_mode must be a valid mode for the current block size
std::vector<uint16_t> valid_block_modes;
for (uint16_t j = 0; j < WEIGHTS_MAX_BLOCK_MODES; ++j)
{
if (bsd.block_mode_packed_index[j] != BLOCK_BAD_BLOCK_MODE)
{
valid_block_modes.push_back(j);
}
}

if (valid_block_modes.empty())
{
return 0;
}

size_t mode_index = stream.ConsumeIntegralInRange<size_t>(0, valid_block_modes.size() - 1);
scb.block_mode = valid_block_modes[mode_index];
const auto& bm = bsd.get_block_mode(scb.block_mode);

scb.partition_count = stream.ConsumeIntegralInRange<uint8_t>(1, 4);
if (scb.partition_count > 1)
{
uint16_t part_count = bsd.partitioning_count_all[scb.partition_count - 1];
if (part_count == 0)
{
// This block size does not support this partition count, so abort
return 0;
}
scb.partition_index = stream.ConsumeIntegralInRange<uint16_t>(0, part_count - 1);
}

// Pick a valid quantization method from the allowed enum values
static const std::array<quant_method, 4> valid_quant_modes {{
QUANT_6, QUANT_8, QUANT_10, QUANT_12
}};
scb.quant_mode = stream.PickValueInArray(valid_quant_modes);

if (bm.is_dual_plane)
{
scb.plane2_component = stream.ConsumeIntegralInRange<int8_t>(0, 3);
}
else
{
scb.plane2_component = -1;
}

scb.color_formats_matched = stream.ConsumeBool();
for (unsigned int j = 0; j < scb.partition_count; j++)
{
scb.color_formats[j] = stream.ConsumeIntegralInRange<uint8_t>(0, 15);
for (int k = 0; k < 8; k++)
{
scb.color_values[j][k] = stream.ConsumeIntegral<uint8_t>();
}
}

size_t consumed = stream.ConsumeData(scb.weights, sizeof(scb.weights));
if (consumed != sizeof(scb.weights))
{
return 0;
}

// Check that the generated symbolic block is valid and will not
// overflow the 128-bit physical block on encoding. This check
// mimics the logic within the new symbolic_to_physical.
const auto& di = bsd.get_decimation_info(bm.decimation_mode);
int weight_count = di.weight_count;
quant_method weight_quant_method = bm.get_weight_quant_mode();
int is_dual_plane = bm.is_dual_plane;
int real_weight_count = is_dual_plane ? 2 * weight_count : weight_count;
int bits_for_weights = get_ise_sequence_bitcount(real_weight_count, weight_quant_method);

int below_weights_pos = 128 - bits_for_weights;
if (scb.partition_count > 1 && !scb.color_formats_matched)
{
int encoded_type_highpart_size = (3 * scb.partition_count) - 4;
below_weights_pos -= encoded_type_highpart_size;
}

if (is_dual_plane)
{
below_weights_pos -= 2;
}

int start_of_high_data = below_weights_pos;

int start_pos_for_colors = (scb.partition_count == 1) ? 17 : (19 + PARTITION_INDEX_BITS);

int valuecount_to_encode = 0;
for (unsigned int j = 0; j < scb.partition_count; j++)
{
int vals = 2 * (scb.color_formats[j] >> 2) + 2;
valuecount_to_encode += vals;
}

quant_method color_quant_method = scb.get_color_quant_mode();
int bits_for_colors = get_ise_sequence_bitcount(valuecount_to_encode, color_quant_method);

if (start_pos_for_colors + bits_for_colors > start_of_high_data)
{
return 0;
}
}

// Create a buffer for the physical block output
uint8_t pcb[16];

// Call the function under test
symbolic_to_physical(bsd, scb, pcb);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: astc-encoder
function signature: void symbolic_to_physical(const struct block_size_descriptor &, const struct symbolic_compressed_block &, uint8_t *)
</input>

<description>
The `symbolic_to_physical` function converts a symbolic representation of a compressed block (`symbolic_compressed_block`) into a physical hardware-readable block format (`pcb`). The block size and mode information is provided by the `block_size_descriptor`. The function handles different block types, including constant-color blocks and more complex blocks with weights and multiple partitions. It encodes the symbolic information into a 16-byte physical block by writing bits to the correct positions according to the ASTC specification.
</description>

<requirements>
<requirement>
The `scb.block_type` must not be `SYM_BTYPE_ERROR`. This is because the function starts with an assertion that this condition is false.
</requirement>
<requirement>
The `pcb` pointer must point to a writable buffer of at least 16 bytes. The function writes 16 bytes of data into this buffer, so it must be large enough to avoid a buffer overflow.
</requirement>
<requirement>
The `scb.block_mode` must be a valid index for the block modes supported by the provided `block_size_descriptor`. An invalid block mode will cause a crash when calling `bsd.get_block_mode()`.
</requirement>
<requirement>
If the block mode indicates a dual-plane encoding, `scb.plane2_component` must be initialized. This field is written to the physical block if the encoding is dual-plane.
</requirement>
<requirement>
The `scb.quant_mode` field must be initialized to a value between `QUANT_6` and `QUANT_12`. This value is used to index into the `color_uquant_to_scrambled_pquant_tables` array, and an out-of-range value will cause a crash.
</requirement>
<requirement>
The `scb.weights` array must be populated with valid weight values. These weights are used in calculations and to look up values in scramble maps, so invalid values could lead to incorrect behavior or crashes.
</requirement>
<requirement>
If `scb.partition_count` is greater than 1, `scb.partition_index` must be initialized. The partition index is written to the physical block for multi-partition blocks.
</requirement>
</requirements>

</function-requirements>

