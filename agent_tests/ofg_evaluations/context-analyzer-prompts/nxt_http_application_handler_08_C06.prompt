<fuzz-target>
/*
* Copyright (C) NGINX, Inc.
*/

#include <nxt_main.h>
#include "/src/unit/src/nxt_http.h"
#include "/src/unit/src/nxt_queue.h"
#include "/src/unit/src/nxt_port_rpc.h"
#include <nxt_application.h>
#include <sys/socket.h>

/*
* The nxt_http_app_conf_t struct is defined in nxt_router.c and not
* exposed in a header. It is copied here to allow testing of
* nxt_http_application_handler.
*/
typedef struct {
nxt_app_t  *app;
nxt_int_t  target;
} nxt_http_app_conf_t;

/*
* The function under test is nxt_http_application_handler.
* Its signature is provided here for clarity.
*/
nxt_http_action_t * nxt_http_application_handler(nxt_task_t *, nxt_http_request_t *, nxt_http_action_t *);


#define KMININPUTLENGTH 1
#define KMAXINPUTLENGTH 1024


extern int LLVMFuzzerInitialize(int *argc, char ***argv);
extern int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size);


extern char  **environ;


int
LLVMFuzzerInitialize(int *argc, char ***argv)
{
if (nxt_lib_start("fuzzing", NULL, &environ) != NXT_OK) {
return NXT_ERROR;
}

if (nxt_port_rpc_init() != NXT_OK) {
return NXT_ERROR;
}

return 0;
}


int
LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
{
nxt_mp_t             *mp;
nxt_task_t           *task;
nxt_thread_t         *thread;
nxt_runtime_t        *runtime;
nxt_event_engine_t   *engine;
nxt_http_request_t   *r;
nxt_http_action_t    *action;
nxt_http_app_conf_t  *app_conf;
nxt_app_t            *app;
nxt_port_t           *port;

if (size < KMININPUTLENGTH || size > KMAXINPUTLENGTH) {
return 0;
}

mp = nxt_mp_create(1024, 128, 256, 32);
if (mp == NULL) {
return 0;
}

runtime = nxt_mp_zget(mp, sizeof(nxt_runtime_t));
if (runtime == NULL) {
goto failed;
}
runtime->mem_pool = mp;

engine = nxt_mp_zget(mp, sizeof(nxt_event_engine_t));
if (engine == NULL) {
goto failed;
}

port = nxt_mp_zget(mp, sizeof(nxt_port_t));
if (port == NULL) {
goto failed;
}
port->mem_pool = mp;
engine->port = port;

thread = nxt_mp_zget(mp, sizeof(nxt_thread_t));
if (thread == NULL) {
goto failed;
}
thread->runtime = runtime;
thread->engine = engine;
thread->log = &nxt_main_log;

task = nxt_mp_zget(mp, sizeof(nxt_task_t));
if (task == NULL) {
goto failed;
}
task->thread = thread;
task->log = &nxt_main_log;

r = nxt_http_request_create(task);
if (r == NULL) {
goto failed;
}

r->remote = nxt_mp_zget(mp, sizeof(nxt_sockaddr_t));
if (r->remote == NULL) {
goto failed;
}
r->remote->u.sockaddr.sa_family = AF_INET;
r->remote->address_length = 4;

r->local = nxt_mp_zget(mp, sizeof(nxt_sockaddr_t));
if (r->local == NULL) {
goto failed;
}
r->local->u.sockaddr.sa_family = AF_INET;
r->local->address_length = 4;

r->host.start = (u_char *)data;
r->host.length = size;

r->method = nxt_mp_get(mp, sizeof(nxt_str_t));
if (r->method == NULL) {
goto failed;
}
r->method->start = (u_char *) "GET";
r->method->length = 3;

action = nxt_mp_zget(mp, sizeof(nxt_http_action_t));
if (action == NULL) {
goto failed;
}

app_conf = nxt_mp_zget(mp, sizeof(nxt_http_app_conf_t));
if (app_conf == NULL) {
goto failed;
}

app = nxt_mp_zget(mp, sizeof(nxt_app_t));
if (app == NULL) {
goto failed;
}

/*
* The app struct is zero-initialized by nxt_mp_zget.
* This is sufficient for the mutex to be in a valid, unlocked state.
*/
nxt_queue_init(&app->ack_waiting_req);
app->shared_port = nxt_mp_zget(mp, sizeof(nxt_port_t));
if (app->shared_port == NULL) {
goto failed;
}

app_conf->app = app;
action->u.conf = app_conf;

nxt_http_application_handler(task, r, action);

failed:

nxt_mp_destroy(mp);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: unit
function signature: nxt_http_action_t * nxt_http_application_handler(nxt_task_t *, nxt_http_request_t *, nxt_http_action_t *)
</input>

<description>
The function `nxt_http_application_handler` is a handler for HTTP application requests. It is not called directly, but rather its address is assigned to the `handler` field of an `nxt_http_action_t` struct. The function that executes this handler is `nxt_router_process_http_request`. The primary role of `nxt_http_application_handler` is to extract request information, such as the host, and then pass the request to the router for processing.
</description>

<requirements>
<requirement>
The `nxt_http_request_t` object, which is the second argument, should be created using the `nxt_http_request_create` function. This is because `nxt_http_request_create` allocates memory for the request and initializes various fields to default values that are expected by the target function and its callees.
</requirement>
<requirement>
The `host` field of the `nxt_http_request_t` object should be fuzzed. The target function checks the `length` of the `host` string and uses it to set the `server_name`; fuzzing this field can test the handling of different host values.
</requirement>
<requirement>
The `action` argument must be a valid pointer to an `nxt_http_action_t` struct. The `u.conf` field of the `action` struct, which is of type `nxt_http_app_conf_t`, should be properly initialized as it is dereferenced in `nxt_router_process_http_request`.
</requirement>
<requirement>
The `task` argument should be a valid pointer to a `nxt_task_t` struct. The `task->thread->engine` members are accessed in downstream functions, so the task and its associated thread and engine must be initialized.
</requirement>
</requirements>

</function-requirements>

