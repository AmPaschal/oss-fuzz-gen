#include <net-snmp/net-snmp-config.h>
#include <net-snmp/net-snmp-includes.h>
#include <net-snmp/library/snmp_transport.h>
#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

/* Fuzzer-controlled data and session context for the transport */
struct fuzz_magic {
int errstat;
int errindex;
netsnmp_session *session;
};

/*
* Mock transport send function.
* Creates a response PDU and calls the session's callback to simulate a response.
*/
static int fuzz_transport_send(netsnmp_transport *t, const void *packet, int len,
void **diagnostic) {
if (!t || !t->data) {
return -1;
}
struct fuzz_magic *magic = (struct fuzz_magic *)t->data;
netsnmp_session *sp = magic->session;

netsnmp_pdu *response = snmp_pdu_create(SNMP_MSG_RESPONSE);
if (!response) {
return -1;
}

response->errstat = magic->errstat;
response->errindex = magic->errindex;

/* Deliver the mocked response to the synchronous API's callback */
if (sp && sp->callback) {
sp->callback(NETSNMP_CALLBACK_OP_RECEIVED_MESSAGE, sp, 0, response,
sp->callback_magic);
} else {
snmp_free_pdu(response);
}

return len;
}

static int fuzz_transport_close(netsnmp_transport *t) {
/*
* Do not free the transport 't' itself here. The snmp_sess_close()
* function, which calls this callback, will free the transport
* structure after this function returns. Freeing it here would
* result in a double-free. The 'magic' data (t->data) is managed
* and freed by the main fuzzer function.
*/
return 0;
}

int LLVMFuzzerInitialize(int *argc, char ***argv) {
if (getenv("NETSNMP_DEBUGGING") != NULL) {
snmp_enable_stderrlog();
snmp_set_do_debugging(1);
debug_register_tokens("");
}
return 0;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
if (size < sizeof(struct fuzz_magic) + 5) {
return 0;
}

struct fuzz_magic *magic = (struct fuzz_magic*)calloc(1, sizeof(struct fuzz_magic));
if (!magic) {
return 0;
}
memcpy(magic, data, sizeof(struct fuzz_magic));
data += sizeof(struct fuzz_magic);
size -= sizeof(struct fuzz_magic);

netsnmp_session session;
snmp_sess_init(&session);
magic->session = &session;

netsnmp_transport *transport = (netsnmp_transport *)calloc(1, sizeof(netsnmp_transport));
if (!transport) {
free(magic);
return 0;
}
transport->f_send = fuzz_transport_send;
transport->f_close = fuzz_transport_close;
transport->data = magic;

struct session_list *slp = snmp_sess_add(&session, transport, NULL, NULL);
if (!slp) {
/* transport is not added, so we must free it */
free(transport);
free(magic);
return 0;
}

session.version = *data % 3;
data++;
size--;

netsnmp_variable_list *vars = NULL;
int num_vars = (*data % 4) + 1;
data++;
size--;

for (int i = 0; i < num_vars; ++i) {
if (size < 3) break;
oid name_oid[MAX_OID_LEN];
size_t name_oid_len = (*data % (MAX_OID_LEN - 1)) + 1;
data++;
size--;
for (size_t j = 0; j < name_oid_len; ++j) {
name_oid[j] = j + i + 1;
}

u_char type = *data;
data++;
size--;

if (size == 0) break;
size_t value_len = *data % size;
data++;
size--;

if (value_len > size) {
value_len = size;
}

snmp_varlist_add_variable(&vars, name_oid, name_oid_len, type, data, value_len);
data += value_len;
size -= value_len;
}

if (vars) {
netsnmp_query_set(vars, &session);
snmp_free_varbind(vars);
}

snmp_sess_close(slp);
/*
* Do not free 'magic' here. The snmp_sess_close() function above
* takes ownership of the transport and its associated data ('magic')
* and frees it. Freeing it again here would cause a double-free.
*/

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: net-snmp
function signature: int netsnmp_query_set(netsnmp_variable_list *, netsnmp_session *)
</input>

<description>
The `netsnmp_query_set` function sends an SNMP SET request. It is a wrapper around the internal `_query` function, which constructs and sends an SNMP PDU. The function takes a list of variables to set and a session to use for the request. If the session is NULL, it will attempt to use a default session. The function returns SNMP_ERR_NOERROR on success and an error code on failure.
</description>

<requirements>
<requirement>
The first argument, `netsnmp_variable_list *list`, must not be a NULL pointer. The `_query` function, which `netsnmp_query_set` calls, explicitly checks for a NULL list and returns an error if it is NULL.
</requirement>
<requirement>
The `netsnmp_variable_list` pointed to by the `list` argument should be initialized by calling functions such as `snmp_pdu_add_variable` or `snmp_varlist_add_variable`. These functions ensure the variable list is correctly formatted for processing by the `_query` function.
</requirement>
<requirement>
The second argument, `netsnmp_session *session`, must be a valid session object or NULL. If the session is not NULL, it must be initialized using `snmp_open()` or `snmp_sess_init()` so that it contains valid session information for the SNMP request.
</requirement>
<requirement>
If the `session` argument is NULL, a default session must be set up prior to calling `netsnmp_query_set`. This can be done by calling `netsnmp_query_set_default_session` with a valid, initialized `netsnmp_session`.
</requirement>
</requirements>

</function-requirements>

