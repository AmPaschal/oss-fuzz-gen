<fuzz-target>
#include <fuzzer/FuzzedDataProvider.h>

#define protected public
#include "libraw.h"
#undef protected

#include "libraw_datastream.h"
#include "libraw_alloc.h" // For libraw_memmgr
#include <cstdint>
#include <vector>
#include <new> // For placement new
#include <cstddef> // For offsetof

// Internal structures from libraw/src/decoders/crx.cpp and libraw/libraw/libraw_internal.h
// These are necessary to call the internal crx decoding functions.

#ifndef _LIBRAW_INTERNAL_TYPES_H
#define _LIBRAW_INTERNAL_TYPES_H
typedef struct
{
uint32_t first;
uint32_t count;
uint32_t id;
} crx_sample_to_chunk_t;

typedef struct
{
int32_t version;
int32_t f_width;
int32_t f_height;
int32_t tileWidth;
int32_t tileHeight;
int32_t nBits;
int32_t nPlanes;
int32_t cfaLayout;
int32_t encType;
int32_t imageLevels;
int32_t hasTileCols;
int32_t hasTileRows;
int32_t mdatHdrSize;
int32_t medianBits;
uint32_t MediaSize;
INT64 MediaOffset;
uint32_t MediaType;
crx_sample_to_chunk_t *stsc_data;
uint32_t stsc_count;
uint32_t sample_count;
uint32_t sample_size;
int32_t *sample_sizes;
uint32_t chunk_count;
INT64 *chunk_offsets;
} crx_data_header_t;
#endif

struct CrxBandParam;
struct CrxQStep;
struct CrxWaveletTransform;
struct CrxTile;

struct CrxSubband
{
CrxBandParam *bandParam;
uint8_t *bandBuf;
uint32_t bandSize;
uint64_t mdatOffset;
uint32_t dataSize;
uint32_t dataOffset;
uint32_t width;
uint32_t height;
uint8_t supportsPartial;
uint8_t qParam;
uint8_t kParam;
uint32_t qStepBase;
uint16_t qStepMult;
uint8_t rowStartAddOn;
uint8_t rowEndAddOn;
uint8_t colStartAddOn;
uint8_t colEndAddOn;
uint8_t levelShift;
};

struct CrxPlaneComp
{
uint8_t compNumber;
uint8_t supportsPartial;
uint16_t roundedBitsMask;
uint32_t tileFlag;
uint32_t compSize;
uint32_t dataOffset;
CrxSubband *subBands;
CrxWaveletTransform *wvltTransform;
uint8_t *compBuf;
};

struct CrxTile
{
uint16_t tileNumber;
uint16_t tileFlag;
uint32_t tileSize;
uint64_t dataOffset;
uint16_t width;
uint16_t height;
CrxPlaneComp *comps;
CrxQStep *qStep;
uint8_t hasQPData;
uint32_t mdatQPDataSize;
uint16_t mdatExtraSize;
};

// Corrected CrxImage struct definition to match internal layout
struct CrxImage
{
uint8_t nPlanes, samplePrecision, medianBits, subbandCount, levels, nBits,
encType, tileCols, tileRows;
uint16_t planeWidth, planeHeight;
uint32_t repeat_count, frame_count, frame_offset;
CrxTile *tiles;
uint64_t mdatOffset, mdatSize;
int16_t *outBufs[4], *planeBuf;
LibRaw_abstract_datastream *input;
#ifdef LIBRAW_CR3_MEMPOOL
libraw_memmgr memmgr;
#endif

// Fuzzer-specific constructor to handle non-trivial member initialization
CrxImage() :
#ifdef LIBRAW_CR3_MEMPOOL
// Call the libraw_memmgr constructor that takes one argument. '0' is a safe default.
memmgr(0)
#endif
{
#ifdef LIBRAW_CR3_MEMPOOL
// Zero-initialize all fields that come before 'memmgr'.
// Since 'memmgr' is the last field, this will zero-out all other members.
// This replicates the behavior of aggregate initialization '{0}' for the POD members.
memset(this, 0, offsetof(CrxImage, memmgr));
#else
// If memmgr is not present, zero out the whole struct.
memset(this, 0, sizeof(CrxImage));
#endif
}
};

// Forward declare internal functions that are not in public headers
extern int crxSetupImageData(crx_data_header_t *hdr, CrxImage *img, int16_t *outBuf, int64_t mdatOffset, int64_t mdatSize, uint8_t *mdatHdrPtr, int32_t mdatHdrSize);
extern int crxFreeImageData(CrxImage *img);

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
{
FuzzedDataProvider fdp(data, size);

crx_data_header_t hdr = {0};
hdr.version = fdp.PickValueInArray<int32_t>({0x100, 0x200});
hdr.nPlanes = fdp.PickValueInArray<int32_t>({1, 4});

if (hdr.nPlanes == 1)
{
hdr.cfaLayout = 0;
hdr.encType = 0;
hdr.nBits = 8;
}
else
{ // nPlanes == 4
hdr.cfaLayout = fdp.ConsumeIntegralInRange<int32_t>(0, 3);
hdr.encType = fdp.ConsumeBool() ? 0 : 3;
hdr.nBits = fdp.ConsumeIntegralInRange<int32_t>(9, 15);
}

hdr.f_width = fdp.ConsumeIntegralInRange<int32_t>(32, 1024);
hdr.f_height = fdp.ConsumeIntegralInRange<int32_t>(32, 1024);
hdr.tileWidth = fdp.ConsumeIntegralInRange<int32_t>(16, hdr.f_width);
hdr.tileHeight = fdp.ConsumeIntegralInRange<int32_t>(16, hdr.f_height);
if (hdr.tileWidth == 0 || hdr.tileHeight == 0) return 0;

hdr.imageLevels = fdp.ConsumeIntegralInRange<int32_t>(0, 3);
hdr.medianBits = hdr.nBits;
hdr.mdatHdrSize = fdp.ConsumeIntegralInRange<int32_t>(0, 512);

if (fdp.remaining_bytes() < hdr.mdatHdrSize)
{
return 0;
}
std::vector<uint8_t> mdatHdr_data = fdp.ConsumeBytes<uint8_t>(hdr.mdatHdrSize);
std::vector<uint8_t> file_data = fdp.ConsumeRemainingBytes<uint8_t>();

LibRaw libraw_proc;
if (libraw_proc.open_buffer(file_data.data(), file_data.size()) != LIBRAW_SUCCESS) {
return 0;
}

CrxImage img; // Use the custom constructor, which initializes memmgr correctly
img.input = libraw_proc.libraw_internal_data.internal_data.input;

size_t out_buf_size = (size_t)hdr.f_width * hdr.f_height * 4;
if (out_buf_size == 0 || out_buf_size > 20000000) { // Limit memory
crxFreeImageData(&img);
return 0;
}
std::vector<int16_t> outBuf(out_buf_size);

if (crxSetupImageData(&hdr, &img, outBuf.data(), 0, file_data.size(), mdatHdr_data.data(), mdatHdr_data.size()) == 0)
{
libraw_proc.crxLoadDecodeLoop(&img, hdr.nPlanes);
}

crxFreeImageData(&img);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: libraw
function signature: void LibRaw::crxLoadDecodeLoop(void *, int)
</input>

<description>
The `crxLoadDecodeLoop` function is responsible for decoding the image planes of a CRX (Canon Raw v3) file. It iterates through the number of planes specified by the `nPlanes` argument and calls `crxDecodePlane` for each one to perform the actual decoding. The function is parallelized using OpenMP if available. The first argument `img` is a pointer to a `CrxImage` struct which must be fully initialized with data from the image file's headers before calling this function. The main caller, `crxLoadRaw`, handles the setup of this struct by parsing the file headers and then calls this loop to process the image data.
</description>

<requirements>

<requirement>
The first argument, a void pointer, must be a pointer to a valid `CrxImage` struct. This struct must be initialized by `crxSetupImageData` to ensure all necessary fields for decoding are populated correctly.
</requirement>
<requirement>
The `input` field of the `CrxImage` struct must point to a valid and open `LibRaw_abstract_datastream` object. This is because the decoding functions called within the loop read compressed image data from this stream.
</requirement>
<requirement>
The second argument, `nPlanes`, must be either 1 or 4. This is a constraint enforced by the `crxParseImageHeader` function which validates the image metadata.
</requirement>
<requirement>
The second argument, `nPlanes`, must not be greater than 4. This is to prevent a potential stack buffer overflow in the OpenMP version of the function, which uses a fixed-size array of 4 to store results.
</requirement>
<requirement>
The `CrxImage` struct must be initialized based on a `crx_data_header_t` whose `version` field is either 0x100 or 0x200. This is a validity check performed in `crxParseImageHeader`.
</requirement>
<requirement>
If the `nPlanes` field in the `crx_data_header_t` is 1, then the `cfaLayout` and `encType` fields must be 0, and the `nBits` field must be 8. This is a constraint checked by `crxParseImageHeader` for single-plane images.
</requirement>
<requirement>
If the `nPlanes` field in the `crx_data_header_t` is 4, then the `nBits` field must be less than or equal to 15. This is required to prevent errors during the decoding process.
</requirement>

</requirements>

</function-requirements>

