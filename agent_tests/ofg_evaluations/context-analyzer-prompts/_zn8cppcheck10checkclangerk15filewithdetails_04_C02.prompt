* MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
* GNU General Public License for more details.
*
* You should have received a copy of the GNU General Public License
* along with this program.  If not, see <http://www.gnu.org/licenses/>.
*/

#include "cppcheck.h"
#include "errorlogger.h"
#include "filesettings.h"
#include "settings.h"
#include "suppressions.h"

#include <fuzzer/FuzzedDataProvider.h>
#include <string>
#include <cstddef>
#include <cstdint>

class DummyErrorLogger : public ErrorLogger {
public:
void reportOut(const std::string& /*outmsg*/, Color /*c*/) override {}
void reportErr(const ErrorMessage& /*msg*/) override {}
void reportProgress(const std::string& /*filename*/,
const char /*stage*/[],
const std::size_t /*value*/) override {}
void reportMetric(const std::string & /*metric*/) override {}
};

static DummyErrorLogger s_errorLogger;

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
FuzzedDataProvider provider(data, size);

Settings settings;
settings.templateFormat = "{file}:{line}:{column}: {severity}: {id}: {message}";
settings.clang = true;
settings.clangExecutable = "clang"; // Assumes clang is in PATH
settings.addEnabled("all");
settings.certainty.setEnabled(Certainty::inconclusive, true);
settings.quiet = true; // Suppress verbose output to not pollute fuzzer logs

Suppressions suppressions;
CppCheck cppcheck(settings, suppressions, s_errorLogger, false, nullptr);

// Create a FileWithDetails object with a fuzzed language
const Standards::Language lang = provider.PickValueInArray({
Standards::Language::C,
Standards::Language::CPP
});
const FileWithDetails file("fuzz_input.cpp", lang, 0);

// Use the rest of the data as file content
const std::string code = provider.ConsumeRemainingBytesAsString();

// This call will delegate to checkClang because settings.clang is true
cppcheck.check(file, code);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: cppcheck
function signature: unsigned int CppCheck::checkClang(const FileWithDetails &)
</input>

<description>
The `CppCheck::checkClang` function performs a static analysis on a given file using `clang`. It constructs a command line with appropriate flags and executes `clang`. The function takes a `FileWithDetails` object, which contains the path to the file and its programming language. The behavior of the function is heavily influenced by the `mSettings` member of the `CppCheck` class, which provides configuration for include paths, defines, and other `clang` options. The function executes the `clang` command and checks its output for errors.
</description>

<requirements>
<requirement>
The `file` argument, an instance of `FileWithDetails`, must be initialized with a non-empty path. The constructor of `FileWithDetails` throws an exception if the path is empty, which would lead to a crash.
</requirement>
<requirement>
The `lang` member of the `FileWithDetails` object must be either `Standards::Language::C` or `Standards::Language::CPP`. The `getClangFlags` function, called by `checkClang`, contains an assertion `assert(lang != Standards::Language::None)`, and not providing a valid language will cause a crash.
</requirement>
<requirement>
The `mSettings.clang` boolean member of the `CppCheck` class must be set to `true`. The caller function, `CppCheck::check`, will only call `checkClang` if this flag is enabled.
</requirement>
<requirement>
The `mSettings.clangExecutable` member of the `CppCheck` class must be a valid path to a `clang` executable. The function relies on this executable to perform the analysis, and an invalid path will cause the execution to fail.
</requirement>
<requirement>
The `fileIndex` argument should be `0`. The only existing call site of `checkClang` in the codebase uses a hardcoded value of `0` for this parameter.
</requirement>
</requirements>

</function-requirements>

