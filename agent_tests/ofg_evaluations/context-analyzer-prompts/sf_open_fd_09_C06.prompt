// Helper to safely fill a char array with fuzzed data and null-terminate it.
void FuzzTerminatedString(FuzzedDataProvider &provider, char *dest, size_t dest_size) {
if (dest_size == 0) return;
// Consume up to dest_size - 1 bytes to leave room for the null terminator.
std::vector<uint8_t> bytes = provider.ConsumeBytes<uint8_t>(
provider.ConsumeIntegralInRange<size_t>(0, dest_size - 1));
memcpy(dest, bytes.data(), bytes.size());
dest[bytes.size()] = '\0'; // Null-terminate.
}

void perform_read_and_process_operations(SNDFILE *sndfile, SF_INFO &sfinfo,
FuzzedDataProvider &provider) {
if (!sndfile)
return;

// Fuzz sf_command
if (provider.ConsumeBool()) {
int command = provider.PickValueInArray(kCommands);
// Handle commands requiring special structs to avoid passing invalid data types
if (command == SFC_GET_INSTRUMENT) {
SF_INSTRUMENT inst;
sf_command(sndfile, command, &inst, sizeof(inst));
} else if (command == SFC_GET_BROADCAST_INFO) {
SF_BROADCAST_INFO binfo;
sf_command(sndfile, command, &binfo, sizeof(binfo));
} else if (command == SFC_GET_CART_INFO) {
SF_CART_INFO cinfo;
sf_command(sndfile, command, &cinfo, sizeof(cinfo));
} else {
// For other commands, use generic int/double args
if (provider.ConsumeBool()) {
int int_arg = provider.ConsumeIntegral<int>();
sf_command(sndfile, command, &int_arg, sizeof(int_arg));
} else {
double double_arg = provider.ConsumeFloatingPoint<double>();
sf_command(sndfile, command, &double_arg, sizeof(double_arg));
}
}
}

// Fuzz sf_seek
if (provider.ConsumeBool()) {
sf_count_t offset = provider.ConsumeIntegralInRange<sf_count_t>(
0, sfinfo.frames > 0 ? sfinfo.frames - 1 : 0);
int whence = provider.PickValueInArray({SEEK_SET, SEEK_CUR, SEEK_END});
sf_seek(sndfile, offset, whence);
}

// Fuzz sf_read
if (sfinfo.channels > 0) {
size_t items_to_read =
provider.ConsumeIntegralInRange<size_t>(0, 1024);
size_t buffer_size = items_to_read * sfinfo.channels;
if (buffer_size > 0) {
std::vector<float> read_buffer(buffer_size);
sf_readf_float(sndfile, read_buffer.data(), items_to_read);
}
}
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
FuzzedDataProvider provider(data, size);

// Create a temporary file to work with.
FILE *tmp = tmpfile();
if (!tmp) {
return 0;
}
int fd = fileno(tmp);

// --- STAGE 1: WRITE a sound file ---
SF_INFO write_info;
memset(&write_info, 0, sizeof(write_info));

write_info.samplerate = provider.ConsumeIntegralInRange<int>(8000, 192000);
write_info.channels = provider.ConsumeIntegralInRange<int>(1, 16);
int major_format = provider.PickValueInArray(kMajorFormats);
int subtype_format = provider.PickValueInArray(kSubtypeFormats);
write_info.format = major_format | subtype_format;

// SD2 format is not supported with file descriptors.
if ((write_info.format & SF_FORMAT_TYPEMASK) == SF_FORMAT_SD2) {
fclose(tmp);
return 0;
}

if (!sf_format_check(&write_info)) {
fclose(tmp);
return 0;
}

SNDFILE *outfile = sf_open_fd(fd, SFM_WRITE, &write_info, SF_FALSE);
if (outfile) {
// Try setting some info that we can get later.
if (provider.ConsumeBool()) {
SF_INSTRUMENT inst;
memset(&inst, 0, sizeof(inst));
inst.gain = provider.ConsumeIntegral<int>();
inst.basenote = provider.ConsumeIntegral<char>();
inst.detune = provider.ConsumeIntegral<char>();
inst.velocity_lo = provider.ConsumeIntegral<char>();
inst.velocity_hi = provider.ConsumeIntegral<char>();
inst.key_lo = provider.ConsumeIntegral<char>();
inst.key_hi = provider.ConsumeIntegral<char>();
inst.loop_count = provider.ConsumeIntegralInRange<int>(0, 16);
for (int i = 0; i < inst.loop_count; ++i) {
inst.loops[i].mode = provider.ConsumeIntegral<int>();
inst.loops[i].start = provider.ConsumeIntegral<uint32_t>();
inst.loops[i].end = provider.ConsumeIntegral<uint32_t>();
inst.loops[i].count = provider.ConsumeIntegral<uint32_t>();
}
sf_command(outfile, SFC_SET_INSTRUMENT, &inst, sizeof(inst));
}
if (provider.ConsumeBool()) {
SF_BROADCAST_INFO binfo;
memset(&binfo, 0, sizeof(binfo));
FuzzTerminatedString(provider, binfo.description, sizeof(binfo.description));
FuzzTerminatedString(provider, binfo.originator, sizeof(binfo.originator));
FuzzTerminatedString(provider, binfo.originator_reference, sizeof(binfo.originator_reference));
FuzzTerminatedString(provider, binfo.origination_date, sizeof(binfo.origination_date));
FuzzTerminatedString(provider, binfo.origination_time, sizeof(binfo.origination_time));
binfo.time_reference_low = provider.ConsumeIntegral<uint32_t>();
binfo.time_reference_high = provider.ConsumeIntegral<uint32_t>();
binfo.version = provider.ConsumeIntegral<short>();
FuzzTerminatedString(provider, binfo.umid, sizeof(binfo.umid));
FuzzTerminatedString(provider, binfo.coding_history, sizeof(binfo.coding_history));
binfo.coding_history_size = strlen(binfo.coding_history);
sf_command(outfile, SFC_SET_BROADCAST_INFO, &binfo, sizeof(binfo));
}
if (provider.ConsumeBool()) {
SF_CART_INFO cinfo;
memset(&cinfo, 0, sizeof(cinfo));
FuzzTerminatedString(provider, cinfo.version, sizeof(cinfo.version));
FuzzTerminatedString(provider, cinfo.title, sizeof(cinfo.title));
FuzzTerminatedString(provider, cinfo.artist, sizeof(cinfo.artist));
FuzzTerminatedString(provider, cinfo.cut_id, sizeof(cinfo.cut_id));
FuzzTerminatedString(provider, cinfo.client_id, sizeof(cinfo.client_id));
FuzzTerminatedString(provider, cinfo.category, sizeof(cinfo.category));
FuzzTerminatedString(provider, cinfo.classification, sizeof(cinfo.classification));
FuzzTerminatedString(provider, cinfo.out_cue, sizeof(cinfo.out_cue));
FuzzTerminatedString(provider, cinfo.start_date, sizeof(cinfo.start_date));
FuzzTerminatedString(provider, cinfo.start_time, sizeof(cinfo.start_time));
FuzzTerminatedString(provider, cinfo.end_date, sizeof(cinfo.end_date));
FuzzTerminatedString(provider, cinfo.end_time, sizeof(cinfo.end_time));
FuzzTerminatedString(provider, cinfo.producer_app_id, sizeof(cinfo.producer_app_id));
FuzzTerminatedString(provider, cinfo.producer_app_version, sizeof(cinfo.producer_app_version));
FuzzTerminatedString(provider, cinfo.user_def, sizeof(cinfo.user_def));
FuzzTerminatedString(provider, cinfo.url, sizeof(cinfo.url));
FuzzTerminatedString(provider, cinfo.tag_text, sizeof(cinfo.tag_text));
sf_command(outfile, SFC_SET_CART_INFO, &cinfo, sizeof(cinfo));
}

// Write some fuzzed data to the file.
if (write_info.channels > 0) {
size_t items_to_write = provider.ConsumeIntegralInRange<size_t>(0, 1024);
size_t buffer_size = items_to_write * write_info.channels;
if (buffer_size > 0) {
std::vector<float> write_buffer(buffer_size);
provider.ConsumeData(write_buffer.data(), buffer_size * sizeof(float));
for (size_t i = 0; i < buffer_size; ++i) {
if (std::isnan(write_buffer[i]) || std::isinf(write_buffer[i])) {
write_buffer[i] = 0.0f;
} else {
write_buffer[i] = std::max(-1.0f, std::min(1.0f, write_buffer[i]));
}
}
sf_writef_float(outfile, write_buffer.data(), items_to_write);
}
}
sf_close(outfile);
}

// --- STAGE 2: READ and PROCESS the generated file ---
lseek(fd, 0, SEEK_SET); // Rewind the file descriptor.

SF_INFO read_info;
memset(&read_info, 0, sizeof(read_info));

// Fuzz the SF_INFO struct for read operations.
// This is critical for testing RAW file reading and other paths.
if (provider.ConsumeBool()) {
read_info.samplerate = provider.ConsumeIntegralInRange<int>(8000, 192000);
read_info.channels = provider.ConsumeIntegralInRange<int>(1, 16);
int read_major_format = provider.PickValueInArray(kMajorFormats);
int read_subtype_format = provider.PickValueInArray(kSubtypeFormats);
read_info.format = read_major_format | read_subtype_format;
if ((read_info.format & SF_FORMAT_TYPEMASK) == SF_FORMAT_SD2) {
read_info.format = SF_FORMAT_RAW | SF_FORMAT_PCM_16;
}
}

const int close_desc = provider.ConsumeBool();
// Test SFM_RDWR in addition to SFM_READ.
const int read_mode = provider.PickValueInArray({SFM_READ, SFM_RDWR});

SNDFILE *infile = sf_open_fd(fd, read_mode, &read_info, close_desc);
if (infile) {
perform_read_and_process_operations(infile, read_info, provider);
sf_close(infile);
}

// Always close the FILE* to release its resources, even if sf_close
// already closed the underlying file descriptor.
fclose(tmp);

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: libsndfile
function signature: SNDFILE * sf_open_fd(int, int, SF_INFO *, int)
</input>

<description>
The `sf_open_fd` function opens a sound file using a file descriptor. It takes a file descriptor `fd`, an open `mode`, a pointer to an `SF_INFO` structure `sfinfo`, and a boolean `close_desc` as input. The function first checks if the file format is SD2, which is not allowed with file descriptors. It then allocates a private `SF_PRIVATE` structure, initializes it, and sets the file mode and descriptor. Finally, it calls `psf_open_file` to handle the actual file opening and returns a pointer to the `SF_PRIVATE` structure, which is treated as a `SNDFILE` handle.
</description>

<requirements>

<requirement>
The `fd` argument must be a valid file descriptor. The callers of `sf_open_fd` typically use file descriptors obtained from `pipe()` or `fileno(stdin)`.
</requirement>
<requirement>
The `mode` argument must be one of `SFM_READ` (0x10), `SFM_WRITE` (0x20), or `SFM_RDWR` (0x30). These are the only modes supported by the underlying implementation.
</requirement>
<requirement>
The `sfinfo` argument must be a pointer to a valid `SF_INFO` structure. The `format` member of the structure should not be `SF_FORMAT_SD2` as this is explicitly disallowed in the function.
</requirement>
<requirement>
The `close_desc` argument should be either `SF_TRUE` (1) or `SF_FALSE` (0). This argument controls whether the file descriptor is closed when `sf_close()` is called.
</requirement>

</requirements>

</function-requirements>

