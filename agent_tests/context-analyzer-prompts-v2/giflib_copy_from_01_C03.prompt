<fuzz-target>
#include "gif_fuzz_proto.pb.h"
#include "ProtoToGif.h"
#include "gif_lib.h"
#include <string>
#include <cstdint>
#include <fuzzer/FuzzedDataProvider.h>
#include <algorithm>
#include <cstring>

// Helper struct to manage the in-memory GIF data for the read callback.
struct GifReadState {
const std::string* data;
size_t pos;
};

// Custom InputFunc for DGifOpen that reads from our in-memory string.
int ReadFromMemory(GifFileType* gif, GifByteType* buffer, int length) {
GifReadState* state = (GifReadState*)gif->UserData;
if (state->pos >= state->data->length()) {
return 0; // End of data
}
size_t bytes_to_read = std::min((size_t)length, state->data->length() - state->pos);
memcpy(buffer, state->data->data() + state->pos, bytes_to_read);
state->pos += bytes_to_read;
return bytes_to_read;
}

// Helper function to populate a SubBlock message
void PopulateSubBlock(FuzzedDataProvider& provider, gifProtoFuzzer::SubBlock* sub_block) {
sub_block->set_len(provider.ConsumeIntegral<uint32_t>());
sub_block->set_data(provider.ConsumeRandomLengthString(256));
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
FuzzedDataProvider provider(data, size);
gifProtoFuzzer::GifProto from_proto;

// 1. Set all required fields to ensure the proto is valid.
auto header = from_proto.mutable_header();
header->set_ver(provider.PickValueInArray({
gifProtoFuzzer::Header_Version_ENA,
gifProtoFuzzer::Header_Version_ESA,
gifProtoFuzzer::Header_Version_INV,
}));

auto lsd = from_proto.mutable_lsd();
lsd->set_screenwidth(provider.ConsumeIntegralInRange<uint32_t>(1, 4096));
lsd->set_screenheight(provider.ConsumeIntegralInRange<uint32_t>(1, 4096));
lsd->set_packed(provider.ConsumeIntegral<uint32_t>());
lsd->set_backgroundcolor(provider.ConsumeIntegral<uint32_t>());
lsd->set_aspectratio(provider.ConsumeIntegral<uint32_t>());

auto gct = from_proto.mutable_gct();
gct->set_colors(provider.ConsumeRandomLengthString(1024));
if (gct->colors().empty()) {
gct->set_colors("fuzz");
}

from_proto.mutable_trailer();

// 2. Fuzz the repeated 'chunks' field to explore more complex logic.
int num_chunks = provider.ConsumeIntegralInRange<int>(0, 10);
for (int i = 0; i < num_chunks; ++i) {
auto chunk = from_proto.add_chunks();
switch (provider.ConsumeIntegralInRange<int>(0, 3)) {
case 0: {
auto basic = chunk->mutable_basic();
auto desc = basic->mutable_imdescriptor();
desc->set_seperator(provider.ConsumeIntegral<uint32_t>());
desc->set_left(provider.ConsumeIntegral<uint32_t>());
desc->set_top(provider.ConsumeIntegral<uint32_t>());
desc->set_width(provider.ConsumeIntegralInRange<uint32_t>(1, 1024));
desc->set_height(provider.ConsumeIntegralInRange<uint32_t>(1, 1024));
desc->set_packed(provider.ConsumeIntegral<uint32_t>());
basic->mutable_lct()->set_colors(provider.ConsumeRandomLengthString(256));
basic->mutable_img()->set_lzw(provider.ConsumeIntegral<uint32_t>());
break;
}
case 1: {
auto ptext = chunk->mutable_plaintext();
int num_subs = provider.ConsumeIntegralInRange<int>(0, 5);
for (int j = 0; j < num_subs; ++j) {
PopulateSubBlock(provider, ptext->add_subs());
}
break;
}
case 2: {
auto app_ext = chunk->mutable_appext();
app_ext->set_appid(provider.ConsumeIntegral<uint64_t>());
int num_subs = provider.ConsumeIntegralInRange<int>(0, 5);
for (int j = 0; j < num_subs; ++j) {
PopulateSubBlock(provider, app_ext->add_subs());
}
break;
}
case 3: {
auto com_ext = chunk->mutable_comext();
int num_subs = provider.ConsumeIntegralInRange<int>(0, 5);
for (int j = 0; j < num_subs; ++j) {
PopulateSubBlock(provider, com_ext->add_subs());
}
break;
}
}
}

// 3. Convert the proto to a GIF data stream.
gifProtoFuzzer::ProtoConverter converter;
std::string gif_data = converter.gifProtoToString(from_proto);

if (gif_data.empty()) {
return 0;
}

// 4. Set up the state for our custom read function.
GifReadState read_state;
read_state.data = &gif_data;
read_state.pos = 0;

// 5. Call giflib to decode the in-memory GIF.
int error = 0;
GifFileType* gif_file = DGifOpen(&read_state, &ReadFromMemory, &error);
if (gif_file) {
// DGifSlurp will read and parse the entire GIF structure.
if (DGifSlurp(gif_file) == GIF_OK) {
// Successfully parsed. Could add more logic here to fuzz other
// parts of the library that operate on a parsed GIF.
}
// DGifCloseFile will free resources and test cleanup logic.
DGifCloseFile(gif_file, &error);
}

return 0;
}
</fuzz-target>

<function-requirements>

<input>
project name: giflib
function signature: void gifProtoFuzzer::GifProto::CopyFrom(const GifProto &)
</input>

<description>
The function `gifProtoFuzzer::GifProto::CopyFrom` is a method of the `GifProto` protobuf message. It performs a deep copy of the `from` object, which is also a `GifProto` message, into the current object. For the function to execute without errors, the `from` object must be a valid `GifProto` message, meaning all its required fields must be set. The `GifProto` message represents a GIF file, and its structure is defined in the `gif_fuzz_proto.proto` file.
</description>

<requirements>

<requirement>
The `header` field of the input `GifProto` object must be set. This is a required field in the `GifProto` message definition and is needed for the `CopyFrom` function to have a valid source.
</requirement>
<requirement>
The `lsd` (Logical Screen Descriptor) field of the input `GifProto` object must be set. This is a required field in the `GifProto` message definition and is needed for the `CopyFrom` function to have a valid source.
</requirement>
<requirement>
The `gct` (Global Color Table) field of the input `GifProto` object must be set. This is a required field in the `GifProto` message definition and is needed for the `CopyFrom` function to have a valid source.
</requirement>
<requirement>
The `trailer` field of the input `GifProto` object must be set. This is a required field in the `GifProto` message definition and is needed for the `CopyFrom` function to have a valid source.
</requirement>
<requirement>
If the `chunks` field is not empty, its elements must be valid `ImageChunk` messages. This is because `chunks` is a repeated field of `ImageChunk` messages, and if they are not valid, it could lead to deserialization issues or incorrect data being copied.
</requirement>
<requirement>
The `ver` field of the `Header` message must be one of the defined `Version` enum values. This ensures that the GIF version is valid and can be correctly processed.
</requirement>
<requirement>
The `colors` field of the `GlobalColorTable` must not be empty. It is a required field that holds the color data for the GIF.
</requirement>
<requirement>
The `ScreenWidth` and `ScreenHeight` fields of the `LogicalScreenDescriptor` must be greater than 0. A GIF image with zero width or height is invalid and may cause issues in processing.
</requirement>
<requirement>
All required fields within the nested messages (like `LogicalScreenDescriptor`, `ImageDescriptor`, etc.) must be set. The protobuf library will check for this, and a missing required field will cause an error during the `CopyFrom` operation.
</requirement>

</requirements>

</function-requirements>

